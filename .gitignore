dist/
build/
.astro/
.output/
.svelte-kit/
.cache/
.parcel-cache/
.turbo/

# --- Segredos y entorno ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.pid

# --- Editores e IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.code-workspace

# --- Sistemas operativos ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Proveedores / Despliegue ---
.vercel
.netlify
.firebase/
.wrangler/
.sentryclirc

# --- Registros y cachés de herramientas ---
.eslintcache
.stylelintcache
*.tsbuildinfo
.vite/
.parcel-cache/

# --- Documentación interna (no forma parte del sitio) ---
.agents/
informacion/
