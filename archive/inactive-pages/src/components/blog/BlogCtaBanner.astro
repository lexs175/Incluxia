---
import Button from "../ui/Button.astro";
---

<div class="blog-bottom-cta">
  <div class="cta-inner-text">
    <h2 class="cta-heading">Conecta con talento o encuentra tu próximo trabajo</h2>
    <p class="cta-sub">
      Publica proyectos para tu empresa o explora servicios profesionales con precios claros y comunicación 100% por chat.
    </p>
  </div>
  <div class="cta-actions">
    <Button
      href="/publicar"
      variant="primary"
      size="md"
    >
      <span>+ Publicar Trabajo</span>
    </Button>
    <Button
      href="/contratar"
      variant="primary-line"
      size="md"
    >
      <span>Explorar Talentos</span>
    </Button>
  </div>
</div>

<style>
.blog-bottom-cta {
    margin-top: var(--space-16);
    background-color: var(--color-bg);
    border: 1px solid rgba(var(--color-primary-rgb), 0.1);
    border-radius: var(--radius-md);
    padding: var(--space-10) var(--space-12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    box-shadow: none;
  }

  .cta-inner-text {
    max-width: 680px;
  }


  .cta-heading {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0 0 var(--space-2) 0;
  }

  .cta-sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .cta-actions {
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .blog-bottom-cta {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-8);
    }
  }

  @media (max-width: 479px) {
    .blog-bottom-cta {
      padding: var(--space-6) var(--space-4);
    }

    .cta-actions {
      width: 100%;
    }
  }
</style>
