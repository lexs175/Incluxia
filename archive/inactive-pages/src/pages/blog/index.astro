---
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/cards/BlogCard.astro";
import BlogHero from "../../components/blog/BlogHero.astro";
import BlogCtaBanner from "../../components/blog/BlogCtaBanner.astro";
import articlesData from "../../data/articles.json";
---

<Layout
  title="Blog y Guías Útiles | Eco Bolivia"
  description="Artículos claros sobre leyes laborales en Bolivia, carnet de discapacidad, salud auditiva y consejos para trabajar por chat."
  activePath="/blog"
>
  <BlogHero />

  <!-- Categories and Grid Section -->
  <section class="blog-content-section">
    <div class="container">
      <!-- Filter Pills -->
      <div class="category-pills">
        <button class="cat-pill active" data-cat="all"
          >Todos los Artículos</button
        >
        <button class="cat-pill" data-cat="leyes"
          >Leyes y Derechos Bolivia</button
        >
        <button class="cat-pill" data-cat="salud">Salud Auditiva</button>
        <button class="cat-pill" data-cat="consejos"
          >Consejos para Empresas</button
        >
      </div>

      <!-- Articles Grid -->
      <div class="blog-articles-grid" id="articlesGrid">
        {
          articlesData.map((article) => (
            <div
              class="article-item"
              data-category={article.category.toLowerCase()}
            >
              <BlogCard article={article} />
            </div>
          ))
        }
      </div>

      <BlogCtaBanner />
    </div>
  </section>
</Layout>

<script>
  function initBlogFilters() {
    const pills = document.querySelectorAll(".cat-pill");
    const items = document.querySelectorAll(".article-item");

    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        pills.forEach((p) => p.classList.remove("active"));
        pill.classList.add("active");

        const cat = pill.getAttribute("data-cat") || "all";

        items.forEach((item: any) => {
          const itemCat = item.getAttribute("data-category") || "";
          if (cat === "all" || itemCat.includes(cat)) {
            item.style.display = "block";
          } else {
            item.style.display = "none";
          }
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initBlogFilters);
</script>

<style>
  .blog-content-section {
    padding-top: var(--space-10);
    padding-bottom: var(--space-16);
    background-color: var(--color-bg);
  }

  .category-pills {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-bottom: var(--space-10);
  }

  .cat-pill {
    padding: 0.55rem 1.25rem;
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    background-color: var(--color-white);
    color: var(--color-primary);
    border: 1px solid rgba(var(--color-primary-rgb), 0.12);
    box-shadow: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .cat-pill:hover {
    background-color: rgba(var(--color-primary-rgb), 0.05);
    border-color: var(--color-primary);
  }

  .cat-pill.active {
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    border-color: var(--color-primary);
    box-shadow: none;
  }

  .blog-articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  @media (max-width: 1024px) {
    .blog-articles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }

  @media (max-width: 767px) {
    .blog-articles-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .category-pills {
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 0.5rem;
      scrollbar-width: none;
    }

    .category-pills::-webkit-scrollbar {
      display: none;
    }

    .cat-pill {
      white-space: nowrap;
      flex-shrink: 0;
    }
  }
</style>
