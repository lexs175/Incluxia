---
import Button from "../ui/Button.astro";
---

<section class="section final-cta-section">
  <div class="container">
    <div class="final-cta-capsule">
      <h2 class="final-cta-title">
        Tu próximo proyecto o contratación empieza aquí
      </h2>
      <p class="final-cta-subtitle">
        Crea una cuenta para buscar trabajo, contratar o publicar. Si ya tienes una, ingresa para continuar.
      </p>
      <div class="final-cta-buttons">
        <Button
          data-auth-trigger="register"
          variant="white"
          size="lg"
        >
          <span>Crear cuenta</span>
        </Button>
        <Button
          data-auth-trigger="login"
          variant="outline-white"
          size="lg"
        >
          <span>Ingresar</span>
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    background-color: var(--color-bg-primary);

  }

  .final-cta-capsule {
    background: var(--color-surface-dark);
    border-radius: var(--radius-md);
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    color: var(--color-text-inverse);
    margin: 0 auto;
  }

  .final-cta-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-text-inverse);
    margin-bottom: var(--space-4);
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  .final-cta-subtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-base);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto var(--space-8) auto;
  }

  .final-cta-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (max-width: 479px) {
    .final-cta-capsule {
      padding: var(--space-8) var(--space-5);
      border-radius: var(--radius-md);
    }

    .final-cta-buttons {
      flex-direction: column;
      width: 100%;
    }

    .final-cta-buttons :global(.btn) {
      width: 100%;
    }
  }
</style>
