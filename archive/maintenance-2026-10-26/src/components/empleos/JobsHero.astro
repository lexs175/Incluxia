---
interface Props {
  totalJobs: number;
}

const { totalJobs } = Astro.props;
---

<section class="trustly-jobs-hero">
  <div class="container hero-container">
    <div class="hero-header">
      <h1 class="hero-main-title">
        Trabajos para personas con hipoacusia en <span class="highlight-cyan"
          >Bolivia</span
        >
      </h1>

      <p class="hero-lead-text">
        Vacantes formales en Cochabamba, La Paz, Santa Cruz y todo el país.
        Sin filtros telefónicos que descartan tu talento: la postulación,
        entrevista y coordinación se realizan <strong>100% por chat o WhatsApp</strong>.
      </p>
    </div>

    <!-- Quick Search Bar Pill -->
    <div class="search-pill-wrapper">
      <form class="search-pill-form" id="jobFilterForm">
        <div class="search-field">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="text"
            id="jobSearchInput"
            placeholder="Buscar puesto, empresa o habilidad..."
            class="search-input"
          />
        </div>

        <div class="search-field select-field">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <select id="cityFilterSelect" class="search-select">
            <option value="">Todas las Ciudades</option>
            <option value="Cochabamba">Cochabamba</option>
            <option value="La Paz">La Paz</option>
            <option value="Santa Cruz">Santa Cruz</option>
          </select>
        </div>

        <button type="submit" class="search-submit-btn">
          <span>Filtrar</span>
        </button>
      </form>
    </div>

    <!-- Quick Filter Pills -->
    <div class="quick-filter-pills" id="cityQuickPills">
      <button type="button" class="quick-pill active" data-city=""
        >Todas ({totalJobs})</button
      >
      <button type="button" class="quick-pill" data-city="Cochabamba"
        >Cochabamba</button
      >
      <button type="button" class="quick-pill" data-city="La Paz"
        >La Paz</button
      >
      <button type="button" class="quick-pill" data-city="Santa Cruz"
        >Santa Cruz</button
      >
    </div>
  </div>
</section>

<style>
.trustly-jobs-hero {
    background-color: var(--color-bg);
    padding-top: calc(90px + var(--space-12));
    padding-bottom: var(--space-12);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-header {
    max-width: 820px;
    margin-bottom: var(--space-8);
  }

  .hero-main-title {
    font-size: var(--text-hero);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 0 0 var(--space-4) 0;
  }

  .highlight-cyan {
    color: var(--color-accent);
  }

  .hero-lead-text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.6;
    margin: 0;
  }

  .hero-lead-text strong {
    color: var(--color-primary);
    font-weight: 600;
  }

  .search-pill-wrapper {
    width: 100%;
    max-width: 860px;
    margin-bottom: var(--space-6);
  }

  .search-pill-form {
    background: var(--color-white);
    border: 1px solid rgba(var(--color-primary-rgb), 0.12);
    border-radius: var(--radius-md);
    padding: 0.5rem 0.65rem;
    display: grid;
    grid-template-columns: 1.5fr 1fr auto;
    gap: 0.75rem;
    box-shadow: none;
    align-items: center;
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1.15rem;
    background-color: var(--color-bg);
    border-radius: var(--radius-md);
  }

  .search-field svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .search-input {
    width: 100%;
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-main);
    outline: none;
  }

  .search-select {
    width: 100%;
    border: none;
    background: transparent;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
    outline: none;
    cursor: pointer;
  }

  .search-submit-btn {
    background-color: var(--color-primary);
    color: var(--color-white);
    border: none;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    box-shadow: none;
    transition: background-color var(--transition-fast);
  }

  .search-submit-btn:hover {
    background-color: var(--color-primary-hover);
  }

  .quick-filter-pills {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .quick-pill {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.45rem 1.15rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    box-shadow: none;
    transition: all var(--transition-fast);
  }

  .quick-pill:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .quick-pill.active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }

  @media (max-width: 767px) {
    .search-pill-form {
      grid-template-columns: 1fr;
      border-radius: var(--radius-md);
      padding: var(--space-4);
      gap: var(--space-3);
    }
    .search-submit-btn {
      width: 100%;
    }
  }
</style>
