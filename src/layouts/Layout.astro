---
import { ClientRouter } from "astro:transitions";
import { clientImageManifest, optimizedImage } from "../lib/images.server";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import AuthModal from "../components/ui/AuthModal.astro";
import ButtonTemplates from "../components/ui/ButtonTemplates.astro";
import "../styles/session.css";
import "../styles/account-forms.css";
import "../styles/global.css";
import "../styles/workspace.css";

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
}

const {
  title = "Eco Bolivia | Trabajos para Personas con Pérdida Auditiva e Hipoacusia",
  description = "Plataforma boliviana de trabajo y oportunidades laborales para personas con pérdida auditiva o hipoacusia. Postulaciones y entrevistas 100% por chat o WhatsApp, sin llamadas telefónicas.",
  activePath = "/",
} = Astro.props;
const imageManifest = await clientImageManifest();
const socialImage = await optimizedImage('brand/logo.png', 'brand');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <script is:inline data-astro-rerun>
      try {
        const state = JSON.parse(
          localStorage.getItem("incluxia_demo_v1") || "null",
        );
        const legacy = JSON.parse(
          localStorage.getItem("incluxia_auth_user") || "null",
        );
        document.documentElement.dataset.session = (
          state ? state.sessionId : legacy
        )
          ? "member"
          : "guest";
      } catch {
        document.documentElement.dataset.session = "guest";
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#285FF3" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage.src} />

    <!-- Google Fonts: Montserrat (Headings) & Poppins (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Astro View Transitions / Client-side Router -->
    <ClientRouter />
  </head>
  <body
    data-app-surface={activePath === "/" ||
    /^\/(empleos|contratar|publicar|perfil|perfiles|postulaciones)(\/|$)/.test(
      activePath,
    )
      ? ""
      : undefined}
  >
    <script id="site-image-manifest" type="application/json" is:inline set:html={JSON.stringify(imageManifest).replace(/</g, '\\u003c')} />
    <!-- Skip to content for accessibility -->
    <a href="#main-content" class="skip-to-content"
      >Saltar al contenido principal</a
    >

    <!-- Top Navigation Header -->
    <Header activePath={activePath} />

    <!-- Main Content Canvas -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Accessible Auth Modal (Login / Registro) -->
    <AuthModal />
    <ButtonTemplates />

    <!-- Modals and fullscreen drawers, rendered above the header. -->
    <slot name="drawer" />

    <script>
      import "../lib/navigation";
    </script>

    <!-- GSAP Title & Heading Entrance Animations (Left-to-Right Word Stagger) -->
    <script>
      import gsap from "gsap";

      function splitIntoMaskedLinesAndWords(
        element: HTMLElement,
      ): HTMLElement[] {
        // If element is not rendered or hidden, skip
        if (element.offsetWidth === 0 && element.offsetHeight === 0) return [];

        // Save original pristine HTML once
        if (!element.dataset.origHtml) {
          element.dataset.origHtml = element.innerHTML;
        } else {
          // Reset to pristine original HTML before recalculating (essential for responsive resize)
          element.innerHTML = element.dataset.origHtml;
        }

        // Accessibility: preserve full text for screen readers
        const fullText = (element.textContent || "").trim();
        if (!element.getAttribute("aria-label") && fullText) {
          element.setAttribute("aria-label", fullText);
        }

        // 1. Preserve inline formatting and wrap each complete word.
        function processNodeToWords(node: Node): Node[] {
          if (node.nodeType === Node.TEXT_NODE) {
            const text = node.textContent || "";
            if (!text) return [];
            const tokens = text.split(/(\s+)/);
            const result: Node[] = [];

            tokens.forEach((token) => {
              if (/^\s+$/.test(token)) {
                result.push(document.createTextNode(token));
              } else if (token.length > 0) {
                const wordSpan = document.createElement("span");
                wordSpan.className = "line-word";
                wordSpan.textContent = token;
                result.push(wordSpan);
              }
            });
            return result;
          } else if (node.nodeType === Node.ELEMENT_NODE) {
            const el = node as HTMLElement;
            const clone = el.cloneNode(false) as HTMLElement;
            const childNodes = Array.from(el.childNodes);
            childNodes.forEach((child) => {
              const processedChildren = processNodeToWords(child);
              processedChildren.forEach((pChild) => clone.appendChild(pChild));
            });
            return [clone];
          }
          return [node.cloneNode(true)];
        }

        const childNodes = Array.from(element.childNodes);
        element.innerHTML = "";
        childNodes.forEach((child) => {
          const processed = processNodeToWords(child);
          processed.forEach((p) => element.appendChild(p));
        });

        // 2. Measure rendered top position of each .line-word to detect lines
        const wordElements = Array.from(
          element.querySelectorAll<HTMLElement>(".line-word"),
        );
        if (wordElements.length === 0) return [];

        const lineGroups: HTMLElement[][] = [];
        let currentLine: HTMLElement[] = [];
        let lastTop = -99999;

        wordElements.forEach((word) => {
          const top = Math.round(word.getBoundingClientRect().top);
          if (Math.abs(top - lastTop) > 6) {
            if (currentLine.length > 0) {
              lineGroups.push(currentLine);
            }
            currentLine = [word];
            lastTop = top;
          } else {
            currentLine.push(word);
          }
        });
        if (currentLine.length > 0) {
          lineGroups.push(currentLine);
        }

        // 3. Wrap each line in a .line-mask (overflow: hidden)
        const maskList: HTMLElement[] = [];

        for (let i = 0; i < lineGroups.length; i++) {
          const lineWords = lineGroups[i];
          const firstWord = lineWords[0];
          const lastWord = lineWords[lineWords.length - 1];

          const range = document.createRange();
          range.setStartBefore(firstWord);
          range.setEndAfter(lastWord);
          const contents = range.extractContents();

          const mask = document.createElement("span");
          mask.className = "line-mask";
          mask.style.display = "block";
          mask.style.overflow = "hidden";
          mask.style.lineHeight = "inherit";
          mask.style.paddingBottom = "0.14em"; // Prevents clipping descenders (g, j, p, q, y)
          mask.style.marginBottom = "-0.14em";

          mask.appendChild(contents);
          maskList.push(mask);
        }

        element.innerHTML = "";
        maskList.forEach((mask) => element.appendChild(mask));

        // Keep reading order across lines: first word, second word, third word…
        return Array.from(element.querySelectorAll<HTMLElement>(".line-word"));
      }

      function revealWords(words: HTMLElement[], duration: number) {
        if (!words.length) return;
        gsap.fromTo(
          words,
          { x: -24, autoAlpha: 0 },
          {
            x: 0,
            autoAlpha: 1,
            duration,
            stagger: {
              each: Math.min(0.09, 0.5 / Math.max(words.length - 1, 1)),
              from: "start",
            },
            ease: "power3.out",
            clearProps: "transform,opacity,visibility",
          },
        );
      }

      async function initGsapMaskAnimations() {
        if (
          document.documentElement.dataset.session === "member" &&
          document.body.hasAttribute("data-app-surface")
        )
          return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
          return;

        // Ensure custom fonts are loaded so line detection measurements are 100% accurate
        if (document.fonts) {
          try {
            await document.fonts.ready;
          } catch (e) {
            // fallback if fonts ready fails
          }
        }

        // 1. Reveal hero titles one complete word at a time, from left to right.
        const heroTitles = document.querySelectorAll<HTMLElement>(
          "h1, .hero-main-title, .page-header-title, .jobs-hero-title, .casos-hero-title, .perfiles-hero-title, .blog-hero-title, .about-hero-title, .article-headline",
        );

        heroTitles.forEach((heroTitle) => {
          if (heroTitle.dataset.animated === "true") return;
          heroTitle.dataset.animated = "true";

          revealWords(splitIntoMaskedLinesAndWords(heroTitle), 0.5);
        });

        // 2. Use the same word sequence when section titles enter the viewport.
        const sectionHeadings = document.querySelectorAll<HTMLElement>(
          "h2, .section-heading, .bento-box-title, .enterprise-title, .split-title, .final-cta-title, .metrics-banner-title",
        );

        if (sectionHeadings.length > 0 && "IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const target = entry.target as HTMLElement;
                  if (target.dataset.animated !== "true") {
                    target.dataset.animated = "true";
                    revealWords(splitIntoMaskedLinesAndWords(target), 0.45);
                  }
                  observer.unobserve(target);
                }
              });
            },
            { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
          );

          sectionHeadings.forEach((heading) => {
            if (
              heading.tagName !== "H1" &&
              heading.dataset.animated !== "true"
            ) {
              observer.observe(heading);
            }
          });
        }

        // 3. Responsive Resize Listener: dynamically re-split lines on window width change
        let resizeTimer: any;
        let prevWidth = window.innerWidth;

        window.addEventListener("resize", () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            if (Math.abs(window.innerWidth - prevWidth) > 15) {
              prevWidth = window.innerWidth;

              heroTitles.forEach((el) => {
                if (el.dataset.origHtml) {
                  const words = splitIntoMaskedLinesAndWords(el);
                  gsap.set(words, { clearProps: "transform,opacity,visibility" });
                }
              });

              sectionHeadings.forEach((el) => {
                if (el.dataset.origHtml && el.dataset.animated === "true") {
                  const words = splitIntoMaskedLinesAndWords(el);
                  gsap.set(words, { clearProps: "transform,opacity,visibility" });
                }
              });
            }
          }, 200);
        });
      }

      document.addEventListener("astro:page-load", initGsapMaskAnimations);
    </script>
  </body>
</html>

<style is:global>
  /* Keep full words together inside each responsive line mask. */
  .line-mask {
    display: block;
    overflow: hidden;
    line-height: inherit;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  .line-word {
    display: inline-block;
    max-inline-size: 100%;
    overflow-wrap: anywhere;
  }

  .skip-to-content {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: var(--color-primary);
    color: var(--color-text-inverse);
    padding: 0.75rem 1.25rem;
    z-index: 1000;
    border-radius: var(--radius-md);
    font-weight: 700;
    transition: top var(--transition-fast);
  }

  .skip-to-content:focus {
    top: 1rem;
    outline: 3px solid var(--color-white);
    outline-offset: 2px;
  }
</style>
