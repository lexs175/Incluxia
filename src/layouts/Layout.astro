---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFAB from '../components/layout/WhatsAppFAB.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
}

const {
  title = 'Incluxia Bolivia | Trabajos para Personas con Pérdida Auditiva e Hipoacusia',
  description = 'Plataforma boliviana de trabajo y oportunidades laborales para personas con pérdida auditiva o hipoacusia. Postulaciones y entrevistas 100% por chat o WhatsApp, sin llamadas telefónicas.',
  activePath = '/',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#212051" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/logo.png" />

    <!-- Google Fonts: Montserrat (Headings) & Poppins (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Astro View Transitions / Client-side Router -->
    <ClientRouter />
  </head>
  <body>
    <!-- Skip to content for accessibility -->
    <a href="#main-content" class="skip-to-content">Saltar al contenido principal</a>

    <!-- Top Navigation Header -->
    <Header activePath={activePath} />

    <!-- Main Content Canvas -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Accessible Floating Action Button -->
    <WhatsAppFAB />

    <!-- GSAP Title & Heading Entrance Animations (Line Mask + Letter-by-Letter Stagger) -->
    <script>
      import gsap from 'gsap';

      function splitIntoMaskedLinesAndChars(element: HTMLElement): HTMLElement[] {
        // If element is not rendered or hidden, skip
        if (element.offsetWidth === 0 && element.offsetHeight === 0) return [];

        // Save original pristine HTML once
        if (!element.dataset.origHtml) {
          element.dataset.origHtml = element.innerHTML;
        } else {
          // Reset to pristine original HTML before recalculating (essential for responsive resize)
          element.innerHTML = element.dataset.origHtml;
        }

        // Accessibility: preserve full text for screen readers
        const fullText = (element.textContent || '').trim();
        if (!element.getAttribute('aria-label') && fullText) {
          element.setAttribute('aria-label', fullText);
        }

        // 1. Process DOM recursively: wrap words in .line-word and characters in .line-char
        function processNodeToWordsAndChars(node: Node): Node[] {
          if (node.nodeType === Node.TEXT_NODE) {
            const text = node.textContent || '';
            if (!text) return [];
            const tokens = text.split(/(\s+)/);
            const result: Node[] = [];

            tokens.forEach((token) => {
              if (/^\s+$/.test(token)) {
                result.push(document.createTextNode(token));
              } else if (token.length > 0) {
                const wordSpan = document.createElement('span');
                wordSpan.className = 'line-word';
                wordSpan.style.display = 'inline-block';
                wordSpan.style.whiteSpace = 'nowrap';

                for (const char of token) {
                  const charSpan = document.createElement('span');
                  charSpan.className = 'line-char';
                  charSpan.style.display = 'inline-block';
                  charSpan.style.willChange = 'transform';
                  charSpan.textContent = char;
                  wordSpan.appendChild(charSpan);
                }
                result.push(wordSpan);
              }
            });
            return result;
          } else if (node.nodeType === Node.ELEMENT_NODE) {
            const el = node as HTMLElement;
            const clone = el.cloneNode(false) as HTMLElement;
            const childNodes = Array.from(el.childNodes);
            childNodes.forEach((child) => {
              const processedChildren = processNodeToWordsAndChars(child);
              processedChildren.forEach((pChild) => clone.appendChild(pChild));
            });
            return [clone];
          }
          return [node.cloneNode(true)];
        }

        const childNodes = Array.from(element.childNodes);
        element.innerHTML = '';
        childNodes.forEach((child) => {
          const processed = processNodeToWordsAndChars(child);
          processed.forEach((p) => element.appendChild(p));
        });

        // 2. Measure rendered top position of each .line-word to detect lines
        const wordElements = Array.from(element.querySelectorAll<HTMLElement>('.line-word'));
        if (wordElements.length === 0) return [];

        const lineGroups: HTMLElement[][] = [];
        let currentLine: HTMLElement[] = [];
        let lastTop = -99999;

        wordElements.forEach((word) => {
          const top = Math.round(word.getBoundingClientRect().top);
          if (Math.abs(top - lastTop) > 6) {
            if (currentLine.length > 0) {
              lineGroups.push(currentLine);
            }
            currentLine = [word];
            lastTop = top;
          } else {
            currentLine.push(word);
          }
        });
        if (currentLine.length > 0) {
          lineGroups.push(currentLine);
        }

        // 3. Wrap each line in a .line-mask (overflow: hidden)
        const maskList: HTMLElement[] = [];

        for (let i = 0; i < lineGroups.length; i++) {
          const lineWords = lineGroups[i];
          const firstWord = lineWords[0];
          const lastWord = lineWords[lineWords.length - 1];

          const range = document.createRange();
          range.setStartBefore(firstWord);
          range.setEndAfter(lastWord);
          const contents = range.extractContents();

          const mask = document.createElement('span');
          mask.className = 'line-mask';
          mask.style.display = 'block';
          mask.style.overflow = 'hidden';
          mask.style.lineHeight = 'inherit';
          mask.style.paddingBottom = '0.14em'; // Prevents clipping descenders (g, j, p, q, y)
          mask.style.marginBottom = '-0.14em';

          mask.appendChild(contents);
          maskList.push(mask);
        }

        element.innerHTML = '';
        maskList.forEach((mask) => element.appendChild(mask));

        // Return all characters across all line masks in reading order
        return Array.from(element.querySelectorAll<HTMLElement>('.line-char'));
      }

      async function initGsapMaskAnimations() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        // Ensure custom fonts are loaded so line detection measurements are 100% accurate
        if (document.fonts) {
          try {
            await document.fonts.ready;
          } catch (e) {
            // fallback if fonts ready fails
          }
        }

        // 1. Immediate masked line + letter-by-letter reveal for Hero titles (h1)
        const heroTitles = document.querySelectorAll<HTMLElement>(
          'h1, .hero-main-title, .page-header-title, .jobs-hero-title, .casos-hero-title, .perfiles-hero-title, .blog-hero-title, .about-hero-title, .article-headline'
        );

        heroTitles.forEach((heroTitle) => {
          if (heroTitle.dataset.animated === 'true') return;
          heroTitle.dataset.animated = 'true';

          const chars = splitIntoMaskedLinesAndChars(heroTitle);
          if (chars.length > 0) {
            // Pure mask reveal: letters start below the mask line and emerge letter-by-letter with 0 opacity fade
            gsap.fromTo(
              chars,
              { yPercent: 125 },
              {
                yPercent: 0,
                duration: 0.65,
                stagger: 0.018, // Letter by letter cascade
                ease: 'power3.out',
                clearProps: 'transform',
              }
            );
          }
        });

        // 2. Scroll-triggered masked line + letter-by-letter reveal for section titles (h2, etc.)
        const sectionHeadings = document.querySelectorAll<HTMLElement>(
          'h2, .section-heading, .bento-box-title, .enterprise-title, .split-title, .final-cta-title, .metrics-banner-title'
        );

        if (sectionHeadings.length > 0 && 'IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const target = entry.target as HTMLElement;
                  if (target.dataset.animated !== 'true') {
                    target.dataset.animated = 'true';
                    const chars = splitIntoMaskedLinesAndChars(target);
                    if (chars.length > 0) {
                      gsap.fromTo(
                        chars,
                        { yPercent: 125 },
                        {
                          yPercent: 0,
                          duration: 0.6,
                          stagger: 0.015,
                          ease: 'power3.out',
                          clearProps: 'transform',
                        }
                      );
                    }
                  }
                  observer.unobserve(target);
                }
              });
            },
            { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
          );

          sectionHeadings.forEach((heading) => {
            if (heading.tagName !== 'H1' && heading.dataset.animated !== 'true') {
              observer.observe(heading);
            }
          });
        }

        // 3. Responsive Resize Listener: dynamically re-split lines on window width change
        let resizeTimer: any;
        let prevWidth = window.innerWidth;

        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            if (Math.abs(window.innerWidth - prevWidth) > 15) {
              prevWidth = window.innerWidth;

              heroTitles.forEach((el) => {
                if (el.dataset.origHtml) {
                  const chars = splitIntoMaskedLinesAndChars(el);
                  gsap.set(chars, { yPercent: 0, clearProps: 'transform' });
                }
              });

              sectionHeadings.forEach((el) => {
                if (el.dataset.origHtml && el.dataset.animated === 'true') {
                  const chars = splitIntoMaskedLinesAndChars(el);
                  gsap.set(chars, { yPercent: 0, clearProps: 'transform' });
                }
              });
            }
          }, 200);
        });
      }

      document.addEventListener('astro:page-load', initGsapMaskAnimations);
    </script>
  </body>
</html>

<style is:global>
  /* Line Mask Reveal Animation Core Styles */
  .line-mask {
    display: block;
    overflow: hidden;
    line-height: inherit;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  .line-word {
    display: inline-block;
    white-space: nowrap;
  }

  .line-char {
    display: inline-block;
    will-change: transform;
  }

  .skip-to-content {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: var(--color-primary);
    color: var(--color-text-inverse);
    padding: 0.75rem 1.25rem;
    z-index: 1000;
    border-radius: var(--radius-md);
    font-weight: 700;
    transition: top var(--transition-fast);
  }

  .skip-to-content:focus {
    top: 1rem;
    outline: 3px solid var(--color-accent);
  }
</style>
