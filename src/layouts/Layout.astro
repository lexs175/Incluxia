---
import { ClientRouter } from "astro:transitions";
import { clientImageManifest, optimizedImage } from "../lib/images.server";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import AuthModal from "../components/ui/AuthModal.astro";
import ButtonTemplates from "../components/ui/ButtonTemplates.astro";
import "../styles/session.css";
import "../styles/account-forms.css";
import "../styles/global.css";
import "../styles/workspace.css";

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
}

const {
  title = "Eco Bolivia | Trabajos para Personas con Pérdida Auditiva e Hipoacusia",
  description = "Plataforma boliviana de trabajo y oportunidades laborales para personas con pérdida auditiva o hipoacusia. Postulaciones y entrevistas 100% por chat o WhatsApp, sin llamadas telefónicas.",
  activePath = "/",
} = Astro.props;
const imageManifest = await clientImageManifest();
const socialImage = await optimizedImage('brand/open-graph-eco.png', 'social');
const socialImageUrl = new URL(socialImage.src!, Astro.site);
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageAlt = 'Eco: Más oportunidades, menos barreras. Una profesional con audífono trabaja en una computadora junto a un compañero.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      if (performance.getEntriesByType("navigation")[0]?.type === "reload") {
        const resetReloadScroll = () => {
          history.scrollRestoration = "manual";
          if (history.state) {
            history.replaceState({ ...history.state, scrollX: 0, scrollY: 0 }, "");
          }
          window.scrollTo({ top: 0, left: 0, behavior: "instant" });
        };
        // Reset the saved router position before Astro can restore it.
        resetReloadScroll();
        document.addEventListener("astro:page-load", resetReloadScroll, { once: true });
      }
    </script>
    <script is:inline data-astro-rerun>
      try {
        const state = JSON.parse(
          localStorage.getItem("incluxia_demo_v1") || "null",
        );
        const legacy = JSON.parse(
          localStorage.getItem("incluxia_auth_user") || "null",
        );
        document.documentElement.dataset.session = (
          state ? state.sessionId : legacy
        )
          ? "member"
          : "guest";
      } catch {
        document.documentElement.dataset.session = "guest";
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#285FF3" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eco Bolivia" />
    <meta property="og:locale" content="es_BO" />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:secure_url" content={socialImageUrl.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <!-- Google Fonts: Montserrat (Headings) & Poppins (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Astro View Transitions / Client-side Router -->
    <ClientRouter />
  </head>
  <body
    data-app-surface={activePath === "/" ||
    /^\/(empleos|contratar|publicar|perfil|perfiles|postulaciones)(\/|$)/.test(
      activePath,
    )
      ? ""
      : undefined}
  >
    <script id="site-image-manifest" type="application/json" is:inline set:html={JSON.stringify(imageManifest).replace(/</g, '\\u003c')} />
    <!-- Skip to content for accessibility -->
    <a href="#main-content" class="skip-to-content"
      >Saltar al contenido principal</a
    >

    <!-- Top Navigation Header -->
    <Header activePath={activePath} />

    <!-- Main Content Canvas -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Accessible Auth Modal (Login / Registro) -->
    <AuthModal />
    <ButtonTemplates />

    <!-- Modals and fullscreen drawers, rendered above the header. -->
    <slot name="drawer" />

    <script>
      import "../lib/navigation";
    </script>

    <script>
      import "../lib/heading-motion";
    </script>
  </body>
</html>

<style is:global>
  .heading-word {
    display: inline-block;
    max-inline-size: 100%;
    overflow-wrap: anywhere;
  }

  .skip-to-content {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: var(--color-primary);
    color: var(--color-text-inverse);
    padding: 0.75rem 1.25rem;
    z-index: 1000;
    border-radius: var(--radius-md);
    font-weight: 700;
    transition: top var(--transition-fast);
  }

  .skip-to-content:focus {
    top: 1rem;
    outline: 3px solid var(--color-white);
    outline-offset: 2px;
  }
</style>
