---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import Badge from "../components/ui/Badge.astro";
import JobCard from "../components/cards/JobCard.astro";
import StoryCard from "../components/cards/StoryCard.astro";
import BlogCard from "../components/cards/BlogCard.astro";

import jobsData from "../data/jobs.json";
import storiesData from "../data/stories.json";
import articlesData from "../data/articles.json";

const featuredJobs = jobsData.slice(0, 3);
const featuredStories = storiesData.slice(0, 3);
const featuredArticles = articlesData.slice(0, 3);
---

<Layout
  title="Incluxia Bolivia | Inclusión Laboral para Personas con Hipoacusia"
  description="Plataforma de trabajo en Bolivia para personas con hipoacusia. Procesos de selección 100% por chat o WhatsApp, sin llamadas telefónicas. Cumplimiento de la Ley 977."
  activePath="/"
>
  <!-- 1. HERO SECTION: Clean Modern Canvas (Trustly Fintech Style) -->
  <section class="trustly-hero">
    <div class="container hero-container">
      <div class="hero-header">
        <h1 class="hero-main-title">
          Trabajos para personas con hipoacusia en <span class="highlight-cyan"
            >Bolivia</span
          >
        </h1>

        <p class="hero-lead-text">
          Basta de llamadas telefónicas sorpresa que descartan tu talento.
          Conectamos profesionales con empresas formales donde todo se coordina <strong
            >100% por chat o WhatsApp</strong
          >, con tareas claras por escrito y salario justo.
        </p>

        <!-- Quick Search Bar Pill in Hero -->
        <div class="hero-search-wrapper">
          <form action="/empleos" method="GET" class="search-pill-form">
            <div class="search-field">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="text"
                name="q"
                placeholder="Puesto, habilidad o palabra clave..."
                class="search-input"
              />
            </div>
            <div class="search-field select-field">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <select name="ciudad" class="search-select">
                <option value="">Toda Bolivia</option>
                <option value="Cochabamba">Cochabamba</option>
                <option value="La Paz">La Paz</option>
                <option value="Santa Cruz">Santa Cruz</option>
              </select>
            </div>
            <Button type="submit" variant="primary" size="sm">
              <span>Buscar</span>
            </Button>
          </form>

          <div class="hero-sub-actions">
            <span class="hero-quick-tag-label">Frecuentes:</span>
            <a href="/empleos?q=auxiliar" class="hero-quick-tag">Auxiliar</a>
            <a href="/empleos?q=digitador" class="hero-quick-tag">Digitador</a>
            <a href="/empleos?q=diseno" class="hero-quick-tag">Diseño</a>
            <a href="/empleos?q=archivo" class="hero-quick-tag">Archivo</a>
            <span class="hero-quick-dot">·</span>
            <a href="#empresas-ley977" class="hero-quick-empresa">Para Empresas (Ley 977) &rarr;</a>
          </div>
        </div>
      </div>

      <!-- Hero Centerpiece Bento Showcase -->
      <div class="hero-showcase-wrapper">
        <div class="hero-showcase-bento">
          <!-- Left: Dark Panel with Live WhatsApp Interview Preview -->
          <div class="showcase-dark-panel">
            <div class="panel-header-badge">
              <span class="chat-live-indicator">
                <span class="pulse-green-dot"></span>
                Coordinación 100% Escrita
              </span>
            </div>

            <div class="panel-main-copy">
              <h2 class="panel-title">Entrevistas directas por WhatsApp</h2>
              <p class="panel-desc">
                Sin intermediarios ni llamadas sorpresa. Postulas con un clic y
                te responden directamente por mensaje de texto.
              </p>
            </div>

            <div class="whatsapp-mock-bubble">
              <div class="bubble-header">
                <div class="whatsapp-avatar" aria-hidden="true">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path
                      d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                    ></path>
                  </svg>
                </div>
                <div class="bubble-sender">
                  <span class="sender-name"
                    >Equipo de Selección · Banco Mercantil</span
                  >
                  <span class="sender-time">Hoy 10:15 am</span>
                </div>
              </div>
              <p class="bubble-message">
                "Hola Valeria, revisamos tu CV y tu portafolio en Incluxia. Tu
                experiencia es ideal. Coordinemos la entrevista técnica
                directamente por este chat."
              </p>
            </div>

            <div class="panel-metric-row">
              <div class="metric-pill">
                <span class="metric-val">100%</span>
                <span class="metric-txt">Chat Escrito</span>
              </div>
              <div class="metric-pill">
                <span class="metric-val">0</span>
                <span class="metric-txt">Llamadas Telefónicas</span>
              </div>
              <div class="metric-pill">
                <span class="metric-val">Ley 977</span>
                <span class="metric-txt">Cuotas 2% y 4%</span>
              </div>
            </div>
          </div>

          <!-- Right: Professional Real Workplace Photography -->
          <div class="showcase-photo-panel">
            <img
              src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=1000&q=80"
              alt="Profesional concentrada trabajando en oficina moderna en Bolivia"
              class="showcase-cover-img"
              loading="eager"
            />
            <div class="photo-overlay-tag">
              <span class="tag-bold">Talento Verificado</span>
              <span class="tag-sub"
                >Inclusión con estabilidad y trato digno</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Trust Ribbon (Like Trustly Partners Strip) -->
      <div class="trust-ribbon">
        <span class="trust-label"
          >Empresas e instituciones comprometidas con la inclusión laboral:</span
        >
        <div class="trust-logos-row">
          <span class="trust-company-tag">Banco Mercantil Santa Cruz</span>
          <span class="trust-dot-sep">·</span>
          <span class="trust-company-tag">Farmacorp</span>
          <span class="trust-dot-sep">·</span>
          <span class="trust-company-tag">Tigo Bolivia</span>
          <span class="trust-dot-sep">·</span>
          <span class="trust-company-tag">Banco Nacional de Bolivia</span>
          <span class="trust-dot-sep">·</span>
          <span class="trust-company-tag">Embol</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. BOLD MANIFESTO STATEMENT (Large Typography Section) -->
  <section class="manifesto-section">
    <div class="container manifesto-container">
      <p class="manifesto-text">
        El talento no se mide por lo que escuchas, sino por lo que eres capaz de
        resolver. En Incluxia eliminamos las barreras telefónicas para conectar
        a personas de alta concentración con puestos de trabajo formales en toda
        Bolivia.
      </p>
    </div>
  </section>

  <!-- 3. SOFT BENTO SECTION: CÓMO FUNCIONA LA INCLUSIÓN (Trustly Soft Tinted Box) -->
  <section class="section bento-how-section">
    <div class="container">
      <div class="bento-container-box">
        <div class="bento-box-header">
          <h2 class="bento-box-title">
            Diseñado para que trabajar sea fácil, claro y justo
          </h2>
          <p class="bento-box-desc">
            Eliminamos de raíz las llamadas sorpresa y los malos entendidos.
            Todo el proceso está pensado para tu comodidad desde el primer
            contacto.
          </p>
        </div>

        <div class="bento-cards-grid">
          <!-- Bento Card 1 -->
          <div class="bento-card">
            <div class="bento-card-icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                ></path>
              </svg>
            </div>
            <h3 class="bento-title">100% por WhatsApp o Chat</h3>
            <p class="bento-text">
              Postulas con un solo clic desde tu teléfono celular. Recibes
              respuestas y convocatorias por mensaje escrito, sin temor a
              llamadas perdidas.
            </p>
          </div>

          <!-- Bento Card 2 -->
          <div class="bento-card">
            <div class="bento-card-icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
            </div>
            <h3 class="bento-title">Entrevistas con Cámara o Texto</h3>
            <p class="bento-text">
              Videollamadas con lectura labial, subtítulos automáticos en vivo,
              preguntas por chat escrito o intérprete de Lengua de Señas
              Boliviana (LSB).
            </p>
          </div>

          <!-- Bento Card 3 -->
          <div class="bento-card">
            <div class="bento-card-icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </div>
            <h3 class="bento-title">Tareas Claras y Escritas</h3>
            <p class="bento-text">
              Las empresas asociadas entregan manuales con capturas de pantalla,
              objetivos por escrito y seguimiento en herramientas digitales.
            </p>
          </div>

          <!-- Bento Card 4 -->
          <div class="bento-card">
            <div class="bento-card-icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h3 class="bento-title">Respaldo de la Ley 977</h3>
            <p class="bento-text">
              Puestos de trabajo formales con estabilidad laboral, inamovilidad
              y todos los beneficios de ley garantizados por la normativa
              boliviana.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. TRABAJOS DISPONIBLES (Modern Bento Job Directory) -->
  <section class="section jobs-section">
    <div class="container">
      <div class="section-top-bar">
        <div>
          <h2 class="section-heading">Ofertas de Trabajo Disponibles</h2>
          <p class="section-desc">
            Vacantes con procesos de selección evaluados por chat escrito y
            adaptaciones garantizadas en Bolivia.
          </p>
        </div>
        <a href="/empleos" class="section-action-link">
          <span>Ver todas las ofertas ({jobsData.length})</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="jobs-cards-grid">
        {featuredJobs.map((job) => <JobCard job={job} />)}
      </div>
    </div>
  </section>

  <!-- 5. BLACK BENTO SHOWCASE: PARA EMPRESAS Y LEY 977 (Trustly Dark Bento) -->
  <section class="section enterprise-dark-section" id="empresas-ley977">
    <div class="container">
      <div class="enterprise-dark-card">
        <div class="enterprise-content-grid">
          <!-- Left: Information and High-Contrast Metrics -->
          <div class="enterprise-info-col">
            <h2 class="enterprise-title">
              Cumple tu cuota de la Ley 977 con el mejor talento
            </h2>
            <p class="enterprise-lead">
              Las personas con hipoacusia destacan por su agudeza visual,
              concentración profunda y apego al cumplimiento de procesos. Cumple
              la cuota legal en Bolivia de forma ágil, con coordinación directa
              por chat.
            </p>

            <div class="metrics-bento-grid">
              <div class="metric-bento-card">
                <span class="metric-huge">2%</span>
                <span class="metric-card-title">Sector Privado</span>
                <p class="metric-card-desc">
                  Obligatorio en empresas con más de 50 trabajadores (Ley 977).
                </p>
              </div>

              <div class="metric-bento-card">
                <span class="metric-huge">4%</span>
                <span class="metric-card-title">Sector Público</span>
                <p class="metric-card-desc">
                  Obligatorio en ministerios, alcaldías y gobernaciones (Ley
                  223).
                </p>
              </div>

              <div class="metric-bento-card">
                <span class="metric-huge">100%</span>
                <span class="metric-card-title">Chat Escrito</span>
                <p class="metric-card-desc">
                  Soporte y coordinación continua sin barreras telefónicas.
                </p>
              </div>
            </div>
          </div>

          <!-- Right: Clean White Form Capsule -->
          <div class="enterprise-form-capsule">
            <h3 class="form-capsule-title">Publica tu vacante laboral</h3>
            <p class="form-capsule-desc">
              Ingresa los datos de tu empresa y el puesto. El equipo de Incluxia
              te escribirá por WhatsApp para coordinar los detalles.
            </p>

            <form
              class="company-form"
              id="companyVacancyForm"
            >
              <div class="form-item">
                <label for="compName" class="form-label"
                  >Nombre de la Empresa o Negocio *</label
                >
                <input
                  type="text"
                  id="compName"
                  required
                  placeholder="Ej. Banco Mercantil, Farmacorp, etc."
                  class="form-input-field"
                />
              </div>

              <div class="form-item">
                <label for="contactPerson" class="form-label"
                  >Persona de Contacto *</label
                >
                <input
                  type="text"
                  id="contactPerson"
                  required
                  placeholder="Nombre y apellido"
                  class="form-input-field"
                />
              </div>

              <div class="form-item">
                <label for="contactInfo" class="form-label"
                  >WhatsApp o Correo Corporativo *</label
                >
                <input
                  type="text"
                  id="contactInfo"
                  required
                  placeholder="+591 70000000 o rrhh@empresa.com"
                  class="form-input-field"
                />
              </div>

              <div class="form-item">
                <label for="jobDetails" class="form-label"
                  >Puesto Vacante y Ciudad *</label
                >
                <textarea
                  id="jobDetails"
                  required
                  placeholder="Puesto (diseño, contabilidad, archivo), ciudad y funciones..."
                  class="form-textarea-field"></textarea>
              </div>

              <Button type="submit" variant="primary" fullWidth={true} id="btnSubmitCompany">
                <span id="btnSubmitCompanyText">Enviar Vacante a Incluxia</span>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              </Button>
            </form>

            <div id="companySuccessBox" class="company-success-box" style="display: none;">
              <span class="company-success-icon">✓</span>
              <div>
                <strong>¡Vacante enviada con éxito!</strong>
                <p>El equipo de Incluxia revisará los detalles y te contactará por WhatsApp para coordinar los postulantes idóneos.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. CASOS DE ÉXITO (Real Story Cards with Video & LSB Badge) -->
  <section class="section stories-section">
    <div class="container">
      <div class="section-top-bar">
        <div>
          <h2 class="section-heading">Talento Sin Barreras en Bolivia</h2>
          <p class="section-desc">
            Conoce a personas con hipoacusia que demuestran su capacidad y
            compromiso en tecnología, diseño y administración.
          </p>
        </div>
        <a href="/casos-de-exito" class="section-action-link">
          <span>Ver todas las historias</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="stories-cards-grid">
        {featuredStories.map((story) => <StoryCard story={story} />)}
      </div>
    </div>
  </section>

  <!-- 7. BLOG & RECURSOS (Editorial Cards) -->
  <section class="section blog-section">
    <div class="container">
      <div class="section-top-bar">
        <div>
          <h2 class="section-heading">Blog y Consejos Prácticos</h2>
          <p class="section-desc">
            Guías claras sobre la Ley 223 y 977, cómo tramitar tu carnet de
            discapacidad y adaptaciones razonables en la oficina.
          </p>
        </div>
        <a href="/blog" class="section-action-link">
          <span>Ver todos los artículos</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="blog-cards-grid">
        {featuredArticles.map((article) => <BlogCard article={article} />)}
      </div>
    </div>
  </section>

  <!-- 8. FINAL HIGH-IMPACT CTA (Trustly Bottom Style) -->
  <section class="section final-cta-section">
    <div class="container">
      <div class="final-cta-capsule">
        <h2 class="final-cta-title">
          Tu próximo paso laboral empieza con un mensaje de texto.
        </h2>
        <p class="final-cta-subtitle">
          Ya sea que busques empleo o quieras contratar talento comprometido, en
          Incluxia te conectamos sin llamadas ni complicaciones.
        </p>
        <div class="final-cta-buttons">
          <Button href="/empleos" variant="primary" size="lg">
            <span>Ver Trabajos Disponibles</span>
          </Button>
          <Button
            href="https://wa.me/59170000000?text=Hola%20Incluxia%2C%20deseo%20m%C3%A1s%20informaci%C3%B3n"
            target="_blank"
            rel="noopener noreferrer"
            variant="whatsapp"
            size="lg"
          >
            <span>Escribir por WhatsApp</span>
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ====================================================
     1. HERO: CLEAN MODERN CANVAS (TRUSTLY FINTECH STYLE)
     ==================================================== */
  .trustly-hero {
    background-color: var(--color-white);
    padding-top: calc(90px + var(--space-12));
    padding-bottom: var(--space-16);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto var(--space-12) auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .status-dot-pulse {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--color-whatsapp);
    border: 1px solid var(--color-white);
    box-shadow: none; /* ZERO SHADOWS */
  }

  .hero-main-title {
    font-size: var(--text-hero);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .highlight-cyan {
    color: var(--color-accent-dark);
    position: relative;
  }

  .hero-lead-text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.65;
    max-width: 680px;
    margin: 0 auto var(--space-8) auto;
  }

  .hero-lead-text strong {
    color: var(--color-primary);
    font-weight: 600;
  }

  .hero-search-wrapper {
    max-width: 680px;
    margin: 0 auto var(--space-8) auto;
    width: 100%;
  }

  .hero-sub-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .hero-quick-tag-label {
    font-weight: 500;
  }

  .hero-quick-tag {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(var(--color-primary-rgb), 0.25);
    transition: all var(--transition-fast);
  }

  .hero-quick-tag:hover {
    color: var(--color-accent-dark);
    text-decoration-color: var(--color-accent-dark);
  }

  .hero-quick-dot {
    color: rgba(var(--color-primary-rgb), 0.2);
    margin: 0 0.25rem;
  }

  .hero-quick-empresa {
    color: var(--color-primary);
    font-weight: 700;
    font-family: var(--font-heading);
    transition: color var(--transition-fast);
  }

  .hero-quick-empresa:hover {
    color: var(--color-accent-dark);
  }

  /* Hero Centerpiece Bento Showcase */
  .hero-showcase-wrapper {
    width: 100%;
