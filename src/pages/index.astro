---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import ExpandableButton from "../components/ui/ExpandableButton.astro";
import Badge from "../components/ui/Badge.astro";
import JobCard from "../components/cards/JobCard.astro";
import StoryCard from "../components/cards/StoryCard.astro";
import BlogCard from "../components/cards/BlogCard.astro";

import jobsData from "../data/jobs.json";
import storiesData from "../data/stories.json";
import articlesData from "../data/articles.json";

const featuredJobs = jobsData.slice(0, 3);
const featuredStories = storiesData.slice(0, 3);
const featuredArticles = articlesData.slice(0, 3);
---

<Layout
  title="Incluxia Bolivia | Inclusión Laboral para Personas con Hipoacusia"
  description="Plataforma de trabajo en Bolivia para personas con hipoacusia. Procesos de selección 100% por chat o WhatsApp, sin llamadas telefónicas. Cumplimiento de la Ley 977."
  activePath="/"
>
  <!-- 1. HERO SECTION: ASHICO Cochabamba Community Hero -->
  <section class="ashico-hero" aria-label="Sección Principal de Incluxia">
    <div class="container hero-container">
      <div class="hero-content">
        <h1 class="hero-title">
          Trabajos para personas<br />
          con hipoacusia en<br />
          <span class="hero-city-title">COCHABAMBA</span>
        </h1>

        <p class="hero-description">
          Basta de llamadas telefónicas sorpresa que descartan tu talento.
          Conectamos profesionales y postulantes con empresas inclusivas en
          Cochabamba donde todo se coordina <strong
            >100% por chat o WhatsApp</strong
          >, con salario justo y tareas claras por escrito.
        </p>

        <div class="hero-actions">
          <ExpandableButton
            href="/empleos?ciudad=Cochabamba"
            text="Buscar trabajo"
            size="lg"
            variant="white"
            id="heroBtnBuscar"
          />
        </div>
      </div>
    </div>
  </section>
  <!-- 3. SOFT BENTO SECTION: CÓMO FUNCIONA LA INCLUSIÓN (Trustly Soft Tinted Box) -->
  <section class="section bento-how-section">
    <div class="container">
      <div class="bento-container-box">
        <div class="bento-box-header">
          <h2 class="bento-box-title">
            Diseñado para que trabajar sea fácil, claro y justo
          </h2>
          <p class="bento-box-desc">
            Eliminamos de raíz las llamadas sorpresa y los malos entendidos.
            Todo el proceso está pensado para tu comodidad desde el primer
            contacto.
          </p>
        </div>

        <div class="bento-cards-grid">
          <!-- Bento Card 1 -->
          <div class="bento-card">
            <div class="bento-card-icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                ></path>
              </svg>
            </div>
            <h3 class="bento-title">100% por WhatsApp o Chat</h3>
            <p class="bento-text">
              Postulas con un solo clic desde tu teléfono celular. Recibes
              respuestas y convocatorias por mensaje escrito, sin temor a
              llamadas perdidas.
            </p>
          </div>

          <!-- Bento Card 2 -->
          <div class="bento-card">
            <div class="bento-card-icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
            </div>
            <h3 class="bento-title">Entrevistas con Cámara o Texto</h3>
            <p class="bento-text">
              Videollamadas con lectura labial, subtítulos automáticos en vivo,
              preguntas por chat escrito o intérprete de Lengua de Señas
              Boliviana (LSB).
            </p>
          </div>

          <!-- Bento Card 3 -->
          <div class="bento-card">
            <div class="bento-card-icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </div>
            <h3 class="bento-title">Tareas Claras y Escritas</h3>
            <p class="bento-text">
              Las empresas asociadas entregan manuales con capturas de pantalla,
              objetivos por escrito y seguimiento en herramientas digitales.
            </p>
          </div>

          <!-- Bento Card 4 -->
          <div class="bento-card">
            <div class="bento-card-icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h3 class="bento-title">Respaldo de la Ley 977</h3>
            <p class="bento-text">
              Puestos de trabajo formales con estabilidad laboral, inamovilidad
              y todos los beneficios de ley garantizados por la normativa
              boliviana.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. TRABAJOS DISPONIBLES (Modern Bento Job Directory) -->
  <section class="section jobs-section">
    <div class="container">
      <div class="section-top-bar">
        <div>
          <h2 class="section-heading">Ofertas de Trabajo Disponibles</h2>
          <p class="section-desc">
            Vacantes con procesos de selección evaluados por chat escrito y
            adaptaciones garantizadas en Bolivia.
          </p>
        </div>
        <a href="/empleos" class="section-action-link">
          <span>Ver todas las ofertas ({jobsData.length})</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="jobs-cards-grid">
        {featuredJobs.map((job) => <JobCard job={job} />)}
      </div>
    </div>
  </section>

  <!-- 5. BLACK BENTO SHOWCASE: PARA EMPRESAS Y LEY 977 (Trustly Dark Bento) -->
  <section class="section enterprise-dark-section" id="empresas-ley977">
    <div class="container">
      <div class="enterprise-dark-card">
        <div class="enterprise-content-grid">
          <!-- Left: Information and High-Contrast Metrics -->
          <div class="enterprise-info-col">
            <h2 class="enterprise-title">
              Cumple tu cuota de la Ley 977 con el mejor talento
            </h2>
            <p class="enterprise-lead">
              Las personas con hipoacusia destacan por su agudeza visual,
              concentración profunda y apego al cumplimiento de procesos. Cumple
              la cuota legal en Bolivia de forma ágil, con coordinación directa
              por chat.
            </p>

            <div class="metrics-bento-grid">
              <div class="metric-bento-card">
                <span class="metric-huge">2%</span>
                <span class="metric-card-title">Sector Privado</span>
                <p class="metric-card-desc">
                  Obligatorio en empresas con más de 50 trabajadores (Ley 977).
                </p>
              </div>

              <div class="metric-bento-card">
                <span class="metric-huge">4%</span>
                <span class="metric-card-title">Sector Público</span>
                <p class="metric-card-desc">
                  Obligatorio en ministerios, alcaldías y gobernaciones (Ley
                  223).
                </p>
              </div>

              <div class="metric-bento-card">
                <span class="metric-huge">100%</span>
                <span class="metric-card-title">Chat Escrito</span>
                <p class="metric-card-desc">
                  Soporte y coordinación continua sin barreras telefónicas.
                </p>
              </div>
            </div>
          </div>

          <!-- Right: Clean White Form Capsule -->
          <div class="enterprise-form-capsule">
            <h3 class="form-capsule-title">Publica tu vacante laboral</h3>
            <p class="form-capsule-desc">
              Ingresa los datos de tu empresa y el puesto. El equipo de Incluxia
              te escribirá por WhatsApp para coordinar los detalles.
            </p>

            <form class="company-form" id="companyVacancyForm">
              <div class="form-item">
                <label for="compName" class="form-label"
                  >Nombre de la Empresa o Negocio *</label
                >
                <input
                  type="text"
                  id="compName"
                  required
                  placeholder="Ej. Banco Mercantil, Farmacorp, etc."
                  class="form-input-field"
                />
              </div>

              <div class="form-item">
                <label for="contactPerson" class="form-label"
                  >Persona de Contacto *</label
                >
                <input
                  type="text"
                  id="contactPerson"
                  required
                  placeholder="Nombre y apellido"
                  class="form-input-field"
                />
              </div>

              <div class="form-item">
                <label for="contactInfo" class="form-label"
                  >WhatsApp o Correo Corporativo *</label
                >
                <input
                  type="text"
                  id="contactInfo"
                  required
                  placeholder="+591 70000000 o rrhh@empresa.com"
                  class="form-input-field"
                />
              </div>

              <div class="form-item">
                <label for="jobDetails" class="form-label"
                  >Puesto Vacante y Ciudad *</label
                >
                <textarea
                  id="jobDetails"
                  required
                  placeholder="Puesto (diseño, contabilidad, archivo), ciudad y funciones..."
                  class="form-textarea-field"></textarea>
              </div>

              <Button
                type="submit"
                variant="primary"
                fullWidth={true}
                id="btnSubmitCompany"
              >
                <span id="btnSubmitCompanyText">Enviar Vacante a Incluxia</span>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              </Button>
            </form>

            <div
              id="companySuccessBox"
              class="company-success-box"
              style="display: none;"
            >
              <span class="company-success-icon">✓</span>
              <div>
                <strong>¡Vacante enviada con éxito!</strong>
                <p>
                  El equipo de Incluxia revisará los detalles y te contactará
                  por WhatsApp para coordinar los postulantes idóneos.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. CASOS DE ÉXITO (Real Story Cards with Video & LSB Badge) -->
  <section class="section stories-section">
    <div class="container">
      <div class="section-top-bar">
        <div>
          <h2 class="section-heading">Talento Sin Barreras en Bolivia</h2>
          <p class="section-desc">
            Conoce a personas con hipoacusia que demuestran su capacidad y
            compromiso en tecnología, diseño y administración.
          </p>
        </div>
        <a href="/casos-de-exito" class="section-action-link">
          <span>Ver todas las historias</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="stories-cards-grid">
        {featuredStories.map((story) => <StoryCard story={story} />)}
      </div>
    </div>
  </section>

  <!-- 7. BLOG & RECURSOS (Editorial Cards) -->
  <section class="section blog-section">
    <div class="container">
      <div class="section-top-bar">
        <div>
          <h2 class="section-heading">Blog y Consejos Prácticos</h2>
          <p class="section-desc">
            Guías claras sobre la Ley 223 y 977, cómo tramitar tu carnet de
            discapacidad y adaptaciones razonables en la oficina.
          </p>
        </div>
        <a href="/blog" class="section-action-link">
          <span>Ver todos los artículos</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="blog-cards-grid">
        {featuredArticles.map((article) => <BlogCard article={article} />)}
      </div>
    </div>
  </section>

  <!-- 8. FINAL HIGH-IMPACT CTA (Trustly Bottom Style) -->
  <section class="section final-cta-section">
    <div class="container">
      <div class="final-cta-capsule">
        <h2 class="final-cta-title">
          Tu próximo paso laboral empieza con un mensaje de texto.
        </h2>
        <p class="final-cta-subtitle">
          Ya sea que busques empleo o quieras contratar talento comprometido, en
          Incluxia te conectamos sin llamadas ni complicaciones.
        </p>
        <div class="final-cta-buttons">
          <Button
            href="https://wa.me/59170000000?text=Hola%20Incluxia%2C%20deseo%20m%C3%A1s%20informaci%C3%B3n"
            target="_blank"
            rel="noopener noreferrer"
            variant="white-whatsapp"
            size="lg"
          >
            <span>Escribir por WhatsApp</span>
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ====================================================
     1. HERO: ASHICO COCHABAMBA COMMUNITY HERO
     ==================================================== */
  .ashico-hero {
    position: relative;
    width: 100%;
    min-height: 90dvh;
    display: flex;
    align-items: center;
    background-color: var(--color-primary-dark);
    background-image:
      linear-gradient(
        180deg,
        rgba(var(--color-primary-rgb), 0.72) 0%,
        rgba(var(--color-primary-dark-rgb), 0.85) 45%,
        var(--color-primary-dark) 80%,
        var(--color-primary-dark) 100%
      ),
      url("/images/hero-ashico-cochabamba.jpg");
    background-size: cover;
    background-position: center 30%;
    background-repeat: no-repeat;
    padding-top: calc(90px + var(--space-8));
    padding-bottom: var(--space-16);
    margin-bottom: -1px;
    overflow: hidden;
  }

  .hero-container {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .hero-content {
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    position: relative;
    z-index: 2;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: var(--text-hero);
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin-bottom: var(--space-5);
    text-wrap: balance;
  }

  .hero-city-title {
    color: var(--color-white);
    letter-spacing: -0.01em;
  }

  .hero-description {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
    max-width: 560px;
    margin-bottom: var(--space-8);
  }

  .hero-description strong {
    color: var(--color-white);
    font-weight: 700;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .hero-btn-accent {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background-color: var(--color-accent);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    padding-block: var(--space-3);
    padding-inline: var(--space-6);
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: none; /* ZERO SHADOWS */
    transition:
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .hero-btn-accent:hover {
    background-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .hero-btn-accent svg {
    transition: transform var(--transition-fast);
  }

  .hero-btn-accent:hover svg {
    transform: translateX(4px);
  }

  /* Trust Ribbon: Aliados */
  .trust-ribbon-section {
    background-color: var(--color-white);
    padding-block: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .trust-ribbon {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .trust-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .trust-logos-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    color: var(--color-text-main);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .trust-company-tag {
    padding: 0.2rem 0.5rem;
  }

  .trust-dot-sep {
    color: var(--color-text-light);
  }

  /* ====================================================
     2. BOLD MANIFESTO STATEMENT
     ==================================================== */
  .manifesto-section {
    padding: var(--space-16) 0;
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .manifesto-container {
    max-width: 900px;
    text-align: center;
    margin: 0 auto;
  }

  .manifesto-text {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.35;
    letter-spacing: -0.025em;
    margin: 0;
  }

  /* ====================================================
     3. SOFT BENTO SECTION: CÓMO FUNCIONA LA INCLUSIÓN
     ==================================================== */
  .bento-how-section {
    background-color: var(--color-primary-dark);
    position: relative;
    z-index: 1;
  }

  .bento-container-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-10);
  }

  .bento-box-header {
    max-width: 720px;
    margin-bottom: var(--space-10);
  }

  .bento-box-title {
    color: var(--color-text-inverse);
    font-size: var(--text-4xl);
    font-weight: 800;
    text-align: center;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin-top: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .bento-box-desc {
    color: var(--color-text-light);
    text-align: center;
    font-size: var(--text-base);
    line-height: 1.6;
    margin: 0;
  }

  .bento-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .bento-card {
    background: var(--color-primary-rgba);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    box-shadow: none; /* ZERO SHADOWS */
  }

  .bento-card:hover {
    box-shadow: none; /* ZERO SHADOWS */
    /* NO TRANSLATEY, NO BORDER CHANGE */
  }

  .bento-card-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .bento-title {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.015em;
    margin: 0;
    line-height: 1.3;
  }

  .bento-text {
    font-size: var(--text-sm);
    color: var(--color-white);
    line-height: 1.55;
    margin: 0;
  }

  /* ====================================================
     4. TRABAJOS DISPONIBLES (JOB BOARD BENTO)
     ==================================================== */
  .jobs-section {
    background-color: var(--color-bg);
  }

  .section-top-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .section-heading {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin-top: var(--space-2);
    margin-bottom: 0.25rem;
    line-height: 1.25;
  }

  .section-desc {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    margin: 0;
    max-width: 620px;
  }

  .section-action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
    padding-bottom: 0.25rem;
    border-bottom: 2px solid var(--color-accent);
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .section-action-link:hover {
    color: var(--color-primary-light);
    gap: 0.75rem;
  }

  /* Search Pill Form */
  .search-pill-form {
    background: var(--color-white);
    border: 1px solid rgba(var(--color-primary-rgb), 0.1);
    border-radius: var(--radius-full);
    padding: 0.65rem 0.85rem;
    display: grid;
    grid-template-columns: 1.5fr 1fr auto;
