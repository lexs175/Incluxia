---
import Layout from "../layouts/Layout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeBento from "../components/home/HomeBento.astro";
import HomeJobs from "../components/home/HomeJobs.astro";
import HomeEnterprise from "../components/home/HomeEnterprise.astro";
import HomeStories from "../components/home/HomeStories.astro";
import HomeBlog from "../components/home/HomeBlog.astro";
import HomeFinalCta from "../components/home/HomeFinalCta.astro";

import jobsData from "../data/jobs.json";
import storiesData from "../data/stories.json";
import articlesData from "../data/articles.json";

const featuredJobs = jobsData.slice(0, 3);
const featuredStories = storiesData.slice(0, 3);
const featuredArticles = articlesData.slice(0, 3);
---

<Layout
  title="Incluxia Bolivia | Inclusión Laboral para Personas con Hipoacusia"
  description="Plataforma de trabajo en Bolivia para personas con hipoacusia. Procesos de selección 100% por chat o WhatsApp, sin llamadas telefónicas. Cumplimiento de la Ley 977."
  activePath="/"
>
  <HomeHero />
  <HomeBento />
  <HomeJobs jobs={featuredJobs} totalJobs={jobsData.length} />
  <HomeEnterprise />
  <HomeStories stories={featuredStories} />
  <HomeBlog articles={featuredArticles} />
  <HomeFinalCta />
</Layout>
