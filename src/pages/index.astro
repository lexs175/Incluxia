---
import Layout from "../layouts/Layout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeBento from "../components/home/HomeBento.astro";
import HomeStories from "../components/home/HomeStories.astro";
import JobsDirectory from "../components/empleos/JobsDirectory.astro";
import HomeWalkthrough from "../components/home/HomeWalkthrough.astro";
import HomeCommunity from "../components/home/HomeCommunity.astro";

import jobsData from "../data/jobs.json";
import storiesData from "../data/stories.json";

const featuredStories = storiesData.slice(0, 3);
---

<Layout
  title="Incluxia Bolivia | Inclusión Laboral para Personas con Hipoacusia"
  description="Encuentra trabajo, ofrece tus servicios o contrata a personas con hipoacusia en Bolivia. Revisa perfiles y comunícate por chat."
  activePath="/"
>
  <div data-guest>
  <HomeHero />
  <HomeBento />
  <HomeWalkthrough />

  <HomeCommunity />

  <HomeStories stories={featuredStories} />

  </div>
  <section class="member-home" data-member><div class="container"><JobsDirectory jobs={jobsData} /></div></section>
</Layout>

<style>
.member-home { background: var(--color-bg); min-height: 85dvh; padding-top: calc(80px + var(--space-8)); padding-bottom: var(--space-16); }
</style>
