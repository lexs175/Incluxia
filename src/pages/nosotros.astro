---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
---

<Layout
  title="Sobre Nosotros | Incluxia Bolivia"
  description="Conoce Incluxia: la plataforma boliviana que conecta a personas con hipoacusia con trabajos formales mediante procesos 100% por chat y WhatsApp."
  activePath="/nosotros"
>
  <!-- 1. HERO SECTION: Clean Modern White Canvas (Trustly Fintech Style) -->
  <section class="trustly-about-hero">
    <div class="container hero-container">
      <div class="hero-split-header">
        <div class="header-left">
          <h1 class="hero-main-title">
            Inclusión laboral sin barreras telefónicas en <span
              class="highlight-cyan">Bolivia</span
            >
          </h1>
        </div>

        <div class="header-right">
          <p class="hero-lead-text">
            Somos la primera plataforma boliviana diseñada exclusivamente para
            conectar a profesionales con hipoacusia con empresas formales donde
            todo se coordina <strong
              >100% por chat, WhatsApp y tareas escritas</strong
            >.
          </p>
        </div>
      </div>

      <!-- Centerpiece Visual Bento Showcase (Zero Shadows, Radius 32px) -->
      <div class="about-centerpiece-box">
        <img
          src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1400&q=80"
          alt="Equipo colaborando en oficina moderna e inclusiva"
          class="centerpiece-img"
          loading="eager"
        />
        <div class="centerpiece-overlay"></div>
        <div class="centerpiece-caption">
          <span class="caption-tag">Nuestro Compromiso</span>
          <p class="caption-quote">
            "Eliminamos las llamadas telefónicas sorpresa que descartan
            injustamente el talento más disciplinado del país."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. BOLD TYPOGRAPHY MANIFESTO -->
  <section class="about-manifesto-section">
    <div class="container">
      <p class="manifesto-statement">
        Las personas con hipoacusia destacan por su agudeza visual,
        concentración profunda y disciplina técnica. No necesitan caridad:
        necesitan que las empresas dejen de depender del teléfono y empiecen a
        comunicarse por canales digitales eficientes.
      </p>
    </div>
  </section>

  <!-- 3. SPLIT BENTO CARDS: NUESTRA MISIÓN Y VISIÓN (Trustly Split Layout) -->
  <section class="section vision-mission-section">
    <div class="container vision-mission-container">
      <!-- Card 1: Nuestra Misión -->
      <div class="split-bento-card">
        <div class="split-text-col">
          <h2 class="split-title">Nuestra Misión</h2>
          <p class="split-desc">
            Abrir puertas laborales dignas y formales en toda Bolivia para
            personas con cualquier grado de pérdida auditiva, garantizando
            procesos de selección, entrevistas y tareas diarias 100% por
            escrito.
          </p>
          <div class="split-check-item">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Cero llamadas imprevistas de Recursos Humanos</span>
          </div>
        </div>
        <div class="split-photo-col">
          <img
            src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=700&q=80"
            alt="Profesional concentrada trabajando en su computadora"
            class="split-photo"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Card 2: Nuestra Visión -->
      <div class="split-bento-card">
        <div class="split-text-col">
          <h2 class="split-title">Nuestra Visión</h2>
          <p class="split-desc">
            Convertir a Bolivia en un referente regional donde la inclusión
            laboral bajo la Ley 977 y 223 no sea vista como una obligación
            burocrática, sino como una ventaja competitiva de alto rendimiento.
          </p>
          <div class="split-check-item">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Empresas adaptadas con cultura 100% escrita</span>
          </div>
        </div>
        <div class="split-photo-col">
          <img
            src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=700&q=80"
            alt="Joven profesional boliviano sonriendo en su lugar de trabajo"
            class="split-photo"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 4. DARK BENTO METRICS SHOWCASE (Trustly $100b / 33 / 900 Style) -->
  <section class="section metrics-showcase-section">
    <div class="container">
      <div class="metrics-bento-container">
        <div class="metrics-banner-top">
          <h2 class="metrics-banner-title">Métricas de impacto en Bolivia</h2>
          <p class="metrics-banner-desc">
            Resultados transparentes que respaldan nuestro compromiso con la
            inclusión laboral real.
          </p>
        </div>

        <div class="metrics-cards-grid">
          <div class="dark-metric-card">
            <span class="metric-huge-number">100%</span>
            <span class="metric-bold-label">Coordinación por Chat</span>
            <p class="metric-sub-text">
              Cero llamadas sorpresa. Todas las convocatorias se hacen por
              WhatsApp o mensajería.
            </p>
          </div>

          <div class="dark-metric-card">
            <span class="metric-huge-number">2% / 4%</span>
            <span class="metric-bold-label">Cuota Legal Garantizada</span>
            <p class="metric-sub-text">
              Cumplimiento formal de la Ley 977 en sector privado y Ley 223 en
              sector público.
            </p>
          </div>

          <div class="dark-metric-card">
            <span class="metric-huge-number">3</span>
            <span class="metric-bold-label">Ejes Principales</span>
            <p class="metric-sub-text">
              Puestos verificados en Santa Cruz, La Paz y Cochabamba con
              cobertura nacional.
            </p>
          </div>

          <div class="dark-metric-card">
            <span class="metric-huge-number">0 Bs</span>
            <span class="metric-bold-label">Costo para Candidatos</span>
            <p class="metric-sub-text">
              El registro, postulación y asesoría para personas con hipoacusia
              es 100% gratuito.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. TEAM & CULTURE GRID (Trustly Management Style: Clean Black & White Portraits) -->
  <section class="section team-culture-section">
    <div class="container">
      <div class="section-top-bar">
        <div>
          <h2 class="section-heading">Liderazgo con vocación inclusiva</h2>
          <p class="section-desc">
            Especialistas en accesibilidad, derecho laboral y tecnología
            trabajando por una Bolivia sin barreras.
          </p>
        </div>
      </div>

      <div class="team-cards-grid">
        <div class="team-card">
          <div class="team-photo-wrap">
            <img
              src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=500&q=80"
              alt="Coordinador de Selección"
              class="team-photo"
              loading="lazy"
            />
          </div>
          <div class="team-card-body">
            <h3 class="team-member-name">Carlos Mendoza Terán</h3>
            <span class="team-member-role"
              >Dirección de Inclusión y Selección</span
            >
            <p class="team-member-bio">
              Especialista en procesos de selección accesibles y adaptación de
              puestos de trabajo para personas sordas e hipoacúsicas.
            </p>
          </div>
        </div>

        <div class="team-card">
          <div class="team-photo-wrap">
            <img
              src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=500&q=80"
              alt="Asesora Legal Ley 977"
              class="team-photo"
              loading="lazy"
            />
          </div>
          <div class="team-card-body">
            <h3 class="team-member-name">Dra. Gabriela Siles Rocha</h3>
            <span class="team-member-role"
              >Asesoría Legal Laboral (Ley 977 / 223)</span
            >
            <p class="team-member-bio">
              Abogada especializada en derechos de personas con discapacidad,
              carnetización SIPRUNPCD e intermediación empresarial.
            </p>
          </div>
        </div>

        <div class="team-card">
          <div class="team-photo-wrap">
            <img
              src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=500&q=80"
              alt="Intérprete Oficial LSB"
              class="team-photo"
              loading="lazy"
            />
          </div>
          <div class="team-card-body">
            <h3 class="team-member-name">Rodrigo Peñaranda</h3>
            <span class="team-member-role"
              >Coordinación de Lengua de Señas (LSB)</span
            >
            <p class="team-member-bio">
              Intérprete acreditado de Lengua de Señas Boliviana para
              entrevistas técnicas y facilitación de reuniones corporativas.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. FINAL IMPACT CTA (Trustly Full-Width Bottom Capsule) -->
  <section class="section final-cta-section" id="contacto">
    <div class="container">
      <div class="final-cta-capsule">
        <h2 class="final-cta-title">
          Construyamos juntos un mercado laboral más justo y productivo.
        </h2>
        <p class="final-cta-subtitle">
          Ya sea que busques empleo formal o quieras contratar talento
          verificado bajo la Ley 977, escríbenos directamente por WhatsApp.
        </p>
        <div class="final-cta-buttons">
          <Button href="/empleos" variant="white" size="lg">
            <span>Ver Ofertas de Trabajo</span>
          </Button>
          <Button
            href="https://wa.me/59172255726?text=Hola%20Incluxia%2C%20quisiera%20contactarme%20con%20el%20equipo"
            target="_blank"
            rel="noopener noreferrer"
            variant="white-whatsapp"
            size="lg"
          >
            <span>Escribir por WhatsApp</span>
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ====================================================
     1. HERO SECTION: TRUSTLY CLEAN FINTECH STYLE
     Zero shadows. Zero glow. Flat minimalism.
     ==================================================== */
  .trustly-about-hero {
    background-color: var(--color-white);
    padding-top: calc(90px + var(--space-12));
    padding-bottom: var(--space-16);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .hero-split-header {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-10);
    align-items: end;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--color-whatsapp);
  }

  .hero-main-title {
    font-size: var(--text-hero);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 0;
  }

  .highlight-cyan {
    color: var(--color-accent);
  }

  .hero-lead-text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.65;
    margin: 0;
  }

  .hero-lead-text strong {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Centerpiece Visual Container */
  .about-centerpiece-box {
    position: relative;
    width: 100%;
    height: 480px;
    border-radius: var(--radius-3xl);
    overflow: hidden;
    border: 1px solid var(--color-border-dark);
    box-shadow: none; /* ZERO SHADOWS */
    background-color: var(--color-surface-dark);
  }

  .centerpiece-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.65);
  }

  .centerpiece-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(11, 15, 25, 0.1) 0%,
      rgba(11, 15, 25, 0.8) 100%
    );
  }

  .centerpiece-caption {
    position: absolute;
    bottom: var(--space-8);
    left: var(--space-8);
    right: var(--space-8);
    max-width: 780px;
    z-index: 5;
  }

  .caption-tag {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
    display: inline-block;
  }

  .caption-quote {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: -0.02em;
    line-height: 1.35;
    margin: 0;
  }

  /* ====================================================
     2. BOLD MANIFESTO STATEMENT
     ==================================================== */
  .about-manifesto-section {
    padding: var(--space-16) 0;
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .manifesto-statement {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.025em;
    text-align: center;
    max-width: 980px;
    margin: 0 auto;
    line-height: 1.35;
  }

  /* ====================================================
     3. SPLIT BENTO CARDS: MISIÓN Y VISIÓN
     ==================================================== */
  .vision-mission-section {
    background-color: var(--color-white);
  }

  .vision-mission-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .split-bento-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-3xl);
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    box-shadow: none; /* ZERO SHADOWS */
    min-height: 380px;
  }

  .split-text-col {
    padding: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
  }

  .split-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.025em;
    margin: 0;
  }

  .split-desc {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.65;
    margin: 0;
  }

  .split-check-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
    margin-top: var(--space-2);
  }

  .split-check-item svg {
    color: var(--color-whatsapp-dark);
  }

  .split-photo-col {
    position: relative;
    overflow: hidden;
  }

  .split-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ====================================================
     4. DARK BENTO METRICS SHOWCASE
     ==================================================== */
  .metrics-showcase-section {
    background-color: var(--color-white);
    padding-top: 0;
  }

  .metrics-bento-container {
    background-color: var(--color-surface-dark);
    border-radius: var(--radius-3xl);
    border: 1px solid var(--color-border-dark);
    padding: clamp(2.5rem, 5vw, 4rem);
    box-shadow: none; /* ZERO SHADOWS */
  }

  .metrics-banner-top {
    max-width: 680px;
    margin-bottom: var(--space-10);
  }

  .metrics-banner-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.025em;
    margin-bottom: var(--space-2);
  }

  .metrics-banner-desc {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  .metrics-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .dark-metric-card {
    background-color: var(--color-surface-dark-card);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    box-shadow: none; /* ZERO SHADOWS */
  }

  .metric-huge-number {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 800;
    color: var(--color-accent);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .metric-bold-label {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-white);
  }

  .metric-sub-text {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
    margin: 0;
  }

  /* ====================================================
     5. TEAM & CULTURE GRID
     ==================================================== */
  .team-culture-section {
    background-color: var(--color-bg);
  }

  .section-top-bar {
    margin-bottom: var(--space-10);
  }

  .section-heading {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin-top: var(--space-2);
    margin-bottom: 0.25rem;
    line-height: 1.25;
  }

  .section-desc {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    max-width: 620px;
    margin: 0;
  }

  .team-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .team-card {
    background-color: var(--color-white);
    border: 1px solid rgba(var(--color-primary-rgb), 0.1);
    border-radius: var(--radius-2xl);
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: none; /* ZERO SHADOWS */
  }

  .team-photo-wrap {
    width: 100%;
    height: 260px;

    border-radius: 0;
    overflow: hidden;
    margin-bottom: 0;
    background-color: var(--color-bg);
  }

  .team-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    filter: grayscale(100%);
  }

  .team-card-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .team-member-name {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.015em;
    margin: 0 0 0.25rem 0;
  }

  .team-member-role {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }

  .team-member-bio {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* ====================================================
     6. FINAL CTA SECTION
     ==================================================== */
  .final-cta-section {
    background-color: var(--color-white);
    padding-top: var(--space-12);
  }

  .final-cta-capsule {
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-primary-dark) 100%
    );
    border-radius: var(--radius-3xl);
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    color: var(--color-text-inverse);
    box-shadow: none; /* ZERO SHADOWS */
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin: 0 auto;
  }

  .final-cta-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-text-inverse);
    margin-bottom: var(--space-4);
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  .final-cta-subtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-base);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto var(--space-8) auto;
  }

  .final-cta-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  /* Responsive Rules */
  @media (max-width: 991px) {
    .hero-split-header {
      grid-template-columns: 1fr;
    }
    .about-centerpiece-box {
      height: 380px;
    }
    .split-bento-card {
      grid-template-columns: 1fr;
    }
    .split-photo {
      height: 280px;
    }
    .metrics-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .team-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .about-centerpiece-box {
      height: 300px;
    }
    .caption-quote {
      font-size: var(--text-lg);
    }
    .metrics-cards-grid {
      grid-template-columns: 1fr;
    }
    .team-cards-grid {
      grid-template-columns: 1fr;
    }
    .final-cta-buttons {
      flex-direction: column;
      width: 100%;
    }
    .final-cta-buttons .btn {
      width: 100%;
    }
  }
</style>
