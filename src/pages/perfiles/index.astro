---
import Layout from "../../layouts/Layout.astro";
import ProfilesHero from "../../components/perfiles/ProfilesHero.astro";
import ProfilesDirectory from "../../components/perfiles/ProfilesDirectory.astro";
import ProfilesCta from "../../components/perfiles/ProfilesCta.astro";
import profilesData from "../../data/profiles.json";
---

<Layout
  title="Perfiles Laborales Inclusivos | Incluxia Bolivia"
  description="Conoce perfiles de profesionales con hipoacusia en Bolivia listos para trabajar, con comunicación 100% por chat o WhatsApp. Cumplimiento Ley 977."
  activePath="/perfiles"
>
  <ProfilesHero totalProfiles={profilesData.length} />
  <ProfilesDirectory profiles={profilesData} />
  <ProfilesCta />
</Layout>
