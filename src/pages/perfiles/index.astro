---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import ProfileCard from "../../components/cards/ProfileCard.astro";
import profilesData from "../../data/profiles.json";
---

<Layout
  title="Perfiles Laborales Inclusivos | Incluxia Bolivia"
  description="Conoce perfiles de profesionales con hipoacusia en Bolivia listos para trabajar, con comunicación 100% por chat o WhatsApp. Cumplimiento Ley 977."
  activePath="/perfiles"
>
  <!-- 1. HERO SECTION: Clean Modern White Canvas (Trustly Fintech Style) -->
  <section class="trustly-profiles-hero">
    <div class="container hero-container">
      <div class="hero-header">
        <h1 class="hero-main-title">
          Perfiles profesionales con <span class="highlight-cyan"
            >hipoacusia</span
          >
        </h1>

        <p class="hero-lead-text">
          Conoce a profesionales preparados en tecnología, diseño,
          administración y finanzas. Cada perfil cuenta con adaptaciones
          verificadas y coordinación directa <strong
            >100% por chat o WhatsApp</strong
          >.
        </p>
      </div>

      <!-- Trustly Horizontal Stats Ribbon (Zero Shadows, Clean Flat Pills) -->
      <div class="stats-pills-row">
        <div class="stat-pill-item">
          <span class="stat-number">{profilesData.length}</span>
          <span class="stat-text">Perfiles Activos</span>
        </div>
        <div class="stat-sep" aria-hidden="true">·</div>
        <div class="stat-pill-item">
          <span class="stat-number">100%</span>
          <span class="stat-text">Canales Escritos</span>
        </div>
        <div class="stat-sep" aria-hidden="true">·</div>
        <div class="stat-pill-item">
          <span class="stat-number">0</span>
          <span class="stat-text">Llamadas Telefónicas</span>
        </div>
        <div class="stat-sep" aria-hidden="true">·</div>
        <div class="stat-pill-item">
          <span class="stat-number">3</span>
          <span class="stat-text">Ciudades Principales</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PROFILES DIRECTORY GRID SECTION (Soft Tinted Background, Zero Shadows) -->
  <section class="section profiles-grid-section">
    <div class="container">
      <div class="section-top-bar">
        <div>
          <h2 class="section-heading">Profesionales listos para tu empresa</h2>
          <p class="section-desc">
            Pasa el cursor sobre cada perfil para conocer sus habilidades clave
            y abrir su currículum completo.
          </p>
        </div>

        <Button href="/empleos" variant="outline" size="sm">
          <span>Ver Ofertas de Trabajo</span>
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </Button>
      </div>

      <div class="profiles-cards-grid">
        {profilesData.map((profile) => <ProfileCard profile={profile} />)}
      </div>
    </div>
  </section>

  <!-- 3. BOTTOM CTA CAPSULE FOR RECRUITERS (Zero Shadows, Clean Flat Design) -->
  <section class="section final-cta-section">
    <div class="container">
      <div class="final-cta-capsule">
        <h2 class="final-cta-title">
          ¿Buscas contratar talento comprometido y cumplir la Ley 977?
        </h2>
        <p class="final-cta-subtitle">
          El equipo de Incluxia te ayuda a coordinar entrevistas técnicas
          directas por WhatsApp y a implementar adaptaciones razonables en tu
          equipo sin costo.
        </p>
        <div class="final-cta-buttons">
          <Button href="/#empresas-ley977" variant="white" size="lg">
            <span>Publicar Puesto de Trabajo</span>
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ====================================================
     1. HERO SECTION: TRUSTLY CLEAN FINTECH STYLE
     Zero shadows. Zero glow. Flat minimalism.
     ==================================================== */
  .trustly-profiles-hero {
    background-color: var(--color-primary);
    padding-top: calc(90px + var(--space-12));
    padding-bottom: var(--space-16);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto var(--space-8) auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.45rem 1.15rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
    letter-spacing: -0.01em;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--color-whatsapp);
  }

  .hero-main-title {
    font-size: var(--text-hero);
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .highlight-cyan {
    color: var(--color-accent);
  }

  .hero-lead-text {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-lg);
    line-height: 1.65;
    max-width: 720px;
    margin: 0 auto;
  }

  .hero-lead-text strong {
    color: var(--color-white);
    font-weight: 600;
  }

  /* Stats Ribbon */
  .stats-pills-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-8);
  }

  .stat-pill-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.5rem 1.15rem;
    border-radius: var(--radius-full);
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-accent);
  }

  .stat-text {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
  }

  .stat-sep {
    color: rgba(255, 255, 255, 0.35);
  }

  /* ====================================================
     2. PROFILES GRID SECTION
     ==================================================== */
  .profiles-grid-section {
    background-color: var(--color-bg);
  }

  .section-top-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
    flex-wrap: wrap;
  }

  .section-heading {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin-top: var(--space-2);
    margin-bottom: 0.25rem;
    line-height: 1.25;
  }

  .section-desc {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    max-width: 620px;
    margin: 0;
  }

  .profiles-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  /* ====================================================
     3. FINAL CTA SECTION
     ==================================================== */
  .final-cta-section {
    background-color: var(--color-white);
    padding-top: var(--space-12);
  }

  .final-cta-capsule {
    background: var(--color-primary-dark);
    border-radius: var(--radius-md);
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    color: var(--color-text-inverse);
    margin: 0 auto;
  }

  .final-cta-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-text-inverse);
    margin-bottom: var(--space-4);
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  .final-cta-subtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-base);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto var(--space-8) auto;
  }

  .final-cta-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  /* Responsive Rules */
  @media (max-width: 991px) {
    .profiles-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .profiles-cards-grid {
      grid-template-columns: 1fr;
    }

    .stats-pills-row {
      gap: var(--space-2);
    }

    .stat-sep {
      display: none;
    }

    .final-cta-buttons {
      flex-direction: column;
      width: 100%;
    }

    .final-cta-buttons .btn {
      width: 100%;
    }
  }
</style>
