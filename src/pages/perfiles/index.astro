---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import ProfileCard from '../../components/cards/ProfileCard.astro';
import profilesData from '../../data/profiles.json';
---

<Layout
  title="Perfiles Laborales | Incluxia Bolivia"
  description="Conoce perfiles de personas con hipoacusia en Bolivia listos para trabajar, con comunicación 100% por chat o WhatsApp."
  activePath="/perfiles"
>
  <!-- Hero Section -->
  <section class="profiles-hero">
    <div class="container hero-split">
      <div class="hero-text-col">
        <Badge variant="cyan" class="profiles-badge">Talento con Hipoacusia · Bolivia</Badge>
        <h1 class="hero-title">Perfiles Laborales Inclusivos</h1>
        <p class="hero-desc">
          Conoce a profesionales con hipoacusia listos para integrarse en tu empresa. Cada perfil incluye experiencia laboral, habilidades y disponibilidad para contacto 100% por chat o WhatsApp.
        </p>
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-number">{profilesData.length}</span>
            <span class="stat-label">Perfiles activos</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-number">100%</span>
            <span class="stat-label">Contacto por escrito</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-number">3</span>
            <span class="stat-label">Ciudades de Bolivia</span>
          </div>
        </div>
      </div>

      <div class="hero-illustration-col" aria-hidden="true">
        <div class="hero-card-preview">
          <div class="preview-avatar-ring">
            {profilesData.slice(0, 3).map((p) => (
              <img src={p.photo} alt="" class="preview-avatar" loading="lazy" />
            ))}
          </div>
          <div class="preview-text-block">
            <span class="preview-label">Profesionales verificados</span>
            <p class="preview-desc">Con adaptaciones garantizadas y procesos 100% escritos</p>
          </div>
          <div class="preview-badge-row">
            <span class="preview-badge-pill">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              LSB disponible
            </span>
            <span class="preview-badge-pill">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Chat escrito
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Profiles Grid Section -->
  <section class="section profiles-grid-section">
    <div class="container">
      <div class="grid-header">
        <div class="grid-header-text">
          <h2 class="grid-title">Directorio de Profesionales</h2>
          <p class="grid-sub">Haz clic en cada tarjeta para ver el currículum completo y datos de contacto.</p>
        </div>
        <Button href="/empleos" variant="outline" size="sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
          Ver Trabajos Disponibles
        </Button>
      </div>

      <div class="profiles-grid">
        {profilesData.map((profile) => (
          <ProfileCard profile={profile} />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Bottom -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-icon-wrap" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <div class="cta-content">
          <h2 class="cta-title">¿Tu empresa busca personas con ganas de trabajar?</h2>
          <p class="cta-desc">
            En Incluxia te conectamos directo con profesionales preparados. Te ayudamos a organizar las tareas por chat y coordinar todo sin llamadas ni complicaciones.
          </p>
        </div>
        <div class="cta-actions">
          <Button href="/nosotros#contacto" variant="primary" size="lg">Contactar con Incluxia</Button>
          <Button href="/casos-de-exito" variant="outline" size="lg">Ver Casos de Éxito</Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ====================================================
     HERO
     ==================================================== */
  .profiles-hero {
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    min-height: 560px;
    padding: calc(var(--space-16) + 48px) 0 var(--space-16) 0;
    display: flex;
    align-items: center;
  }

  .profiles-hero .container {
    width: 100%;
  }

  .hero-split {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-12);
    align-items: center;
    width: 100%;
  }

  .profiles-badge {
    margin-bottom: var(--space-5);
  }

  .hero-title {
    color: var(--color-text-inverse);
    font-size: var(--text-5xl);
    line-height: 1.15;
    margin-bottom: var(--space-5);
  }

  .hero-desc {
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--text-lg);
    line-height: 1.65;
    margin-bottom: var(--space-8);
    max-width: 560px;
  }

  /* Stats row */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--color-accent);
    line-height: 1;
  }

  .stat-label {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.65);
    font-weight: 500;
    white-space: nowrap;
  }

  .stat-divider {
    width: 1px;
    height: 36px;
    background-color: rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
  }

  /* Hero illustration card */
  .hero-card-preview {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .preview-avatar-ring {
    display: flex;
    margin-left: 0;
  }

  .preview-avatar {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 3px solid var(--color-primary);
    margin-left: -14px;
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .preview-avatar:first-child {
    margin-left: 0;
  }

  .preview-avatar:hover {
    transform: translateY(-4px);
    z-index: 1;
  }

  .preview-label {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-inverse);
    display: block;
    margin-bottom: var(--space-1);
  }

  .preview-desc {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
    margin: 0;
  }

  .preview-badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .preview-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    background-color: rgba(var(--color-accent-rgb), 0.15);
    color: var(--color-accent);
    border: 1px solid rgba(var(--color-accent-rgb), 0.3);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-full);
  }

  /* ====================================================
     GRID SECTION
     ==================================================== */
  .profiles-grid-section {
    background-color: var(--color-bg);
  }

  .grid-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .grid-title {
    margin-bottom: var(--space-1);
  }

  .grid-sub {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    margin: 0;
  }

  .profiles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  /* ====================================================
     CTA BOTTOM
     ==================================================== */
  .cta-section {
    padding-top: 0;
  }

  .cta-card {
    background: var(--color-primary);
    border-radius: var(--radius-xl);
    padding: var(--space-12);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-8);
  }

  .cta-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-xl);
    background-color: rgba(var(--color-accent-rgb), 0.15);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cta-title {
    font-size: var(--text-2xl);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-2);
  }

  .cta-desc {
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--text-base);
    line-height: 1.6;
    max-width: 520px;
    margin: 0;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  /* ====================================================
     5-TIER RESPONSIVE
     ==================================================== */

  /* 1. Desktop (>= 1440px) */
  @media (min-width: 1440px) {
    .profiles-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }

  /* 2. Laptop (992px - 1439px) */
  @media (min-width: 992px) and (max-width: 1439px) {
    .hero-split {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-8);
    }
    .profiles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* 3. Tablet (768px - 991px) */
  @media (min-width: 768px) and (max-width: 991px) {
    .profiles-hero {
      min-height: 480px;
      padding: calc(90px + var(--space-8)) 0 var(--space-12) 0;
    }
    .hero-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .hero-illustration-col {
      display: none;
    }
    .profiles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .cta-card {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .cta-icon-wrap {
      margin: 0 auto;
    }
    .cta-desc {
      max-width: 100%;
    }
    .cta-actions {
      flex-direction: row;
      justify-content: center;
      width: 100%;
    }
  }

  /* 4. Mobile Landscape (480px - 767px) */
  @media (min-width: 480px) and (max-width: 767px) {
    .profiles-hero {
      min-height: 400px;
      padding: calc(90px + var(--space-8)) 0 var(--space-10) 0;
    }
    .hero-split {
      grid-template-columns: 1fr;
    }
    .hero-illustration-col {
      display: none;
    }
    .hero-stats {
      gap: var(--space-4);
    }
    .profiles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
    .cta-card {
      grid-template-columns: 1fr;
      padding: var(--space-8);
    }
    .cta-icon-wrap {
      display: none;
    }
    .cta-actions {
      width: 100%;
    }
  }

  /* 5. Mobile Portrait (240px - 479px) */
  @media (max-width: 479px) {
    .profiles-hero {
      min-height: 360px;
      padding: calc(90px + var(--space-6)) 0 var(--space-10) 0;
    }
    .hero-split {
      grid-template-columns: 1fr;
    }
    .hero-illustration-col {
      display: none;
    }
    .hero-desc {
      font-size: var(--text-sm);
    }
    .hero-stats {
      gap: var(--space-3);
    }
    .stat-divider {
      height: 28px;
    }
    .profiles-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .grid-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .cta-card {
      grid-template-columns: 1fr;
      padding: var(--space-6);
      gap: var(--space-5);
    }
    .cta-icon-wrap {
      display: none;
    }
    .cta-actions {
      width: 100%;
    }
    .cta-actions .btn {
      width: 100%;
    }
  }
</style>
