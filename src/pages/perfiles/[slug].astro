---
import Layout from "../../layouts/Layout.astro";
import ExpandableButton from "../../components/ui/ExpandableButton.astro";
import profilesData from "../../data/profiles.json";

export function getStaticPaths() {
  return profilesData.map((profile) => ({
    params: { slug: profile.slug },
    props: { profile },
  }));
}

const { profile } = Astro.props;

const whatsappUrl = `https://wa.me/${profile.contact.whatsapp}?text=${encodeURIComponent(
  `Hola ${profile.name}, vi tu perfil en Incluxia Bolivia y nos gustaría coordinar una entrevista 100% por chat.`
)}`;

const shareUrl = `https://wa.me/?text=${encodeURIComponent(
  `Te comparto el perfil profesional de ${profile.name} (${profile.role}) en Incluxia Bolivia: ${Astro.url}`
)}`;
---

<Layout
  title={`${profile.name} – ${profile.role} | Incluxia Bolivia`}
  description={profile.tagline}
  activePath="/perfiles"
>
  <div class="profile-page-wrapper">
    <div class="container profile-container">
      
      <div class="profile-stack">
        <!-- ====================================================
             1. TARJETA HERO DE CABECERA (Portada + Avatar + Contacto)
             ==================================================== -->
        <section class="profile-detail-card profile-hero-card" aria-label="Información principal del perfil">
          <!-- Portada / Cover Banner -->
          <div class="profile-cover-banner" aria-hidden="true">
            <div class="cover-pattern-watermark">INCLUXIA</div>
          </div>

          <!-- Avatar superpuesto -->
          <div class="profile-avatar-container">
            <img
              src={profile.photo}
              alt={`Foto de ${profile.name}`}
              class="profile-avatar-img"
              loading="eager"
            />
          </div>

          <!-- Información del Perfil -->
          <div class="profile-hero-body">
            <div class="profile-name-row">
              <h1 class="profile-name">{profile.name}</h1>
              <span class="verified-badge">
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Candidato Verificado</span>
              </span>
            </div>

            <p class="profile-headline-role">{profile.role}</p>

            <div class="profile-meta-info">
              <span class="meta-city">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                {profile.city}, Bolivia
              </span>
              <span class="meta-sep">•</span>
              <span class="meta-status">
                <span class="status-indicator"></span>
                {profile.availability} (Ley 977)
              </span>
            </div>

            <!-- Botones de Acción Inmediata (Estilo LinkedIn) -->
            <div class="profile-hero-actions">
              <ExpandableButton
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                text="Enviar mensaje WhatsApp"
                variant="primary"
                size="md"
              />
              <ExpandableButton
                href={`mailto:${profile.contact.email}`}
                text="Enviar correo"
                variant="primary-line"
                size="md"
              />
            </div>
          </div>
        </section>

        <!-- ====================================================
             2. TARJETA ACERCA DE
             ==================================================== -->
        <section class="profile-detail-card" aria-labelledby="about-heading">
          <div class="card-header-row">
            <h2 id="about-heading" class="card-section-title">Acerca de</h2>
          </div>
          <p class="profile-about-paragraph">{profile.about}</p>

          <!-- Highlight Box: Principales aptitudes (Estilo LinkedIn) -->
          <div class="aptitudes-highlight-box">
            <div class="aptitudes-icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
            <div class="aptitudes-content">
              <span class="aptitudes-label">Principales aptitudes</span>
              <p class="aptitudes-list-preview">
                {profile.skills.slice(0, 4).join(" · ")}
              </p>
            </div>
            <div class="aptitudes-arrow" aria-hidden="true">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </div>
        </section>

        <!-- ====================================================
             3. TARJETA EXPERIENCIA LABORAL
             ==================================================== -->
        <section class="profile-detail-card" aria-labelledby="experience-heading">
          <div class="card-header-row">
            <h2 id="experience-heading" class="card-section-title">Experiencia</h2>
          </div>

          <div class="experience-list">
            {
              profile.experience.map((exp, index) => (
                <div class={`experience-item ${index < profile.experience.length - 1 ? 'has-divider' : ''}`}>
                  <div class="experience-company-icon" aria-hidden="true">
                    <span>{exp.company.charAt(0)}</span>
                  </div>

                  <div class="experience-details">
                    <h3 class="experience-role">{exp.role}</h3>
                    <p class="experience-company">{exp.company}</p>
                    <span class="experience-period">{exp.period}</span>

                    <ul class="experience-highlights" role="list">
                      {exp.highlights.map((h) => (
                        <li class="highlight-item">
                          <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="highlight-bullet"
                            aria-hidden="true"
                          >
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                          <span>{h}</span>
                        </li>
                      ))}
                    </ul>

                    <div class="experience-aptitudes-badge">
                      <svg
                        width="13"
                        height="13"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                      </svg>
                      <span>{profile.skills.slice(0, 3).join(", ")} y más aptitudes aplicadas</span>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- ====================================================
             4. TARJETA EDUCACIÓN
             ==================================================== -->
        <section class="profile-detail-card" aria-labelledby="education-heading">
          <div class="card-header-row">
            <h2 id="education-heading" class="card-section-title">Educación</h2>
          </div>

          <div class="education-list">
            {
              profile.education.map((ed, index) => (
                <div class={`education-item ${index < profile.education.length - 1 ? 'has-divider' : ''}`}>
                  <div class="education-icon-box" aria-hidden="true">
                    <svg
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                      <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                    </svg>
                  </div>

                  <div class="education-details">
                    <h3 class="education-institution">{ed.institution}</h3>
                    <p class="education-degree">{ed.degree}</p>
                    <span class="education-year">{ed.year}</span>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- ====================================================
             5. TARJETA HABILIDADES Y APTITUDES
             ==================================================== -->
        <section class="profile-detail-card" aria-labelledby="skills-heading">
          <div class="card-header-row">
            <h2 id="skills-heading" class="card-section-title">Habilidades y Aptitudes</h2>
            <span class="card-counter-badge">{profile.skills.length} aptitudes</span>
          </div>

          <div class="skills-card-grid">
            {
              profile.skills.map((skill) => (
                <div class="skill-row-item">
                  <div class="skill-icon-diamond" aria-hidden="true">
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  </div>
                  <div class="skill-info">
                    <span class="skill-title-name">{skill}</span>
                    <span class="skill-tag-check">Aptitud comprobada</span>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- ====================================================
             6. TARJETA IDIOMAS Y COMUNICACIÓN INCLUSIVA
             ==================================================== -->
        <section class="profile-detail-card" aria-labelledby="languages-heading">
          <div class="card-header-row">
            <h2 id="languages-heading" class="card-section-title">Comunicación e Idiomas</h2>
          </div>
          <p class="languages-lead-text">
            Metodologías de coordinación 100% accesibles y efectivas, operadas por canales escritos y digitales (WhatsApp, Slack, correo).
          </p>

          <div class="languages-grid">
            {
              profile.languages.map((lang) => (
                <div class="language-pill-item">
                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lang-check-icon"
                    aria-hidden="true"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>{lang}</span>
                </div>
              ))
            }
          </div>
        </section>

        <!-- ====================================================
             7. TARJETA DE COMPARTIR Y GARANTÍA INCLUXIA
             ==================================================== -->
        <section class="profile-detail-card share-card" aria-label="Compartir perfil">
          <div class="share-card-content">
            <div class="share-card-info">
              <div class="share-card-badge">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="18" cy="5" r="3"></circle>
                  <circle cx="6" cy="12" r="3"></circle>
                  <circle cx="18" cy="19" r="3"></circle>
                  <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                  <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                </svg>
                <span>Recomendación Inmediata</span>
              </div>
              <h3 class="share-card-title">¿Deseas compartir este perfil con tu equipo?</h3>
              <p class="share-card-desc">
                Facilita la toma de decisiones compartiendo este enlace directamente por WhatsApp con RRHH o gerencia.
              </p>
            </div>
            <ExpandableButton
              href={shareUrl}
              target="_blank"
              rel="noopener noreferrer"
              text="Compartir en WhatsApp"
              variant="primary-line"
              size="md"
            />
          </div>
        </section>

      </div>
    </div>
  </div>
</Layout>

<style>
  /* ====================================================
     ESTRUCTURA DE PÁGINA (Lienzo Contraste Slate-100)
     ==================================================== */
  .profile-page-wrapper {
    background-color: var(--color-bg-alt);
    min-height: 100dvh;
    padding-top: calc(75px + var(--space-6));
    padding-bottom: var(--space-20);
  }

  /* Ancho 1440px (Consistencia con el sistema de tokens) */
  .profile-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* Pila de Tarjetas Modulares */
  .profile-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Tarjeta Base Elevada */
  .profile-detail-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    box-shadow: 0 1px 3px rgba(var(--color-primary-dark-rgb), 0.04), 0 6px 16px -4px rgba(var(--color-primary-dark-rgb), 0.03);
    box-sizing: border-box;
    transition: border-color var(--transition-fast);
  }

  /* Cabecera unificada de cada Tarjeta */
  .card-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .card-section-title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--color-text-main);
    margin: 0;
  }

  .card-counter-badge {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    background-color: rgba(var(--color-primary-rgb), 0.08);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  /* ====================================================
     1. TARJETA HERO DE CABECERA
     ==================================================== */
  .profile-hero-card {
    padding: 0;
    overflow: hidden;
  }

  .profile-cover-banner {
    width: 100%;
    height: clamp(180px, 26vw, 320px);
    background: linear-gradient(
      135deg,
      var(--color-primary-dark) 0%,
      var(--color-primary) 50%,
      var(--color-primary-light) 100%
    );
    position: relative;
    overflow: hidden;
  }

  .cover-pattern-watermark {
    position: absolute;
    right: clamp(1.5rem, 4vw, 3.5rem);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-heading);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 900;
    letter-spacing: 0.15em;
    color: rgba(var(--white-rgb), 0.12);
    user-select: none;
    pointer-events: none;
  }

  .profile-avatar-container {
    margin-top: calc(-1 * clamp(65px, 8vw, 85px));
    margin-left: var(--space-8);
    width: clamp(130px, 15vw, 160px);
    height: clamp(130px, 15vw, 160px);
    border-radius: var(--radius-full);
    border: 4px solid var(--color-bg-card);
    overflow: hidden;
    background-color: var(--color-bg-alt);
    position: relative;
    z-index: 2;
    box-shadow: 0 4px 12px rgba(var(--color-primary-dark-rgb), 0.08);
  }

  .profile-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .profile-hero-body {
    padding: var(--space-5) var(--space-8) var(--space-8);
  }

  .profile-name-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-1);
  }

  .profile-name {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.2;
  }

  .verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    background-color: rgba(var(--color-primary-rgb), 0.08);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1;
  }

  .profile-headline-role {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 var(--space-3) 0;
  }

  .profile-meta-info {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .meta-city {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-city svg {
    color: var(--color-primary);
  }

  .meta-sep {
    color: var(--color-border);
  }

  .meta-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text-main);
    font-weight: 600;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--color-success);
  }

  .profile-hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* ====================================================
     2. TARJETA ACERCA DE
     ==================================================== */
  .profile-about-paragraph {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-main);
    line-height: 1.7;
    margin: 0 0 var(--space-5) 0;
  }

  .aptitudes-highlight-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .aptitudes-highlight-box:hover {
    border-color: rgba(var(--color-primary-rgb), 0.35);
    background-color: rgba(var(--color-primary-rgb), 0.02);
  }

  .aptitudes-icon {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    background-color: rgba(var(--color-primary-rgb), 0.08);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .aptitudes-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .aptitudes-label {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .aptitudes-list-preview {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.4;
  }

  .aptitudes-arrow {
    color: var(--color-text-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .aptitudes-highlight-box:hover .aptitudes-arrow {
    color: var(--color-primary);
    transform: translateX(3px);
  }

  /* ====================================================
     3. TARJETA EXPERIENCIA LABORAL
     ==================================================== */
  .experience-list {
    display: flex;
    flex-direction: column;
  }

  .experience-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    padding-block: var(--space-3);
  }

  .experience-item:first-child {
    padding-top: 0;
  }

  .experience-item:last-child {
    padding-bottom: 0;
  }

  .experience-item.has-divider {
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .experience-company-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .experience-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .experience-role {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-main);
    margin: 0;
    line-height: 1.3;
  }

  .experience-company {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    font-weight: 500;
  }

  .experience-period {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    margin-bottom: var(--space-2);
  }

  .experience-highlights {
    list-style: none;
    padding: 0;
    margin: var(--space-1) 0 var(--space-3) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-main);
    line-height: 1.5;
  }

  .highlight-bullet {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .experience-aptitudes-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: 500;
    margin-top: var(--space-1);
  }

  .experience-aptitudes-badge svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  /* ====================================================
     4. TARJETA EDUCACIÓN
     ==================================================== */
  .education-list {
    display: flex;
    flex-direction: column;
  }

  .education-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    padding-block: var(--space-3);
  }

  .education-item:first-child {
    padding-top: 0;
  }

  .education-item:last-child {
    padding-bottom: 0;
  }

