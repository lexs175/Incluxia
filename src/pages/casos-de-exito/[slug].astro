---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/ui/Button.astro";
import StoryCard from "../../components/cards/StoryCard.astro";
import storiesData from "../../data/stories.json";

export function getStaticPaths() {
  return storiesData.map((story) => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const otherStories = storiesData.filter((s) => s.id !== story.id).slice(0, 3);
const shareWhatsAppUrl = `https://wa.me/?text=${encodeURIComponent(`Conoce la historia de éxito de ${story.name} (${story.role}) en Incluxia Bolivia: ${Astro.url}`)}`;
---

<Layout
  title={`${story.name} - ${story.role} | Caso de Éxito Incluxia Bolivia`}
  description={story.quote}
  activePath="/casos-de-exito"
>
  <div class="story-detail-page">
    <div class="container">
      <!-- Breadcrumb & Top Info -->
      <div class="story-top-nav">
        <a href="/casos-de-exito" class="back-link">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Todos los Casos de Éxito</span>
        </a>
      </div>

      <!-- Main Editorial Header (Trustly Large Typography) -->
      <header class="story-header">
        <div class="header-badge-row">
          <span class="custom-badge"
            >{story.category || "Inclusión Laboral"}</span
          >
          <span class="company-badge">{story.company}</span>
        </div>

        <h1 class="story-main-title">{story.name}: {story.role}</h1>

        <div class="story-byline">
          <span class="byline-item">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            {story.city}, Bolivia
          </span>
          <span class="byline-dot">·</span>
          <span class="byline-item">Entrevista con Intérprete LSB</span>
        </div>
      </header>

      <!-- Fotografía Principal del Caso de Éxito -->
      <div class="media-showcase-box">
        <img
          src={story.image}
          alt={`Fotografía de ${story.name}`}
          class="media-cover-img"
          loading="eager"
        />
      </div>

      <!-- 2-Column Content Layout: Editorial Story + Sticky Sidebar -->
      <div class="story-content-grid">
        <!-- Main Column: Story Narrative -->
        <main class="story-editorial-col">
          <!-- Big Highlighted Quote -->
          <blockquote class="editorial-highlight-quote">
            “{story.quote}”
          </blockquote>

          <section class="editorial-section">
            <h2 class="editorial-heading">El desafío antes de Incluxia</h2>
            <p class="editorial-paragraph">
              Durante meses, {story.name} enfrentó el filtro más injusto del mercado
              tradicional en Bolivia: llamadas telefónicas imprevistas de reclutadores
              donde el tono de voz o la imposibilidad de escuchar definían su futuro
              profesional, ignorando años de formación y capacidad técnica.
            </p>
          </section>

          <section class="editorial-section">
            <h2 class="editorial-heading">
              La adaptación razonable en {story.company}
            </h2>
            <p class="editorial-paragraph">
              A través de Incluxia, {story.company} coordinó todo el proceso 100%
              por mensaje de WhatsApp. En su puesto de trabajo diario como {
                story.role
              }, las tareas se definen con manuales escritos, tableros digitales
              y seguimiento por chat. Sin teléfono de por medio, el rendimiento
              y la precisión de {story.name} superaron todas las expectativas.
            </p>
          </section>

          <section class="editorial-section">
            <h2 class="editorial-heading">
              Impacto y cumplimiento de la Ley 977
            </h2>
            <p class="editorial-paragraph">
              La contratación no solo cumplió la cuota legal obligatoria en
              Bolivia (2% o 4%), sino que enriqueció la cultura del equipo,
              demostrando que la accesibilidad laboral genera rentabilidad y
              lealtad profesional.
            </p>
          </section>

          <!-- Share Story Pill -->
          <div class="story-share-capsule">
            <span class="share-label">Compartir esta historia:</span>
            <Button
              href={shareWhatsAppUrl}
              target="_blank"
              rel="noopener noreferrer"
              variant="whatsapp"
              size="sm"
            >
              <span>Compartir en WhatsApp</span>
            </Button>
          </div>
        </main>

        <!-- Right Sidebar: Quick Facts & Contact (Flat Bento Card, Zero Shadows) -->
        <aside class="story-sidebar-col">
          <div class="facts-bento-card">
            <h3 class="facts-card-title">Ficha del Puesto</h3>

            <div class="fact-item">
              <span class="fact-label">Profesional:</span>
              <span class="fact-value">{story.name}</span>
            </div>

            <div class="fact-item">
              <span class="fact-label">Puesto Laboral:</span>
              <span class="fact-value">{story.role}</span>
            </div>

            <div class="fact-item">
              <span class="fact-label">Empresa:</span>
              <span class="fact-value">{story.company}</span>
            </div>

            <div class="fact-item">
              <span class="fact-label">Ubicación:</span>
              <span class="fact-value">{story.city}, Bolivia</span>
            </div>

            <div class="facts-cta-row">
              <Button
                href="/empleos"
                variant="primary"
                size="md"
                fullWidth={true}
              >
                <span>Ver Empleos Disponibles</span>
              </Button>
            </div>
          </div>
        </aside>
      </div>

      <!-- Other Stories (Related Testimonials) -->
      {
        otherStories.length > 0 && (
          <section class="related-stories-section">
            <div class="section-top-bar">
              <div>
                <span class="badge badge-navy">Historias Relacionadas</span>
                <h2 class="section-heading">Más casos de éxito en Bolivia</h2>
              </div>
            </div>
            <div class="stories-cards-grid">
              {otherStories.map((s) => (
                <StoryCard story={s} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</Layout>

<style>
  .story-detail-page {
    background-color: var(--color-white);
    padding-top: calc(90px + var(--space-8));
    padding-bottom: var(--space-16);
  }

  .story-top-nav {
    margin-bottom: var(--space-6);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  /* Header Section */
  .story-header {
    margin-bottom: var(--space-8);
  }

  .header-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-4);
  }

  .custom-badge {
    background: rgba(var(--color-primary-rgb), 0.06);
    border: 1px solid rgba(var(--color-primary-rgb), 0.12);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .company-badge {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .story-main-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }

  .story-byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-family: var(--font-heading);
    font-weight: 600;
    flex-wrap: wrap;
  }

  .byline-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .byline-dot {
    color: var(--color-text-light);
  }

  /* Media Showcase Box (Fotografía Principal) */
  .media-showcase-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-12);
    background-color: var(--color-surface-dark);
  }

  .media-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 2-Column Content Layout */
  .story-content-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: var(--space-12);
    align-items: start;
    margin-bottom: var(--space-16);
  }

  .editorial-highlight-quote {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.4;
    letter-spacing: -0.02em;
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-6);
    margin: 0 0 var(--space-8) 0;
  }

  .editorial-section {
    margin-bottom: var(--space-8);
  }

  .editorial-heading {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.015em;
    margin-bottom: var(--space-3);
  }

  .editorial-paragraph {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.7;
    margin: 0;
  }

  .story-share-capsule {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-5) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-10);
    box-shadow: none; /* ZERO SHADOWS */
  }

  .share-label {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
  }

  /* Sidebar Facts Card */
  .facts-bento-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    box-shadow: none; /* ZERO SHADOWS */
    position: sticky;
    top: calc(90px + var(--space-4));
  }

  .facts-card-title {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.015em;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    margin: 0;
  }

  .fact-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .fact-label {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .fact-value {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .highlight-green {
    color: var(--color-whatsapp-dark);
  }

  .facts-cta-row {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  /* Related Stories */
  .related-stories-section {
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-border);
  }

  .section-top-bar {
    margin-bottom: var(--space-8);
  }

  .section-heading {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin-top: var(--space-2);
  }

  .stories-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  /* Responsive */
  @media (max-width: 991px) {
    .story-content-grid {
      grid-template-columns: 1fr;
    }
    .stories-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .stories-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
