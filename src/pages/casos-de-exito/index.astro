---
import Layout from "../../layouts/Layout.astro";
import StoriesHero from "../../components/casos-de-exito/StoriesHero.astro";
import StoriesFeaturedShowcase from "../../components/casos-de-exito/StoriesFeaturedShowcase.astro";
import StoriesGrid from "../../components/casos-de-exito/StoriesGrid.astro";
import storiesData from "../../data/stories.json";

const featuredStory = storiesData[0];
---

<Layout
  title="Casos de Éxito en Bolivia | Eco"
  description="Historias reales de profesionales con hipoacusia que destacan en empresas formales de Bolivia con comunicación 100% por chat."
  activePath="/casos-de-exito"
>
  <StoriesHero />
  {featuredStory && <StoriesFeaturedShowcase story={featuredStory} />}
  <StoriesGrid stories={storiesData} />
</Layout>
