---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/ui/Badge.astro";
import StoryCard from "../../components/cards/StoryCard.astro";
import Button from "../../components/ui/Button.astro";
import ExpandableButton from "../../components/ui/ExpandableButton.astro";
import storiesData from "../../data/stories.json";

const featuredStory = storiesData[0];
---

<Layout
  title="Casos de Éxito en Bolivia | Incluxia"
  description="Historias reales de profesionales con hipoacusia que destacan en empresas formales de Bolivia con comunicación 100% por chat."
  activePath="/casos-de-exito"
>
  <!-- 1. HERO SECTION: Clean Modern White Canvas (Trustly Fintech Style) -->
  <section class="trustly-stories-hero">
    <div class="container hero-container">
      <div class="hero-header">
        <h1 class="hero-main-title">
          Casos de éxito que inspiran a <span class="highlight-cyan"
            >Bolivia</span
          >
        </h1>

        <p class="hero-lead-text">
          Profesionales con hipoacusia demostrando su capacidad y concentración
          en tecnología, diseño, administración y finanzas cuando las empresas
          eligen canales 100% escritos.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. FEATURED SHOWCASE SECTION (Borde a borde de la pantalla) -->
  {
    featuredStory && (
      <section class="section featured-showcase-section">
        <div class="container">
          <div class="featured-showcase-grid">
            <div class="featured-content-col">
              <div class="featured-badge-row">
                <span class="featured-company-pill">
                  {featuredStory.company}
                </span>
              </div>

              <h2 class="featured-name-title">
                {featuredStory.name}: {featuredStory.role}
              </h2>

              <blockquote class="featured-quote">
                “{featuredStory.quote}”
              </blockquote>

              <div class="featured-meta-row">
                <span class="meta-tag">
                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                  {featuredStory.city}, Bolivia
                </span>
                <span class="meta-dot">·</span>
                <span class="meta-tag">Entrevista con Intérprete LSB</span>
              </div>

              <div class="featured-action-wrap">
                <ExpandableButton
                  href={`/casos-de-exito/${featuredStory.slug}`}
                  text="Ver historia completa"
                  variant="white"
                  size="md"
                />
              </div>
            </div>

            <div class="featured-photo-col">
              <img
                src={featuredStory.image}
                alt={`Entrevista con ${featuredStory.name}`}
                class="featured-photo"
                loading="eager"
              />
              <div class="photo-caption-bar">
                <span class="caption-title">{featuredStory.name}</span>
                <span class="caption-sub">
                  {featuredStory.role} en {featuredStory.company}
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- 2. GALLERY GRID SECTION (Soft Tinted Bento Grid) -->
  <section class="section stories-grid-section">
    <div class="container">
      <div class="section-top-bar">
        <div>
          <span class="badge badge-navy">Directorio de Testimonios</span>
          <h2 class="section-heading">
            Más trayectorias que derriban barreras
          </h2>
          <p class="section-desc">
            Cada testimonio demuestra que la agudeza visual, la disciplina y el
            trabajo sin interrupciones acústicas impulsan el éxito corporativo.
          </p>
        </div>
      </div>

      <div class="stories-cards-grid">
        {storiesData.map((story) => <StoryCard story={story} />)}
      </div>
    </div>
  </section>

  <!-- 3. BOTTOM CTA CAPSULE (Trustly Clean Fintech Style) -->
  <section class="section final-cta-section">
    <div class="container">
      <div class="final-cta-capsule">
        <h2 class="final-cta-title">
          ¿Quieres encontrar un trabajo digno o contratar talento como ellos?
        </h2>
        <p class="final-cta-subtitle">
          En Incluxia conectamos a profesionales con hipoacusia con empresas que
          coordinan por WhatsApp y ofrecen estabilidad laboral conforme a la Ley
          977.
        </p>
        <div class="final-cta-buttons">
          <Button
            href="https://wa.me/59172255726?text=Hola%2C%20quisiera%20m%C3%A1s%20informaci%C3%B3n%20sobre%20Incluxia"
            target="_blank"
            rel="noopener noreferrer"
            variant="white-whatsapp"
            size="lg"
          >
            <span>Contactar por WhatsApp</span>
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ====================================================
     1. HERO SECTION: TRUSTLY CLEAN FINTECH STYLE
     Zero shadows. Zero glow. Flat minimalism.
     ==================================================== */
  .trustly-stories-hero {
    background-color: var(--color-white);
    padding-top: calc(90px + var(--space-8));
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-main-title {
    font-size: var(--text-hero);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .highlight-cyan {
    color: var(--color-accent);
  }

  .hero-lead-text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.65;
    max-width: 680px;
    margin: 0 auto;
  }

  /* ====================================================
     2. FEATURED SHOWCASE SECTION (Borde a borde de pantalla)
     ==================================================== */
  .featured-showcase-section {
    background-color: var(--color-primary-dark);
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    position: relative;
    width: 100%;
    color: var(--color-white);
  }

  .featured-showcase-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    min-height: 440px;
  }

  .featured-content-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-6);
    color: var(--color-white);
  }

  .featured-badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .featured-company-pill {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .featured-name-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin: 0;
  }

  .featured-quote {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    font-style: italic;
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-5);
    margin: 0;
  }

  .featured-meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: rgba(255, 255, 255, 0.65);
    font-size: var(--text-xs);
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .meta-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-dot {
    color: rgba(255, 255, 255, 0.3);
  }

  .featured-action-wrap {
    padding-top: var(--space-2);
  }

  /* Photo Column */
  .featured-photo-col {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 100%;
    min-height: 380px;
    max-height: 480px;
    display: flex;
  }

  .featured-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-md);
  }

  .photo-caption-bar {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
    right: var(--space-4);
    background: rgba(11, 15, 25, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
  }

  .caption-title {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-white);
  }

  .caption-sub {
    font-size: 0.72rem;
    color: var(--color-accent);
  }

  /* ====================================================
     2. STORIES GRID SECTION
     ==================================================== */
  .stories-grid-section {
    background-color: var(--color-bg);
  }

  .section-top-bar {
    margin-bottom: var(--space-10);
  }

  .section-heading {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin-top: var(--space-2);
    margin-bottom: 0.25rem;
    line-height: 1.25;
  }

  .section-desc {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    max-width: 620px;
    margin: 0;
  }

  .stories-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  /* ====================================================
     3. FINAL CTA SECTION
     ==================================================== */
  .final-cta-section {
    background-color: var(--color-white);
    padding-top: var(--space-12);
  }

  .final-cta-capsule {
    background: var(--color-primary-dark);
    border-radius: var(--radius-md);
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    color: var(--color-text-inverse);
    margin: 0 auto;
  }

  .final-cta-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-text-inverse);
    margin-bottom: var(--space-4);
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  .final-cta-subtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-base);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto var(--space-8) auto;
  }

  .final-cta-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  /* Responsive Rules */
  @media (max-width: 991px) {
    .featured-showcase-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .featured-photo-col {
      min-height: 320px;
      height: 360px;
    }

    .stories-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .stories-cards-grid {
      grid-template-columns: 1fr;
    }

    .final-cta-buttons {
      flex-direction: column;
      width: 100%;
    }

    .final-cta-buttons .btn {
      width: 100%;
    }
  }
</style>
