---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import BlogCard from "../../components/cards/BlogCard.astro";
import articlesData from "../../data/articles.json";
---

<Layout
  title="Blog y Guías Útiles | Incluxia Bolivia"
  description="Artículos claros sobre leyes laborales en Bolivia, carnet de discapacidad, salud auditiva y consejos para trabajar por chat."
  activePath="/blog"
>
  <!-- Hero Section Trustly Style -->
  <section class="blog-hero">
    <div class="container blog-hero-container">
      <div class="blog-hero-content">
        <h1 class="blog-hero-title">Blog y Consejos Prácticos</h1>
        <p class="blog-hero-desc">
          Información clara y sin rodeos sobre leyes laborales en Bolivia, cómo
          tramitar tu carnet de discapacidad en el SIPRUNPCD, salud auditiva y
          trabajo inclusivo.
        </p>
      </div>
    </div>
  </section>

  <!-- Categories and Grid Section -->
  <section class="blog-content-section">
    <div class="container">
      <!-- Filter Pills -->
      <div class="category-pills">
        <button class="cat-pill active" data-cat="all"
          >Todos los Artículos</button
        >
        <button class="cat-pill" data-cat="leyes"
          >Leyes y Derechos Bolivia</button
        >
        <button class="cat-pill" data-cat="salud">Salud Auditiva</button>
        <button class="cat-pill" data-cat="consejos"
          >Consejos para Empresas</button
        >
      </div>

      <!-- Articles Grid -->
      <div class="blog-articles-grid" id="articlesGrid">
        {
          articlesData.map((article) => (
            <div
              class="article-item"
              data-category={article.category.toLowerCase()}
            >
              <BlogCard article={article} />
            </div>
          ))
        }
      </div>

      <!-- Trustly Bottom CTA Card -->
      <div class="blog-bottom-cta">
        <div class="cta-inner-text">
          <span class="cta-label">¿TIENES DUDAS LEGALES O MÉDICAS?</span>
          <h2 class="cta-heading">Te asesoramos paso a paso por WhatsApp</h2>
          <p class="cta-sub">
            Conoce cómo registrar tu discapacidad auditiva o cómo adaptar tu
            empresa a la Ley 223 sin complicaciones burocráticas.
          </p>
        </div>
        <div class="cta-actions">
          <Button
            href="https://wa.me/59172255726?text=Hola%2C%20tengo%20preguntas%20sobre%20las%20gu%C3%ADas%20y%20leyes%20de%20Incluxia"
            target="_blank"
            rel="noopener noreferrer"
            variant="whatsapp"
            size="md"
          >
            Consultar por WhatsApp
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  function initBlogFilters() {
    const pills = document.querySelectorAll(".cat-pill");
    const items = document.querySelectorAll(".article-item");

    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        pills.forEach((p) => p.classList.remove("active"));
        pill.classList.add("active");

        const cat = pill.getAttribute("data-cat") || "all";

        items.forEach((item: any) => {
          const itemCat = item.getAttribute("data-category") || "";
          if (cat === "all" || itemCat.includes(cat)) {
            item.style.display = "block";
          } else {
            item.style.display = "none";
          }
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initBlogFilters);
</script>

<style>
  /* ========================================================
     BLOG HERO (Trustly Style)
     ======================================================== */
  .blog-hero {
    background-color: var(--color-primary);
    padding-top: calc(90px + var(--space-12));
    padding-bottom: var(--space-12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .blog-hero-container {
    width: 100%;
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding-inline: var(--container-padding);
  }

  .blog-hero-content {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .blog-hero-title {
    font-size: var(--text-5xl);
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.035em;
    line-height: 1.15;
    margin: 0 0 var(--space-4) 0;
  }

  .blog-hero-desc {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  /* ========================================================
     BLOG CONTENT & PILLS
     ======================================================== */
  .blog-content-section {
    padding-top: var(--space-10);
    padding-bottom: var(--space-16);
    background-color: var(--color-bg);
  }

  .category-pills {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-bottom: var(--space-10);
  }

  .cat-pill {
    padding: 0.55rem 1.25rem;
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    background-color: var(--color-white);
    color: var(--color-primary);
    border: 1px solid rgba(var(--color-primary-rgb), 0.12);
    box-shadow: none; /* ZERO SHADOWS */
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .cat-pill:hover {
    background-color: rgba(var(--color-primary-rgb), 0.05);
    border-color: var(--color-primary);
  }

  .cat-pill.active {
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    border-color: var(--color-primary);
    box-shadow: none; /* ZERO SHADOWS */
  }

  .blog-articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  /* ========================================================
     BOTTOM CTA BANNER (Flat Trustly Style)
     ======================================================== */
  .blog-bottom-cta {
    margin-top: var(--space-16);
    background-color: var(--color-white);
    border: 1px solid rgba(var(--color-primary-rgb), 0.1);
    border-radius: var(--radius-md);
    padding: var(--space-10) var(--space-12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    box-shadow: none; /* ZERO SHADOWS */
  }

  .cta-inner-text {
    max-width: 680px;
  }

  .cta-label {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--color-accent);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  .cta-heading {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0 0 var(--space-2) 0;
  }

  .cta-sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .cta-actions {
    flex-shrink: 0;
  }

  /* ========================================================
     RESPONSIVE ADAPTATIONS
     ======================================================== */
  @media (max-width: 1024px) {
    .blog-articles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }

    .blog-bottom-cta {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-8);
    }
  }

  @media (max-width: 767px) {
    .blog-hero {
      padding-top: calc(90px + var(--space-6));
      padding-bottom: var(--space-8);
    }

    .blog-articles-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .category-pills {
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 0.5rem;
      scrollbar-width: none;
    }

    .category-pills::-webkit-scrollbar {
      display: none;
    }

    .cat-pill {
      white-space: nowrap;
      flex-shrink: 0;
    }
  }

  @media (max-width: 479px) {
    .blog-hero {
      padding-top: calc(90px + var(--space-4));
      padding-bottom: var(--space-6);
    }

    .blog-bottom-cta {
      padding: var(--space-6) var(--space-4);
    }

    .cta-actions {
      width: 100%;
    }
  }
</style>
