---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import articlesData from '../../data/articles.json';

export function getStaticPaths() {
  return articlesData.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const otherArticles = articlesData.filter((a) => a.id !== article.id).slice(0, 3);
const shareWhatsAppUrl = `https://wa.me/?text=${encodeURIComponent(`${article.title} - ${Astro.url}`)}`;
---

<Layout
  title={`${article.title} | Blog Incluxia Bolivia`}
  description={article.summary}
  activePath="/blog"
>
  <div class="article-page-layout">
    <div class="container article-container">
      <!-- Breadcrumb navigation -->
      <nav class="article-breadcrumb" aria-label="Ruta de navegación">
        <a href="/blog" class="breadcrumb-back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Volver a todos los artículos
        </a>
      </nav>

      <!-- 2-Column Grid: Main Article Content + Right Sidebar -->
      <div class="article-grid">
        
        <!-- Left: Main Article Column -->
        <main class="article-main-column">
          <!-- Article Header directly on page -->
          <header class="article-intro-header">
            <div class="badge-wrapper">
              <Badge variant="cyan">{article.category}</Badge>
            </div>
            
            <h1 class="article-headline">{article.title}</h1>

            <div class="article-byline">
              <span class="byline-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {article.date}
              </span>
              <span class="byline-divider">•</span>
              <span class="byline-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
                {article.author}
              </span>
              <span class="byline-divider">•</span>
              <span class="byline-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                4 min de lectura
              </span>
            </div>
          </header>

          <!-- Featured Header Image (Flat, Zero Shadows, Zero Scale) -->
          <div class="featured-image-box">
            <img src={article.image} alt={article.title} class="featured-img" />
          </div>

          <!-- Article Prose Paragraphs -->
          <div class="article-content-body">
            {article.content.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <!-- Social Share Bottom Section -->
          <div class="article-share-section">
            <span class="share-headline">¿Te resultó útil esta información?</span>
            <Button
              href={shareWhatsAppUrl}
              target="_blank"
              rel="noopener noreferrer"
              variant="whatsapp"
              size="md"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.014 8.00613C6.12827 7.1024 7.30277 5.87414 8.23488 6.01043L8.23339 6.00894C9.14051 6.18132 9.85859 7.74261 10.2635 8.44465C10.5504 8.95402 10.3641 9.4701 10.0965 9.68787C9.7355 9.97883 9.17099 10.3803 9.28943 10.7834C9.5 11.5 12 14 13.2296 14.7107C13.695 14.9797 14.0325 14.2702 14.3207 13.9067C14.5301 13.6271 15.0466 13.46 15.5548 13.736C16.3138 14.178 17.0288 14.6917 17.69 15.27C18.0202 15.546 18.0977 15.9539 17.8689 16.385C17.4659 17.1443 16.3003 18.1456 15.4542 17.9421C13.9764 17.5868 8 15.27 6.08033 8.55801C5.97237 8.24048 5.99955 8.12044 6.014 8.00613Z" fill="currentColor"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 23C10.7764 23 10.0994 22.8687 9 22.5L6.89443 23.5528C5.56462 24.2177 4 23.2507 4 21.7639V19.5C1.84655 17.492 1 15.1767 1 12C1 5.92487 5.92487 1 12 1C18.0751 1 23 5.92487 23 12C23 18.0751 18.0751 23 12 23ZM6 18.6303L5.36395 18.0372C3.69087 16.4772 3 14.7331 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12C21 16.9706 16.9706 21 12 21C11.0143 21 10.552 20.911 9.63595 20.6038L8.84847 20.3397L6 21.7639V18.6303Z" fill="currentColor"/>
              </svg>
              <span>Compartir en WhatsApp</span>
            </Button>
          </div>
        </main>

        <!-- Right: Modern Flat Sidebar -->
        <aside class="article-sidebar">
          <!-- Card 1: SIPRUNPCD Card (Zero Shadows) -->
          <div class="sidebar-siprunpcd-card">
            <span class="siprunpcd-badge">TRÁMITE OFICIAL</span>
            <h3 class="siprunpcd-title">Carnet de Discapacidad en Bolivia</h3>
            <p class="siprunpcd-desc">
              Conoce los pasos sencillos ante el SIPRUNPCD para tramitar tu carnet oficial y acceder a los beneficios de la Ley 223.
            </p>
            <a href="/nosotros#tramites" class="siprunpcd-btn">
              Ver Guía de Trámite ➔
            </a>
          </div>

          <!-- Card 2: Recomendados (Zero Shadows, Zero Scale) -->
          <div class="sidebar-recomended-section">
            <h3 class="recommended-header">Artículos Recomendados</h3>
            <div class="recommended-list">
              {otherArticles.map((rec) => (
                <a href={`/blog/${rec.slug}`} class="recommended-card-item">
                  <img src={rec.image} alt={rec.title} class="rec-thumbnail-img" />
                  <div class="rec-text-wrap">
                    <span class="rec-item-cat">{rec.category}</span>
                    <h4 class="rec-item-title">{rec.title}</h4>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <!-- Card 3: Newsletter Box (Zero Shadows) -->
          <div class="sidebar-newsletter-box">
            <div class="newsletter-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <h4 class="newsletter-title">Boletín Informativo</h4>
            <p class="newsletter-desc">
              Recibe avisos sobre nuevas convocatorias de empleo e informes sobre leyes de inclusión en Bolivia.
            </p>
            <form class="newsletter-form-inner" onsubmit="event.preventDefault(); const b=this.querySelector('button'); if(b){ b.textContent='✓ ¡Suscrito con Éxito!'; b.disabled=true; b.style.opacity='0.85'; }">
              <input
                type="email"
                required
                placeholder="Tu correo electrónico"
                class="newsletter-input"
              />
              <button type="submit" class="newsletter-submit-btn">
                Suscribirme
              </button>
            </form>
          </div>
        </aside>

      </div>
    </div>
  </div>
</Layout>

<style>
  .article-page-layout {
    background-color: var(--color-white);
    padding-top: calc(90px + var(--space-8));
    padding-bottom: var(--space-16);
    min-height: 100vh;
  }

  .article-container {
    width: 100%;
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding-inline: var(--container-padding);
  }

  /* Breadcrumb */
  .article-breadcrumb {
    margin-bottom: var(--space-6);
  }

  .breadcrumb-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb-back-link:hover {
    color: var(--color-primary);
  }

  /* 2-Column Main Layout */
  .article-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 3.5rem;
    align-items: start;
  }

  /* Left Main Column */
  .article-main-column {
    display: flex;
    flex-direction: column;
  }

  /* Article Intro Header */
  .article-intro-header {
    margin-bottom: 2rem;
  }

  .badge-wrapper {
    margin-bottom: var(--space-3);
  }

  .article-headline {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem 0;
  }

  .article-byline {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .byline-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .byline-divider {
    color: rgba(var(--color-primary-rgb), 0.2);
  }

  /* Featured Hero Image (Flat, Zero Shadows, Zero Scale) */
  .featured-image-box {
    width: 100%;
    height: 420px;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    margin-bottom: 2rem;
    border: 1px solid rgba(var(--color-primary-rgb), 0.1);
    box-shadow: none; /* ZERO SHADOWS */
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* ZERO SCALE ON HOVER */
  }



  /* Article Content Body */
  .article-content-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    color: var(--color-text-main);
    font-size: var(--text-base);
    line-height: 1.8;
  }

  .article-content-body p {
    margin: 0;
  }

  /* Share Section */
  .article-share-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    margin-top: 2.5rem;
    border-top: 1px solid rgba(var(--color-primary-rgb), 0.1);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .share-headline {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
  }

  /* ==========================================================
     RIGHT SIDEBAR CARDS (Flat Trustly Style)
     ========================================================== */
  .article-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Card 1: SIPRUNPCD Dark Card (Flat) */
  .sidebar-siprunpcd-card {
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    border: 1px solid rgba(var(--color-primary-rgb), 0.2);
    box-shadow: none; /* ZERO SHADOWS */
  }

  .siprunpcd-badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--color-accent);
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }

  .siprunpcd-title {
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem 0;
    line-height: 1.3;
  }

  .siprunpcd-desc {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-sm);
    line-height: 1.55;
    margin: 0 0 1.5rem 0;
  }

  .siprunpcd-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background-color: var(--color-accent);
    color: var(--color-primary);
    text-align: center;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    padding: 0.8rem 1.25rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    box-shadow: none; /* ZERO SHADOWS */
    transition: background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .siprunpcd-btn:hover {
    background-color: var(--color-accent-dark);
  }

  /* Card 2: Recommended Section (Flat) */
  .sidebar-recomended-section {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid rgba(var(--color-primary-rgb), 0.08);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    box-shadow: none; /* ZERO SHADOWS */
  }

  .recommended-header {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 800;
    letter-spacing: -0.015em;
    margin: 0 0 1.25rem 0;
  }

  .recommended-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .recommended-card-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    padding: 0.5rem;
    border-radius: var(--radius-xl);
    transition: background-color 0.2s ease;
  }

  .recommended-card-item:hover {
    background-color: rgba(var(--color-primary-rgb), 0.04);
  }

  .rec-thumbnail-img {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-lg);
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid rgba(var(--color-primary-rgb), 0.08);
  }

  .rec-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .rec-item-cat {
    color: var(--color-accent-dark);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .rec-item-title {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.35;
    margin: 0;
    transition: color 0.2s ease;
  }

  .recommended-card-item:hover .rec-item-title {
    color: var(--color-primary-hover);
  }

  /* Card 3: Newsletter Box (Flat) */
  .sidebar-newsletter-box {
    background-color: var(--color-bg);
    border: 1px solid rgba(var(--color-primary-rgb), 0.08);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    box-shadow: none; /* ZERO SHADOWS */
  }

  .newsletter-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: rgba(var(--color-accent-rgb), 0.15);
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-3);
  }

  .newsletter-title {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 800;
    letter-spacing: -0.015em;
    margin: 0 0 0.4rem 0;
  }

  .newsletter-desc {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1.5;
    margin: 0 0 1rem 0;
  }

  .newsletter-input {
    width: 100%;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(var(--color-primary-rgb), 0.15);
    font-size: var(--text-xs);
    color: var(--color-text-main);
    background-color: var(--color-white);
    margin-bottom: 0.75rem;
    outline: none;
    box-shadow: none;
    transition: border-color 0.2s ease;
  }

  .newsletter-input:focus {
    border-color: var(--color-primary);
    outline: 2px solid var(--color-primary);
  }

  .newsletter-submit-btn {
    width: 100%;
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.7rem 1.25rem;
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    box-shadow: none; /* ZERO SHADOWS */
    transition: background-color 0.2s ease;
  }

  .newsletter-submit-btn:hover {
    background-color: var(--color-primary-hover);
  }

  /* ==========================================================
     RESPONSIVE BREAKPOINTS
     ========================================================== */
  @media (max-width: 1024px) {
    .article-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .article-sidebar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    .sidebar-newsletter-box {
      grid-column: span 2;
    }
  }

  @media (max-width: 767px) {
    .article-page-layout {
      padding-top: calc(90px + var(--space-4));
      padding-bottom: var(--space-10);
    }
    .article-sidebar {
      grid-template-columns: 1fr;
    }
    .sidebar-newsletter-box {
      grid-column: span 1;
    }
    .featured-image-box {
      height: 260px;
    }

  }

  @media (max-width: 479px) {
    .article-byline {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
    .byline-divider {
      display: none;
    }
    .featured-image-box {
      height: 200px;
      border-radius: var(--radius-xl);
    }

    .article-share-section {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
