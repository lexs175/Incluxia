---
import Layout from "../../layouts/Layout.astro";
import SiteImage from "../../components/ui/SiteImage.astro";
import ExpandableButton from "../../components/ui/ExpandableButton.astro";
import articlesData from "../../data/articles.json";

export function getStaticPaths() {
  return articlesData.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const otherArticles = articlesData
  .filter((a) => a.id !== article.id)
  .slice(0, 3);
---

<Layout
  title={`${article.title} | Blog Eco Bolivia`}
  description={article.summary}
  activePath="/blog"
>
  <div class="article-page-layout">
    <div class="container">
      <nav class="article-breadcrumb" aria-label="Ruta de navegación">
        <a href="/blog" class="breadcrumb-back-link">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Volver a todos los artículos
        </a>
      </nav>

      <div class="article-grid">
        <main class="article-main-column">
          <header class="article-intro-header">
            <h1 class="article-headline">{article.title}</h1>

            <div class="article-byline">
              <span class="byline-item">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {article.date}
              </span>
              <span class="byline-divider" aria-hidden="true">•</span>
              <span class="byline-item">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
                {article.author}
              </span>
              {article.readTime && (
                <>
                  <span class="byline-divider" aria-hidden="true">•</span>
                  <span class="byline-item">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    {article.readTime}
                  </span>
                </>
              )}
            </div>
          </header>

          <div class="featured-image-box">
            <SiteImage
              kind="detail"
              src={article.image}
              alt={article.title}
              class="featured-img"
              loading="eager"
              priority
            />
          </div>

          <div class="article-content-body">
            {article.content.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </main>

        <aside class="article-sidebar">
          <div class="sidebar-siprunpcd-card">
            <h3 class="siprunpcd-title">Carnet de Discapacidad en Bolivia</h3>
            <p class="siprunpcd-desc">
              Conoce los pasos sencillos ante el SIPRUNPCD para tramitar tu
              carnet oficial y acceder a los beneficios de la Ley 223 y Ley 977.
            </p>
            <ExpandableButton
              text="Ver Guía de Trámite"
              href="/blog/que-es-la-hipoacusia-sintomas-causas-mitos"
              variant="secondary"
              size="md"
            />
          </div>

          <div class="sidebar-recommended-section">
            <h3 class="recommended-header">Artículos Recomendados</h3>
            <div class="recommended-list">
              {
                otherArticles.map((rec) => (
                  <a href={`/blog/${rec.slug}`} class="recommended-card-item">
                    <div class="rec-thumb-wrap">
                      <SiteImage
                        kind="avatar"
                        src={rec.image}
                        alt={rec.title}
                        class="rec-thumbnail-img"
                        loading="lazy"
                      />
                    </div>
                    <div class="rec-text-wrap">
                      <span class="rec-item-cat">{rec.category}</span>
                      <h4 class="rec-item-title">{rec.title}</h4>
                    </div>
                  </a>
                ))
              }
            </div>
          </div>

          <div class="sidebar-newsletter-box">
            <div class="newsletter-icon-wrap" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <h4 class="newsletter-title">Boletín Informativo</h4>
            <p class="newsletter-desc">
              Recibe avisos sobre nuevas convocatorias de empleo e información sobre leyes de inclusión en Bolivia.
            </p>
            <form
              class="newsletter-form-inner"
              onsubmit="event.preventDefault(); const b=this.querySelector('button'); if(b){ b.textContent='✓ ¡Suscrito con Éxito!'; b.disabled=true; }"
            >
              <input
                type="email"
                required
                placeholder="Tu correo electrónico"
                class="newsletter-input"
                aria-label="Correo electrónico para boletín"
              />
              <button type="submit" class="newsletter-submit-btn">
                Suscribirme
              </button>
            </form>
          </div>
        </aside>
      </div>
    </div>
  </div>
</Layout>

<style>
  .article-page-layout {
    width: 100%;
    background-color: var(--color-bg);
    padding-top: calc(90px + var(--space-8));
    padding-bottom: var(--space-16);
    min-height: 100vh;
  }

  .article-breadcrumb {
    margin-bottom: var(--space-6);
  }

  .breadcrumb-back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb-back-link:hover {
    color: var(--color-primary);
  }

  .breadcrumb-back-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: var(--space-10);
    align-items: start;
  }

  .article-main-column {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .article-intro-header {
    margin-bottom: var(--space-8);
  }

  .article-headline {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-4) 0;
    text-wrap: balance;
  }

  .article-byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    flex-wrap: wrap;
  }

  .byline-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .byline-divider {
    color: rgba(var(--color-primary-rgb), 0.25);
  }

  .featured-image-box {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 440px;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-8);
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-alt);
    box-shadow: none;
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article-content-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    color: var(--color-text-main);
    font-size: var(--text-base);
    line-height: 1.75;
    font-family: var(--font-body);
  }

  .article-content-body p {
    margin: 0;
  }

  .article-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .sidebar-siprunpcd-card {
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    box-shadow: none;
  }

  .siprunpcd-title {
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-3) 0;
    line-height: 1.3;
  }

  .siprunpcd-desc {
    color: rgba(var(--color-white-rgb), 0.88);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0 0 var(--space-6) 0;
  }

  .sidebar-recommended-section {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: none;
  }

  .recommended-header {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 800;
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-5) 0;
  }

  .recommended-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .recommended-card-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    padding: var(--space-2);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast);
  }

  .recommended-card-item:hover {
    background-color: var(--color-bg-alt);
  }

  .rec-thumb-wrap {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-md);
    overflow: hidden;
    flex-shrink: 0;
    background-color: var(--color-bg-alt);
  }

  .rec-thumbnail-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .rec-text-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .rec-item-cat {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .rec-item-title {
    color: var(--color-text-primary);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.4;
    margin: 0;
    transition: color var(--transition-fast);
  }

  .recommended-card-item:hover .rec-item-title {
    color: var(--color-primary-hover);
  }

  .sidebar-newsletter-box {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: none;
  }

  .newsletter-icon-wrap {
    width: var(--space-10);
    height: var(--space-10);
    border-radius: var(--radius-md);
    background: rgba(var(--color-accent-rgb), 0.15);
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-3);
  }

  .newsletter-title {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 800;
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-2) 0;
  }

  .newsletter-desc {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1.6;
    margin: 0 0 var(--space-4) 0;
  }

  .newsletter-input {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-text-main);
    background-color: var(--color-bg-alt);
    margin-bottom: var(--space-3);
    box-sizing: border-box;
    transition: border-color var(--transition-fast);
  }

  .newsletter-input:focus {
    border-color: var(--color-primary);
    outline: 2px solid var(--color-primary);
  }

  .newsletter-submit-btn {
    width: 100%;
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: var(--space-3) var(--space-4);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    box-shadow: none;
    transition: background-color var(--transition-fast);
  }

  .newsletter-submit-btn:hover {
    background-color: var(--color-primary-hover);
  }

  .newsletter-submit-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (max-width: 1024px) {
    .article-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .article-sidebar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
    .sidebar-newsletter-box {
      grid-column: span 2;
    }
  }

  @media (max-width: 767px) {
    .article-page-layout {
      padding-top: calc(90px + var(--space-4));
      padding-bottom: var(--space-10);
    }
    .article-sidebar {
      grid-template-columns: 1fr;
    }
    .sidebar-newsletter-box {
      grid-column: span 1;
    }
  }

  @media (max-width: 479px) {
    .article-byline {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }
    .byline-divider {
      display: none;
    }
  }
</style>
