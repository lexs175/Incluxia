---
import AccessGate from "../../components/ui/AccessGate.astro";
import Layout from "../../layouts/Layout.astro";
import CategoryCard from "../../components/contratar/CategoryCard.astro";
import hiringData from "../../data/hiring.json";

const { categories, autonomos, services } = hiringData;

// Conteos dinámicos basados estrictamente en los registros reales
const enrichedCategories = categories.map((cat) => ({
  ...cat,
  countAutonomos: autonomos.filter((a) => a.categorySlug === cat.slug).length,
  countServices: services.filter((s) => s.categorySlug === cat.slug).length,
}));
---

<Layout
  title="Contratar Talento Inclusivo y Servicios por Rubro | Eco Bolivia"
  description="Contrata a profesionales autónomos con hipoacusia o paquetes de servicios cerrados en Bolivia. Comunicación 100% por chat o WhatsApp, cumplimiento Ley 977."
  activePath="/contratar"
>
  <AccessGate title="Ingresa para contratar talento" />
  <div class="hiring-hub-wrapper" data-member>
    <div class="container hiring-hub-container">
      <!-- Cabecera Hero del Hub -->
      <header class="hub-hero-section">
        <h1 class="hub-hero-title">
          Contratar por especialidad y rubro en Bolivia
        </h1>

        <p class="hub-hero-desc">
          Encuentra profesionales autónomos con hipoacusia listos para sumarse a
          tu equipo, o adquiere paquetes de servicios cerrados con entrega
          garantizada y coordinación 100% por chat.
        </p>
      </header>

      <!-- Cuadrícula de Rubros (Componente CategoryCard) -->
      <section
        class="hub-categories-grid"
        aria-label="Especialidades de contratación"
      >
        {enrichedCategories.map((cat) => <CategoryCard category={cat} />)}
      </section>
    </div>
  </div>
</Layout>

<style>
  /* ====================================================
     CAPA 1: WRAPPER EXTERIOR
     ==================================================== */
  .hiring-hub-wrapper {
    background: linear-gradient(180deg, rgba(var(--color-accent-rgb), 0.25) 0%, var(--color-bg) 420px);
    background-color: var(--color-bg);
    min-height: 100dvh;
    padding-top: calc(75px + var(--space-8));
    padding-bottom: var(--space-20);
    box-sizing: border-box;
  }

  /* ====================================================
     CAPA 2: CONTENEDOR 1440px (Tokens Oficiales)
     ==================================================== */
  .hiring-hub-container {
    max-width: var(--container-max-width);
    margin-inline: auto;
    box-sizing: border-box;
  }

  /* ====================================================
     HERO SECTION
     ==================================================== */
  .hub-hero-section {
    text-align: center;
    max-width: 860px;
    margin: 0 auto var(--space-12);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hub-hero-title {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 var(--space-4) 0;
  }

  .hub-hero-desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* ====================================================
     CUADRÍCULA DE RUBROS
     ==================================================== */
  .hub-categories-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  /* ====================================================
     RESPONSIVE BREAKPOINTS
     ==================================================== */
  @media (max-width: 1200px) {
    .hub-categories-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 860px) {
    .hub-categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .hub-categories-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { readStore, categories, profiles } from "../../lib/demo";
  import hiring from "../../data/hiring.json";
  function initHubCategories() {
    const grid = document.querySelector<HTMLElement>(".hub-categories-grid");
    if (!grid || grid.dataset.ready) return;
    grid.dataset.ready = "true";
    const cards = document.querySelectorAll<HTMLElement>(
      ".category-rubro-card",
    );
    const state = readStore();
    cards.forEach((card) => {
      const slug =
        card.dataset.categorySlug ||
        card.getAttribute("href")?.split("/").pop();
      const name = categories.find((c) => c.slug === slug)?.name;
      const people =
        hiring.autonomos.filter(
          (a) => a.categorySlug === slug && a.name !== profiles[0].name,
        ).length +
        state.accounts.filter(
          (a) =>
            a.profession &&
            (a.category ||
              (a.id === "demo-valeria" ? categories[0].name : "")) === name,
        ).length;
      const services = state.publications.filter(
        (p) =>
          p.type === "service" && p.status === "active" && p.category === name,
      ).length;
      const count = card.querySelector(".count-chip");
      if (count)
        count.textContent = people + " autónomos · " + services + " servicios";
    });

    cards.forEach((card) =>
      card.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a,button")) return;
        card
          .querySelector<HTMLAnchorElement>(".category-action-button")
          ?.click();
      }),
    );
  }

  document.addEventListener("astro:page-load", initHubCategories);
</script>
