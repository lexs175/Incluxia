---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import ActivityList from '../components/ui/ActivityList.astro';
---

<Layout
  title="Publicar Trabajo o Proyecto | Incluxia Bolivia"
  description="Publica una vacante o proyecto freelance en Bolivia. Conecta con talento calificado con comunicación 100% por chat escrito sin llamadas telefónicas."
  activePath="/publicar"
>
  <div class="publish-wrapper">
    <div class="container publish-container">
      
      <div class="publish-card" id="publishWorkspace">
        
        <!-- ESTADO 1: BLOQUEO POR AUTENTICACIÓN (Solo si NO ha iniciado sesión) -->
        <div id="publishAuthGate" class="publish-auth-gate" style="display: none;">
          <div class="auth-gate-icon-box">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          
          <h2 class="auth-gate-title" data-animated="true">Inicia sesión o regístrate para publicar</h2>
          <p class="auth-gate-desc">
            Para publicar puestos o proyectos, recibir postulaciones de candidatos y coordinar contrataciones por chat, necesitas acceder con tu cuenta.
          </p>

          <Button text="Ingresar" data-auth-trigger="login" data-auth-next="/publicar" />
          <Button text="Crear cuenta" variant="primary-line" data-auth-trigger="register" data-auth-next="/publicar" />
        </div>

        <!-- ESTADO 2: FORMULARIO DESBLOQUEADO (Visible ÚNICAMENTE si está logueado) -->
        <div id="publishFormWrapper" style="display: none;">
          <div class="publish-header">
            <h1 class="publish-title">Crea tu publicación</h1>
            <p class="publish-desc">
              Publica como empresa, como persona u ofrece un servicio desde esta misma cuenta. La actividad de esta demostración se guarda en tu navegador.
            </p>
          </div>

          <fieldset class="publication-kind-picker">
            <legend class="form-label">¿Qué quieres publicar?</legend>
            <div class="publication-kind-options">
              <label class="publication-kind-option" data-kind="company">
                <input type="radio" name="publicationKindChoice" value="company" form="publishJobForm" data-publication-kind checked />
                <span>Una vacante</span>
              </label>
              <label class="publication-kind-option" data-kind="person">
                <input type="radio" name="publicationKindChoice" value="person" form="publishJobForm" data-publication-kind />
                <span>Encargo como persona</span>
              </label>
              <label class="publication-kind-option" data-kind="service">
                <input type="radio" name="publicationKindChoice" value="service" form="publishJobForm" data-publication-kind />
                <span>Ofrecer un servicio</span>
              </label>
            </div>
          </fieldset>
          <input type="hidden" id="publicationKind" value="company" form="publishJobForm" />
          <p id="publicationKindHelp" class="demo-caption"></p>

          <!-- Formulario Oficial -->
          <form class="publish-form" id="publishJobForm">
            <div class="form-group" id="jobTypeToggle">
              <label for="jobTypeInput" class="form-label">Tipo de trabajo</label>
              <select id="jobTypeInput" class="form-control form-select">
                <option value="freelance">Proyecto / Freelance</option>
                <option value="fixed">Empleo fijo / Planilla</option>
              </select>
            </div>

            <!-- 1. Título del Trabajo -->
            <div class="form-group">
              <label for="jobTitle" class="form-label">
                Título del puesto o proyecto <span class="required-star">*</span>
              </label>
              <input
                type="text"
                id="jobTitle"
                required
                placeholder="Ej. Diseño de catálogo y piezas para redes / Auxiliar contable facturación"
                class="form-control"
              />
            </div>

            <!-- 2. Categoría y Ciudad (Grid 2 cols) -->
            <div class="form-grid-2">
              <div class="form-group">
                <label for="jobCategory" class="form-label">
                  Especialidad / Rubro <span class="required-star">*</span>
                </label>
                <select id="jobCategory" required class="form-control form-select">
                  <option value="" disabled selected>Selecciona un rubro</option>
                  <option value="Diseño Gráfico">Diseño Gráfico & Multimedia</option>
                  <option value="Desarrollo Web">Desarrollo Web & Software</option>
                  <option value="Sistemas y TI">Sistemas & Soporte Técnico</option>
                  <option value="Contabilidad y Finanzas">Contabilidad & Finanzas</option>
                  <option value="Digitación y Archivo">Digitación & Archivo de Datos</option>
                  <option value="Redes Sociales">Redes Sociales & Contenido</option>
                  <option value="Edición Audiovisual">Edición Audiovisual & Subtitulado</option>
                </select>
              </div>

              <div class="form-group">
                <label for="jobCity" class="form-label">
                  Ubicación <span class="required-star">*</span>
                </label>
                <select id="jobCity" required class="form-control form-select">
                  <option value="100% Remoto">100% Remoto (Toda Bolivia)</option>
                  <option value="Cochabamba">Cochabamba</option>
                  <option value="La Paz">La Paz / El Alto</option>
                  <option value="Santa Cruz">Santa Cruz</option>
                  <option value="Sucre">Sucre</option>
                  <option value="Tarija">Tarija</option>
                </select>
              </div>
            </div>

            <div class="form-grid-2">
              <div class="form-group"><label class="form-label" for="jobModality">Modalidad</label><select class="form-control form-select" id="jobModality"><option>Remoto</option><option>Presencial</option><option>Híbrido</option></select></div>
              <div class="form-group"><label class="form-label" for="jobDelivery">Plazo o disponibilidad</label><input class="form-control" id="jobDelivery" required placeholder="Ej. 10 días / Jornada completa" /></div>
            </div>
            <!-- 3. Presupuesto o Salario -->
            <div class="form-group">
              <label for="jobBudget" class="form-label">
                <span id="budgetLabelText">Presupuesto estimado (en Bolivianos)</span> <span class="required-star">*</span>
              </label>
              <div class="budget-input-wrap">
                <span class="budget-currency-prefix">Bs.</span>
                <input
                  type="text"
                  id="jobBudget"
                  required
                  placeholder="Ej. 650 (por proyecto) o 3200 (mensual)"
                  class="form-control budget-input"
                />
              </div>
            </div>

            <!-- 4. Descripción y Entregables -->
            <div class="form-group">
              <label for="jobDescription" class="form-label">
                Descripción de las tareas o entregables <span class="required-star">*</span>
              </label>
              <textarea
                id="jobDescription"
                required
                rows="4"
                placeholder="Describe qué necesitas lograr, herramientas requeridas (Photoshop, Excel, SIAT, etc.) y plazos estimados..."
                class="form-control form-textarea"
              ></textarea>
            </div>

            <div class="form-group"><label class="form-label" for="jobTasks">Tareas o entregables (uno por línea)</label><textarea id="jobTasks" class="form-control form-textarea" rows="3" required></textarea></div>
            <div class="form-group"><label class="form-label" for="jobRequirements">Requisitos (uno por línea, opcional)</label><textarea id="jobRequirements" class="form-control form-textarea" rows="3"></textarea></div>
            <!-- 5. Datos de quien publica -->
            <div class="form-grid-2">
              <div class="form-group">
                <label for="jobCompany" class="form-label">
                  Empresa o Nombre de Contratante <span class="required-star">*</span>
                </label>
                <input
                  type="text"
                  id="jobCompany"
                  required
                  placeholder="Ej. Estudio Creativo / Farmacorp / Personal"
                  class="form-control"
                />
              </div>

              <div class="form-group">
                <label for="jobWhatsapp" class="form-label">
                  Tu WhatsApp de contacto <span class="required-star">*</span>
                </label>
                <input
                  type="tel"
                  id="jobWhatsapp"
                  required
                  placeholder="+591 70000000"
                  class="form-control"
                />
              </div>
            </div>

            <!-- Botón Submit -->
            <Button type="submit" id="btnSubmitPublish" text="Revisar publicación" fullWidth size="md" />
          </form>
        </div>

        <!-- ESTADO 3: ÉXITO TRAS PUBLICAR -->
        <div id="publishSuccessBox" class="publish-success-state" style="display: none;">
          <div class="success-icon-badge">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          
          <h2 class="success-title">Tu publicación ya está disponible</h2>
          <p class="success-desc" id="successSummaryText">
            Tu vacante está activa. Los profesionales interesados podrán postular directamente por chat.
          </p>

          <div class="success-actions-box"><Button id="viewPublished" href="/" text="Ver publicación" variant="primary" /><Button id="viewMyPublished" text="Mis publicaciones" variant="primary-line" /></div>

          <Button id="btnPublishAnother" text="Crear otra publicación" variant="primary-line" />
        </div>

        <div id="publicationPreview" hidden><h2 class="publish-title">Revisa antes de publicar</h2><ActivityList id="previewList" /><div class="form-actions"><Button id="confirmPublication" text="Confirmar publicación" /><Button id="editPublicationPreview" text="Volver a editar" variant="primary-line" /></div></div>
        <section id="myPublications" hidden><h1 class="publish-title">Mis publicaciones</h1><p class="publish-desc">Administra tus empleos, encargos y servicios. Las consultas de contratación aparecen junto a cada servicio.</p><ActivityList id="publicationList" /></section>
        <p class="demo-feedback" id="publicationFeedback" role="status"></p>
      </div>

    </div>
  </div>
</Layout>

<script>
import {initPublish} from '../lib/publish';
document.addEventListener('astro:page-load',initPublish);
</script>

<style>
  .publication-kind-picker { border: 0; padding: 0; margin: 0; min-width: 0; }
  .publication-kind-picker legend { margin-bottom: var(--space-3); }
  .publication-kind-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
  .publication-kind-option { position: relative; display: flex; align-items: center; justify-content: center; min-height: 48px; padding: var(--space-3) var(--space-2); border: 1px solid var(--color-primary); border-radius: var(--radius-sm); color: var(--color-primary); font-family: var(--font-heading); font-size: var(--text-xs); font-weight: 700; line-height: 1.4; text-align: center; cursor: pointer; }
  .publication-kind-option input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .publication-kind-option:has(input:checked) { background: var(--color-primary); color: var(--color-text-inverse); }
  .publication-kind-option:has(input:focus-visible) { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  .publication-kind-option:hover { border-color: var(--color-primary-hover); }
  #publicationKindHelp { margin-block: var(--space-2) var(--space-6); }
  @media (max-width: 479px) { .publication-kind-options { grid-template-columns: 1fr; gap: var(--space-2); } .publication-kind-option { min-height: 44px; } }

  /* ====================================================
     CAPA 1: WRAPPER
     ==================================================== */
.publish-wrapper {
    background-color: var(--color-bg);
    min-height: 100dvh;
    padding-top: calc(75px + var(--space-8));
    padding-bottom: var(--space-20);
    box-sizing: border-box;
  }

  /* ====================================================
     CAPA 2: CONTENEDOR 1440px
     ==================================================== */
  .publish-container {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding);
    display: flex;
    justify-content: center;
  }

  /* ====================================================
     CAPA 3: CÁPSULA / TARJETA MAESTRA
     ==================================================== */
  .publish-card {
    width: 100%;
    max-width: 760px;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow: none;
    box-sizing: border-box;
  }

  /* ====================================================
     ESTADO 1: BLOQUEO POR AUTENTICACIÓN (AUTH GATE)
     ==================================================== */
  .publish-auth-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-8);
  }

  .auth-gate-icon-box {
    width: 68px;
    height: 68px;
    border-radius: var(--radius-full);
    background-color: rgba(var(--color-primary-rgb), 0.08);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-5);
  }

  .auth-gate-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: var(--space-3);
  }

  .auth-gate-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 480px;
    margin-bottom: var(--space-6);
  }

  .auth-gate-login-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.95rem 1.75rem;
    border-radius: var(--radius-md);
    border: none;
    background-color: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    box-shadow: none;
    transition: all var(--transition-fast);
  }

  .auth-gate-login-btn:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-1px);
    box-shadow: none;
  }

  /* ====================================================
     ESTADO 2: FORMULARIO
     ==================================================== */
  .publish-header {
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .publish-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .publish-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
    max-width: 580px;
    margin-inline: auto;
  }

  /* Formulario y Controles */
  .publish-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .required-star {
    color: var(--color-error);
  }

  .form-control {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-alt);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-main);
    box-sizing: border-box;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .form-control:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-color: var(--color-primary);
    background-color: var(--color-bg-card);
    box-shadow: none;
  }

  .form-select {
    cursor: pointer;
  }

  .form-textarea {
    resize: vertical;
    min-height: 90px;
    line-height: 1.5;
  }

  .budget-input-wrap {
    display: flex;
    align-items: center;
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .budget-currency-prefix {
    padding-left: 1rem;
    padding-right: 0.35rem;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--color-primary);
  }

  .budget-input {
    border: none !important;
    background: transparent !important;
    padding-left: 0.25rem !important;
  }

  .budget-input:focus {
    outline: none;
    box-shadow: none;
  }

  .budget-input-wrap:focus-within {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-color: var(--color-primary);
    box-shadow: none;
    background-color: var(--color-bg-card);
  }

  /* Botón Submit */
  .publish-submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.95rem 1.5rem;
    border-radius: var(--radius-md);
    border: none;
    background-color: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    box-shadow: none;
    transition: all var(--transition-fast);
  }

  .publish-submit-btn:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-1px);
    box-shadow: none;
  }

  /* ====================================================
     ESTADO 3: ÉXITO
     ==================================================== */
  .publish-success-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-6);
  }

  .success-icon-badge {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    background-color: rgba(var(--color-success-rgb), 0.12);
    color: var(--color-success);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .success-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .success-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
    max-width: 520px;
    margin-bottom: var(--space-6);
  }

  .success-actions-box {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    max-width: 420px;
    margin-bottom: var(--space-6);
  }

  .success-primary-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-md);
    background-color: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .success-primary-btn:hover {
    background-color: var(--color-primary-hover);
    color: var(--color-white);
  }

  .success-whatsapp-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-md);
    background-color: var(--color-whatsapp-light);
    color: var(--color-whatsapp-dark);
    border: 1px solid var(--color-whatsapp);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .success-whatsapp-btn:hover {
    background-color: var(--color-whatsapp);
    color: var(--color-white);
  }

  .btn-publish-another {
    background: transparent;
    border: none;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .btn-publish-another:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* Responsive Rules (Cero font-sizes en media queries) */
  @media (max-width: 640px) {
    .form-grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
