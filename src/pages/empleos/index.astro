---
import Layout from "../../layouts/Layout.astro";
import JobsDirectory from "../../components/empleos/JobsDirectory.astro";
import AccessGate from "../../components/ui/AccessGate.astro";
import jobsData from "../../data/jobs.json";
---

<Layout
  title="Ofertas de Empleo en Bolivia | Eco"
  description="Encuentra empleos formales para personas con hipoacusia en Bolivia. Comunicación 100% por chat o WhatsApp, sin llamadas telefónicas. Cumplimiento Ley 977."
  activePath="/empleos"
>
  <AccessGate title="Ingresa para buscar trabajo" next="/" />
  <div class="jobs-page-shell" data-member>
    <div class="container jobs-container">
      <JobsDirectory jobs={jobsData} />
    </div>
  </div>
</Layout>

<style>
  .jobs-page-shell {
    background: linear-gradient(180deg, rgba(var(--color-accent-rgb), 0.25) 0%, var(--color-bg) 420px);
    background-color: var(--color-bg);
    min-height: 100dvh;
    padding-top: calc(80px + var(--space-8));
    padding-bottom: var(--space-8);
    box-sizing: border-box;
  }

  .jobs-container {
    max-width: 1440px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  @media (max-width: 767px) {
    .jobs-page-shell {
      padding-top: calc(75px + var(--space-2));
      padding-bottom: var(--space-4);
    }
  }
</style>
