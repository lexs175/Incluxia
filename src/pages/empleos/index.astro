---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import JobCard from "../../components/cards/JobCard.astro";
import jobsData from "../../data/jobs.json";
---

<Layout
  title="Ofertas de Trabajo en Bolivia | Incluxia"
  description="Encuentra empleos formales para personas con hipoacusia en Bolivia. Comunicación 100% por chat o WhatsApp, sin llamadas telefónicas. Cumplimiento Ley 977."
  activePath="/empleos"
>
  <!-- 1. HERO SECTION: Clean Modern White Canvas (Trustly Fintech Style) -->
  <section class="trustly-jobs-hero">
    <div class="container hero-container">
      <div class="hero-header">
        <span class="hero-pill-badge">
          <span class="status-dot"></span>
          Ofertas Verificadas · Bolivia · Ley 977
        </span>

        <h1 class="hero-main-title">
          Trabajos para personas con hipoacusia en <span class="highlight-cyan">Bolivia</span>
        </h1>

        <p class="hero-lead-text">
          Vacantes formales en Cochabamba, La Paz, Santa Cruz y todo el país. Sin filtros telefónicos que descartan tu talento: la postulación, entrevista y coordinación se realizan <strong>100% por chat o WhatsApp</strong>.
        </p>
      </div>

      <!-- Quick Search Bar Pill (Clean Flat Geometry, Zero Shadows) -->
      <div class="search-pill-wrapper">
        <form class="search-pill-form" id="jobFilterForm">
          <div class="search-field">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="jobSearchInput"
              placeholder="Buscar puesto, empresa o habilidad..."
              class="search-input"
            />
          </div>

          <div class="search-field select-field">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <select id="cityFilterSelect" class="search-select">
              <option value="">Todas las Ciudades</option>
              <option value="Cochabamba">Cochabamba</option>
              <option value="La Paz">La Paz</option>
              <option value="Santa Cruz">Santa Cruz</option>
            </select>
          </div>

          <button type="submit" class="search-submit-btn">
            <span>Filtrar</span>
          </button>
        </form>
      </div>

      <!-- Quick Filter Pills -->
      <div class="quick-filter-pills" id="cityQuickPills">
        <button type="button" class="quick-pill active" data-city="">Todas ({jobsData.length})</button>
        <button type="button" class="quick-pill" data-city="Cochabamba">Cochabamba</button>
        <button type="button" class="quick-pill" data-city="La Paz">La Paz</button>
        <button type="button" class="quick-pill" data-city="Santa Cruz">Santa Cruz</button>
      </div>
    </div>
  </section>

  <!-- 2. JOBS DIRECTORY GRID (Soft Tinted Background, Zero Shadows) -->
  <section class="section jobs-directory-section">
    <div class="container">
      <div class="directory-top-meta">
        <span class="results-count" id="resultsCount">
          Mostrando <strong>{jobsData.length}</strong> empleos verificados
        </span>
        <span class="security-guarantee">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Procesos 100% coordinados por WhatsApp / Chat
        </span>
      </div>

      <div class="jobs-cards-grid" id="jobsGrid">
        {jobsData.map((job) => (
          <div class="job-item-wrapper" data-city={job.city} data-title={job.title.toLowerCase()} data-company={job.company.toLowerCase()}>
            <JobCard job={job} />
          </div>
        ))}
      </div>

      <div id="noResultsMsg" class="no-results-box" style="display: none;">
        <p class="no-results-title">No se encontraron ofertas con esos filtros</p>
        <p class="no-results-desc">Prueba seleccionando otra ciudad o borrando el término de búsqueda.</p>
        <Button href="/empleos" variant="outline" size="sm">Ver todos los empleos</Button>
      </div>
    </div>
  </section>

  <!-- 3. FOR COMPANIES CTA (Black Bento Showcase) -->
  <section class="section enterprise-cta-section">
    <div class="container">
      <div class="enterprise-dark-card">
        <div class="enterprise-split">
          <div class="enterprise-text-col">
            <h2 class="enterprise-card-title">
              ¿Tu empresa necesita cumplir la cuota de la Ley 977?
            </h2>
            <p class="enterprise-card-desc">
              Publica tu vacante en Incluxia de forma gratuita. Conectamos a tu equipo con profesionales calificados y te asesoramos para adaptar la entrevista y las tareas por escrito.
            </p>
            <div class="enterprise-actions">
              <Button href="/#empresas-ley977" variant="primary" size="lg">
                <span>Publicar Vacante Laboral</span>
              </Button>
              <Button href="https://wa.me/59172255726?text=Hola%2C%20represento%20a%20una%20empresa%20y%20deseo%20publicar%20una%20vacante%20en%20Incluxia" target="_blank" rel="noopener noreferrer" variant="whatsapp" size="lg">
                <span>Escribir por WhatsApp</span>
              </Button>
            </div>
          </div>

          <div class="enterprise-metrics-box">
            <div class="metric-mini-card">
              <span class="metric-number">2%</span>
              <span class="metric-label">Sector Privado (Ley 977)</span>
            </div>
            <div class="metric-mini-card">
              <span class="metric-number">4%</span>
              <span class="metric-label">Sector Público (Ley 223)</span>
            </div>
            <div class="metric-mini-card">
              <span class="metric-number">0</span>
              <span class="metric-label">Llamadas Telefónicas</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  function initJobFilters() {
    const input = document.getElementById('jobSearchInput') as HTMLInputElement | null;
    const citySelect = document.getElementById('cityFilterSelect') as HTMLSelectElement | null;
    const form = document.getElementById('jobFilterForm') as HTMLFormElement | null;
    const quickPills = document.querySelectorAll<HTMLButtonElement>('.quick-pill');
    const jobItems = document.querySelectorAll<HTMLElement>('.job-item-wrapper');
    const resultsCount = document.getElementById('resultsCount');
    const noResultsMsg = document.getElementById('noResultsMsg');

    let activeCity = '';
    let searchQuery = '';

    function applyFilters() {
      let visibleCount = 0;

      jobItems.forEach((item) => {
        const itemCity = item.getAttribute('data-city') || '';
        const itemTitle = item.getAttribute('data-title') || '';
        const itemCompany = item.getAttribute('data-company') || '';

        const matchesCity = !activeCity || itemCity.toLowerCase() === activeCity.toLowerCase();
        const matchesQuery = !searchQuery || itemTitle.includes(searchQuery) || itemCompany.includes(searchQuery);

        if (matchesCity && matchesQuery) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (resultsCount) {
        resultsCount.innerHTML = `Mostrando <strong>${visibleCount}</strong> empleos verificados`;
      }

      if (noResultsMsg) {
        noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      searchQuery = input?.value.trim().toLowerCase() || '';
      activeCity = citySelect?.value || '';
      
      // Update quick pills active state
      quickPills.forEach((pill) => {
        pill.classList.toggle('active', pill.getAttribute('data-city') === activeCity);
      });

      applyFilters();
    });

    input?.addEventListener('input', () => {
      searchQuery = input.value.trim().toLowerCase();
      applyFilters();
    });

    citySelect?.addEventListener('change', () => {
      activeCity = citySelect.value;
      quickPills.forEach((pill) => {
        pill.classList.toggle('active', pill.getAttribute('data-city') === activeCity);
      });
      applyFilters();
    });

    quickPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        quickPills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        activeCity = pill.getAttribute('data-city') || '';
        if (citySelect) citySelect.value = activeCity;
        applyFilters();
      });
    });
  }

  document.addEventListener('astro:page-load', initJobFilters);
</script>

<style>
  /* ====================================================
     1. HERO SECTION: TRUSTLY CLEAN FINTECH STYLE
     Zero shadows. Flat minimalism.
     ==================================================== */
  .trustly-jobs-hero {
    background-color: var(--color-white);
    padding-top: calc(90px + var(--space-12));
    padding-bottom: var(--space-16);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto var(--space-8) auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(var(--color-primary-rgb), 0.04);
    border: 1px solid rgba(var(--color-primary-rgb), 0.12);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.45rem 1.15rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
    letter-spacing: -0.01em;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--color-whatsapp);
  }

  .hero-main-title {
    font-size: var(--text-hero);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .highlight-cyan {
    color: var(--color-accent-dark);
  }

  .hero-lead-text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.65;
    max-width: 720px;
    margin: 0 auto;
  }

  .hero-lead-text strong {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Search Pill Wrapper */
  .search-pill-wrapper {
    width: 100%;
    max-width: 860px;
    margin-top: var(--space-8);
  }

  .search-pill-form {
    background: var(--color-white);
    border: 1.5px solid rgba(var(--color-primary-rgb), 0.12);
    border-radius: var(--radius-full);
    padding: 0.65rem 0.85rem;
    display: grid;
    grid-template-columns: 1.6fr 1.1fr auto;
    gap: 0.75rem;
    align-items: center;
    box-shadow: none; /* ZERO SHADOWS */
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1.15rem;
    background-color: var(--color-bg);
    border-radius: var(--radius-full);
  }

  .search-field svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .search-input {
    width: 100%;
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-main);
    outline: none;
  }

  .search-select {
    width: 100%;
    border: none;
    background: transparent;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
    outline: none;
    cursor: pointer;
  }

  .search-submit-btn {
    background-color: var(--color-primary);
    color: var(--color-white);
    border: none;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    cursor: pointer;
    box-shadow: none; /* ZERO SHADOWS */
    transition: background-color var(--transition-fast);
  }

  .search-submit-btn:hover {
    background-color: var(--color-primary-hover);
  }

  /* Quick City Pills */
  .quick-filter-pills {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }

  .quick-pill {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.45rem 1.15rem;
    border-radius: var(--radius-full);
    cursor: pointer;
    box-shadow: none; /* ZERO SHADOWS */
    transition: all var(--transition-fast);
  }

  .quick-pill:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .quick-pill.active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }

  /* ====================================================
     2. JOBS DIRECTORY GRID
     ==================================================== */
  .jobs-directory-section {
    background-color: var(--color-bg);
  }

  .directory-top-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .results-count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
  }

  .results-count strong {
    color: var(--color-primary);
  }

  .security-guarantee {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-whatsapp-dark);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .jobs-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .no-results-box {
    text-align: center;
    padding: var(--space-16) var(--space-4);
    background-color: var(--color-white);
    border-radius: var(--radius-2xl);
    border: 1px solid var(--color-border);
    max-width: 600px;
    margin: var(--space-8) auto 0 auto;
  }

  .no-results-title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .no-results-desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
  }

  /* ====================================================
     3. FOR COMPANIES CTA
     ==================================================== */
  .enterprise-cta-section {
    background-color: var(--color-white);
  }

  .enterprise-dark-card {
    background-color: var(--color-surface-dark);
    border-radius: var(--radius-3xl);
    border: 1px solid var(--color-border-dark);
    padding: clamp(2.5rem, 5vw, 4rem);
    box-shadow: none; /* ZERO SHADOWS */
  }

  .enterprise-split {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: var(--space-10);
    align-items: center;
  }

  .enterprise-card-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.025em;
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
    line-height: 1.25;
  }

  .enterprise-card-desc {
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--text-base);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .enterprise-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .enterprise-metrics-box {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .metric-mini-card {
    background-color: var(--color-surface-dark-card);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }

  .metric-number {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
  }

  .metric-label {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-white);
  }

  /* Responsive Rules */
  @media (max-width: 991px) {
    .jobs-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .enterprise-split {
      grid-template-columns: 1fr;
    }
    .search-pill-form {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 767px) {
    .jobs-cards-grid {
      grid-template-columns: 1fr;
    }
    .search-pill-form {
      grid-template-columns: 1fr;
      border-radius: var(--radius-2xl);
    }
  }
</style>
