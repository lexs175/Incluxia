---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import jobsData from '../../data/jobs.json';

export function getStaticPaths() {
  return jobsData.map((job) => ({
    params: { slug: job.slug },
    props: { job },
  }));
}

const { job } = Astro.props;
---

<Layout
  title={`${job.title} | ${job.company} - Incluxia Bolivia`}
  description={`Postula al trabajo de ${job.title} en ${job.company} (${job.city}). Comunicación 100% por chat o WhatsApp.`}
  activePath="/empleos"
>
  <!-- Breadcrumbs & Header Section -->
  <section class="job-header-section">
    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="breadcrumbs" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span class="crumb-separator">/</span>
        <a href="/empleos">Ofertas</a>
        <span class="crumb-separator">/</span>
        <span class="crumb-current">{job.title}</span>
      </nav>

      <!-- Main Header Content -->
      <div class="job-header-grid">
        <div>
          <Badge variant="cyan" class="job-tag">{job.accessibilityBadge}</Badge>
          <h1 class="job-page-title">{job.title}</h1>

          <div class="job-meta-row">
            <div class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
              <span>{job.company}</span>
            </div>

            <div class="meta-dot"></div>

            <div class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>{job.city}</span>
            </div>

            <div class="meta-dot"></div>

            <div class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              <span>{job.modality || 'Presencial'}</span>
            </div>

            <div class="meta-dot"></div>

            <div class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>{job.contractType || 'Tiempo Completo'}</span>
            </div>
          </div>
        </div>

        <div class="job-header-action">
          <Button href="#formulario-postulacion" variant="accent" size="lg">
            <span>Postularme Ahora</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Grid -->
  <section class="section job-detail-body">
    <div class="container job-layout-grid">
      <!-- Left Column: Details & Accessibility Ficha -->
      <div class="job-main-info">
        <!-- 1. Accessibility Adjustments Card -->
        <div class="accessibility-card">
          <div class="a11y-card-header">
            <div class="a11y-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
            </div>
            <div>
              <h2 class="a11y-title">Ajustes de Accesibilidad en este Puesto</h2>
              <p class="a11y-sub">Garantías de trabajo accesible validadas por el equipo de Incluxia.</p>
            </div>
          </div>

          <div class="a11y-items-list">
            {job.accessibilityHighlights.map((item) => (
              <div class="a11y-item">
                <div class="item-icon-tag">
                  {item.icon === 'chat' ? (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  ) : item.icon === 'headphones-off' ? (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="1" y1="1" x2="23" y2="23"></line><path d="M4 14v-3a8 8 0 0 1 14.93-4"></path><path d="M21 14v-3a8 8 0 0 0-.82-3.5"></path><rect x="2" y="14" width="4" height="7" rx="1"></rect><rect x="18" y="14" width="4" height="7" rx="1"></rect></svg>
                  ) : (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                  )}
                </div>
                <div class="item-text">
                  <h4 class="item-title">{item.title}</h4>
                  <p class="item-desc">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 2. Job Functions -->
        <div class="info-block">
          <h3 class="block-title">Funciones Principales</h3>
          <ul class="check-list">
            {job.functions.map((fn) => (
              <li>
                <div class="check-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>{fn}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- 3. Requirements -->
        <div class="info-block">
          <h3 class="block-title">Requisitos y Competencias Técnicas</h3>
          <ul class="check-list">
            {job.requirements.map((req) => (
              <li>
                <div class="check-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>{req}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Right Column: Application Form Card -->
      <aside class="job-apply-aside" id="formulario-postulacion">
        <div class="apply-card">
          <h3 class="apply-title">Postularme a esta Vacante</h3>
          <p class="apply-sub">
            Tu postulación será enviada directamente a <strong>{job.company}</strong> a través de <strong>Incluxia</strong>.
          </p>

          <form
            class="apply-form"
            onsubmit="event.preventDefault(); alert('¡Postulación enviada exitosamente! Se te contactará por WhatsApp para la confirmación.');"
          >
            <div class="form-group">
              <label for="applicantName" class="form-label">Nombre Completo *</label>
              <input type="text" id="applicantName" required placeholder="Ej. Ana Pérez" class="form-input" />
            </div>

            <div class="form-group">
              <label for="applicantWhatsapp" class="form-label">Número de WhatsApp *</label>
              <input type="tel" id="applicantWhatsapp" required placeholder="+591 70000000" class="form-input" />
            </div>

            <div class="form-group">
              <label for="applicantEmail" class="form-label">Correo Electrónico</label>
              <input type="email" id="applicantEmail" placeholder="ana@ejemplo.com" class="form-input" />
            </div>

            <div class="form-group">
              <label class="form-label">Cargar CV / Currículum Vitae</label>
              <div class="file-upload-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="upload-icon">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <p class="upload-main">Arrastra tu CV aquí o <span>haz clic para examinar</span></p>
                <p class="upload-sub">Formato PDF o DOCX (Máx. 5MB)</p>
                <input type="file" class="file-hidden-input" accept=".pdf,.doc,.docx" />
              </div>
            </div>

            <Button type="submit" variant="primary" style="width: 100%; margin-top: 0.5rem;">
              <span>Enviar Postulación Directa</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </Button>

            <div class="or-divider">
              <span>O TAMBIÉN</span>
            </div>

            <Button
              href={`https://wa.me/59170000000?text=Hola%2C%20deseo%20postular%20a%20la%20vacante%20de%20${encodeURIComponent(job.title)}%20en%20${encodeURIComponent(job.company)}`}
              target="_blank"
              rel="noopener noreferrer"
              variant="whatsapp"
              fullWidth={true}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.014 8.00613C6.12827 7.1024 7.30277 5.87414 8.23488 6.01043L8.23339 6.00894C9.14051 6.18132 9.85859 7.74261 10.2635 8.44465C10.5504 8.95402 10.3641 9.4701 10.0965 9.68787C9.7355 9.97883 9.17099 10.3803 9.28943 10.7834C9.5 11.5 12 14 13.2296 14.7107C13.695 14.9797 14.0325 14.2702 14.3207 13.9067C14.5301 13.6271 15.0466 13.46 15.5548 13.736C16.3138 14.178 17.0288 14.6917 17.69 15.27C18.0202 15.546 18.0977 15.9539 17.8689 16.385C17.4659 17.1443 16.3003 18.1456 15.4542 17.9421C13.9764 17.5868 8 15.27 6.08033 8.55801C5.97237 8.24048 5.99955 8.12044 6.014 8.00613Z" fill="currentColor"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 23C10.7764 23 10.0994 22.8687 9 22.5L6.89443 23.5528C5.56462 24.2177 4 23.2507 4 21.7639V19.5C1.84655 17.492 1 15.1767 1 12C1 5.92487 5.92487 1 12 1C18.0751 1 23 5.92487 23 12C23 18.0751 18.0751 23 12 23ZM6 18.6303L5.36395 18.0372C3.69087 16.4772 3 14.7331 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12C21 16.9706 16.9706 21 12 21C11.0143 21 10.552 20.911 9.63595 20.6038L8.84847 20.3397L6 21.7639V18.6303Z" fill="currentColor"/>
              </svg>
              <span>Postular por WhatsApp</span>
            </Button>
          </form>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  /* Header Section */
  .job-header-section {
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    min-height: 550px;
    padding: calc(var(--space-8) + 44px) 0 var(--space-12) 0;
    display: flex;
    align-items: center;
  }

  .job-header-section .container {
    width: 100%;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: var(--space-6);
  }

  .breadcrumbs a {
    color: rgba(255, 255, 255, 0.85);
  }

  .breadcrumbs a:hover {
    color: var(--color-accent);
  }

  .crumb-separator {
    color: rgba(255, 255, 255, 0.4);
  }

  .crumb-current {
    color: var(--color-accent);
    font-weight: 600;
  }

  .job-header-grid {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .job-tag {
    margin-bottom: var(--space-3);
  }

  .job-page-title {
    color: var(--color-text-inverse);
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .job-meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.85);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .meta-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  /* Body Layout Grid */
  .job-layout-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-10);
    align-items: start;
  }

  /* Accessibility Card */
  .accessibility-card {
    background: var(--color-bg-card);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    margin-bottom: var(--space-10);
    box-shadow: none;
  }

  .a11y-card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .a11y-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .a11y-title {
    font-size: var(--text-xl);
    margin-bottom: 0.15rem;
  }

  .a11y-sub {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .a11y-items-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .a11y-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background-color: var(--color-bg);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
  }

  .item-icon-tag {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background-color: var(--color-primary);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .item-title {
    font-size: var(--text-sm);
    font-weight: 700;
    margin-bottom: 0.2rem;
  }

  .item-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 0;
  }

  /* Info Blocks */
  .info-block {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
  }

  .block-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1.5px solid var(--color-border);
  }

  .check-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .check-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    font-size: var(--text-sm);
    color: var(--color-text-main);
    line-height: 1.6;
  }

  .check-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: rgba(var(--color-primary-rgb), 0.08);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Apply Form Card Aside */
  .apply-card {
    background: var(--color-bg-card);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    box-shadow: none;
    position: sticky;
    top: 100px;
  }

  .apply-title {
    font-size: var(--text-xl);
    margin-bottom: 0.35rem;
  }

  .apply-sub {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-6);
  }

  .apply-sub strong {
    color: var(--color-primary);
  }

  .file-upload-box {
    border: 2px dashed var(--color-border-hover);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-4);
    text-align: center;
    background-color: var(--color-bg);
    cursor: pointer;
    position: relative;
    transition: all var(--transition-fast);
  }

  .file-upload-box:hover {
    border-color: var(--color-primary);
    background-color: rgba(var(--color-accent-rgb), 0.1);
  }

  .upload-icon {
    color: var(--color-primary);
    margin: 0 auto var(--space-2) auto;
  }

  .upload-main {
    font-size: var(--text-xs);
    font-weight: 600;
    margin-bottom: 0.2rem;
  }

  .upload-main span {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .upload-sub {
    font-size: 0.7rem;
    color: var(--color-text-light);
    margin-bottom: 0;
  }

  .file-hidden-input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .or-divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin: var(--space-4) 0;
    color: var(--color-text-light);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .or-divider::before,
  .or-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--color-border);
  }

  .or-divider span {
    padding: 0 0.75rem;
  }

  /* ========================================================
     5-TIER RESPONSIVE ADAPTATIONS
     ======================================================== */

  /* 1. Desktop Tier (>= 1440px) */
  @media (min-width: 1440px) {
    .job-layout-grid {
      grid-template-columns: 1fr 400px;
      gap: var(--space-12);
    }
  }

  /* 2. Laptop Tier (992px - 1439px) */
  @media (min-width: 992px) and (max-width: 1439px) {
    .job-layout-grid {
      grid-template-columns: 1fr 340px;
      gap: var(--space-8);
    }
  }

  /* 3. Tablet Tier (768px - 991px) */
  @media (min-width: 768px) and (max-width: 991px) {
    .job-header-section {
      min-height: 480px;
      height: auto;
      padding: calc(90px + var(--space-8)) 0 var(--space-10) 0;
    }
    .job-layout-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .apply-card {
      position: static;
    }
    .job-header-grid {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }

  /* 4. Mobile Landscape Tier (480px - 767px) */
  @media (min-width: 480px) and (max-width: 767px) {
    .job-header-section {
      min-height: 440px;
      height: auto;
      padding: calc(90px + var(--space-8)) 0 var(--space-8) 0;
    }
    .job-layout-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .apply-card {
      position: static;
      padding: var(--space-6);
    }
    .job-header-grid {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
    .job-header-action {
      width: 100%;
    }
    .job-header-action .btn {
      width: 100%;
    }
    .job-meta-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
    .meta-dot {
      display: none;
    }
  }

  /* 5. Mobile Portrait Tier (240px - 479px) */
  @media (max-width: 479px) {
    .job-header-section {
      min-height: auto;
      height: auto;
      padding: calc(90px + var(--space-8)) 0 var(--space-8) 0;
    }
    .job-layout-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .accessibility-card, .info-block, .apply-card {
      padding: var(--space-4);
      border-radius: var(--radius-md);
    }
    .a11y-item {
      flex-direction: column;
      gap: 0.5rem;
    }
    .apply-card {
      position: static;
    }
    .job-header-grid {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
    .job-header-action {
