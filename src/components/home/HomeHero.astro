---
import ExpandableButton from "../ui/ExpandableButton.astro";
---

<section class="ashico-hero" aria-label="Sección Principal de Incluxia">
  <div class="container hero-container">
    <div class="hero-content">
      <h1 class="hero-title">
        Trabajos para personas<br />
        con hipoacusia en<br />
        <span class="hero-city-title">COCHABAMBA</span>
      </h1>

      <p class="hero-description">
        Basta de llamadas telefónicas sorpresa que descartan tu talento.
        Conectamos profesionales y postulantes con empresas inclusivas en
        Cochabamba donde todo se coordina <strong>100% por chat o WhatsApp</strong>,
        con salario justo y tareas claras por escrito.
      </p>

      <div class="hero-actions">
        <ExpandableButton
          href="/contratar"
          text="Contratar Talento"
          size="lg"
          variant="secondary"
          id="heroBtnContratar"
        />
        <ExpandableButton
          href="/empleos"
          text="Buscar Trabajo"
          size="lg"
          variant="secondary-line"
          id="heroBtnBuscar"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .ashico-hero {
    position: relative;
    width: 100%;
    min-height: 90dvh;
    display: flex;
    align-items: center;
    background-color: var(--color-primary-dark);
    background-image:
      linear-gradient(
        180deg,
        rgba(var(--color-primary-rgb), 0.30) 0%,
        rgba(var(--color-primary-rgb), 0.85) 45%,
        var(--color-primary-dark) 80%,
        var(--color-primary-dark) 100%
      ),
      url("/images/hero-ashico-cochabamba.jpg");
    background-size: cover;
    background-position: center 30%;
    background-repeat: no-repeat;
    padding-top: calc(90px + var(--space-8));
    padding-bottom: var(--space-16);
    margin-bottom: -1px;
    overflow: hidden;
  }

  .hero-container {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .hero-content {
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    position: relative;
    z-index: 2;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: var(--text-hero);
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin-bottom: var(--space-5);
    text-wrap: balance;
  }

  .hero-city-title {
    color: var(--color-white);
    letter-spacing: -0.01em;
  }

  .hero-description {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
    max-width: 560px;
    margin-bottom: var(--space-8);
  }

  .hero-description strong {
    color: var(--color-white);
    font-weight: 700;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (min-width: 480px) and (max-width: 767px) {
    .ashico-hero {
      background-image:
        linear-gradient(
          180deg,
          rgba(var(--color-primary-rgb), 0.80) 0%,
          rgba(var(--color-primary-dark-rgb), 0.90) 45%,
          var(--color-primary-dark) 78%,
          var(--color-primary-dark) 100%
        ),
        url("/images/hero-ashico-cochabamba.jpg");
      padding-top: calc(90px + var(--space-6));
      padding-bottom: var(--space-14);
      min-height: clamp(520px, 85dvh, 680px);
    }
  }

  @media (max-width: 479px) {
    .ashico-hero {
      background-image:
        linear-gradient(
          180deg,
          rgba(var(--color-primary-rgb), 0.82) 0%,
          rgba(var(--color-primary-dark-rgb), 0.92) 45%,
          var(--color-primary-dark) 78%,
          var(--color-primary-dark) 100%
        ),
        url("/images/hero-ashico-cochabamba.jpg");
      padding-top: calc(85px + var(--space-6));
      padding-bottom: var(--space-14);
      min-height: clamp(520px, 85dvh, 680px);
    }
  }
</style>
