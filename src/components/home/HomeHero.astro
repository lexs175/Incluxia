---
import SiteImage from "../ui/SiteImage.astro";
import imageSlots from "../../data/image-slots.json";
import ExpandableButton from "../ui/ExpandableButton.astro";
---

<section class="ashico-hero" aria-labelledby="home-title">
  <div class="container">
    <div class="hero-layout">
      <div class="hero-content">
        <h1 id="home-title" class="hero-title">Conectamos talento con oportunidades reales</h1>
        <p class="hero-description">Encuentra trabajo, ofrece tus servicios o contrata a personas con hipoacusia en Bolivia. Comunícate por chat desde el primer contacto.</p>
        <div class="hero-actions">
          <ExpandableButton data-auth-trigger="register" data-auth-next="/contratar" text="Contratar talento" size="lg" variant="primary" id="heroBtnContratar" />
          <ExpandableButton data-auth-trigger="register" data-auth-next="/" text="Buscar trabajo" size="lg" variant="primary-line" id="heroBtnBuscar" />
        </div>
      </div>
      <div class="hero-photos">
        <SiteImage kind="hero" priority src={imageSlots.home.hero.primary.src} alt={imageSlots.home.hero.primary.alt} />
        <SiteImage kind="heroSecondary" src={imageSlots.home.hero.secondary.src} alt={imageSlots.home.hero.secondary.alt} />
      </div>
    </div>
  </div>
</section>

<style>
.ashico-hero { width: 100%; background: var(--color-bg); padding-top: clamp(6.5rem, 6.36vw, 7.625rem); }
  .hero-layout { display: flex; flex-direction: column; gap: var(--space-12); }
  .hero-content { display: flex; flex-direction: column; align-items: center; gap: var(--space-6); text-align: center; }
  .hero-title { max-width: 100%; margin: 0; font-size: var(--text-home-hero); font-weight: 800; line-height: 1.1; letter-spacing: -0.0175em; color: var(--color-primary-dark); text-wrap: balance; }
  .hero-description { max-width: 560px; margin: 0; font-size: var(--text-base); line-height: 1.65; color: var(--color-text-main); text-wrap: pretty; }
  .hero-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-6); }
  .hero-photos { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); grid-template-rows: minmax(0, 1fr); gap: 10px; height: clamp(20rem, 28vw, 33.525rem); overflow: hidden; }
  .hero-photos img { width: 100%; height: 100%; min-width: 0; min-height: 0; object-fit: cover; border-radius: var(--radius-md) var(--radius-md) 0 0; }
  .hero-photos img:first-child { grid-column: span 3; }
  .hero-photos img:last-child { grid-column: span 2; }
  @media (max-width: 767px) {
    .hero-layout { gap: var(--space-8); }
    .hero-actions { margin-top: var(--space-2); gap: var(--space-3); }
    .hero-photos { height: clamp(16rem, 56vw, 24rem); gap: var(--space-2); }
  }
  @media (max-width: 479px) {
    .hero-photos { grid-template-columns: 1fr; }
    .hero-photos img:first-child { grid-column: auto; }
    .hero-photos img:last-child { display: none; }
  }
</style>
