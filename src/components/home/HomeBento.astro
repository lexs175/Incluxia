---
import SiteImage from "../ui/SiteImage.astro";
const items = [
  { icon: 'chat', title: 'Habla por chat', text: 'Coordina tareas y resuelve dudas por chat, WhatsApp o correo.' },
  { icon: 'experience', title: 'Revisa la experiencia', text: 'Consulta los estudios, las habilidades y los trabajos de cada profesional.' },
  { icon: 'tasks', title: 'Acuerda las tareas', text: 'Deja por escrito el trabajo, el precio y la fecha de entrega.' },
  { icon: 'work', title: 'Elige por su trabajo', text: 'Revisa las muestras de trabajo y elige a quien necesita tu proyecto.' },
];
---

<section class="bento-how-section" aria-labelledby="home-hiring-title">
  <div class="container">
    <div class="bento-container-box">
      <div class="bento-box-header">
        <h2 id="home-hiring-title" class="bento-box-title">Contrata y coordina por escrito</h2>
        <p class="bento-box-desc">Revisa los perfiles, compara su experiencia y acuerda el trabajo por chat.</p>
      </div>
      <div class="bento-cards-grid">
        {items.map(item => <article class="bento-card">
          <div class="bento-card-icon"><SiteImage kind="detail" src={`home/${item.icon}.svg`} width="24" height="24" alt="" loading="lazy" /></div>
          <h3 class="bento-title">{item.title}</h3>
          <p class="bento-text">{item.text}</p>
        </article>)}
      </div>
    </div>
  </div>
</section>

<style>
  .bento-how-section { width: 100%; background: var(--color-home-primary); padding-block: var(--space-16); }
  .bento-container-box { display: flex; flex-direction: column; align-items: center; gap: var(--space-16); }
  .bento-box-header { max-width: 720px; text-align: center; }
  .bento-box-title { margin-bottom: var(--space-3); font-size: var(--text-4xl); font-weight: 800; line-height: 1.2; color: var(--color-white); text-wrap: balance; }
  .bento-box-desc { font-size: var(--text-base); color: var(--color-white); line-height: 1.6; margin: 0; text-wrap: pretty; }
  .bento-cards-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); width: 100%; }
  .bento-card { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; padding: var(--space-6); border-radius: var(--radius-md); background: var(--color-white); }
  .bento-card-icon { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; }
  .bento-title { font-size: var(--text-lg); font-weight: 800; line-height: 1.3; color: var(--color-primary-dark); text-wrap: balance; }
  .bento-text { font-size: var(--text-sm); line-height: 1.55; color: var(--color-primary-dark); margin: 0; }
  @media (max-width: 1100px) { .bento-cards-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .bento-how-section { padding-block: var(--space-10); } .bento-container-box { gap: var(--space-8); } }
  @media (max-width: 479px) { .bento-cards-grid { grid-template-columns: 1fr; gap: var(--space-3); } }
</style>
