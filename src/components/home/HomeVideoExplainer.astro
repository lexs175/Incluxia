---
interface Props {
  id?: string;
}

const { id = "como-funciona" } = Astro.props;
---

<section
  class="home-video-section"
  id={id}
  aria-labelledby="video-explainer-title"
>
  <span id="buscar-trabajo" class="scroll-anchor" aria-hidden="true"></span>
  <div class="container">
    <div class="video-layout">
      <header class="video-header">
        <span class="video-tag">Explicación Paso a Paso</span>
        <h2 id="video-explainer-title" class="video-title">
          ¿Cómo funciona la plataforma Eco?
        </h2>
        <p class="video-description">
          Conoce en este video qué es cada sección dentro de Eco, cómo postular a empleos formales, cómo ofrecer tus servicios y cómo comunicarte 100% por chat sin llamadas.
        </p>
      </header>

      <div class="video-frame-wrapper">
        <div class="video-player-container">
          <iframe
            class="video-iframe"
            src="https://www.youtube-nocookie.com/embed/Gj8_5qPfd20"
            title="¿Cómo funciona la plataforma Eco?"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>

        <div class="video-features-bar">
          <div class="feature-item">
            <span class="feature-bullet" aria-hidden="true">1</span>
            <div class="feature-text">
              <strong>Explora ofertas reales</strong>
              <span>Conoce los puestos con requisitos claros y empresas verificadas.</span>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-bullet" aria-hidden="true">2</span>
            <div class="feature-text">
              <strong>Postulación sin llamadas</strong>
              <span>Envía tu perfil y comunícate exclusivamente por chat o WhatsApp.</span>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-bullet" aria-hidden="true">3</span>
            <div class="feature-text">
              <strong>Ofrece o contrata talento</strong>
              <span>Muestra tus servicios como autónomo o contrata a especialistas.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-video-section {
    position: relative;
    width: 100%;
    padding-block: var(--space-20);
    background-color: var(--color-bg);
    scroll-margin-top: 100px;
  }

  .scroll-anchor {
    position: absolute;
    top: -100px;
    visibility: hidden;
    pointer-events: none;
  }

  .video-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    max-width: 1080px;
    margin-inline: auto;
  }

  .video-header {
    text-align: center;
    max-width: 760px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .video-tag {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-4);
  }

  .video-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin: 0 0 var(--space-4) 0;
    text-wrap: balance;
  }

  .video-description {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
    text-wrap: pretty;
  }

  .video-frame-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .video-player-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    overflow: hidden;
    box-shadow: none;
  }

  .video-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .video-features-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .feature-bullet {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-alt);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .feature-text strong {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.3;
  }

  .feature-text span {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  @media (max-width: 991px) {
    .video-features-bar {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .home-video-section {
      padding-block: var(--space-12);
    }

    .video-layout {
      gap: var(--space-8);
    }
  }
</style>
