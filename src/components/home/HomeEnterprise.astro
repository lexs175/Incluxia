---
import Button from "../ui/Button.astro";
---

<section class="section enterprise-dark-section" id="contratar-talento">
  <div class="container">
    <div class="enterprise-dark-card">
      <div class="enterprise-header-box">
        <h2 class="enterprise-title">
          Encuentra y contrata talento profesional en Bolivia
        </h2>
        <p class="enterprise-lead">
          Conecta con profesionales calificados para tus proyectos freelance o vacantes fijas. Coordinación y entregas 100% por chat escrito sin llamadas telefónicas.
        </p>
      </div>

      <div class="enterprise-features-grid">
        <div class="feature-capsule">
          <div class="feature-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <h3 class="feature-title">Paquetes y Proyectos</h3>
          <p class="feature-desc">
            Contrata por entregables con precios transparentes en diseño, programación, contabilidad, digitación y redes.
          </p>
        </div>

        <div class="feature-capsule">
          <div class="feature-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <h3 class="feature-title">100% Chat Escrito</h3>
          <p class="feature-desc">
            Cero llamadas que te quiten tiempo. Todo queda organizado y documentado por chat o WhatsApp desde el inicio.
          </p>
        </div>

        <div class="feature-capsule">
          <div class="feature-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h3 class="feature-title">Talento Verificado</h3>
          <p class="feature-desc">
            Perfiles comprobados con portafolios visuales, trabajos completados y reseñas de clientes anteriores.
          </p>
        </div>
      </div>

      <div class="enterprise-actions-row">
        <Button href="/publicar" variant="white" size="lg">
          <span>+ Publicar un Trabajo o Proyecto</span>
        </Button>
        <Button href="/contratar" variant="outline-white" size="lg">
          <span>Explorar Talentos y Servicios</span>
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .enterprise-dark-section {
    background-color: var(--color-bg);
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  .enterprise-dark-card {
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-primary-dark) 100%
    );
    border-radius: var(--radius-3xl);
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3.5rem);
    box-shadow: none;
    box-sizing: border-box;
    text-align: center;
  }

  .enterprise-header-box {
    max-width: 720px;
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }

  .enterprise-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
    line-height: 1.25;
  }

  .enterprise-lead {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.6;
    margin: 0;
  }

  .enterprise-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-10);
    text-align: left;
  }

  .feature-capsule {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }

  .feature-capsule:hover {
    background: rgba(255, 255, 255, 0.12);
    transform: translateY(-2px);
  }

  .feature-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.15);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .feature-title {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-white);
    margin-bottom: var(--space-2);
  }

  .feature-desc {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.55;
    margin: 0;
  }

  .enterprise-actions-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .enterprise-features-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 479px) {
    .enterprise-dark-card {
      padding: var(--space-6) var(--space-4);
      border-radius: var(--radius-2xl);
    }

    .enterprise-actions-row {
      flex-direction: column;
      width: 100%;
    }

    .enterprise-actions-row :global(.btn) {
      width: 100%;
    }
  }
</style>
