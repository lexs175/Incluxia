---
import Button from "../ui/Button.astro";
---

<section class="section enterprise-dark-section" id="empresas-ley977">
  <div class="container">
    <div class="enterprise-dark-card">
      <div class="enterprise-content-grid">
        <!-- Left: Information and High-Contrast Metrics -->
        <div class="enterprise-info-col">
          <h2 class="enterprise-title">
            Cumple tu cuota de la Ley 977 con el mejor talento
          </h2>
          <p class="enterprise-lead">
            Las personas con hipoacusia destacan por su agudeza visual,
            concentración profunda y apego al cumplimiento de procesos. Cumple
            la cuota legal en Bolivia de forma ágil, con coordinación directa
            por chat.
          </p>

          <div class="metrics-bento-grid">
            <div class="metric-bento-card">
              <span class="metric-huge">2%</span>
              <span class="metric-card-title">Sector Privado</span>
              <p class="metric-card-desc">
                Obligatorio en empresas con más de 50 trabajadores (Ley 977).
              </p>
            </div>

            <div class="metric-bento-card">
              <span class="metric-huge">4%</span>
              <span class="metric-card-title">Sector Público</span>
              <p class="metric-card-desc">
                Obligatorio en ministerios, alcaldías y gobernaciones (Ley 223).
              </p>
            </div>

            <div class="metric-bento-card">
              <span class="metric-huge">100%</span>
              <span class="metric-card-title">Chat Escrito</span>
              <p class="metric-card-desc">
                Soporte y coordinación continua sin barreras telefónicas.
              </p>
            </div>
          </div>
        </div>

        <!-- Right: Clean White Form Capsule -->
        <div class="enterprise-form-capsule">
          <h3 class="form-capsule-title">Publica tu vacante laboral</h3>
          <p class="form-capsule-desc">
            Ingresa los datos de tu empresa y el puesto. El equipo de Incluxia
            te escribirá por WhatsApp para coordinar los detalles.
          </p>

          <form class="company-form" id="companyVacancyForm">
            <div class="form-item">
              <label for="compName" class="form-label"
                >Nombre de la Empresa o Negocio *</label
              >
              <input
                type="text"
                id="compName"
                required
                placeholder="Ej. Banco Mercantil, Farmacorp, etc."
                class="form-input-field"
              />
            </div>

            <div class="form-item">
              <label for="contactPerson" class="form-label"
                >Persona de Contacto *</label
              >
              <input
                type="text"
                id="contactPerson"
                required
                placeholder="Nombre y apellido"
                class="form-input-field"
              />
            </div>

            <div class="form-item">
              <label for="contactInfo" class="form-label"
                >WhatsApp o Correo Corporativo *</label
              >
              <input
                type="text"
                id="contactInfo"
                required
                placeholder="+591 70000000 o rrhh@empresa.com"
                class="form-input-field"
              />
            </div>

            <div class="form-item">
              <label for="jobDetails" class="form-label"
                >Puesto Vacante y Ciudad *</label
              >
              <textarea
                id="jobDetails"
                required
                placeholder="Puesto (diseño, contabilidad, archivo), ciudad y funciones..."
                class="form-textarea-field"></textarea>
            </div>

            <Button
              type="submit"
              variant="primary"
              fullWidth={true}
              id="btnSubmitCompany"
            >
              <span id="btnSubmitCompanyText">Enviar Vacante a Incluxia</span>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </Button>
          </form>

          <div
            id="companySuccessBox"
            class="company-success-box"
            style="display: none;"
          >
            <span class="company-success-icon">✓</span>
            <div>
              <strong>¡Vacante enviada con éxito!</strong>
              <p>
                El equipo de Incluxia revisará los detalles y te contactará
                por WhatsApp para coordinar los postulantes idóneos.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .enterprise-dark-section {
    background-color: var(--color-primary);
  }

  .enterprise-dark-card {
    border-radius: var(--radius-3xl);
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3.5rem);
    box-shadow: none;
  }

  .enterprise-content-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-10);
    align-items: start;
  }

  .enterprise-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .enterprise-lead {
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--text-base);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .metrics-bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .metric-bento-card {
    background: var(--color-primary-dark);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .metric-huge {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
  }

  .metric-card-title {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-white);
    margin-top: var(--space-1);
  }

  .metric-card-desc {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.45;
    margin: 0;
  }

  .enterprise-form-capsule {
    background: var(--color-white);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    color: var(--color-text-main);
    box-shadow: none;
    border: 1px solid var(--color-border);
  }

  .form-capsule-title {
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--color-primary);
    margin: 0 0 0.25rem 0;
  }

  .form-capsule-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
    line-height: 1.5;
  }

  .company-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-label {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .form-input-field {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-main);
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .form-input-field:focus {
    border-color: var(--color-primary);
  }

  .form-textarea-field {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-main);
    resize: vertical;
    min-height: 80px;
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .form-textarea-field:focus {
    border-color: var(--color-primary);
  }

  .company-success-box {
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    background-color: rgba(var(--color-primary-rgb), 0.06);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: var(--text-xs);
    color: var(--color-primary);
    line-height: 1.45;
  }

  .company-success-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background-color: var(--color-primary);
    color: var(--color-white);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .company-success-box strong {
    display: block;
    font-size: var(--text-sm);
    margin-bottom: 0.2rem;
  }

  .company-success-box p {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 991px) {
    .enterprise-content-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .metrics-bento-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 479px) {
    .enterprise-dark-card {
      padding: var(--space-6) var(--space-4);
      border-radius: var(--radius-2xl);
    }
    .enterprise-form-capsule {
      padding: var(--space-5);
    }
  }
</style>

<script>
  function initCompanyVacancyForm() {
    const form = document.getElementById(
      "companyVacancyForm",
    ) as HTMLFormElement;
    const submitBtn = document.getElementById(
      "btnSubmitCompany",
    ) as HTMLButtonElement;
    const submitText = document.getElementById("btnSubmitCompanyText");
    const successBox = document.getElementById("companySuccessBox");

    if (form && submitBtn && submitText && successBox) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();

        submitText.textContent = "✓ ¡Vacante Enviada con Éxito!";
        submitBtn.style.backgroundColor = "var(--color-primary-dark)";
        submitBtn.style.pointerEvents = "none";
        submitBtn.setAttribute("disabled", "true");

        successBox.style.display = "flex";
        successBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });
    }
  }

  document.addEventListener("astro:page-load", initCompanyVacancyForm);
</script>
