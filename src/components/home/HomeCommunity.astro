---
import SiteImage from "../ui/SiteImage.astro";
import imageSlots from "../../data/image-slots.json";
import ExpandableButton from "../ui/ExpandableButton.astro";

// Cada posición conserva un archivo propio; las dos vueltas reutilizan la misma selección.
const columns = imageSlots.home.gallery;
---

<section
  class="community-section"
  id="comunidad"
  aria-labelledby="community-title"
>
  <div class="container">
    <div class="community-content">
      <h2 id="community-title">Crea tu cuenta en Eco</h2>
      <p>
        Busca trabajo, ofrece tus servicios o contrata a personas con
        hipoacusia. Comparte tu experiencia y contacta por chat.
      </p>
      <div class="community-actions">
        <ExpandableButton
          text="Crear cuenta"
          data-auth-trigger="register"
          variant="white"
          size="md"
        />
      </div>
    </div>
  </div>
  <div class="community-gallery" id="community-gallery">
    <div class="gallery-track">
      {
        [0, 1].map((copy) => (
          <div
            class="gallery-group"
            aria-hidden={copy === 1 ? "true" : undefined}
          >
            {columns.map((column) => (
              <div class="gallery-column">
                {column.map((photo) => (
                  <div
                    class:list={[
                      "gallery-photo",
                      { "gallery-photo--tall": column.length === 1 },
                    ]}
                  >
                    <SiteImage kind={column.length === 1 ? "galleryTall" : "gallery"}
                      src={photo.src}
                      alt={copy === 0 ? photo.alt : ""}
                      width="640"
                      height="800"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .community-section {
    width: 100%;
    overflow: hidden;
    background: var(--color-bg-primary);
    color: var(--color-white);
    padding-block: var(--space-16);
  }
  .community-content {
    max-width: 830px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }
  .community-content h2 {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: inherit;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .community-content p {
    max-width: 720px;
    font-size: var(--text-base);
    line-height: 1.75;
    color: inherit;
    margin: 0;
  }
  .community-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-6);
  }
  .community-gallery {
    --gallery-card-width: clamp(10rem, 16.667vw, 20rem);
    --gallery-card-height: clamp(9rem, 14.896vw, 17.875rem);
    --gallery-gap: var(--space-5);
    margin-top: var(--space-10);
    overflow: hidden;
  }
  .gallery-track {
    display: flex;
    width: max-content;
    animation: community-drift 75s linear infinite;
  }
  .gallery-group {
    display: flex;
    align-items: flex-start;
    gap: var(--gallery-gap);
    padding-right: var(--gallery-gap);
  }
  .gallery-column {
    display: flex;
    flex-direction: column;
    flex: 0 0 var(--gallery-card-width);
    width: var(--gallery-card-width);
    gap: var(--gallery-gap);
  }
  .gallery-column:nth-child(3n + 1) {
    padding-top: var(--space-16);
  }
  .gallery-column:nth-child(3n + 2) {
    padding-top: var(--space-24);
  }
  .gallery-photo {
    width: 100%;
    height: var(--gallery-card-height);
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-primary-dark);
  }
  .gallery-photo--tall {
    height: calc(var(--gallery-card-height) * 2);
  }
  .gallery-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  @keyframes community-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (max-width: 767px) {
    .community-section {
      padding-block: var(--space-10);
    }
    .community-gallery {
      --gallery-gap: var(--space-3);
    }
    .gallery-column:nth-child(3n + 1) {
      padding-top: var(--space-8);
    }
    .gallery-column:nth-child(3n + 2) {
      padding-top: var(--space-12);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-track {
      animation: none;
    }
    .community-gallery {
      overflow-x: auto;
    }
    .gallery-group[aria-hidden="true"] {
      display: none;
    }
  }
</style>
