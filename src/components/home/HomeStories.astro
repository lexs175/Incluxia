---
import StoryCard from "../cards/StoryCard.astro";
import SectionLink from "../ui/SectionLink.astro";

interface Props {
  stories: any[];
}

const { stories } = Astro.props;
---

<section class="section stories-section">
  <div class="container">
    <div class="section-top-bar">
      <div>
        <h2 class="section-heading">Conoce sus experiencias</h2>
        <p class="section-desc">
          Historias de trabajo en tecnología, diseño y administración.
        </p>
      </div>
      <SectionLink href="/casos-de-exito" text="Ver todas las historias" />
    </div>

    <div class="stories-cards-grid">
      {stories.map((story) => <StoryCard story={story} compact />)}
    </div>
  </div>
</section>

<style>
  .stories-section {
    background-color: var(--color-bg);
  }

  .section-top-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .section-heading {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin-top: var(--space-2);
    margin-bottom: 0.25rem;
    line-height: 1.25;
  }

  .section-desc {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    margin: 0;
    max-width: 620px;
  }

  .stories-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 1440px) {
    .stories-cards-grid {
      gap: var(--space-8);
    }
  }

  @media (min-width: 992px) and (max-width: 1439px) {
    .stories-cards-grid {
      gap: var(--space-5);
    }
  }

  @media (min-width: 768px) and (max-width: 991px) {
    .stories-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .stories-cards-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
