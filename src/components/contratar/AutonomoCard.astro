---
import SiteImage from "../ui/SiteImage.astro";
import ActionButton from "../ui/ActionButton.astro";
interface Props { autonomo: any; }
const { autonomo } = Astro.props;
const initials = autonomo.name.split(/\s+/).slice(0, 2).map((part: string) => part[0]).join("");
---

<article class="autonomo-card-item" data-id={autonomo.id} data-name={autonomo.name.toLowerCase()} data-role={autonomo.role.toLowerCase()} data-city={autonomo.city} data-skills={autonomo.skills.join(" ").toLowerCase()}>
  <div class="autonomo-card-header">
    <div class="autonomo-avatar">
      <span class="autonomo-initials" aria-hidden="true">{initials}</span>
      <SiteImage kind="avatar" sizes="48px" src={autonomo.avatar} alt={autonomo.name} class="autonomo-avatar-img" width="48" height="48" loading="lazy" />
    </div>
    <div class="autonomo-header-info">
      <div class="autonomo-name-row">
        <h2 class="autonomo-name">{autonomo.name}</h2>
        <span class="pro-tag">PRO</span>
      </div>
      <p class="autonomo-role">{autonomo.role}</p>
      <p class="autonomo-city">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
        <span>{autonomo.city}, Bolivia</span><span aria-hidden="true">·</span><span class="rate-badge">{autonomo.hourlyRate}</span>
      </p>
    </div>
  </div>
  <p class="autonomo-bio-preview">{autonomo.bio}</p>
  <div class="autonomo-skills-chips" aria-label="Especialidades">
    {autonomo.skills.slice(0, 3).map((skill: string) => {
      const cleanSkill = skill.replace(/^Adobe\s+/i, '');
      return <span class="skill-chip" title={skill}>{cleanSkill}</span>;
    })}
  </div>
  <div class="autonomo-card-footer">
    <div class="footer-meta-item">
      <span class="autonomo-rating">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01L12 2Z" /></svg>
        <strong>{autonomo.rating.toFixed(1)}</strong>
      </span>
      <span>{autonomo.completedJobs} trabajos completados</span>
    </div>
    <div class="autonomo-action-wrap">
      <ActionButton variant="secondary" size="sm" class="card-open-trigger">
        <span>Ver detalles</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </ActionButton>
    </div>
  </div>
</article>

<style>
  .autonomo-card-item { container-type: inline-size; display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-card); cursor: pointer; transition: border-color var(--transition-fast); }
  .autonomo-card-item:hover { border-color: var(--color-primary); }
  .autonomo-card-header { display: flex; align-items: flex-start; gap: var(--space-3); min-width: 0; }
  .autonomo-avatar { position: relative; display: grid; place-items: center; flex: 0 0 48px; width: 48px; height: 48px; overflow: hidden; border: 1px solid var(--color-primary); border-radius: var(--radius-full); background: var(--color-bg); color: var(--color-primary); }
  .autonomo-initials { font-family: var(--font-heading); font-size: var(--text-sm); font-weight: 700; }
  .autonomo-avatar-img { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: var(--radius-full); object-fit: cover; }
  .autonomo-header-info { flex: 1; min-width: 0; }
  .autonomo-name-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--space-1) var(--space-2); }
  .autonomo-name { margin: 0; font-size: var(--text-sm); font-weight: 800; line-height: 1.4; color: var(--color-text-main); overflow-wrap: anywhere; }
  .pro-tag { flex-shrink: 0; padding: var(--space-1) var(--space-2); border-radius: var(--radius-md); background: var(--color-primary); color: var(--color-text-inverse); font-family: var(--font-heading); font-size: var(--text-xs); font-weight: 700; line-height: 1; }
  .autonomo-role { margin: var(--space-1) 0; font-size: var(--text-xs); line-height: 1.5; color: var(--color-text-muted); }
  .autonomo-city { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-1); margin: 0; font-size: var(--text-xs); line-height: 1.5; color: var(--color-text-muted); }
  .autonomo-city svg { flex-shrink: 0; }
  .rate-badge { color: var(--color-text-main); font-weight: 700; }
  .autonomo-bio-preview { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 3em; margin: 0; font-size: var(--text-xs); line-height: 1.5; color: var(--color-text-muted); }
  .autonomo-skills-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-1); }
  .skill-chip { padding: var(--space-1) var(--space-2); border-radius: var(--radius-md); background: var(--color-bg-primary-soft); font-size: var(--text-xs); line-height: 1.5; color: var(--color-text-main); white-space: nowrap; }
  .autonomo-card-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3); margin-top: auto; padding-top: var(--space-3); border-top: 1px solid var(--color-border); }
  .footer-meta-item { display: flex; flex-direction: column; font-size: var(--text-xs); line-height: 1.5; color: var(--color-text-muted); }
  .autonomo-rating { display: inline-flex; align-items: center; gap: var(--space-1); }
  .autonomo-action-wrap { margin-left: auto; }
  .autonomo-card-item:hover :global(.card-open-trigger) {
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
  }
  .autonomo-card-item:hover :global(.card-open-trigger svg) {
    transform: translate(2px, -2px);
  }
  @container (max-width: 270px) {
    .autonomo-action-wrap { width: 100%; margin-left: 0; }
    .autonomo-action-wrap :global(.management-action) { width: 100%; }
  }
</style>
