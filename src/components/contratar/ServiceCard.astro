---
import ExpandableButton from "../ui/ExpandableButton.astro";

interface Props {
  service: any;
}

const { service } = Astro.props;
---

<article
  class="service-card-item"
  data-id={service.id}
  data-title={service.title.toLowerCase()}
  data-city={service.author.city}
>
  <!-- Miniatura visual del servicio con bordes superiores limpios -->
  <div class="service-cover-preview" style={`background-color: ${service.previewColor};`}>
    <div class="service-preview-overlay">
      <span class="delivery-badge">⏱ {service.deliveryTime}</span>
    </div>
    <div class="service-preview-inner-art">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
        <polyline points="2 17 12 22 22 17"></polyline>
        <polyline points="2 12 12 17 22 12"></polyline>
      </svg>
      <span>{service.title}</span>
    </div>
  </div>

  <div class="service-card-body">
    <div class="service-author-row">
      <img
        src={service.author.avatar}
        alt={service.author.name}
        class="service-author-avatar"
        loading="lazy"
      />
      <div class="service-author-info">
        <span class="service-author-name">{service.author.name}</span>
        <span class="service-author-city">{service.author.city}</span>
      </div>
    </div>

    <h2 class="service-card-title">{service.title}</h2>
    <p class="service-card-desc">{service.description}</p>

    <div class="service-price-row">
      <div>
        <span class="price-label">Precio cerrado:</span>
        <span class="price-value">{service.price}</span>
      </div>
      <div class="service-action-wrap">
        <ExpandableButton
          text="Ver paquete"
          variant="primary-line"
          size="sm"
          type="button"
          class="card-open-trigger"
        />
      </div>
    </div>
  </div>
</article>

<style>
  .service-card-item {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: none;
    cursor: pointer;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .service-card-item:hover {
    border-color: var(--color-primary);
    transform: translateY(-3px);
    box-shadow: none;
  }

  .service-cover-preview {
    height: 160px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    box-sizing: border-box;
  }

  .service-preview-overlay {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
  }

  .delivery-badge {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    background-color: rgba(var(--white-rgb), 0.9);
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .service-preview-inner-art {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    max-width: 80%;
  }

  .service-card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-3);
    box-sizing: border-box;
  }

  .service-author-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .service-author-avatar {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .service-author-info {
    display: flex;
    flex-direction: column;
  }

  .service-author-name {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .service-author-city {
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }

  .service-card-title {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--color-text-main);
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .service-card-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .service-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .price-label {
    display: block;
    font-size: 0.68rem;
    color: var(--color-text-light);
  }

  .price-value {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-primary);
  }

  .service-action-wrap {
    pointer-events: none;
  }
</style>
