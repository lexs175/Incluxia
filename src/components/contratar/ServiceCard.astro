---
import SiteImage from "../ui/SiteImage.astro";
import ActionButton from "../ui/ActionButton.astro";
import hiring from "../../data/hiring.json";
interface Props { service: any; }
const { service } = Astro.props;
const cover = service.previewImage || hiring.categories.find(category => category.slug === service.categorySlug)?.image || hiring.categories[0].image;
const initials = service.author.name.split(/\s+/).slice(0, 2).map((part: string) => part[0]).join("");
---

<article class="service-card-item" data-id={service.id} data-title={service.title.toLowerCase()} data-city={service.author.city}>
  <div class:list={["service-cover-preview", { "service-cover-preview--custom": Boolean(service.previewImage) }]}>
    <SiteImage kind="service" class="service-cover-image" src={cover} data-service-preview={service.previewImage} alt={service.previewAlt || ""} width="720" height="300" loading="lazy" />
    <span class="delivery-badge">{service.deliveryTime}</span>
  </div>
  <div class="service-card-body">
    <div class="service-author-row">
      <div class="service-author-photo">
        <span class="service-author-initials" aria-hidden="true">{initials}</span>
        <SiteImage kind="avatar" sizes="32px" src={service.author.avatar} alt={service.author.name} class="service-author-avatar" width="32" height="32" loading="lazy" />
      </div>
      <div class="service-author-info">
        <span class="service-author-name">{service.author.name}</span>
        <span class="service-author-city">{service.author.city}</span>
      </div>
    </div>
    <h2 class="service-card-title">{service.title}</h2>
    <p class="service-card-desc">{service.description}</p>
    <div class="service-price-row">
      <div class="service-price">
        <span class="price-label">Precio cerrado</span>
        <span class="price-value">{service.price}</span>
      </div>
      <div class="service-action-wrap">
        <ActionButton variant="secondary" size="sm" class="card-open-trigger">
          <span>Ver paquete</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </ActionButton>
      </div>
    </div>
  </div>
</article>

<style>
  .service-card-item { container-type: inline-size; display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-card); cursor: pointer; transition: border-color var(--transition-fast); }
  .service-card-item:hover { border-color: var(--color-primary); }
  .service-cover-preview { position: relative; aspect-ratio: 12 / 5; overflow: hidden; background: var(--color-bg); }
  .service-cover-preview::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, var(--color-primary), transparent 85%); pointer-events: none; }
  .service-cover-preview--custom::after { display: none; }
  .service-cover-image { width: 100%; height: 100%; object-fit: cover; }
  .delivery-badge { position: absolute; top: var(--space-3); right: var(--space-3); z-index: 1; max-width: 85%; padding: var(--space-1) var(--space-2); border-radius: var(--radius-md); background: var(--color-bg); color: var(--color-text-main); font-family: var(--font-heading); font-size: var(--text-xs); font-weight: 700; line-height: 1.4; }
  .service-card-body { display: flex; flex: 1; flex-direction: column; gap: var(--space-3); min-width: 0; padding: var(--space-5); }
  .service-author-row { display: flex; align-items: center; gap: var(--space-3); min-width: 0; }
  .service-author-photo { position: relative; display: grid; place-items: center; flex: 0 0 32px; width: 32px; height: 32px; overflow: hidden; border-radius: var(--radius-full); background: var(--color-bg); color: var(--color-primary); }
  .service-author-initials { font-family: var(--font-heading); font-size: var(--text-xs); font-weight: 700; }
  .service-author-avatar { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: var(--radius-full); object-fit: cover; }
  .service-author-info { display: flex; flex-direction: column; min-width: 0; }
  .service-author-name { font-family: var(--font-heading); font-size: var(--text-xs); font-weight: 700; line-height: 1.5; color: var(--color-text-main); overflow-wrap: anywhere; }
  .service-author-city { font-size: var(--text-xs); line-height: 1.5; color: var(--color-text-muted); }
  .service-card-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin: 0; font-size: var(--text-sm); font-weight: 800; line-height: 1.4; color: var(--color-text-main); }
  .service-card-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin: 0; font-size: var(--text-xs); line-height: 1.5; color: var(--color-text-muted); }
  .service-price-row { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3); margin-top: auto; padding-top: var(--space-3); border-top: 1px solid var(--color-border); }
  .service-price { min-width: 0; }
  .price-label { display: block; margin-bottom: var(--space-1); font-size: var(--text-xs); line-height: 1.5; color: var(--color-text-muted); }
  .price-value { display: block; font-family: var(--font-heading); font-size: var(--text-base); font-weight: 800; line-height: 1.4; color: var(--color-primary); overflow-wrap: anywhere; }
  .service-action-wrap { margin-left: auto; }
  .service-card-item:hover :global(.card-open-trigger) {
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
  }
  .service-card-item:hover :global(.card-open-trigger svg) {
    transform: translate(2px, -2px);
  }
  @container (max-width: 270px) {
    .service-action-wrap { width: 100%; margin-left: 0; }
    .service-action-wrap :global(.management-action) { width: 100%; }
  }
</style>
