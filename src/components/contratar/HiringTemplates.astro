---
import AutonomoCard from './AutonomoCard.astro';
import ServiceCard from './ServiceCard.astro';
import HiringDrawer from './HiringDrawer.astro';
import hiring from '../../data/hiring.json';
const serviceTemplate = { ...hiring.services[0], previewImage: undefined, previewAlt: undefined };
---
<template id="newAutonomoTemplate"><AutonomoCard autonomo={hiring.autonomos[0]} /></template>
<template id="newServiceTemplate"><ServiceCard service={serviceTemplate} /></template>
<template id="newServiceDetailTemplate"><HiringDrawer autonomos={[hiring.autonomos[0]]} services={[serviceTemplate]} /></template>
