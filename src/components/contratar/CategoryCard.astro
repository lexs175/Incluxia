---
import ExpandableButton from '../ui/ExpandableButton.astro';

interface Props {
  category: {
    id: string;
    slug: string;
    name: string;
    shortDesc: string;
    image: string;
    tags: string[];
    countAutonomos?: number;
    countServices?: number;
    bgGradient?: string;
  };
}
const { category } = Astro.props;
const href = `/contratar/${category.slug}`;
---

<article class="category-rubro-card" data-category-slug={category.slug} data-name={category.name.toLowerCase()} data-tags={category.tags.join(' ').toLowerCase()} aria-labelledby={`category-${category.slug}`}>
  <img class="category-cover" src={category.image} alt="" width="900" height="800" loading="lazy" />
  <div class="card-image-overlay" aria-hidden="true"></div>
  <div class="card-content-wrap">
    <div class="card-main-info">
      <h2 class="category-card-title" id={`category-${category.slug}`}>{category.name}</h2>
      <p class="category-card-desc">{category.shortDesc}</p>
    </div>
    <div class="category-action">
      <ExpandableButton href={href} text="Ver oferta" variant="white" size="sm" class="category-action-button" />
    </div>
  </div>
</article>

<style>
  .category-rubro-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    container-type: inline-size;
    min-width: 0;
    min-height: 300px;
    overflow: hidden;
    border: none;
    border-radius: var(--radius-md);
    background: var(--color-primary-dark);
    cursor: pointer;
  }

  .category-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .card-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(186.57461864deg, rgba(var(--color-primary-rgb), 0) 25.553%, rgba(var(--color-primary-dark-rgb), 0.95) 94.594%);
    pointer-events: none;
  }

  .card-content-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    padding: var(--space-5);
  }

  .card-main-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .category-card-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-white);
    overflow-wrap: anywhere;
  }

  .category-card-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    font-size: var(--text-xs);
    line-height: 1.45;
    color: rgba(var(--white-rgb), 0.9);
    text-wrap: pretty;
  }

  .category-action {
    display: flex;
    justify-content: flex-end;
    margin-top: 0;
  }

  .category-rubro-card:focus-within {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
</style>
