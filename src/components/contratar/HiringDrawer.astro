---
import ExpandableButton from "../ui/ExpandableButton.astro";

interface Props {
  autonomos: any[];
  services: any[];
}

const { autonomos, services } = Astro.props;
---

<!-- Fondo oscuro con desenfoque (Backdrop) -->
<div class="hiring-drawer-backdrop" id="hiringDrawerBackdrop" aria-hidden="true"></div>

<!-- Panel Lateral Deslizante Unificado (Z-index 2000 > Navbar 1000) -->
<aside
  class="hiring-side-drawer"
  id="hiringSideDrawer"
  role="dialog"
  aria-modal="true"
  aria-label="Detalle ampliado de contratación"
>
  <!-- Cabecera fija del Drawer -->
  <div class="drawer-header-bar">
    <span class="drawer-type-chip" id="drawerTypeChip">Detalle</span>
    <button type="button" class="drawer-close-btn" id="hiringDrawerCloseBtn" aria-label="Cerrar panel de detalle">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="18" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Contenedor scrollable con paneles pre-renderizados como componentes oficiales -->
  <div class="drawer-scroll-body" id="hiringDrawerScrollBody">
    
    <!-- PANELES DE AUTÓNOMOS (Pre-renderizados limpios con ExpandableButton) -->
    {
      autonomos.map((aut) => {
        const whatsappUrl = `https://wa.me/${aut.whatsapp}?text=${encodeURIComponent(
          `Hola ${aut.name}, vi tu perfil profesional en Incluxia Bolivia y deseo consultar tu disponibilidad para un proyecto.`
        )}`;

        return (
          <div
            class="drawer-detail-panel autonomo-detail-panel"
            id={`drawer-autonomo-${aut.id}`}
            data-id={aut.id}
            style="display: none;"
          >
            <!-- Banner superior con avatar superpuesto -->
            <div class="drawer-hero-banner" aria-hidden="true"></div>
            <div class="drawer-avatar-wrap">
              <img src={aut.avatar} alt={aut.name} class="drawer-avatar-img" />
            </div>

            <!-- Títulos e información principal -->
            <div class="drawer-title-block">
              <h2 class="drawer-name">{aut.name}</h2>
              <p class="drawer-headline">{aut.role} · {aut.city}, Bolivia</p>
              
              <div class="drawer-meta-badges">
                <span class="drawer-meta-pill">💼 Tarifa: <strong>{aut.hourlyRate}</strong></span>
                <span class="drawer-meta-pill">⭐ {aut.rating.toFixed(1)} ({aut.completedJobs} trabajos)</span>
                <span class="drawer-meta-pill">⏱ {aut.experienceYears} de exp.</span>
                <span class="drawer-meta-pill">💬 Chat 100% fluido</span>
              </div>

              <!-- Botones oficiales ExpandableButton -->
              <div class="drawer-actions-row">
                <ExpandableButton
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  text={`Consultar disponibilidad (${aut.hourlyRate})`}
                  variant="primary"
                  size="md"
                />
                <ExpandableButton
                  href={`/perfiles/${aut.slug}`}
                  text="Ver perfil completo"
                  variant="primary-line"
                  size="md"
                />
              </div>
            </div>

            <!-- Biografía y Aptitudes -->
            <div class="drawer-section-block">
              <h3 class="drawer-section-heading">Acerca del profesional</h3>
              <p class="drawer-body-text">{aut.bio}</p>
              
              <div class="drawer-skills-chips">
                {aut.skills.map((skill: string) => (
                  <span class="drawer-skill-chip">{skill}</span>
                ))}
              </div>
            </div>

            <!-- Pestañas internas: Portafolio vs Reseñas -->
            <div class="drawer-section-block">
              <div class="drawer-tabs-nav" role="tablist">
                <button
                  type="button"
                  class="drawer-tab-btn active"
                  data-tab="works"
                  data-panel-id={aut.id}
                  role="tab"
                  aria-selected="true"
                >
                  Portafolio ({aut.portfolio.length})
                </button>
                <button
                  type="button"
                  class="drawer-tab-btn"
                  data-tab="reviews"
                  data-panel-id={aut.id}
                  role="tab"
                  aria-selected="false"
                >
                  Reseñas de clientes ({aut.reviews.length})
                </button>
              </div>

              <!-- Contenido de Portafolio -->
              <div class="drawer-portfolio-grid" id={`tabWorksContent-${aut.id}`}>
                {aut.portfolio.map((p: any) => (
                  <div class="drawer-work-card" style={`background-color: ${p.color};`}>
                    <span class="drawer-work-title">{p.title}</span>
                    <span class="drawer-work-cat">{p.category}</span>
                  </div>
                ))}
              </div>

              <!-- Contenido de Reseñas -->
              <div class="drawer-reviews-list" id={`tabReviewsContent-${aut.id}`} style="display: none;">
                {aut.reviews.map((r: any) => (
                  <div class="drawer-review-card">
                    <div class="review-header">
                      <strong class="review-client">{r.client} ({r.company})</strong>
                      <span class="review-date">{r.date}</span>
                    </div>
                    <div class="review-stars" aria-label="5 de 5 estrellas">★★★★★</div>
                    <p class="review-comment">"{r.comment}"</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        );
      })
    }

    <!-- PANELES DE SERVICIOS (Pre-renderizados limpios con ExpandableButton) -->
    {
      services.map((serv) => {
        const whatsappUrl = `https://wa.me/${serv.author.whatsapp}?text=${encodeURIComponent(
          `Hola ${serv.author.name}, vi tu paquete de servicio "${serv.title}" en Incluxia Bolivia (${serv.price}) y nos gustaría contratarlo.`
        )}`;

        return (
          <div
            class="drawer-detail-panel service-detail-panel"
            id={`drawer-service-${serv.id}`}
            data-id={serv.id}
            style="display: none;"
          >
            <!-- Portada visual del paquete -->
            <div class="drawer-service-gallery" style={`background-color: ${serv.previewColor};`}>
              <div class="service-gallery-art">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                  <polyline points="2 17 12 22 22 17"></polyline>
                  <polyline points="2 12 12 17 22 12"></polyline>
                </svg>
                <span class="gallery-package-title">{serv.title}</span>
              </div>
            </div>

            <!-- Caja de Precio y Plazo Oficial -->
            <div class="drawer-service-price-box">
              <div>
                <span class="price-box-label">Precio total del paquete:</span>
                <span class="price-box-value">{serv.price}</span>
              </div>
              <div class="price-box-delivery">
                <span class="price-box-label">Plazo de entrega:</span>
                <span class="delivery-time-val">⏱ {serv.deliveryTime}</span>
              </div>
            </div>

            <!-- Ficha del profesional a cargo -->
            <div class="drawer-author-card">
              <img src={serv.author.avatar} alt={serv.author.name} class="drawer-author-avatar" />
              <div>
                <strong class="drawer-author-name">Profesional a cargo: {serv.author.name}</strong>
                <span class="drawer-author-meta">{serv.author.role} · {serv.author.city}</span>
              </div>
            </div>

            <!-- Descripción del paquete -->
            <div class="drawer-section-block">
              <h3 class="drawer-section-heading">Descripción del servicio</h3>
              <p class="drawer-body-text">{serv.description}</p>
            </div>

            <!-- Checklist de entregables -->
            <div class="drawer-section-block">
              <h3 class="drawer-section-heading">¿Qué incluye este paquete?</h3>
              <div class="drawer-checklist">
                {serv.highlights.map((h: string) => (
                  <div class="drawer-check-item">
                    <span class="drawer-check-bullet" aria-hidden="true">✔</span>
                    <span>{h}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Botón oficial ExpandableButton para Contratar -->
            <div class="drawer-service-cta-block">
              <ExpandableButton
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                text={`Contratar este paquete (${serv.price})`}
                variant="primary"
                size="md"
                fullWidth={true}
              />
              <span class="cta-guarantee-note">
                Coordinación y entrega 100% por chat escrito sin llamadas telefónicas
              </span>
            </div>
          </div>
        );
      })
    }

  </div>
</aside>

<style>
  /* ====================================================
     Z-INDEX SUPERIOR A LA NAVBAR (Navbar = 1000, FAB = 999)
     Backdrop = 9998, Drawer = 9999
     ==================================================== */
  .hiring-drawer-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(var(--color-primary-dark-rgb), 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 9998 !important;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-normal);
    touch-action: none;
    overscroll-behavior: none;
  }

  .hiring-drawer-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .hiring-side-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(560px, 100vw);
    background-color: var(--color-bg-card);
    border-left: 1px solid var(--color-border);
    box-shadow: -12px 0 40px rgba(var(--color-primary-dark-rgb), 0.25);
    z-index: 9999 !important;
    transform: translateX(100%);
    transition: transform var(--transition-smooth);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    overscroll-behavior: contain !important;
  }

  .hiring-side-drawer.is-open {
    transform: translateX(0);
  }

  /* Cabecera del Drawer */
  .drawer-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
    flex-shrink: 0;
  }

  .drawer-type-chip {
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background-color: rgba(var(--color-primary-rgb), 0.08);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .drawer-close-btn {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .drawer-close-btn:hover {
    background-color: var(--color-bg-alt);
    color: var(--color-primary);
  }

  /* Cuerpo con scroll independiente */
  .drawer-scroll-body {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    overscroll-behavior: contain !important;
    -webkit-overflow-scrolling: touch;
  }

  .drawer-detail-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Elementos de Autónomo */
  .drawer-hero-banner {
    height: 120px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    margin-bottom: -50px;
  }

  .drawer-avatar-wrap {
    width: 90px;
    height: 90px;
    border-radius: var(--radius-full);
    border: 4px solid var(--color-bg-card);
    overflow: hidden;
    box-shadow: 0 4px 12px rgba(var(--color-primary-dark-rgb), 0.12);
    background-color: var(--color-bg-alt);
    margin-left: var(--space-4);
  }

  .drawer-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .drawer-title-block {
    display: flex;
    flex-direction: column;
  }

  .drawer-name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-text-main);
    margin: var(--space-2) 0 0.15rem 0;
  }

  .drawer-headline {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .drawer-meta-badges {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .drawer-meta-pill {
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .drawer-actions-row {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .drawer-section-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .drawer-section-heading {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--color-text-main);
    margin: 0;
  }

  .drawer-body-text {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .drawer-skills-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: var(--space-2);
  }

  .drawer-skill-chip {
    padding: 0.25rem 0.6rem;
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    color: var(--color-text-main);
    font-weight: 600;
  }

  /* Pestañas de Portafolio vs Reseñas */
  .drawer-tabs-nav {
    display: flex;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-4);
  }

  .drawer-tab-btn {
    padding: 0.65rem 1.25rem;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-muted);
    border: none;
    background: transparent;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .drawer-tab-btn:hover {
    color: var(--color-primary);
  }

  .drawer-tab-btn.active {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .drawer-portfolio-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .drawer-work-card {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 110px;
    box-sizing: border-box;
  }

  .drawer-work-title {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .drawer-work-cat {
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }

  .drawer-reviews-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .drawer-review-card {
    padding: var(--space-4);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .review-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.25rem;
  }

  .review-client {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    color: var(--color-text-main);
  }

  .review-date {
    font-size: 0.68rem;
    color: var(--color-text-light);
  }

  .review-stars {
    color: var(--color-warning);
    font-size: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .review-comment {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* Elementos de Servicio */
  .drawer-service-gallery {
    height: 170px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    padding: var(--space-4);
    text-align: center;
  }

  .service-gallery-art {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-primary);
  }

  .gallery-package-title {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 800;
    max-width: 85%;
  }

  .drawer-service-price-box {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: var(--space-4);
    background-color: rgba(var(--color-primary-rgb), 0.08);
    border: 1px solid rgba(var(--color-primary-rgb), 0.18);
    border-radius: var(--radius-md);
  }

  .price-box-label {
    display: block;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .price-box-value {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-primary);
  }

  .price-box-delivery {
    text-align: right;
  }

  .delivery-time-val {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .drawer-author-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .drawer-author-avatar {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .drawer-author-name {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    color: var(--color-text-main);
    display: block;
  }

  .drawer-author-meta {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .drawer-checklist {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .drawer-check-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-main);
    line-height: 1.5;
  }

  .drawer-check-bullet {
    color: var(--color-primary);
    font-weight: 800;
  }

  .drawer-service-cta-block {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cta-guarantee-note {
    display: block;
    text-align: center;
    font-size: 0.72rem;
    color: var(--color-text-light);
  }
</style>
