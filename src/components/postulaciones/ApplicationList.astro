---
import '../../styles/management.css';
---

<div class="application-list" id="applicationList"></div>
<template id="applicationListTemplate">
  <article class="application-card activity-item">
    <header class="application-header">
      <div class="application-identity">
        <p class="application-status"></p>
        <h2 class="application-title"></h2>
        <p class="application-context"></p>
      </div>
      <div class="application-update" hidden></div>
    </header>
    <ul class="application-meta" aria-label="Datos de la postulación">
      <li class="application-location-item">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
        <span class="application-location"></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18" /></svg>
        <span class="application-date"></span>
      </li>
      <li class="application-file-item">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" /><path d="M14 2v6h6M8 13h8M8 17h6" /></svg>
        <span class="application-file"></span>
      </li>
    </ul>
    <div class="application-message-block">
      <h3 class="application-message-label"></h3>
      <p class="application-message"></p>
    </div>
    <footer class="application-actions"></footer>
  </article>
</template>
<template id="applicationEmptyTemplate">
  <section class="application-empty">
    <h2 class="application-empty-title"></h2>
    <p class="application-empty-description"></p>
    <div class="application-empty-action"></div>
  </section>
</template>

<style>
  .application-list { display: grid; gap: var(--space-5); }
  .application-card, .application-empty { min-width: 0; padding: var(--workspace-card-padding); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-card); }
  .application-header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: var(--space-6); margin-bottom: var(--space-5); }
  .application-status { color: var(--color-primary); font-size: var(--text-sm); font-weight: 700; margin: 0 0 var(--space-3); }
  .application-card[data-status='Seleccionada'] .application-status { color: var(--color-success-text); }
  .application-card[data-status='No seleccionada'] .application-status,
  .application-card[data-status='Retirada'] .application-status { color: var(--color-text-muted); }
  .application-title { color: var(--color-text-main); font-family: var(--font-heading); font-size: var(--text-3xl); font-weight: 800; line-height: 1.25; letter-spacing: -0.025em; margin: 0 0 var(--space-3); overflow-wrap: anywhere; }
  .application-context { color: var(--color-text-muted); font-size: var(--text-base); line-height: 1.5; margin: 0; overflow-wrap: anywhere; }
  .application-update { min-width: 0; width: 220px; max-width: 100%; }
  .application-update :global(label) { display: grid; gap: var(--space-2); color: var(--color-text-muted); font-size: var(--text-sm); font-weight: 500; }
  .application-update :global(select) { width: 100%; min-height: 44px; padding: var(--space-2) var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-card); color: var(--color-text-main); font: inherit; cursor: pointer; }
  .application-update :global(select:focus-visible) { outline: 2px solid var(--color-primary); outline-offset: var(--space-1); }
  .application-update :global(select:disabled) { color: var(--color-text-muted); background: var(--color-bg-alt); cursor: default; }
  .application-meta { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); list-style: none; padding: 0; margin: 0 0 var(--space-6); color: var(--color-text-muted); font-size: var(--text-sm); }
  .application-meta li { display: flex; align-items: center; gap: var(--space-2); min-width: 0; }
  .application-meta svg { width: 20px; height: 20px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .application-meta span { overflow-wrap: anywhere; }
  .application-message-label { font-size: var(--text-sm); font-weight: 600; color: var(--color-text-muted); margin: 0 0 var(--space-2); }
  .application-message { max-width: 75ch; color: var(--color-text-main); font-size: var(--text-base); line-height: 1.65; white-space: pre-line; overflow-wrap: anywhere; margin: 0; }
  .application-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); border-top: 1px solid var(--color-border); margin-top: var(--space-6); padding-top: var(--space-5); }
  .application-actions :global(.management-action--danger) { margin-inline-start: auto; padding-inline: var(--space-2); }
  .application-empty-title { color: var(--color-text-main); font-size: var(--text-xl); font-weight: 700; margin: 0 0 var(--space-3); }
  .application-empty-description { max-width: 65ch; color: var(--color-text-muted); font-size: var(--text-base); line-height: 1.6; margin: 0 0 var(--space-5); }
  @media (max-width: 767px) {
    .application-header { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
    .application-meta { display: grid; }
  }
  @media (max-width: 479px) {
    .application-update { width: 100%; }
    .application-actions { display: grid; grid-template-columns: minmax(0, 1fr); }
    .application-actions :global(.management-action--danger) { margin-inline-start: 0; }
  }
</style>
