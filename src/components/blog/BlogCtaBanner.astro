---
import ExpandableButton from "../ui/ExpandableButton.astro";
---

<div class="blog-bottom-cta">
  <div class="cta-inner-text">
    <h2 class="cta-heading">Únete a la comunidad de Eco</h2>
    <p class="cta-sub">
      Crea tu cuenta gratuita para postular o contratar con comunicación 100% por chat, o inicia sesión si ya formas parte de Eco.
    </p>
  </div>
  <div class="cta-actions">
    <ExpandableButton
      data-auth-trigger="register"
      data-auth-next="/blog"
      variant="primary"
      size="md"
      text="Crear cuenta"
    />
    <ExpandableButton
      data-auth-trigger="login"
      data-auth-next="/blog"
      variant="primary-line"
      size="md"
      text="Ingresar"
    />
  </div>
</div>

<style>
  .blog-bottom-cta {
    margin-top: var(--space-16);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-8) var(--space-10);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    box-shadow: none;
  }

  .cta-inner-text {
    max-width: 680px;
  }

  .cta-heading {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0 0 var(--space-2) 0;
  }

  .cta-sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .blog-bottom-cta {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-8);
      gap: var(--space-6);
    }
  }

  @media (max-width: 479px) {
    .blog-bottom-cta {
      padding: var(--space-6) var(--space-4);
    }

    .cta-actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
