---
import Button from "../ui/Button.astro";
---

<section class="section final-cta-section">
  <div class="container">
    <div class="final-cta-capsule">
      <h2 class="final-cta-title">
        ¿Buscas contratar profesionales verificados para tu negocio?
      </h2>
      <p class="final-cta-subtitle">
        Publica tu requerimiento o explora paquetes de servicios con precios claros y coordinación 100% por chat escrito.
      </p>
      <div class="final-cta-buttons">
        <Button href="/publicar" variant="white" size="lg">
          <span>+ Publicar un Trabajo</span>
        </Button>
        <Button href="/contratar" variant="outline-white" size="lg">
          <span>Explorar Servicios</span>
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    background-color: var(--color-bg-primary);
    padding-top: var(--space-12);
  }

  .final-cta-capsule {
    background: var(--color-surface-dark);
    border-radius: var(--radius-md);
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    color: var(--color-text-inverse);
    margin: 0 auto;
  }

  .final-cta-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-text-inverse);
    margin-bottom: var(--space-4);
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  .final-cta-subtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-base);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto var(--space-8) auto;
  }

  .final-cta-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (max-width: 767px) {
    .final-cta-buttons {
      flex-direction: column;
      width: 100%;
    }

    .final-cta-buttons :global(.btn) {
      width: 100%;
    }
  }
</style>
