---
import SiteImage from "../ui/SiteImage.astro";
import ActionButton from "../ui/ActionButton.astro";
import ExpandableButton from "../ui/ExpandableButton.astro";
import ProfileEditor from "./ProfileEditor.astro";
import ActivityList from "../ui/ActivityList.astro";
import ContactRequest from "../ui/ContactRequest.astro";
import { seedAccounts } from "../../lib/demo";
import "../../styles/management.css";
const {
  profile,
  own = false,
  dynamic = false,
  application = false,
} = Astro.props;
const initials = profile.name
  .split(/\s+/)
  .slice(0, 2)
  .map((part: string) => part[0])
  .join("")
  .toUpperCase();
const shareUrl = `https://wa.me/?text=${encodeURIComponent("Perfil de " + profile.name + " en Eco")}`;
const profileAccount = seedAccounts.find(
  (account) => account.profileSlug === profile.slug,
);
---

<div
  class="profile-page-wrapper"
  id="profileDetail"
  data-own={own ? "true" : undefined}
  data-profile-id={profile.slug}
  data-dynamic={dynamic ? "true" : undefined}
  aria-busy={own || dynamic ? "true" : undefined}
>
  <div class="container profile-container">
    <div class="profile-stack">
      <!-- ====================================================
             1. TARJETA HERO DE CABECERA (Portada + Avatar + Contacto)
             ==================================================== -->
      <section
        class="profile-detail-card profile-hero-card"
        aria-label="Información principal del perfil"
      >
        <!-- Portada / Cover Banner -->
        <div class="profile-cover-banner" aria-hidden="true">
          <SiteImage kind="profileCover" src={profile.cover} alt="" class="profile-cover-image" loading="eager" hidden={!profile.cover} />
        </div>

        <!-- Avatar superpuesto -->
        <div class="profile-avatar-container">
          <span
            class="profile-avatar-initial"
            hidden={!!profile.photo}
            aria-hidden="true">{initials}</span
          >
          <SiteImage kind="avatar" sizes="88px"
            src={profile.photo || undefined}
            alt={`Foto de ${profile.name}`}
            class="profile-avatar-img"
            loading="eager"
            hidden={!profile.photo}
          />
        </div>

        <!-- Información del Perfil -->
        <div class="profile-hero-body">
          <div class="profile-name-row">
            <h1 class="profile-name">{profile.name}</h1>
          </div>

          <p class="profile-headline-role">{profile.role}</p>

          <div class="profile-meta-info">
            <span class="meta-city">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span data-profile-city>{profile.city}, Bolivia</span>
            </span>
            <span class="meta-sep">•</span>
            <span class="meta-status">
              <span class="status-indicator"></span>
              {profile.availability} (Ley 977)
            </span>
          </div>

          <!-- Botones de Acción Inmediata (Estilo LinkedIn) -->
          <div class="profile-hero-actions">
            {
              own ? (
                <>
                  <ActionButton
                    id="editMyProfile"
                    text="Editar mi perfil"
                    variant="primary"
                  />
                  <ActionButton
                    href="/publicar?kind=service"
                    text="Ofrecer mis servicios"
                    variant="secondary"
                  />
                </>
              ) : (
                <>
                  <ContactRequest
                    recipientId={profileAccount?.id || "talent-" + profile.name}
                    text={
                      application
                        ? "Contactar postulante"
                        : "Consultar disponibilidad"
                    }
                  />
                  <ActionButton
                    href={`mailto:${profile.contact.email}`}
                    text="Enviar correo"
                    variant="secondary"
                    id="profileEmail"
                  />
                </>
              )
            }
          </div>
          <p
            class="demo-caption profile-demo-note"
            data-profile-demo
            hidden={!profile.demo}
          >
            Perfil de demostración.
          </p>
          {own && <ProfileEditor />}
        </div>
      </section>

      <!-- ====================================================
             2. TARJETA ACERCA DE
             ==================================================== -->
      <section class="profile-detail-card" aria-labelledby="about-heading">
        <div class="card-header-row">
          <h2 id="about-heading" class="card-section-title">Acerca de</h2>
        </div>
        <p class="profile-about-paragraph">{profile.about}</p>

        <!-- Highlight Box: Principales aptitudes (Estilo LinkedIn) -->
        <div class="aptitudes-highlight-box">
          <div class="aptitudes-content">
            <span class="aptitudes-label">Principales aptitudes</span>
            <p class="aptitudes-list-preview">
              {profile.skills.slice(0, 4).join(" · ")}
            </p>
          </div>
        </div>
      </section>

      <!-- ====================================================
             3. TARJETA EXPERIENCIA LABORAL
             ==================================================== -->
      <section class="profile-detail-card" aria-labelledby="experience-heading">
        <div class="card-header-row">
          <h2 id="experience-heading" class="card-section-title">
            Experiencia
          </h2>
        </div>

        <div class="experience-list">
          {
            profile.experience.map((exp, index) => (
              <div
                class={`experience-item ${index < profile.experience.length - 1 ? "has-divider" : ""}`}
              >
                <div class="experience-company-icon" aria-hidden="true">
                  <span>{exp.company.charAt(0)}</span>
                </div>

                <div class="experience-details">
                  <h3 class="experience-role">{exp.role}</h3>
                  <p class="experience-company">{exp.company}</p>
                  <span class="experience-period">{exp.period}</span>

                  <ul class="experience-highlights" role="list">
                    {exp.highlights.map((h) => (
                      <li class="highlight-item">
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="highlight-bullet"
                          aria-hidden="true"
                        >
                          <polyline points="20 6 9 17 4 12" />
                        </svg>
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="experience-aptitudes-badge">
                    <span>
                      {profile.skills.slice(0, 3).join(", ")} y más aptitudes
                      aplicadas
                    </span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- ====================================================
             4. TARJETA EDUCACIÓN
             ==================================================== -->
      <section class="profile-detail-card" aria-labelledby="education-heading">
        <div class="card-header-row">
          <h2 id="education-heading" class="card-section-title">Educación</h2>
        </div>

        <div class="education-list">
          {
            profile.education.map((ed, index) => (
              <div
                class={`education-item ${index < profile.education.length - 1 ? "has-divider" : ""}`}
              >
                <div class="education-icon-box" aria-hidden="true">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                    <path d="M6 12v5c3 3 9 3 12 0v-5" />
                  </svg>
                </div>

                <div class="education-details">
                  <h3 class="education-institution">{ed.institution}</h3>
                  <p class="education-degree">{ed.degree}</p>
                  <span class="education-year">{ed.year}</span>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- ====================================================
             5. TARJETA HABILIDADES Y APTITUDES
             ==================================================== -->
      <section class="profile-detail-card" aria-labelledby="skills-heading">
        <div class="card-header-row">
          <h2 id="skills-heading" class="card-section-title">
            Habilidades y Aptitudes
          </h2>
        </div>

        <div class="skills-card-grid">
          {
            profile.skills.map((skill) => (
              <div class="skill-row-item">
                <div class="skill-info">
                  <span class="skill-title-name">{skill}</span>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- ====================================================
             6. TARJETA IDIOMAS Y COMUNICACIÓN INCLUSIVA
             ==================================================== -->
      <section class="profile-detail-card" aria-labelledby="languages-heading">
        <div class="card-header-row">
          <h2 id="languages-heading" class="card-section-title">
            Comunicación e Idiomas
          </h2>
        </div>
        <p class="languages-lead-text">
          Metodologías de coordinación 100% accesibles y efectivas, operadas por
          canales escritos y digitales (WhatsApp, Slack, correo).
        </p>

        <div class="languages-grid">
          {
            profile.languages.map((lang) => (
              <div class="language-pill-item">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lang-check-icon"
                  aria-hidden="true"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>{lang}</span>
              </div>
            ))
          }
        </div>
      </section>

      <section class="profile-detail-card" aria-labelledby="portfolio-heading">
        <h2 id="portfolio-heading" class="card-section-title">
          Muestras de trabajo
        </h2>
        <div id="profilePortfolio">
          {
            profile.projects?.length ? (
              profile.projects.map((project) => (
                <article class="profile-project-card">
                  <>
                    <h3 class="profile-project-title">{project.title}</h3>
                    <p class="profile-project-category">{project.category}</p>
                  </>
                </article>
              ))
            ) : (
              <p class="profile-about-paragraph">
                Sin muestras añadidas todavía.
              </p>
            )
          }
        </div>
      </section>
      <template id="profileProjectTemplate"
        ><article class="profile-project-card">
          <h3 class="profile-project-title"></h3><p
            class="profile-project-category"
          >
          </p>
        </article></template
      >
      <section class="profile-detail-card" id="profileServicesSection" hidden>
        <h2 class="card-section-title">Servicios</h2><ActivityList
          id="profileServices"
        />
      </section>
      {
        own && (
          <section class="profile-detail-card">
            <>
              <h2 class="card-section-title">Consultas recibidas</h2>
              <ActivityList id="profileInquiries" />
            </>
          </section>
        )
      }
      <!-- ====================================================
             7. TARJETA DE COMPARTIR Y GARANTÍA ECO
             ==================================================== -->
      <section
        class="profile-detail-card share-card"
        aria-label="Compartir perfil"
      >
        <div class="share-card-content">
          <div class="share-card-info">
            <div class="share-card-badge">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
              <span>Recomendación Inmediata</span>
            </div>
            <h3 class="share-card-title">
              ¿Deseas compartir este perfil con tu equipo?
            </h3>
            <p class="share-card-desc">
              Facilita la toma de decisiones compartiendo este enlace
              directamente por WhatsApp con RRHH o gerencia.
            </p>
          </div>
          <ExpandableButton
            id="profileShare"
            href={shareUrl}
            target="_blank"
            rel="noopener noreferrer"
            text="Compartir en WhatsApp"
            variant="primary-line"
            size="md"
          />
        </div>
      </section>
    </div>
  </div>
</div>

<style>
  /* ====================================================
     ESTRUCTURA DE PÁGINA (Lienzo Contraste Slate-100)
     ==================================================== */
  .profile-page-wrapper {
    background: linear-gradient(180deg, rgba(var(--color-accent-rgb), 0.25) 0%, var(--color-bg) 420px);
    background-color: var(--color-bg);
    min-height: 100dvh;
    padding-top: calc(var(--app-header-height) + var(--space-8));
    padding-bottom: var(--space-20);
  }

  /* Ancho 1440px (Consistencia con el sistema de tokens) */
  .profile-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* Pila de Tarjetas Modulares */
  .profile-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Tarjeta Base Elevada */
  .profile-detail-card {
    min-width: 0;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: none;
    box-sizing: border-box;
    transition: border-color var(--transition-fast);
  }

  /* Cabecera unificada de cada Tarjeta */
  .card-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .card-section-title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--color-text-main);
    margin: 0;
  }

  /* ====================================================
     1. TARJETA HERO DE CABECERA
     ==================================================== */
  .profile-hero-card {
    padding: 0;
    overflow: hidden;
  }

  .profile-cover-banner {
    width: 100%;
    height: clamp(160px, 18vw, 240px);
    background: var(--color-primary);
    position: relative;
    overflow: hidden;
  }

  .profile-cover-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .profile-avatar-container {
    margin-top: calc(-1 * var(--space-12));
    margin-left: var(--space-8);
    width: var(--space-24);
    height: var(--space-24);
    border-radius: var(--radius-full);
    border: 4px solid var(--color-bg-card);
    overflow: hidden;
    background-color: var(--color-primary);
    position: relative;
    z-index: 2;
    box-shadow: none;
  }

  .profile-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .profile-hero-body {
    padding: var(--space-5) var(--space-8) var(--space-8);
  }

  .profile-name-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-1);
  }

  .profile-name {
    overflow-wrap: anywhere;
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.2;
  }

  .profile-headline-role {
    overflow-wrap: anywhere;
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 var(--space-3) 0;
  }

  .profile-meta-info {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .meta-city {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-city svg {
    color: var(--color-primary);
  }

  .meta-sep {
    color: var(--color-border);
  }

  .meta-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text-main);
    font-weight: 600;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--color-success);
  }

  .profile-hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .profile-hero-actions :global(.contact-request) {
    width: auto;
    max-width: 100%;
  }
  .profile-hero-actions :global(.contact-request:has(form:not([hidden]))) {
    flex-basis: 100%;
  }
  .profile-demo-note {
    margin: var(--space-3) 0 0;
  }

  /* ====================================================
     2. TARJETA ACERCA DE
     ==================================================== */
  .profile-about-paragraph {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-main);
    line-height: 1.7;
    margin: 0 0 var(--space-5) 0;
  }

  .aptitudes-highlight-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .aptitudes-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .aptitudes-label {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .aptitudes-list-preview {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.4;
  }

  /* ====================================================
     3. TARJETA EXPERIENCIA LABORAL
     ==================================================== */
  .experience-list {
    display: flex;
    flex-direction: column;
  }

  .experience-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    padding-block: var(--space-3);
  }

  .experience-item:first-child {
    padding-top: 0;
  }

  .experience-item:last-child {
    padding-bottom: 0;
  }

  .experience-item.has-divider {
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .experience-company-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .experience-details {
    min-width: 0;
    overflow-wrap: anywhere;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .experience-role {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-main);
    margin: 0;
    line-height: 1.3;
  }

  .experience-company {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    font-weight: 500;
  }

  .experience-period {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    margin-bottom: var(--space-2);
  }

  .experience-highlights {
    list-style: none;
    padding: 0;
    margin: var(--space-1) 0 var(--space-3) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-main);
    line-height: 1.5;
  }

  .highlight-bullet {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .experience-aptitudes-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: 500;
    margin-top: var(--space-1);
  }

  /* ====================================================
     4. TARJETA EDUCACIÓN
     ==================================================== */
  .education-list {
    display: flex;
    flex-direction: column;
  }

  .education-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    padding-block: var(--space-3);
  }

  .education-item:first-child {
    padding-top: 0;
  }

  .education-item:last-child {
    padding-bottom: 0;
  }

  .education-item.has-divider {
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .education-icon-box {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .education-details {
    min-width: 0;
    overflow-wrap: anywhere;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .education-institution {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-main);
    margin: 0;
    line-height: 1.3;
  }

  .education-degree {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .education-year {
    font-size: var(--text-xs);
    color: var(--color-text-light);
  }

  /* ====================================================
     5. TARJETA HABILIDADES Y APTITUDES
     ==================================================== */
  .skills-card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .skill-row-item {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .skill-row-item:hover {
    border-color: rgba(var(--color-primary-rgb), 0.35);
