---
import '../../styles/management.css';
import ActionButton from '../ui/ActionButton.astro';
import Icon from '../ui/Icon.astro';
interface Props { id: string; preview?: boolean }
const { id, preview = false } = Astro.props;
---

<div class="publication-list" id={id}></div>
<template id={`${id}Template`}>
  <article class="publication-card">
    <header class="publication-card-top">
      <p class="publication-state-line">
        <span class="publication-state"></span>
        <span class="publication-kind"></span>
      </p>
      {!preview && (
        <ActionButton
          variant="icon"
          size="lg"
          class="publication-menu-trigger"
          ariaLabel="Más opciones de publicación"
          aria-haspopup="menu"
          aria-expanded="false"
        >
          <Icon name="more" size={24} />
        </ActionButton>
      )}
      {!preview && <div class="publication-menu" popover="auto" role="menu"></div>}
    </header>

    <h2 class="publication-title"></h2>
    <ul class="publication-meta" aria-label="Datos de la publicación">
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2Z" /></svg>
        <span class="publication-owner"></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="10" cy="5" rx="7" ry="3" /><path d="M3 5v5c0 1.7 3.1 3 7 3M17 5v5M3 10v5c0 1.7 3.1 3 7 3" /><ellipse cx="16" cy="15" rx="5" ry="2.5" /><path d="M11 15v4c0 1.4 2.2 2.5 5 2.5s5-1.1 5-2.5v-4" /></svg>
        <span class="publication-salary"></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
        <span class="publication-location"></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l4 2" /></svg>
        <span class="publication-delivery"></span>
      </li>
    </ul>

    <p class="publication-description"></p>
    <ul class="publication-tasks" aria-label="Tareas o entregables"></ul>
    {!preview && <footer class="publication-footer"></footer>}
    {!preview && <div class="publication-inquiries"></div>}
  </article>
</template>

<style>
  .publication-list { display: grid; gap: var(--space-5); margin-top: var(--space-6); }
  .publication-card { min-width: 0; padding: var(--workspace-card-padding); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-card); }
  .publication-card-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-4); }
  .publication-state-line { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); margin: 0; font-size: var(--text-base); line-height: 1.5; }
  .publication-state { font-weight: 700; color: var(--color-text-muted); }
  .publication-card[data-status='active'] .publication-state { color: var(--color-primary); }
  .publication-card[data-status='paused'] .publication-state { color: var(--color-warning-text); }
  .publication-kind { color: var(--color-text-muted); }
  .publication-menu-trigger { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: var(--radius-md); background: var(--color-bg-primary-soft); color: var(--color-text-muted); cursor: pointer; }
  .publication-menu-trigger:hover { background: var(--color-bg-alt); color: var(--color-text-main); }
  .publication-menu-trigger:focus-visible { outline: 2px solid var(--color-primary); outline-offset: var(--space-1); }
  .publication-title { color: var(--color-text-main); font-family: var(--font-heading); font-size: var(--text-3xl); font-weight: 800; line-height: 1.25; letter-spacing: -0.025em; margin: 0 0 var(--space-5); overflow-wrap: anywhere; }
  .publication-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-4); padding: 0; margin: 0 0 var(--space-8); list-style: none; color: var(--color-text-muted); font-size: var(--text-base); }
  .publication-meta li { display: flex; align-items: center; gap: var(--space-2); min-width: 0; }
  .publication-meta li + li { padding-inline-start: var(--space-4); border-inline-start: 1px solid var(--color-border); }
  .publication-meta svg { width: 20px; height: 20px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .publication-meta span { overflow-wrap: anywhere; }
  .publication-description { margin: 0 0 var(--space-5); color: var(--color-text-main); font-size: var(--text-base); line-height: 1.65; white-space: pre-line; overflow-wrap: anywhere; }
  .publication-tasks { display: grid; gap: var(--space-1); padding: 0; margin: 0; list-style: none; color: var(--color-text-muted); font-size: var(--text-base); line-height: 1.6; overflow-wrap: anywhere; }
  .publication-tasks:empty { display: none; }
  .publication-footer { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-3); border-top: 1px solid var(--color-border); margin-top: var(--space-6); padding-top: var(--space-5); }
  .publication-card :global(.publication-edit) { min-height: 44px; margin-inline-start: auto; padding-inline: var(--space-3); background: var(--color-bg-primary-soft); color: var(--color-primary); }
  .publication-card :global(.publication-count) { display: inline-flex; align-items: center; justify-content: center; min-width: 24px; min-height: 24px; padding-inline: var(--space-2); border-radius: var(--radius-full); background: var(--color-bg-primary-soft); font-variant-numeric: tabular-nums; }
  .publication-menu { position: fixed; inset: auto; min-width: 200px; max-width: 100%; margin: 0; padding: var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-card); color: var(--color-text-main); }
  .publication-menu :global(.management-action) { display: flex; justify-content: flex-start; width: 100%; min-height: 44px; padding: var(--space-2) var(--space-3); text-align: start; }
  .publication-menu :global(.management-action:hover) { background: var(--color-bg-alt); }
  .publication-menu :global(.management-action--danger) { color: var(--color-error-text); }
  .publication-menu :global(.management-action--danger:hover) { background: var(--color-error-bg); }
  .publication-inquiries { margin-top: var(--space-4); color: var(--color-text-muted); font-size: var(--text-sm); line-height: 1.6; white-space: pre-line; }
  .publication-inquiries:empty { display: none; }
  .publication-inquiries :global(h3) { color: var(--color-text-main); font-size: var(--text-base); font-weight: 600; margin-bottom: var(--space-4); }
  .publication-inquiries :global(.publication-inquiry + .publication-inquiry) { margin-top: var(--space-4); }
  .publication-inquiries :global(.publication-inquiry-meta) { font-size: var(--text-sm); font-weight: 600; color: var(--color-text-muted); margin-bottom: var(--space-2); }
  .publication-inquiries :global(.publication-inquiry-message) { font-size: var(--text-base); color: var(--color-text-main); margin: 0; overflow-wrap: anywhere; }
  @media (max-width: 640px) {
    .publication-meta { display: grid; grid-template-columns: minmax(0, 1fr); }
    .publication-meta li + li { padding-inline-start: 0; border: 0; }
    .publication-footer { display: grid; grid-template-columns: minmax(0, 1fr) auto; }
    .publication-footer :global(.management-action--primary) { grid-column: 1 / -1; }
    .publication-footer :global(.management-action--secondary) { padding-inline: var(--space-3); }
  }
  @media (prefers-reduced-motion: reduce) {
    .publication-card :global(.management-action) { transition: none; }
  }
</style>
