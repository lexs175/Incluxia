---
interface Props {
  href?: string;
  text?: string;
  variant?:
    | "primary"
    | "primary-line"
    | "secondary"
    | "secondary-line"
    | "default"
    | "white"
    | "whatsapp"
    | "white-whatsapp"
    | "accent"
    | "dark"
    | "outline-white";
  size?: "sm" | "md" | "lg";
  class?: string;
  target?: string;
  rel?: string;
  id?: string;
  type?: "button" | "submit" | "reset";
  fullWidth?: boolean;
}

const {
  href,
  text,
  variant = "primary",
  size = "md",
  class: className = "",
  target,
  rel,
  id,
  type = "button",
  fullWidth = false,
  ...rest
} = Astro.props;

// Normalización limpia a las 4 variantes oficiales + variantes funcionales
let variantClass = "btn-primary";
if (variant === "primary-line") {
  variantClass = "btn-primary-line";
} else if (variant === "secondary" || variant === "white") {
  variantClass = "btn-secondary";
} else if (variant === "secondary-line" || variant === "outline-white") {
  variantClass = "btn-secondary-line";
} else if (variant === "whatsapp") {
  variantClass = "btn-whatsapp";
} else if (variant === "white-whatsapp") {
  variantClass = "btn-white-whatsapp";
} else {
  variantClass = "btn-primary"; // default, primary, dark, accent
}

const sizeClass =
  size === "sm" ? "btn-sm" : size === "lg" ? "btn-lg" : "btn-md";
const fullWidthClass = fullWidth ? "btn-block" : "";
const combinedClasses =
  `modular-btn trustly-expand-btn ${variantClass} ${sizeClass} ${fullWidthClass} ${className}`.trim();
const ariaLabel = text || undefined;
---

{
  href ? (
    <a
      href={href}
      class={combinedClasses}
      id={id}
      target={target}
      rel={rel}
      aria-label={ariaLabel}
      {...rest}
    >
      <!-- Main Text Capsule (Posición fija continua, cero layout shift) -->
      <span class="btn-text-capsule">
        <span class="btn-text-label">{text ? text : <slot />}</span>
      </span>

      <!-- Right Companion Badge with Directional Arrow -->
      <span class="btn-badge btn-badge--right" aria-hidden="true">
        <span class="btn-badge-inner">
          <svg
            class="btn-arrow-svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="13 6 19 12 13 18"></polyline>
          </svg>
        </span>
      </span>
    </a>
  ) : (
    <button
      type={type}
      class={combinedClasses}
      id={id}
      aria-label={ariaLabel}
      {...rest}
    >
      <!-- Main Text Capsule (Posición fija continua, cero layout shift) -->
      <span class="btn-text-capsule">
        <span class="btn-text-label">{text ? text : <slot />}</span>
      </span>

      <!-- Right Companion Badge with Directional Arrow -->
      <span class="btn-badge btn-badge--right" aria-hidden="true">
        <span class="btn-badge-inner">
          <svg
            class="btn-arrow-svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="13 6 19 12 13 18"></polyline>
          </svg>
        </span>
      </span>
    </button>
  )
}

<style>
  /* ====================================================
     MODULAR BUTTON (Ultra-Rendimiento GPU, Cero Reflow)
     Estructura: [ Text Capsule ] [ Companion Badge ↗ ]
     Hover:       [ Text Capsule ] [ Companion Badge → ]
     - Anchos y márgenes 100% constantes en todo momento
     - Cero desplazamiento o salto en elementos contiguos
     - Animación por GPU pura (transform/opacity) a 60/120 FPS
     ==================================================== */
  .modular-btn {
    --btn-speed: var(--transition-fast);
    --btn-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --btn-h: 2.85em;
    --btn-gap: 0.14em;
    --btn-radius: var(--radius-md);
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    user-select: none;
    vertical-align: middle;
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1;
    transform: translateY(0);
    transition: transform var(--btn-speed) var(--btn-ease);
    will-change: transform;
    -webkit-font-smoothing: antialiased;
  }

  /* Control de tamaño fluido únicamente con font-size */
  .btn-sm { font-size: var(--text-xs); }
  .btn-md { font-size: var(--text-sm); }
  .btn-lg { font-size: var(--text-base); }

  .btn-block {
    width: 100%;
    display: flex;
  }
  .btn-block .btn-text-capsule {
    flex: 1;
  }

  /* Cápsula de texto: dimensiones estrictas, sin desplazamientos laterales */
  .btn-text-capsule {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--btn-h);
    padding-inline: 1.25em;
    border-radius: var(--btn-radius);
    letter-spacing: -0.01em;
    white-space: nowrap;
    box-sizing: border-box;
    transition:
      background-color var(--btn-speed) var(--btn-ease),
      border-color var(--btn-speed) var(--btn-ease),
      color var(--btn-speed) var(--btn-ease);
  }

  .btn-text-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
  }

  /* Slot de badge: ancho estricto fijo, CERO animación de width/margin */
  .btn-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--btn-h);
    height: var(--btn-h);
    margin-left: var(--btn-gap);
    flex-shrink: 0;
    pointer-events: auto;
  }

  /* Cuadrado visual 1:1 proporcional en 'em' con micro-escala fluida */
  .btn-badge-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: var(--btn-radius);
    transform-origin: center center;
    box-sizing: border-box;
    transition:
      transform var(--btn-speed) var(--btn-ease),
      background-color var(--btn-speed) var(--btn-ease),
      border-color var(--btn-speed) var(--btn-ease);
    will-change: transform;
  }

  /* Flecha con aceleración GPU: reposo a 45° */
  .btn-arrow-svg {
    display: block;
    width: 1.1em;
    height: 1.1em;
    transform-origin: center center;
    transform: rotate(45deg);
    transition: transform var(--btn-speed) var(--btn-ease);
    will-change: transform;
  }

  /* ====================================================
     4 VARIANTES OFICIALES (Tokens Semánticos Estrictos)
     ==================================================== */

  /* 1. Primary (Fill Azul) */
  .btn-primary .btn-text-capsule {
    background-color: var(--color-bg-primary);
    border: 1.5px solid transparent;
    color: var(--color-text-inverse);
  }
  .btn-primary .btn-badge-inner {
    background-color: var(--color-bg-primary);
    border: 1.5px solid transparent;
    color: var(--color-text-inverse);
  }

  /* 2. Primary Line (Línea Azul) */
  .btn-primary-line .btn-text-capsule {
    background-color: transparent;
    border: 1.5px solid var(--color-border-primary);
    color: var(--color-text-primary);
  }
  .btn-primary-line .btn-badge-inner {
    background-color: transparent;
    border: 1.5px solid var(--color-border-primary);
    color: var(--color-text-primary);
  }

  /* 3. Secondary (Fill Blanco) */
  .btn-secondary .btn-text-capsule {
    background-color: var(--color-bg-white);
    border: 1.5px solid transparent;
    color: var(--color-text-primary);
  }
  .btn-secondary .btn-badge-inner {
    background-color: var(--color-bg-white);
    border: 1.5px solid transparent;
    color: var(--color-text-primary);
  }

  /* 4. Secondary Line (Línea Blanca) */
  .btn-secondary-line .btn-text-capsule {
    background-color: transparent;
    border: 1.5px solid var(--color-border-white);
    color: var(--color-text-inverse);
  }
  .btn-secondary-line .btn-badge-inner {
    background-color: transparent;
    border: 1.5px solid var(--color-border-white);
    color: var(--color-text-inverse);
  }

  /* Variantes Funcionales (WhatsApp) */
  .btn-whatsapp .btn-text-capsule {
    background-color: var(--color-bg-primary);
    border: 1.5px solid transparent;
    color: var(--color-text-inverse);
  }
  .btn-whatsapp .btn-badge-inner {
    background-color: var(--color-whatsapp);
    border: 1.5px solid transparent;
    color: var(--color-text-inverse);
  }

  .btn-white-whatsapp .btn-text-capsule {
    background-color: var(--color-bg-white);
    border: 1.5px solid transparent;
    color: var(--color-text-primary);
  }
  .btn-white-whatsapp .btn-badge-inner {
    background-color: var(--color-whatsapp);
    border: 1.5px solid transparent;
    color: var(--color-text-inverse);
  }

  /* ====================================================
     HOVER & FOCUS STATES (100% GPU Transform, 0 Layout Shift)
     ==================================================== */
  @media (hover: hover) and (pointer: fine) {
    .modular-btn:hover,
    .modular-btn:focus-visible,
    :global(.job-card:hover) .modular-btn,
    :global(.profile-card:hover) .modular-btn,
    :global(.story-card:hover) .modular-btn,
    :global(.blog-card:hover) .modular-btn,
    :global(.bento-card:hover) .modular-btn {
      transform: translateY(-2px);
    }

    .modular-btn:hover .btn-arrow-svg,
    .modular-btn:focus-visible .btn-arrow-svg,
    :global(.job-card:hover) .modular-btn .btn-arrow-svg,
    :global(.profile-card:hover) .modular-btn .btn-arrow-svg,
    :global(.story-card:hover) .modular-btn .btn-arrow-svg,
    :global(.blog-card:hover) .modular-btn .btn-arrow-svg,
    :global(.bento-card:hover) .modular-btn .btn-arrow-svg {
      transform: rotate(0deg) translateX(3px);
    }

    .modular-btn:hover .btn-badge-inner,
    .modular-btn:focus-visible .btn-badge-inner,
    :global(.job-card:hover) .modular-btn .btn-badge-inner,
    :global(.profile-card:hover) .modular-btn .btn-badge-inner,
    :global(.story-card:hover) .modular-btn .btn-badge-inner,
    :global(.blog-card:hover) .modular-btn .btn-badge-inner,
    :global(.bento-card:hover) .modular-btn .btn-badge-inner {
      transform: scale(1.05);
    }

    /* Primary hover */
    .btn-primary:hover .btn-text-capsule,
    .btn-primary:hover .btn-badge-inner {
      background-color: var(--color-primary-hover);
    }

    /* Secondary hover */
    .btn-secondary:hover .btn-text-capsule,
    .btn-secondary:hover .btn-badge-inner {
      background-color: var(--color-white);
      color: var(--color-primary-dark);
    }

    /* Primary line hover */
    .btn-primary-line:hover .btn-text-capsule,
    .btn-primary-line:hover .btn-badge-inner {
      border-color: var(--color-primary);
      background-color: rgba(var(--color-primary-rgb), 0.06);
    }

    /* Secondary line hover */
    .btn-secondary-line:hover .btn-text-capsule,
    .btn-secondary-line:hover .btn-badge-inner {
      border-color: var(--color-white);
      background-color: rgba(var(--white-rgb), 0.12);
    }
  }

  .modular-btn:active {
    transform: translateY(0) scale(0.98);
  }

  .modular-btn:focus-visible {
    outline: 2px solid var(--color-border-primary);
    outline-offset: 3px;
    border-radius: var(--btn-radius);
  }

  @media (prefers-reduced-motion: reduce) {
    .modular-btn,
    .btn-badge,
    .btn-badge-inner,
    .btn-text-capsule,
    .btn-arrow-svg {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
