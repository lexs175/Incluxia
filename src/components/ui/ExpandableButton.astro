---
interface Props {
  href?: string;
  text?: string;
  variant?: "default" | "white" | "whatsapp" | "white-whatsapp" | "accent" | "dark" | "primary" | "outline-white";
  size?: "sm" | "md" | "lg";
  class?: string;
  target?: string;
  rel?: string;
  id?: string;
  type?: "button" | "submit" | "reset";
  fullWidth?: boolean;
}

const {
  href,
  text,
  variant = "default",
  size = "md",
  class: className = "",
  target,
  rel,
  id,
  type = "button",
  fullWidth = false,
  ...rest
} = Astro.props;

// Soporte para cápsula blanca en secciones oscuras
const isWhite = variant === "white" || variant === "white-whatsapp" || variant === "outline-white";
const isWhatsapp = variant === "whatsapp" || variant === "white-whatsapp";

const variantClass = isWhite
  ? (isWhatsapp ? "btn-white-whatsapp" : "btn-white")
  : (isWhatsapp ? "btn-whatsapp" : "btn-default");

const sizeClass =
  size === "sm" ? "btn-sm" : size === "lg" ? "btn-lg" : "btn-md";
const fullWidthClass = fullWidth ? "btn-block" : "";
const combinedClasses =
  `modular-btn trustly-expand-btn ${variantClass} ${sizeClass} ${fullWidthClass} ${className}`.trim();
const ariaLabel = text || undefined;
---

{
  href ? (
    <a
      href={href}
      class={combinedClasses}
      id={id}
      target={target}
      rel={rel}
      aria-label={ariaLabel}
      {...rest}
    >
      <!-- Left Badge Slot: Escala a 1 en hover desktop -->
      <span class="btn-badge btn-badge--left" aria-hidden="true">
        <span class="btn-badge-inner">
          <svg
            class="btn-arrow-svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="13 6 19 12 13 18"></polyline>
          </svg>
        </span>
      </span>

      <!-- Main Text Capsule -->
      <span class="btn-text-capsule">
        <span class="btn-text-label">{text ? text : <slot />}</span>
      </span>

      <!-- Right Badge Slot: Visible en reposo, escala a 0 en hover -->
      <span class="btn-badge btn-badge--right" aria-hidden="true">
        <span class="btn-badge-inner">
          <svg
            class="btn-arrow-svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="13 6 19 12 13 18"></polyline>
          </svg>
        </span>
      </span>
    </a>
  ) : (
    <button
      type={type}
      class={combinedClasses}
      id={id}
      aria-label={ariaLabel}
      {...rest}
    >
      <!-- Left Badge Slot: Escala a 1 en hover desktop -->
      <span class="btn-badge btn-badge--left" aria-hidden="true">
        <span class="btn-badge-inner">
          <svg
            class="btn-arrow-svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="13 6 19 12 13 18"></polyline>
          </svg>
        </span>
      </span>

      <!-- Main Text Capsule -->
      <span class="btn-text-capsule">
        <span class="btn-text-label">{text ? text : <slot />}</span>
      </span>

      <!-- Right Badge Slot: Visible en reposo, escala a 0 en hover -->
      <span class="btn-badge btn-badge--right" aria-hidden="true">
        <span class="btn-badge-inner">
          <svg
            class="btn-arrow-svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="13 6 19 12 13 18"></polyline>
          </svg>
        </span>
      </span>
    </button>
  )
}

<style>
  /* ====================================================
     MODULAR BUTTON (Solo 2 variantes, escala proporcional con 'em')
     Normal: [ Text Capsule ] [ Badge ↘ ]
     Hover:  [ Badge → ] [ Text Capsule ]
     ==================================================== */
  .modular-btn {
    --btn-speed: 0.5s;
    --btn-h: 2.85em;
    --btn-gap: 0.12em;
    --btn-radius: 0.4em;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    text-decoration: none;
    cursor: pointer;
    box-shadow: none;
    border: none;
    background: transparent;
    padding: 0;
    position: relative;
    user-select: none;
    vertical-align: middle;
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1;
  }

  /* Control de tamaño fluido únicamente con font-size */
  .btn-sm { font-size: var(--text-xs); }
  .btn-md { font-size: var(--text-sm); }
  .btn-lg { font-size: var(--text-base); }

  .btn-block {
    width: 100%;
    display: flex;
  }
  .btn-block .btn-text-capsule {
    flex: 1;
  }

  /* Cápsula de texto (Fondo azul marino primario, texto blanco) */
  .btn-text-capsule {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--btn-h);
    padding-inline: 1.25em;
    border-radius: var(--btn-radius);
    letter-spacing: -0.01em;
    white-space: nowrap;
    background-color: var(--color-primary);
    color: var(--color-white);
    transition: background-color var(--transition-fast);
  }

  .btn-text-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
  }

  /* Slot de layout (Controla el espacio flex sin recortar) */
  .btn-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--btn-h);
    overflow: visible;
    flex-shrink: 0;
    transition:
      width var(--btn-speed) cubic-bezier(0.16, 1, 0.3, 1),
      max-width var(--btn-speed) cubic-bezier(0.16, 1, 0.3, 1),
      margin var(--btn-speed) cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Cuadrado visual 1:1 proporcional en 'em' */
  .btn-badge-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--btn-h);
    height: var(--btn-h);
    min-width: var(--btn-h);
    border-radius: var(--btn-radius);
    transform-origin: center center;
    color: var(--color-white);
    transition:
      transform var(--btn-speed) cubic-bezier(0.16, 1, 0.3, 1),
      opacity calc(var(--btn-speed) * 0.75) cubic-bezier(0.16, 1, 0.3, 1),
      background-color var(--transition-fast);
  }

  .btn-arrow-svg {
    display: block;
    width: 1.1em;
    height: 1.1em;
    transform-origin: center center;
    transition: transform var(--btn-speed) cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Reposo: Izquierdo oculto (escala 0) */
  .btn-badge--left {
    width: 0;
    max-width: 0;
    margin-right: 0;
    pointer-events: none;
  }
  .btn-badge--left .btn-badge-inner {
    opacity: 0;
    transform: scale(0);
  }
  .btn-badge--left .btn-arrow-svg {
    transform: rotate(0deg);
  }

  /* Reposo: Derecho visible (flecha 45° ↘) */
  .btn-badge--right {
    width: var(--btn-h);
    max-width: var(--btn-h);
    margin-left: var(--btn-gap);
    pointer-events: auto;
  }
  .btn-badge--right .btn-badge-inner {
    opacity: 1;
    transform: scale(1);
  }
  .btn-badge--right .btn-arrow-svg {
    transform: rotate(45deg);
  }

  /* ====================================================
     4 VARIANTES DE COLOR OFICIALES
     ==================================================== */

  /* --- GRUPO 1: CÁPSULA AZUL NAVY (var(--color-primary)) --- */

  /* 1. Default: Cápsula Navy + Arrow Naranja Accent */
  .btn-default .btn-text-capsule {
    background-color: var(--color-primary);
    color: var(--color-white);
  }
  .btn-default .btn-badge-inner {
    background-color: var(--color-accent);
  }

  /* 2. WhatsApp: Cápsula Navy + Arrow Verde WhatsApp */
  .btn-whatsapp .btn-text-capsule {
    background-color: var(--color-primary);
    color: var(--color-white);
  }
  .btn-whatsapp .btn-badge-inner {
    background-color: var(--color-whatsapp);
  }

  /* --- GRUPO 2: CÁPSULA BLANCA (var(--color-white)) --- */

  /* 3. White: Cápsula Blanca + Texto Navy + Arrow Naranja Accent */
  .btn-white .btn-text-capsule {
    background-color: var(--color-white);
    color: var(--color-primary);
  }
  .btn-white .btn-badge-inner {
    background-color: var(--color-accent);
  }

  /* 4. White WhatsApp: Cápsula Blanca + Texto Navy + Arrow Verde WhatsApp */
  .btn-white-whatsapp .btn-text-capsule {
    background-color: var(--color-white);
    color: var(--color-primary);
  }
  .btn-white-whatsapp .btn-badge-inner {
    background-color: var(--color-whatsapp);
  }

  /* ====================================================
     HOVER (Solo en pantallas con cursor/mouse)
     ==================================================== */
  @media (hover: hover) and (pointer: fine) {
    /* Hover cápsulas Navy: pasan a primary-hover */
    .btn-default:hover .btn-text-capsule,
    .btn-default:focus-visible .btn-text-capsule,
    .btn-whatsapp:hover .btn-text-capsule,
    .btn-whatsapp:focus-visible .btn-text-capsule,
    :global(.job-card:hover) .btn-default .btn-text-capsule,
    :global(.profile-card:hover) .btn-default .btn-text-capsule,
    :global(.story-card:hover) .btn-default .btn-text-capsule,
    :global(.blog-card:hover) .btn-default .btn-text-capsule,
    :global(.bento-card:hover) .btn-default .btn-text-capsule {
      background-color: var(--color-primary-hover);
      color: var(--color-white);
    }

    /* Hover cápsulas Blancas: pasan a bg-alt sutil manteniendo texto navy */
    .btn-white:hover .btn-text-capsule,
    .btn-white:focus-visible .btn-text-capsule,
    .btn-white-whatsapp:hover .btn-text-capsule,
    .btn-white-whatsapp:focus-visible .btn-text-capsule,
    :global(.story-card:hover) .btn-white .btn-text-capsule,
    :global(.profile-card:hover) .btn-white .btn-text-capsule {
      background-color: var(--color-bg-alt);
      color: var(--color-primary);
    }

    /* Los badges mantienen sus colores puros (cero accent-light) */
    .btn-default:hover .btn-badge-inner,
    .btn-white:hover .btn-badge-inner {
      background-color: var(--color-accent);
    }

    .btn-whatsapp:hover .btn-badge-inner,
    .btn-whatsapp:focus-visible .btn-badge-inner,
    .btn-white-whatsapp:hover .btn-badge-inner,
    .btn-white-whatsapp:focus-visible .btn-badge-inner {
      background-color: var(--color-whatsapp);
    }

    /* Left badge abre a 1 */
    .modular-btn:hover .btn-badge--left,
    .modular-btn:focus-visible .btn-badge--left,
    :global(.job-card:hover) .modular-btn .btn-badge--left,
    :global(.profile-card:hover) .modular-btn .btn-badge--left,
    :global(.story-card:hover) .modular-btn .btn-badge--left,
    :global(.blog-card:hover) .modular-btn .btn-badge--left,
    :global(.bento-card:hover) .modular-btn .btn-badge--left {
      width: var(--btn-h);
      max-width: var(--btn-h);
      margin-right: var(--btn-gap);
      pointer-events: auto;
    }
    .modular-btn:hover .btn-badge--left .btn-badge-inner,
    .modular-btn:focus-visible .btn-badge--left .btn-badge-inner,
    :global(.job-card:hover) .modular-btn .btn-badge--left .btn-badge-inner,
    :global(.profile-card:hover) .modular-btn .btn-badge--left .btn-badge-inner,
    :global(.story-card:hover) .modular-btn .btn-badge--left .btn-badge-inner,
    :global(.blog-card:hover) .modular-btn .btn-badge--left .btn-badge-inner,
    :global(.bento-card:hover) .modular-btn .btn-badge--left .btn-badge-inner {
      opacity: 1;
      transform: scale(1);
    }
    .modular-btn:hover .btn-badge--left .btn-arrow-svg,
    .modular-btn:focus-visible .btn-badge--left .btn-arrow-svg,
    :global(.job-card:hover) .modular-btn .btn-badge--left .btn-arrow-svg,
    :global(.profile-card:hover) .modular-btn .btn-badge--left .btn-arrow-svg,
    :global(.story-card:hover) .modular-btn .btn-badge--left .btn-arrow-svg,
    :global(.blog-card:hover) .modular-btn .btn-badge--left .btn-arrow-svg,
    :global(.bento-card:hover) .modular-btn .btn-badge--left .btn-arrow-svg {
      transform: rotate(0deg);
    }

    /* Right badge cierra a 0 */
    .modular-btn:hover .btn-badge--right,
    .modular-btn:focus-visible .btn-badge--right,
    :global(.job-card:hover) .modular-btn .btn-badge--right,
    :global(.profile-card:hover) .modular-btn .btn-badge--right,
    :global(.story-card:hover) .modular-btn .btn-badge--right,
    :global(.blog-card:hover) .modular-btn .btn-badge--right,
    :global(.bento-card:hover) .modular-btn .btn-badge--right {
      width: 0;
      max-width: 0;
      margin-left: 0;
      pointer-events: none;
    }
    .modular-btn:hover .btn-badge--right .btn-badge-inner,
    .modular-btn:focus-visible .btn-badge--right .btn-badge-inner,
    :global(.job-card:hover) .modular-btn .btn-badge--right .btn-badge-inner,
    :global(.profile-card:hover) .modular-btn .btn-badge--right .btn-badge-inner,
    :global(.story-card:hover) .modular-btn .btn-badge--right .btn-badge-inner,
    :global(.blog-card:hover) .modular-btn .btn-badge--right .btn-badge-inner,
    :global(.bento-card:hover) .modular-btn .btn-badge--right .btn-badge-inner {
      opacity: 0;
      transform: scale(0);
    }
    .modular-btn:hover .btn-badge--right .btn-arrow-svg,
    .modular-btn:focus-visible .btn-badge--right .btn-arrow-svg,
    :global(.job-card:hover) .modular-btn .btn-badge--right .btn-arrow-svg,
    :global(.profile-card:hover) .modular-btn .btn-badge--right .btn-arrow-svg,
    :global(.story-card:hover) .modular-btn .btn-badge--right .btn-arrow-svg,
    :global(.blog-card:hover) .modular-btn .btn-badge--right .btn-arrow-svg,
    :global(.bento-card:hover) .modular-btn .btn-badge--right .btn-arrow-svg {
      transform: rotate(0deg);
    }
  }

  .modular-btn:active {
    transform: scale(0.97);
  }

  .modular-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: var(--btn-radius);
  }

  @media (prefers-reduced-motion: reduce) {
    .modular-btn,
    .btn-badge,
    .btn-badge-inner,
    .btn-text-capsule,
    .btn-arrow-svg {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
