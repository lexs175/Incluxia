---
interface Props {
  href?: string;
  text?: string;
  variant?:
    | "primary"
    | "primary-line"
    | "secondary"
    | "secondary-line"
    | "default"
    | "white"
    | "whatsapp"
    | "white-whatsapp"
    | "accent"
    | "dark"
    | "outline-white";
  size?: "sm" | "md" | "lg";
  class?: string;
  target?: string;
  rel?: string;
  id?: string;
  type?: "button" | "submit" | "reset";
  fullWidth?: boolean;
  leading?: boolean;
}

const {
  href,
  text,
  variant = "primary",
  size = "md",
  class: className = "",
  target,
  rel,
  id,
  type = "button",
  fullWidth = false,
  leading = false,
  ...rest
} = Astro.props;

// Normalización limpia a las 4 variantes oficiales + variantes funcionales
let variantClass = "btn-primary";
if (variant === "primary-line") {
  variantClass = "btn-primary-line";
} else if (variant === "secondary" || variant === "white") {
  variantClass = "btn-secondary";
} else if (variant === "secondary-line" || variant === "outline-white") {
  variantClass = "btn-secondary-line";
} else if (variant === "whatsapp") {
  variantClass = "btn-whatsapp";
} else if (variant === "white-whatsapp") {
  variantClass = "btn-white-whatsapp";
} else {
  variantClass = "btn-primary"; // default, primary, dark, accent
}

const sizeClass =
  size === "sm" ? "btn-sm" : size === "lg" ? "btn-lg" : "btn-md";
const fullWidthClass = fullWidth ? "btn-block" : "";
const combinedClasses =
  `modular-btn trustly-expand-btn ${variantClass} ${sizeClass} ${fullWidthClass} ${leading ? "btn-leading" : ""} ${className}`.trim();
const ariaLabel = text || undefined;
---

{
  href ? (
    <a
      href={href}
      class={combinedClasses}
      id={id}
      target={target}
      rel={rel}
      aria-label={ariaLabel}
      {...rest}
    >
      <!-- Left Companion Badge (Aparece a la izquierda en hover) -->
      <span class="btn-badge btn-badge--left" aria-hidden="true">
        <span class="btn-badge-inner">
          <slot name="arrow"><svg
            class="btn-arrow-svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="13 6 19 12 13 18"></polyline>
          </svg></slot>
        </span>
      </span>

      <!-- Main Text Capsule -->
      <span class="btn-text-capsule">
        <span class="btn-text-label">{text ? text : <slot />}</span>
      </span>

      <!-- Right Companion Badge (Visible en reposo, se encoge en hover) -->
      <span class="btn-badge btn-badge--right" aria-hidden="true">
        <span class="btn-badge-inner">
          <slot name="arrow"><svg
            class="btn-arrow-svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="13 6 19 12 13 18"></polyline>
          </svg></slot>
        </span>
      </span>
    </a>
  ) : (
    <button
      type={type}
      class={combinedClasses}
      id={id}
      aria-label={ariaLabel}
      {...rest}
    >
      <!-- Left Companion Badge (Aparece a la izquierda en hover) -->
      <span class="btn-badge btn-badge--left" aria-hidden="true">
        <span class="btn-badge-inner">
          <slot name="arrow"><svg
            class="btn-arrow-svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="13 6 19 12 13 18"></polyline>
          </svg></slot>
        </span>
      </span>

      <!-- Main Text Capsule -->
      <span class="btn-text-capsule">
        <span class="btn-text-label">{text ? text : <slot />}</span>
      </span>

      <!-- Right Companion Badge (Visible en reposo, se encoge en hover) -->
      <span class="btn-badge btn-badge--right" aria-hidden="true">
        <span class="btn-badge-inner">
          <slot name="arrow"><svg
            class="btn-arrow-svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="13 6 19 12 13 18"></polyline>
          </svg></slot>
        </span>
      </span>
    </button>
  )
}

<style>
  /* ====================================================
     MODULAR BUTTON (4 Variantes Oficiales + Funcionales)
     Reposo: [ Text Capsule ] [ Badge ↘ ]
     Hover:  [ Badge → ] [ Text Capsule ]
     ==================================================== */
  .modular-btn {
    --btn-speed: 0.45s;
    --btn-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --btn-h: 2.85em;
    --btn-gap: 0.14em;
    --btn-radius: var(--radius-md);
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    user-select: none;
    vertical-align: middle;
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1;
    transform: translateY(0);
    transition: transform var(--btn-speed) var(--btn-ease);
    will-change: transform;
    -webkit-font-smoothing: antialiased;
  }

  /* Control de tamaño fluido únicamente con font-size */
  .btn-sm { font-size: var(--text-xs); }
  .btn-md { font-size: var(--text-sm); }
  .btn-lg { font-size: var(--text-base); }

  .btn-block {
    width: 100%;
    display: flex;
  }
  .btn-block .btn-text-capsule {
    flex: 1;
  }

  /* Cápsula de texto */
  .btn-text-capsule {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--btn-h);
    padding-inline: 1.25em;
    border-radius: var(--btn-radius);
    letter-spacing: -0.01em;
    white-space: nowrap;
    box-sizing: border-box;
    transition:
      background-color var(--btn-speed) var(--btn-ease),
      border-color var(--btn-speed) var(--btn-ease),
      color var(--btn-speed) var(--btn-ease);
  }

  .btn-text-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
  }

  /* Slot de layout */
  .btn-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--btn-h);
    overflow: visible;
    flex-shrink: 0;
    transition:
      width var(--btn-speed) var(--btn-ease),
      max-width var(--btn-speed) var(--btn-ease),
      margin var(--btn-speed) var(--btn-ease);
  }

  /* Cuadrado visual 1:1 proporcional en 'em' */
  .btn-badge-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--btn-h);
    height: var(--btn-h);
    min-width: var(--btn-h);
    border-radius: var(--btn-radius);
    transform-origin: center center;
    box-sizing: border-box;
    transition:
      transform var(--btn-speed) var(--btn-ease),
      opacity calc(var(--btn-speed) * 0.75) var(--btn-ease),
      background-color var(--btn-speed) var(--btn-ease),
      border-color var(--btn-speed) var(--btn-ease);
    will-change: transform, opacity;
  }

  /* Flecha SVG */
  .btn-arrow-svg {
    display: block;
    width: 1.1em;
    height: 1.1em;
    transform-origin: center center;
    transition: transform var(--btn-speed) var(--btn-ease);
    will-change: transform;
  }

  /* Reposo: Izquierdo oculto (escala 0, ancho 0) */
  .btn-badge--left {
    width: 0;
    max-width: 0;
    margin-right: 0;
    pointer-events: none;
  }
  .btn-badge--left .btn-badge-inner {
    opacity: 0;
    transform: scale(0);
  }
  .btn-badge--left .btn-arrow-svg {
    transform: rotate(0deg);
  }

  /* Reposo: Derecho visible (flecha 45° ↘) */
  .btn-badge--right {
    width: var(--btn-h);
    max-width: var(--btn-h);
    margin-left: var(--btn-gap);
    pointer-events: auto;
  }
  .btn-badge--right .btn-badge-inner {
    opacity: 1;
    transform: scale(1);
  }
  .btn-badge--right .btn-arrow-svg {
    transform: rotate(45deg);
  }

  /* ====================================================
     4 VARIANTES OFICIALES (Tokens Semánticos Estrictos)
     ==================================================== */

  .modular-btn.btn-leading .btn-badge--left { width: var(--btn-h); max-width: var(--btn-h); margin-right: var(--btn-gap); }
  .modular-btn.btn-leading .btn-badge--left .btn-badge-inner { opacity: 1; transform: scale(1); }
  .modular-btn.btn-leading .btn-badge--right { width: 0; max-width: 0; margin-left: 0; }
  .modular-btn.btn-leading .btn-badge--right .btn-badge-inner { opacity: 0; transform: scale(0); }

  /* 1. Primary (Fill Azul) */
  .btn-primary .btn-text-capsule {
    background-color: var(--color-bg-primary);
    border: 1.5px solid transparent;
    color: var(--color-text-inverse);
  }
  .btn-primary .btn-badge-inner {
    background-color: var(--color-bg-primary);
    border: 1.5px solid transparent;
    color: var(--color-text-inverse);
  }

  /* 2. Primary Line (Línea Azul) */
  .btn-primary-line .btn-text-capsule {
    background-color: transparent;
    border: 1.5px solid var(--color-border-primary);
    color: var(--color-text-primary);
  }
  .btn-primary-line .btn-badge-inner {
    background-color: transparent;
    border: 1.5px solid var(--color-border-primary);
    color: var(--color-text-primary);
  }

  /* 3. Secondary (Fill Blanco) */
  .btn-secondary .btn-text-capsule {
    background-color: var(--color-bg-white);
    border: 1.5px solid transparent;
    color: var(--color-text-primary);
  }
  .btn-secondary .btn-badge-inner {
    background-color: var(--color-bg-white);
    border: 1.5px solid transparent;
    color: var(--color-text-primary);
  }

  /* 4. Secondary Line (Línea Blanca) */
  .btn-secondary-line .btn-text-capsule {
    background-color: transparent;
    border: 1.5px solid var(--color-border-white);
    color: var(--color-text-inverse);
  }
  .btn-secondary-line .btn-badge-inner {
    background-color: transparent;
    border: 1.5px solid var(--color-border-white);
    color: var(--color-text-inverse);
  }

  /* Variantes Funcionales (WhatsApp) */
  .btn-whatsapp .btn-text-capsule {
    background-color: var(--color-bg-primary);
    border: 1.5px solid transparent;
    color: var(--color-text-inverse);
  }
  .btn-whatsapp .btn-badge-inner {
    background-color: var(--color-whatsapp);
    border: 1.5px solid transparent;
    color: var(--color-text-inverse);
  }

  .btn-white-whatsapp .btn-text-capsule {
    background-color: var(--color-bg-white);
    border: 1.5px solid transparent;
    color: var(--color-text-primary);
  }
  .btn-white-whatsapp .btn-badge-inner {
    background-color: var(--color-whatsapp);
    border: 1.5px solid transparent;
    color: var(--color-text-inverse);
  }

  /* ====================================================
     HOVER & FOCUS STATES
     ==================================================== */
  @media (hover: hover) and (pointer: fine) {
    .modular-btn:hover,
    .modular-btn:focus-visible,
    :global(.job-card:hover) .modular-btn,
    :global(.profile-card:hover) .modular-btn,
    :global(.story-card:hover) .modular-btn,
    :global(.blog-card:hover) .modular-btn,
    :global(.bento-card:hover) .modular-btn,
    :global(.category-rubro-card:hover) .modular-btn {
      transform: translateY(-2px);
    }

    /* Left badge abre a 1 (aparece atrás/izquierda) */
    .modular-btn:hover .btn-badge--left,
    .modular-btn:focus-visible .btn-badge--left,
    :global(.job-card:hover) .modular-btn .btn-badge--left,
    :global(.profile-card:hover) .modular-btn .btn-badge--left,
    :global(.story-card:hover) .modular-btn .btn-badge--left,
    :global(.blog-card:hover) .modular-btn .btn-badge--left,
    :global(.bento-card:hover) .modular-btn .btn-badge--left,
    :global(.category-rubro-card:hover) .modular-btn .btn-badge--left {
      width: var(--btn-h);
      max-width: var(--btn-h);
      margin-right: var(--btn-gap);
      pointer-events: auto;
    }
    .modular-btn:hover .btn-badge--left .btn-badge-inner,
    .modular-btn:focus-visible .btn-badge--left .btn-badge-inner,
    :global(.job-card:hover) .modular-btn .btn-badge--left .btn-badge-inner,
    :global(.profile-card:hover) .modular-btn .btn-badge--left .btn-badge-inner,
    :global(.story-card:hover) .modular-btn .btn-badge--left .btn-badge-inner,
    :global(.blog-card:hover) .modular-btn .btn-badge--left .btn-badge-inner,
    :global(.bento-card:hover) .modular-btn .btn-badge--left .btn-badge-inner,
    :global(.category-rubro-card:hover) .modular-btn .btn-badge--left .btn-badge-inner {
      opacity: 1;
      transform: scale(1);
    }
    .modular-btn:hover .btn-badge--left .btn-arrow-svg,
    .modular-btn:focus-visible .btn-badge--left .btn-arrow-svg,
    :global(.job-card:hover) .modular-btn .btn-badge--left .btn-arrow-svg,
    :global(.profile-card:hover) .modular-btn .btn-badge--left .btn-arrow-svg,
    :global(.story-card:hover) .modular-btn .btn-badge--left .btn-arrow-svg,
    :global(.blog-card:hover) .modular-btn .btn-badge--left .btn-arrow-svg,
    :global(.bento-card:hover) .modular-btn .btn-badge--left .btn-arrow-svg,
    :global(.category-rubro-card:hover) .modular-btn .btn-badge--left .btn-arrow-svg {
      transform: rotate(0deg);
    }

    /* Right badge cierra a 0 (se encoge a la derecha) */
    .modular-btn:hover .btn-badge--right,
    .modular-btn:focus-visible .btn-badge--right,
    :global(.job-card:hover) .modular-btn .btn-badge--right,
    :global(.profile-card:hover) .modular-btn .btn-badge--right,
    :global(.story-card:hover) .modular-btn .btn-badge--right,
    :global(.blog-card:hover) .modular-btn .btn-badge--right,
    :global(.bento-card:hover) .modular-btn .btn-badge--right,
    :global(.category-rubro-card:hover) .modular-btn .btn-badge--right {
      width: 0;
      max-width: 0;
      margin-left: 0;
      pointer-events: none;
    }
    .modular-btn:hover .btn-badge--right .btn-badge-inner,
    .modular-btn:focus-visible .btn-badge--right .btn-badge-inner,
    :global(.job-card:hover) .modular-btn .btn-badge--right .btn-badge-inner,
    :global(.profile-card:hover) .modular-btn .btn-badge--right .btn-badge-inner,
    :global(.story-card:hover) .modular-btn .btn-badge--right .btn-badge-inner,
    :global(.blog-card:hover) .modular-btn .btn-badge--right .btn-badge-inner,
    :global(.bento-card:hover) .modular-btn .btn-badge--right .btn-badge-inner,
    :global(.category-rubro-card:hover) .modular-btn .btn-badge--right .btn-badge-inner {
      opacity: 0;
      transform: scale(0);
    }
    .modular-btn:hover .btn-badge--right .btn-arrow-svg,
    .modular-btn:focus-visible .btn-badge--right .btn-arrow-svg,
    :global(.job-card:hover) .modular-btn .btn-badge--right .btn-arrow-svg,
    :global(.profile-card:hover) .modular-btn .btn-badge--right .btn-arrow-svg,
    :global(.story-card:hover) .modular-btn .btn-badge--right .btn-arrow-svg,
    :global(.blog-card:hover) .modular-btn .btn-badge--right .btn-arrow-svg,
    :global(.bento-card:hover) .modular-btn .btn-badge--right .btn-arrow-svg,
    :global(.category-rubro-card:hover) .modular-btn .btn-badge--right .btn-arrow-svg {
      transform: rotate(0deg);
    }

    /* Primary hover color */
    .btn-primary:hover .btn-text-capsule,
    .btn-primary:hover .btn-badge-inner {
      background-color: var(--color-primary-hover);
    }

    /* Secondary hover color */
    .btn-secondary:hover .btn-text-capsule,
    .btn-secondary:hover .btn-badge-inner {
      background-color: var(--color-white);
      color: var(--color-primary-dark);
    }

    /* Primary line hover color */
    .btn-primary-line:hover .btn-text-capsule,
    .btn-primary-line:hover .btn-badge-inner {
      border-color: var(--color-primary);
      background-color: rgba(var(--color-primary-rgb), 0.06);
    }

    /* Secondary line hover color */
    .btn-secondary-line:hover .btn-text-capsule,
    .btn-secondary-line:hover .btn-badge-inner {
      border-color: var(--color-white);
      background-color: rgba(var(--white-rgb), 0.12);
    }

    /* WhatsApp hover */
    .btn-whatsapp:hover .btn-text-capsule {
      background-color: var(--color-primary-hover);
    }
    .btn-whatsapp:hover .btn-badge-inner,
    .btn-white-whatsapp:hover .btn-badge-inner {
      background-color: var(--color-whatsapp);
    }
  }

  .modular-btn:active {
    transform: translateY(0) scale(0.98);
  }

  .modular-btn:focus-visible {
    outline: 2px solid var(--color-border-primary);
    outline-offset: 3px;
    border-radius: var(--btn-radius);
  }

  @media (prefers-reduced-motion: reduce) {
    .modular-btn,
    .btn-badge,
    .btn-badge-inner,
    .btn-text-capsule,
    .btn-arrow-svg {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
