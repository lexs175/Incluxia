---
// AuthModal.astro - Sistema Accesible de Autenticación y Registro para Incluxia (ASHICO)
// 100% alineación pixel-perfect de campos - Cero scrollbar en desktop - Cero desborde en móvil
---

<div
  class="auth-modal-wrapper"
  id="authModalWrapper"
  role="dialog"
  aria-modal="true"
  aria-labelledby="authModalHeading"
  aria-hidden="true"
>
  <div class="auth-modal-backdrop" id="authBackdrop"></div>

  <div class="container auth-modal-container">
    <div class="auth-modal-capsule">
      <!-- COLUMNA IZQUIERDA (DESKTOP): IDENTIDAD Y PROPUESTA DE VALOR -->
      <div class="auth-sidebar">
        <div class="auth-sidebar-brand">
          <div class="auth-brand-badge">
            <span class="auth-brand-dot" aria-hidden="true"></span>
            <span>Incluxia Bolivia</span>
          </div>
          <h2 class="auth-sidebar-title" id="authModalHeading">
            Inclusión laboral sin barreras
          </h2>
          <p class="auth-sidebar-desc">
            Conectamos postulantes con hipoacusia y empresas inclusivas en Cochabamba y toda Bolivia.
          </p>
        </div>

        <!-- 3 Puntos Clave de Accesibilidad -->
        <ul class="auth-perks-list">
          <li class="auth-perk-item">
            <div class="auth-perk-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
            </div>
            <div>
              <strong class="auth-perk-title">100% por chat o WhatsApp</strong>
              <p class="auth-perk-text">Cero llamadas telefónicas sorpresa que descartan tu talento.</p>
            </div>
          </li>

          <li class="auth-perk-item">
            <div class="auth-perk-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            </div>
            <div>
              <strong class="auth-perk-title">Vacantes y Ley 977</strong>
              <p class="auth-perk-text">Empleos reales con adaptaciones razonables y salario justo.</p>
            </div>
          </li>

          <li class="auth-perk-item">
            <div class="auth-perk-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <div>
              <strong class="auth-perk-title">Comunidad ASHICO</strong>
              <p class="auth-perk-text">Acompañamiento cercano de la Asociación de Hipoacúsicos Cochabamba.</p>
            </div>
          </li>
        </ul>

        <div class="auth-sidebar-footer">
          <span>¿Dudas? Chat directo de soporte: <strong>+591 72255726</strong></span>
        </div>
      </div>

      <!-- COLUMNA DERECHA: FORMULARIO DINÁMICO PERFECTAMENTE ALINEADO -->
      <div class="auth-main">
        <!-- Cabecera Superior: Pestañas + Botón de Cerrar (CERO solapamientos, Sticky en móvil) -->
        <header class="auth-header-bar">
          <div class="auth-header-mobile-brand">
            <div class="auth-brand-badge-mobile">
              <span class="auth-brand-dot" aria-hidden="true"></span>
              <span>Incluxia Bolivia</span>
            </div>
          </div>

          <!-- Selector de Pestañas (Tabs) Accesibles -->
          <div class="auth-tabs" role="tablist" aria-label="Opciones de acceso">
            <button
              type="button"
              class="auth-tab-btn active"
              id="tabLoginBtn"
              role="tab"
              aria-selected="true"
              aria-controls="loginPanel"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                <polyline points="10 17 15 12 10 7"></polyline>
                <line x1="15" y1="12" x2="3" y2="12"></line>
              </svg>
              <span>Iniciar Sesión</span>
            </button>

            <button
              type="button"
              class="auth-tab-btn"
              id="tabRegisterBtn"
              role="tab"
              aria-selected="false"
              aria-controls="registerPanel"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="20" y1="8" x2="20" y2="14"></line>
                <line x1="23" y1="11" x2="17" y2="11"></line>
              </svg>
              <span>Crear Cuenta</span>
            </button>
          </div>

          <!-- Botón de Cerrar con Icono SVG -->
          <button
            type="button"
            class="auth-modal-close"
            id="authCloseBtn"
            aria-label="Cerrar ventana de acceso"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </header>

        <!-- Contenedor del Cuerpo de Contenido -->
        <div class="auth-content-body">
          <!-- Mensaje de Notificación / Alerta en Modal -->
        <div
          class="auth-alert"
          id="authAlert"
          role="alert"
          aria-live="polite"
          style="display: none;"
        >
          <span class="auth-alert-icon" id="authAlertIcon" aria-hidden="true"></span>
          <span class="auth-alert-text" id="authAlertText"></span>
        </div>

        <!-- PANEL 1: INICIAR SESIÓN -->
        <div
          class="auth-panel active"
          id="loginPanel"
          role="tabpanel"
          aria-labelledby="tabLoginBtn"
        >
          <div class="panel-header-mini">
            <h3 class="panel-mini-title">Ingresa a tu cuenta</h3>
            <p class="panel-mini-desc">Accede a tus postulaciones o vacantes registradas.</p>
          </div>

          <form class="auth-form" id="loginForm" novalidate>
            <div class="form-group">
              <div class="field-label-bar">
                <label for="loginIdentifier" class="form-label">
                  <span>WhatsApp o Correo</span>
                  <span class="field-req">*</span>
                </label>
              </div>
              <div class="input-with-icon">
                <span class="input-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                </span>
                <input
                  type="text"
                  id="loginIdentifier"
                  class="form-input form-input--icon"
                  placeholder="Ej. +591 70000000 o correo@ejemplo.com"
                  required
                  autocomplete="username"
                />
              </div>
            </div>

            <div class="form-group">
              <div class="field-label-bar">
                <label for="loginPassword" class="form-label">
                  <span>Contraseña o PIN</span>
                  <span class="field-req">*</span>
                </label>
                <button type="button" class="link-btn" id="btnForgotPassword">
                  ¿Olvidaste tu clave?
                </button>
              </div>
              <div class="input-with-icon">
                <span class="input-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                </span>
                <input
                  type="password"
                  id="loginPassword"
                  class="form-input form-input--icon"
                  placeholder="Ingresa tu clave de acceso"
                  required
                  autocomplete="current-password"
                />
                <button
                  type="button"
                  class="input-action-btn"
                  id="toggleLoginPass"
                  aria-label="Ver u ocultar contraseña"
                >
                  <svg class="icon-eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                </button>
              </div>
            </div>

            <button type="submit" class="auth-submit-btn" id="btnLoginSubmit">
              <span>Entrar a mi cuenta</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </form>

          <!-- Accesos Demo Rápidos -->
          <div class="auth-demo-box">
            <div class="demo-box-header">
              <span class="demo-tag">Modo Pruebas</span>
              <span class="demo-desc">Probar con 1 clic sin escribir:</span>
            </div>
            <div class="demo-actions-grid">
              <button
                type="button"
                class="demo-chip-btn"
                id="btnDemoCandidate"
                data-role="candidate"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span>Demo Candidato (Valeria M.)</span>
              </button>

              <button
                type="button"
                class="demo-chip-btn"
                id="btnDemoCompany"
                data-role="company"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                <span>Demo Empresa (Banco Mercantil)</span>
              </button>
            </div>
          </div>
        </div>

        <!-- PANEL 2: REGISTRO GUIADO CON ALINEACIÓN PERFECTA (GRID 2 COLUMNAS) -->
        <div
          class="auth-panel"
          id="registerPanel"
          role="tabpanel"
          aria-labelledby="tabRegisterBtn"
        >
          <div class="panel-header-mini">
            <h3 class="panel-mini-title">Crear Cuenta Gratuita</h3>
            <p class="panel-mini-desc">Selecciona tu perfil para adaptar tu registro.</p>
          </div>

          <form class="auth-form" id="registerForm" novalidate>
            <!-- Selector de Rol Visual Compacto -->
            <div class="role-selector-row">
              <label class="role-card-label">
                <input
                  type="radio"
                  name="userRole"
                  value="candidate"
                  checked
                  class="role-radio"
                  id="roleCandidate"
                />
                <div class="role-card">
                  <div class="role-icon-box" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                      <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                  </div>
                  <div class="role-info">
                    <strong class="role-title">Busco Trabajo</strong>
                    <span class="role-desc">Hipoacusia o familiar</span>
                  </div>
                </div>
              </label>

              <label class="role-card-label">
                <input
                  type="radio"
                  name="userRole"
                  value="company"
                  class="role-radio"
                  id="roleCompany"
                />
                <div class="role-card">
                  <div class="role-icon-box" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                  </div>
                  <div class="role-info">
                    <strong class="role-title">Soy Empresa</strong>
                    <span class="role-desc">Vacantes / Ley 977</span>
                  </div>
                </div>
              </label>
            </div>

            <!-- Fila 1: Nombre (Col 1) | WhatsApp (Col 2) -> AMBOS CON BARRA DE LABEL DE 24PX IDÉNTICA -->
            <div class="form-fields-grid">
              <div class="form-group">
                <div class="field-label-bar">
                  <label for="regFullName" class="form-label" id="labelFullName">
                    <span>Nombre y Apellido</span>
                    <span class="field-req">*</span>
                  </label>
                </div>
                <div class="input-with-icon">
                  <span class="input-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                      <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                  </span>
                  <input
                    type="text"
                    id="regFullName"
                    class="form-input form-input--icon"
                    placeholder="Ej. Valeria Morales"
                    required
                  />
                </div>
              </div>

              <div class="form-group">
                <div class="field-label-bar">
                  <label for="regWhatsApp" class="form-label">
                    <span>WhatsApp</span>
                    <span class="field-req">*</span>
                  </label>
                  <span class="field-hint-tag">Solo chat</span>
                </div>
                <div class="input-with-icon">
                  <span class="input-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                  </span>
                  <input
                    type="tel"
                    id="regWhatsApp"
                    class="form-input form-input--icon"
                    placeholder="+591 70000000"
                    required
                  />
                </div>
              </div>

              <!-- Fila 2: Empresa (si es empresa) / Ciudad y Área (si es candidato) -->
              <div class="form-group" id="companyFieldGroup" style="display: none;">
                <div class="field-label-bar">
                  <label for="regCompanyName" class="form-label">
                    <span>Nombre de la Empresa</span>
                    <span class="field-req">*</span>
                  </label>
                </div>
                <div class="input-with-icon">
                  <span class="input-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                      <path d="M9 22v-4h6v4"></path>
                    </svg>
                  </span>
                  <input
                    type="text"
                    id="regCompanyName"
                    class="form-input form-input--icon"
                    placeholder="Ej. Farmacias Bolivia S.A."
                  />
                </div>
              </div>

              <div class="form-group" id="cityFieldGroup">
                <div class="field-label-bar">
                  <label for="regCity" class="form-label">
                    <span>Ciudad</span>
                    <span class="field-req">*</span>
                  </label>
                </div>
                <select id="regCity" class="form-select" required>
                  <option value="Cochabamba">Cochabamba</option>
                  <option value="La Paz">La Paz</option>
                  <option value="Santa Cruz">Santa Cruz</option>
                  <option value="Sucre">Sucre</option>
                  <option value="Oruro">Oruro</option>
                  <option value="Tarija">Tarija</option>
                  <option value="Potosí">Potosí</option>
                  <option value="Beni">Beni</option>
                  <option value="Pando">Pando</option>
                </select>
              </div>

              <div class="form-group" id="professionFieldGroup">
                <div class="field-label-bar">
                  <label for="regProfession" class="form-label">
                    <span>Área de interés</span>
                  </label>
                </div>
                <select id="regProfession" class="form-select">
                  <option value="Diseño y Multimedia">Diseño y Multimedia</option>
                  <option value="Tecnología y Sistemas">Tecnología y Sistemas</option>
                  <option value="Administración y Archivo">Administración y Archivo</option>
                  <option value="Contabilidad y Finanzas">Contabilidad y Finanzas</option>
                  <option value="Logística y Almacén">Logística y Almacén</option>
                  <option value="Atención por Chat Escrito">Atención por Chat Escrito</option>
                  <option value="Otro oficio">Otro oficio</option>
                </select>
              </div>

              <!-- Fila 3: Contraseña o PIN (Ancho completo) -->
              <div class="form-group form-group--full">
                <div class="field-label-bar">
                  <label for="regPassword" class="form-label">
                    <span>Contraseña o PIN de acceso</span>
                    <span class="field-req">*</span>
                  </label>
                </div>
                <div class="input-with-icon">
                  <span class="input-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                  </span>
                  <input
                    type="password"
                    id="regPassword"
                    class="form-input form-input--icon"
                    placeholder="Mínimo 4 caracteres (fácil de recordar)"
                    required
                    autocomplete="new-password"
                  />
                </div>
              </div>
            </div>

            <button type="submit" class="auth-submit-btn" id="btnRegisterSubmit">
              <span>Crear mi Perfil Gratuito</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </button>
          </form>
        </div>

        <!-- ESTADO DE ÉXITO INTERACTIVO TRAS LOGIN O REGISTRO -->
        <div
          class="auth-success-state"
          id="authSuccessState"
          style="display: none;"
        >
          <div class="success-icon-badge" aria-hidden="true">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>

          <h3 class="success-title" id="successHeading">
            ¡Acceso completado con éxito!
          </h3>
          <p class="success-desc" id="successDetails">
            Tu sesión está activa en Incluxia. Ahora puedes postular o gestionar vacantes.
          </p>

          <div class="user-pill-card">
            <div class="user-avatar-circle" id="successUserAvatar">V</div>
            <div class="user-pill-text">
              <strong id="successUserName">Valeria Morales</strong>
              <span id="successUserRole">Candidato verificado · Cochabamba</span>
            </div>
          </div>

          <button type="button" class="auth-submit-btn" id="btnContinueAuth">
            <span>Continuar en Incluxia</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initAuthSystem() {
    const wrapper = document.getElementById("authModalWrapper");
    const backdrop = document.getElementById("authBackdrop");
    const closeBtn = document.getElementById("authCloseBtn");
    const tabLogin = document.getElementById("tabLoginBtn");
    const tabRegister = document.getElementById("tabRegisterBtn");
    const loginPanel = document.getElementById("loginPanel");
    const registerPanel = document.getElementById("registerPanel");
    const successState = document.getElementById("authSuccessState");
    const alertBox = document.getElementById("authAlert");
    const alertText = document.getElementById("authAlertText");
    const alertIcon = document.getElementById("authAlertIcon");

    const loginForm = document.getElementById("loginForm") as HTMLFormElement | null;
    const registerForm = document.getElementById("registerForm") as HTMLFormElement | null;

    const roleCandidate = document.getElementById("roleCandidate") as HTMLInputElement | null;
    const roleCompany = document.getElementById("roleCompany") as HTMLInputElement | null;
    const companyGroup = document.getElementById("companyFieldGroup");
    const professionGroup = document.getElementById("professionFieldGroup");
    const labelFullName = document.getElementById("labelFullName");

    const btnDemoCandidate = document.getElementById("btnDemoCandidate");
    const btnDemoCompany = document.getElementById("btnDemoCompany");
    const btnContinue = document.getElementById("btnContinueAuth");
    const toggleLoginPass = document.getElementById("toggleLoginPass");
    const loginPassword = document.getElementById("loginPassword") as HTMLInputElement | null;
    const btnForgot = document.getElementById("btnForgotPassword");

    if (!wrapper) return;

    function showAlert(message: string, isError = true) {
      if (!alertBox || !alertText || !alertIcon) return;
      alertText.textContent = message;
      alertBox.className = `auth-alert ${isError ? "auth-alert--error" : "auth-alert--success"}`;
      alertIcon.innerHTML = isError
        ? `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`
        : `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
      alertBox.style.display = "flex";
    }

    function clearAlert() {
      if (alertBox) alertBox.style.display = "none";
    }

    function openModal(defaultTab: "login" | "register" = "login") {
      clearAlert();
      if (successState) successState.style.display = "none";
      wrapper.classList.add("open");
      wrapper.setAttribute("aria-hidden", "false");

      // Reset scroll del contenedor en móvil para que siempre empiece arriba
      const capsule = wrapper.querySelector(".auth-modal-capsule");
      if (capsule) capsule.scrollTop = 0;

      // Bloqueo total de scroll y touch en HTML y BODY
      document.documentElement.classList.add("modal-open");
      document.body.classList.add("modal-open");
      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";

      switchTab(defaultTab);
    }

    function closeModal() {
      wrapper.classList.remove("open");
      wrapper.setAttribute("aria-hidden", "true");

      // Desbloqueo total al cerrar
      document.documentElement.classList.remove("modal-open");
      document.body.classList.remove("modal-open");
      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";

      clearAlert();
    }

    function switchTab(tab: "login" | "register") {
      clearAlert();
      if (successState) successState.style.display = "none";

      const capsule = wrapper.querySelector(".auth-modal-capsule");
      if (capsule) capsule.scrollTop = 0;

      if (tab === "login") {
        tabLogin?.classList.add("active");
        tabLogin?.setAttribute("aria-selected", "true");
        tabRegister?.classList.remove("active");
        tabRegister?.setAttribute("aria-selected", "false");
        if (loginPanel) loginPanel.style.display = "block";
        if (registerPanel) registerPanel.style.display = "none";
      } else {
        tabRegister?.classList.add("active");
        tabRegister?.setAttribute("aria-selected", "true");
        tabLogin?.classList.remove("active");
        tabLogin?.setAttribute("aria-selected", "false");
        if (registerPanel) registerPanel.style.display = "block";
        if (loginPanel) loginPanel.style.display = "none";
      }
    }

    function handleRoleChange() {
      const isCompany = roleCompany?.checked;
      if (companyGroup) companyGroup.style.display = isCompany ? "block" : "none";
      if (professionGroup) professionGroup.style.display = isCompany ? "none" : "block";
      if (labelFullName) {
        labelFullName.innerHTML = isCompany
          ? `<span>Contacto (RRHH)</span> <span class="field-req">*</span>`
          : `<span>Nombre y Apellido</span> <span class="field-req">*</span>`;
      }
    }

    roleCandidate?.addEventListener("change", handleRoleChange);
    roleCompany?.addEventListener("change", handleRoleChange);

    toggleLoginPass?.addEventListener("click", () => {
      if (!loginPassword) return;
      const isPass = loginPassword.type === "password";
      loginPassword.type = isPass ? "text" : "password";
    });

    btnForgot?.addEventListener("click", () => {
      showAlert("Comunícate por WhatsApp con el soporte de Incluxia (+591 72255726) para recuperar tu acceso.", false);
    });

    function saveAndEmitAuth(userData: {
      name: string;
      role: "candidate" | "company";
      phone?: string;
      city?: string;
      companyName?: string;
    }) {
      localStorage.setItem("incluxia_auth_user", JSON.stringify(userData));
      window.dispatchEvent(
        new CustomEvent("incluxia:auth-changed", { detail: userData })
      );

      if (loginPanel) loginPanel.style.display = "none";
      if (registerPanel) registerPanel.style.display = "none";
      clearAlert();

      if (successState) {
        successState.style.display = "flex";
        const nameEl = document.getElementById("successUserName");
        const roleEl = document.getElementById("successUserRole");
        const avatarEl = document.getElementById("successUserAvatar");

        const displayName = userData.role === "company" && userData.companyName
          ? userData.companyName
          : userData.name;

        if (nameEl) nameEl.textContent = displayName;
        if (roleEl) {
          roleEl.textContent = userData.role === "company"
            ? `Empresa Inclusiva · ${userData.city || "Bolivia"}`
            : `Candidato verificado · ${userData.city || "Cochabamba"}`;
        }
        if (avatarEl) {
          avatarEl.textContent = displayName.charAt(0).toUpperCase();
        }
      }
    }

    loginForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const identifier = (document.getElementById("loginIdentifier") as HTMLInputElement)?.value.trim();
      const pass = loginPassword?.value.trim();

      if (!identifier || !pass) {
        showAlert("Por favor, ingresa tu WhatsApp/correo y tu contraseña.");
        return;
      }

      saveAndEmitAuth({
        name: identifier.includes("@") ? identifier.split("@")[0] : identifier,
        role: "candidate",
        phone: identifier,
        city: "Cochabamba",
      });
    });

    registerForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const isCompany = roleCompany?.checked;
      const fullName = (document.getElementById("regFullName") as HTMLInputElement)?.value.trim();
      const companyName = (document.getElementById("regCompanyName") as HTMLInputElement)?.value.trim();
      const whatsApp = (document.getElementById("regWhatsApp") as HTMLInputElement)?.value.trim();
      const city = (document.getElementById("regCity") as HTMLSelectElement)?.value;
      const pass = (document.getElementById("regPassword") as HTMLInputElement)?.value.trim();

      if (!fullName) {
        showAlert("Por favor, anota tu nombre.");
        return;
      }
      if (isCompany && !companyName) {
        showAlert("Por favor, anota el nombre de la empresa.");
        return;
      }
      if (!whatsApp) {
        showAlert("Por favor, ingresa tu número de WhatsApp para contacto.");
        return;
      }
      if (!pass || pass.length < 4) {
        showAlert("Tu contraseña o PIN debe tener al menos 4 caracteres.");
        return;
      }

      saveAndEmitAuth({
        name: fullName,
        companyName: isCompany ? companyName : undefined,
        role: isCompany ? "company" : "candidate",
        phone: whatsApp,
        city: city || "Cochabamba",
      });
    });

    btnDemoCandidate?.addEventListener("click", () => {
      saveAndEmitAuth({
        name: "Valeria Morales Terán",
        role: "candidate",
        phone: "+591 72255726",
        city: "Cochabamba",
      });
    });

    btnDemoCompany?.addEventListener("click", () => {
      saveAndEmitAuth({
        name: "Lic. Carlos Mendoza (RRHH)",
        companyName: "Banco Mercantil Santa Cruz",
        role: "company",
        phone: "+591 77712345",
        city: "Cochabamba",
      });
    });

    btnContinue?.addEventListener("click", closeModal);
    closeBtn?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);

    // Evitar que el desplazamiento con rueda o táctil en el backdrop mueva el fondo
    backdrop?.addEventListener("wheel", (e) => {
      e.preventDefault();
    }, { passive: false });

    backdrop?.addEventListener("touchmove", (e) => {
      e.preventDefault();
    }, { passive: false });

    tabLogin?.addEventListener("click", () => switchTab("login"));
    tabRegister?.addEventListener("click", () => switchTab("register"));

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && wrapper.classList.contains("open")) {
        closeModal();
      }
    });

    document.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest("[data-auth-trigger]");
      if (target) {
        e.preventDefault();
        const action = target.getAttribute("data-auth-trigger");
        openModal(action === "register" ? "register" : "login");
      }
    });

    (window as any).openAuthModal = openModal;
    (window as any).closeAuthModal = closeModal;
  }

  document.addEventListener("astro:page-load", initAuthSystem);
</script>

