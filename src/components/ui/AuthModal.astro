---
import ActionButton from './ActionButton.astro';
import Icon from './Icon.astro';
import PasswordField from './PasswordField.astro';
import GoogleAccessButton from './GoogleAccessButton.astro';
import '../../styles/auth.css';
---
<div class="auth-modal-wrapper" id="authModalWrapper" role="dialog" aria-modal="true" aria-labelledby="loginPanelTitle" aria-describedby="loginPanelDescription" aria-hidden="true" inert>
  <div class="auth-modal-backdrop" id="authBackdrop"></div>
  <div class="container auth-modal-container">
    <div class="auth-modal-capsule">
      <header class="auth-header-bar">
        <span class="auth-brand" aria-hidden="true">Eco</span>
        <ActionButton id="authCloseBtn" variant="icon" size="lg" ariaLabel="Cerrar ventana de acceso"><Icon name="close" size={20} /></ActionButton>
      </header>
      <div class="auth-tabs" role="tablist" aria-label="Opciones de acceso">
        <button type="button" class="auth-tab-btn active" id="tabLoginBtn" role="tab" aria-selected="true" aria-controls="loginPanel">Ingresar</button>
        <button type="button" class="auth-tab-btn" id="tabRegisterBtn" role="tab" aria-selected="false" aria-controls="registerPanel" tabindex="-1">Crear cuenta</button>
      </div>
      <div class="auth-alert" id="authAlert" role="alert" aria-live="assertive" tabindex="-1" hidden><Icon name="close" size={18} /><span id="authAlertText"></span></div>
      <section class="auth-panel" id="loginPanel" role="tabpanel" aria-labelledby="tabLoginBtn">
        <div class="auth-panel-heading">
          <h2 class="auth-title" id="loginPanelTitle" tabindex="-1" data-animated="true">Ingresa a Eco</h2>
          <p class="auth-description" id="loginPanelDescription">Continúa con tus postulaciones, servicios y publicaciones.</p>
        </div>
        <div class="auth-social-access"><GoogleAccessButton id="loginGoogle" /><div class="auth-divider"><span>o continúa con tu correo</span></div></div>
        <form class="auth-form" id="loginForm" novalidate>
          <div class="form-group">
            <label for="loginIdentifier" class="auth-label">Correo electrónico</label>
            <div class="auth-input-wrap"><span class="auth-input-icon"><Icon name="mail" size={18} /></span><input type="email" id="loginIdentifier" name="email" class="auth-input" placeholder="nombre@correo.com" required autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false" /></div>
          </div>
          <PasswordField id="loginPassword" toggleId="toggleLoginPass" />
          <ActionButton type="submit" id="btnLoginSubmit" text="Ingresar" class="auth-primary-action" />
        </form>
      </section>
      <section class="auth-panel" id="registerPanel" role="tabpanel" aria-labelledby="tabRegisterBtn" hidden>
        <div class="auth-panel-heading">
          <h2 class="auth-title" id="registerPanelTitle" tabindex="-1" data-animated="true">Crea tu cuenta</h2>
          <p class="auth-description" id="registerPanelDescription">Busca trabajo, ofrece servicios o contrata con una misma cuenta.</p>
        </div>
        <div class="auth-social-access"><GoogleAccessButton id="registerGoogle" /><div class="auth-divider"><span>o continúa con tu correo</span></div></div>
        <form class="auth-form" id="registerForm" novalidate>
          <div class="form-group">
            <label for="regFullName" class="auth-label">Nombre y apellido</label>
            <div class="auth-input-wrap"><span class="auth-input-icon"><Icon name="user" size={18} /></span><input type="text" id="regFullName" name="name" class="auth-input" placeholder="Tu nombre y apellido" required autocomplete="name" maxlength="120" /></div>
          </div>
          <div class="form-group">
            <label for="regEmail" class="auth-label">Correo electrónico</label>
            <div class="auth-input-wrap"><span class="auth-input-icon"><Icon name="mail" size={18} /></span><input type="email" id="regEmail" name="email" class="auth-input" placeholder="nombre@correo.com" required autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" /></div>
          </div>
          <PasswordField id="regPassword" toggleId="toggleRegisterPass" autocomplete="new-password" minimum={8} hint="Usa al menos 8 caracteres." />
          <ActionButton type="submit" id="btnRegisterSubmit" text="Crear cuenta" class="auth-primary-action" />
        </form>
      </section>
      <div class="auth-preview-access">
        <ActionButton id="btnDemoCandidate" text="Ingresar como Valeria" variant="ghost" class="auth-example-button" />
      </div>
    </div>
  </div>
</div>
<script>
  import { initAuth } from '../../lib/auth';
  document.addEventListener('astro:page-load', initAuth);
</script>
