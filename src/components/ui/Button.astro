---
import ExpandableButton from "./ExpandableButton.astro";

interface Props {
  href?: string;
  variant?: "default" | "primary" | "accent" | "outline" | "outline-white" | "whatsapp" | "white" | "white-whatsapp" | "dark";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit" | "reset";
  class?: string;
  id?: string;
  target?: string;
  rel?: string;
  fullWidth?: boolean;
  text?: string;
}

const {
  href,
  variant = "default",
  size = "md",
  type = "button",
  class: className = "",
  id,
  target,
  rel,
  fullWidth = false,
  text,
  ...rest
} = Astro.props;

const mappedVariant =
  variant === "primary" || variant === "outline" || variant === "accent" || variant === "dark"
    ? "default"
    : variant === "outline-white"
      ? "white"
      : variant;
---

<ExpandableButton
  href={href}
  variant={mappedVariant as any}
  size={size}
  type={type}
  class={className}
  id={id}
  target={target}
  rel={rel}
  fullWidth={fullWidth}
  text={text}
  {...rest}
>
  <slot />
</ExpandableButton>
