---
import Icon from './Icon.astro';
import '../../styles/auth.css';
interface Props {
  id: string;
  toggleId?: string;
  autocomplete?: 'current-password' | 'new-password';
  minimum?: number;
  hint?: string;
}
const { id, toggleId, autocomplete = 'current-password', minimum = 1, hint } = Astro.props;
---
<div class="form-group">
  <label for={id} class="auth-label">Contraseña</label>
  <div class="auth-input-wrap">
    <span class="auth-input-icon"><Icon name="lock" size={18} /></span>
    <input class="auth-input auth-input--password" id={id} name="password" type="password" data-password-input required minlength={minimum} autocomplete={autocomplete} aria-describedby={hint ? `${id}Hint` : undefined} placeholder={autocomplete === 'new-password' ? 'Crea una contraseña' : 'Tu contraseña'} />
    <button type="button" class="auth-password-toggle" id={toggleId} data-password-toggle={id} aria-controls={id} aria-label="Mostrar contraseña" aria-pressed="false">
      <span data-password-show><Icon name="eye" size={20} /></span>
      <span data-password-hide hidden><Icon name="eye-off" size={20} /></span>
    </button>
  </div>
  {hint && <p class="auth-field-hint" id={`${id}Hint`}>{hint}</p>}
</div>
