---
import SiteImage from "./SiteImage.astro";
interface Props { imageId?: string; size?: "sm" | "md"; }
const { imageId, size = "sm" } = Astro.props;
---

<span class:list={["account-avatar", { "account-avatar--md": size === "md" }]} data-account-avatar aria-hidden="true">
  <SiteImage kind="avatar" sizes={size === "md" ? "48px" : "40px"} width="48" height="48" alt="" id={imageId} data-account-image loading="eager" hidden />
  <span class="account-initial" data-account-initial>U</span>
</span>

<style>
  .account-avatar { --avatar-size: var(--space-10); display: grid; place-items: center; flex: 0 0 var(--avatar-size); width: var(--avatar-size); height: var(--avatar-size); overflow: hidden; border-radius: var(--radius-full); background: var(--color-bg-alt); color: var(--color-text-main); }
  .account-avatar--md { --avatar-size: var(--space-12); }
  .account-avatar :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .account-initial { font-family: var(--font-heading); font-size: var(--text-base); font-weight: 600; }
</style>
