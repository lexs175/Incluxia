<section class="trustly-stories-hero">
  <div class="container hero-container">
    <div class="hero-header">
      <h1 class="hero-main-title">
        Casos de éxito que inspiran a <span class="highlight-cyan">Bolivia</span>
      </h1>

      <p class="hero-lead-text">
        Profesionales con hipoacusia demostrando su capacidad y concentración
        en tecnología, diseño, administración y finanzas cuando las empresas
        eligen canales 100% escritos.
      </p>
    </div>
  </div>
</section>

<style>
  .trustly-stories-hero {
    background-color: var(--color-white);
    padding-top: calc(90px + var(--space-8));
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-main-title {
    font-size: var(--text-hero);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .highlight-cyan {
    color: var(--color-accent);
  }

  .hero-lead-text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.65;
    max-width: 680px;
    margin: 0 auto;
  }
</style>
