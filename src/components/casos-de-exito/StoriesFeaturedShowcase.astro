---
import ExpandableButton from "../ui/ExpandableButton.astro";

interface Props {
  story: any;
}

const { story } = Astro.props;
---

<section class="section featured-showcase-section">
  <div class="container">
    <div class="featured-showcase-grid">
      <div class="featured-content-col">
        <div class="featured-badge-row">
          <span class="featured-company-pill">
            {story.company}
          </span>
        </div>

        <h2 class="featured-name-title">
          {story.name}: {story.role}
        </h2>

        <blockquote class="featured-quote">
          “{story.quote}”
        </blockquote>

        <div class="featured-meta-row">
          <span class="meta-tag">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            {story.city}, Bolivia
          </span>
          <span class="meta-dot">·</span>
          <span class="meta-tag">Entrevista con Intérprete LSB</span>
        </div>

        <div class="featured-action-wrap">
          <ExpandableButton
            href={`/casos-de-exito/${story.slug}`}
            text="Ver historia completa"
            variant="white"
            size="md"
          />
        </div>
      </div>

      <div class="featured-photo-col">
        <img
          src={story.image}
          alt={`Entrevista con ${story.name}`}
          class="featured-photo"
          loading="eager"
        />
        <div class="photo-caption-bar">
          <span class="caption-title">{story.name}</span>
          <span class="caption-sub">
            {story.role} en {story.company}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .featured-showcase-section {
    background-color: var(--color-primary-dark);
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    position: relative;
    width: 100%;
    color: var(--color-white);
  }

  .featured-showcase-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    min-height: 440px;
  }

  .featured-content-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-6);
    color: var(--color-white);
  }

  .featured-badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .featured-company-pill {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .featured-name-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin: 0;
  }

  .featured-quote {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    font-style: italic;
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-5);
    margin: 0;
  }

  .featured-meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: rgba(255, 255, 255, 0.65);
    font-size: var(--text-xs);
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .meta-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-dot {
    color: rgba(255, 255, 255, 0.3);
  }

  .featured-action-wrap {
    padding-top: var(--space-2);
  }

  .featured-photo-col {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 100%;
    min-height: 380px;
    max-height: 480px;
    display: flex;
  }

  .featured-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-md);
  }

  .photo-caption-bar {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
    right: var(--space-4);
    background: rgba(11, 15, 25, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
  }

  .caption-title {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-white);
  }

  .caption-sub {
    font-size: 0.72rem;
    color: var(--color-accent);
  }

  @media (max-width: 991px) {
    .featured-showcase-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .featured-photo-col {
      min-height: 320px;
      height: 360px;
    }
  }
</style>
