---
import Badge from "../ui/Badge.astro";
import ExpandableButton from "../ui/ExpandableButton.astro";

interface Props {
  article: {
    id: string;
    slug: string;
    title: string;
    category: string;
    date: string;
    readTime?: string;
    image: string;
    summary: string;
  };
}

const { article } = Astro.props;
---

<article class="blog-card">
  <div class="blog-image-wrapper">
    <img
      src={article.image}
      alt={article.title}
      class="blog-img"
      loading="lazy"
    />
    <div class="blog-badge-wrapper">
      <Badge variant="cyan">{article.category}</Badge>
    </div>
  </div>

  <div class="blog-body">
    <div class="blog-meta">
      <span>{article.date}</span>
      {article.readTime && <span>• {article.readTime}</span>}
    </div>

    <h3 class="blog-title">
      <a href={`/blog/${article.slug}`}>{article.title}</a>
    </h3>

    <p class="blog-summary">{article.summary}</p>

    <div class="blog-btn-wrap">
      <ExpandableButton href={`/blog/${article.slug}`} text="Leer artículo" variant="dark" size="sm" />
    </div>
  </div>
</article>

<style>
  .blog-card {
    background: var(--color-bg-card);
    border: 1px solid rgba(var(--color-primary-rgb), 0.1);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: none; /* ZERO SHADOWS */
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .blog-card:hover {
    box-shadow: none; /* ZERO SHADOWS */
    /* NO TRANSLATEY, NO BORDER CHANGE */
  }

  .blog-btn-wrap {
    margin-top: auto;
    padding-top: var(--space-4);
  }

  .blog-image-wrapper {
    position: relative;
    height: 190px;
    overflow: hidden;
  }

  .blog-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-badge-wrapper {
    position: absolute;
    top: 1rem;
    left: 1rem;
  }

  .blog-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .blog-meta {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    font-weight: 500;
    margin-bottom: var(--space-2);
  }

  .blog-title {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin-bottom: var(--space-3);
  }

  .blog-title a {
    color: var(--color-primary);
    transition: color var(--transition-fast);
  }

  .blog-title a:hover {
    color: var(--color-primary-light);
  }

  .blog-summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-read-more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    transition: all var(--transition-fast);
  }

  .blog-read-more:hover {
    color: var(--color-primary-light);
    gap: 0.75rem;
  }

  @media (max-width: 479px) {
    .blog-image-wrapper {
      height: 160px;
    }
    .blog-body {
      padding: var(--space-4);
    }
  }
</style>
