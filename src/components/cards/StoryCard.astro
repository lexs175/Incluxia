---
import Badge from "../ui/Badge.astro";
import ExpandableButton from "../ui/ExpandableButton.astro";

interface Props {
  story: {
    id: string;
    slug: string;
    name: string;
    role: string;
    company: string;
    city: string;
    image: string;
    quote: string;
    category?: string;
  };
}

const { story } = Astro.props;
---

<article class="story-card">
  <div class="story-image-wrap">
    <img
      src={story.image}
      alt={story.name}
      class="story-image"
      loading="lazy"
    />
    <div class="story-gradient-overlay"></div>
  </div>

  <div class="story-content">
    <div class="story-badge-wrap">
      <Badge variant="cyan">Caso de Éxito</Badge>
    </div>
    <h3 class="story-title">
      {story.name}: {story.role} en {story.company}

    </h3>
    <p class="story-quote">“{story.quote}”</p>
    <div class="story-btn-wrap">
      <ExpandableButton href={`/casos-de-exito/${story.slug}`} text="Ver testimonio" variant="white" size="md" />
    </div>
  </div>
</article>

<style>
  .story-card {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 420px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    box-shadow: none; /* ZERO SHADOWS */
    border: 1px solid rgba(var(--color-primary-rgb), 0.1);
  }

  .story-card:hover {
    box-shadow: none; /* ZERO SHADOWS */
    /* NO TRANSLATEY, NO BORDER CHANGE */
  }

  .story-btn-wrap {
    margin-top: var(--space-3);
  }

  .story-image-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .story-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(var(--color-primary-rgb, 33, 32, 81), 0.98) 0%,
      rgba(var(--color-primary-rgb, 33, 32, 81), 0.88) 38%,
      rgba(var(--color-primary-rgb, 33, 32, 81), 0.50) 65%,
      rgba(var(--color-primary-rgb, 33, 32, 81), 0.10) 85%,
      transparent 100%
    );
    pointer-events: none;
  }

  .story-content {
    position: relative;
    z-index: 2;
    padding: var(--space-6);
    color: var(--color-text-inverse);
  }

  .story-badge-wrap {
    margin-bottom: var(--space-4);
    display: block;
  }

  .story-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-inverse);
    line-height: 1.3;
    margin-bottom: var(--space-2);
  }

  .story-title a {
    color: var(--color-text-inverse);
  }

  .story-title a:hover {
    color: var(--color-accent);
  }

  .story-quote {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.85);
    font-style: italic;
    line-height: 1.5;
    margin-bottom: var(--space-6);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .story-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    transition: gap var(--transition-fast);
  }

  .story-link:hover {
    gap: 0.75rem;
    color: var(--color-text-inverse);
  }

  @media (max-width: 479px) {
    .story-card {
      height: 320px;
      border-radius: var(--radius-md);
    }
    .story-content {
      padding: var(--space-4);
    }
    .story-title {
      font-size: var(--text-base);
    }
  }
</style>
