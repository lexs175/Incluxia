---
import SiteImage from "../ui/SiteImage.astro";
import ExpandableButton from "../ui/ExpandableButton.astro";

interface Props {
  compact?: boolean;
  story: {
    id: string;
    slug: string;
    name: string;
    role: string;
    company: string;
    city: string;
    image: string;
    quote: string;
    category?: string;
  };
}

const { story, compact = false } = Astro.props;
---

<article class:list={['story-card', { 'story-card--compact': compact }]}>
  <div class="story-image-wrapper">
    <SiteImage kind="storyCard"
      src={story.image}
      alt={story.name}
      class="story-img"
      loading="lazy"
    />
  </div>

  <div class="story-body">
    <h3 class="story-title">
      <a href={`/casos-de-exito/${story.slug}`}>
        {compact ? story.name : `${story.name}: ${story.role} en ${story.company}`}
      </a>
    </h3>

    {compact ? <p class="story-summary">{story.role.replaceAll(' & ', ' y ')} en {story.company}.</p> : <p class="story-quote">“{story.quote}”</p>}

    <div class="story-btn-wrap">
      <ExpandableButton
        href={`/casos-de-exito/${story.slug}`}
        text={compact ? 'Ver historia' : 'Ver testimonio'}
        variant="primary"
        size="md"
      />
    </div>
  </div>
</article>

<style>
  .story-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    box-shadow: none; /* ZERO SHADOWS */
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    transition: border-color var(--transition-fast);
  }

  .story-card:hover {
    border-color: var(--color-border-hover);
  }

  .story-image-wrapper {
    position: relative;
    width: 100%;
    height: 220px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-bg-alt);
    flex-shrink: 0;
  }

  .story-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .story-body {
    padding-top: var(--space-5);
    padding-inline: var(--space-1);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }


  .story-title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin: 0 0 var(--space-3) 0;
  }

  .story-title a {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .story-title a:hover {
    color: var(--color-primary-hover);
  }

  .story-quote {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    line-height: 1.6;
    margin: 0 0 var(--space-6) 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .story-btn-wrap {
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .story-summary { font-size: var(--text-sm); color: var(--color-text-main); line-height: 1.6; margin-bottom: var(--space-6); }

  @media (max-width: 479px) {
    .story-card {
      padding: var(--space-3);
    }
    .story-image-wrapper {
      height: 180px;
    }
    .story-body {
      padding-top: var(--space-4);
    }
  }
</style>
