---
import ExpandableButton from "../ui/ExpandableButton.astro";

interface Props {
  story: {
    id: string;
    slug: string;
    name: string;
    role: string;
    company: string;
    city: string;
    image: string;
    quote: string;
    category?: string;
  };
}

const { story } = Astro.props;
---

<article class="story-card">
  <div class="story-image-wrapper">
    <img
      src={story.image}
      alt={story.name}
      class="story-img"
      loading="lazy"
    />
  </div>

  <div class="story-body">
    <span class="story-category-tag">
      {story.category || "Caso de Éxito"}
    </span>

    <h3 class="story-title">
      <a href={`/casos-de-exito/${story.slug}`}>
        {story.name}: {story.role} en {story.company}
      </a>
    </h3>

    <p class="story-quote">“{story.quote}”</p>

    <div class="story-btn-wrap">
      <ExpandableButton
        href={`/casos-de-exito/${story.slug}`}
        text="Ver testimonio"
        variant="primary-line"
        size="md"
      />
    </div>
  </div>
</article>

<style>
  .story-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    box-shadow: none; /* ZERO SHADOWS */
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    transition: border-color var(--transition-fast);
  }

  .story-card:hover {
    border-color: var(--color-border-hover);
  }

  .story-image-wrapper {
    position: relative;
    width: 100%;
    height: 220px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-bg-alt);
    flex-shrink: 0;
  }

  .story-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .story-body {
    padding-top: var(--space-5);
    padding-inline: var(--space-1);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .story-category-tag {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }

  .story-title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin: 0 0 var(--space-3) 0;
  }

  .story-title a {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .story-title a:hover {
    color: var(--color-primary-hover);
  }

  .story-quote {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    line-height: 1.6;
    margin: 0 0 var(--space-6) 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .story-btn-wrap {
    margin-top: auto;
    padding-top: var(--space-2);
  }

  @media (max-width: 479px) {
    .story-card {
      padding: var(--space-3);
    }
    .story-image-wrapper {
      height: 180px;
    }
    .story-body {
      padding-top: var(--space-4);
    }
  }
</style>
