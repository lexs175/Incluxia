---
import ExpandableButton from '../ui/ExpandableButton.astro';

interface Props {
  compact?: boolean;
  href?: string;
  job: {
    id: string;
    slug: string;
    title: string;
    company: string;
    city: string;
    modality?: string;
    contractType?: string;
    postedDays: string;
    accessibilityBadge: string;
    description?: string;
    salary?: string;
  };
}

const { job, compact = false, href = `/empleos/${job.slug}` } = Astro.props;
---

<article class:list={["job-card", { "job-card-compact": compact }]} data-job-id={job.id}>
  <!-- Job Title -->
  <h3 class="job-title">
    <a href={href}>{job.title}</a>
  </h3>

  <!-- Company & Location -->
  <div class="job-meta">
    <span class="company-name">{job.company}</span>
    <span class="meta-separator">•</span>
    <span class="job-location">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      {job.city}
    </span>
  </div>

  {compact && <p class="job-budget">{job.salary || "A convenir"}</p>}
  <!-- Card Footer -->
  <div class="job-card-footer">
    <span class="posted-time">{job.postedDays}</span>
    <ExpandableButton href={href} text={compact ? "Postular" : "Ver Puesto"} variant="white" size="sm" />
  </div>
</article>

<style>

  .job-card {
    background: var(--color-primary);
    border: 1px solid rgba(var(--color-white-rgb), 0.12);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 290px;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    box-shadow: none; /* ZERO SHADOWS */
    color: var(--color-white);
  }

  .job-card:hover {
    box-shadow: none; /* ZERO SHADOWS */
    /* NO TRANSLATEY, NO BORDER CHANGE */
  }


  .company-icon-box {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background-color: rgba(var(--color-white-rgb), 0.08);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }


  .job-title {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin-bottom: var(--space-2);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .job-title a {
    color: var(--color-white);
    transition: color var(--transition-fast);
  }

  .job-title a:hover {
    opacity: 0.85;
    text-decoration: underline;
  }

  .job-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: rgba(var(--color-white-rgb), 0.75);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
    word-break: break-word;
  }

  .company-name {
    font-weight: 600;
    color: var(--color-white);
  }

  .meta-separator {
    color: rgba(var(--color-white-rgb), 0.3);
  }

  .job-location {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: rgba(var(--color-white-rgb), 0.85);
  }

  .job-location svg {
    color: rgba(var(--color-white-rgb), 0.75);
  }

  .job-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid rgba(var(--color-white-rgb), 0.12);
    margin-top: auto;
    gap: 0.5rem;
  }

  .posted-time {
    font-size: var(--text-xs);
    color: rgba(var(--color-white-rgb), 0.65);
    font-weight: 500;
    white-space: nowrap;
  }

  /* Responsive Mobile Portrait Tier (240px - 479px) */
  @media (max-width: 479px) {
    .job-card {
      padding: var(--space-4);
      min-height: auto;
    }


    .company-icon-box {
      width: 38px;
      height: 38px;
    }

    .job-card-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .job-card.job-card-compact { min-height: 230px; padding: var(--space-5); }
  .job-card-compact .job-card-header, .job-card-compact .meta-separator { display: none; }
  .job-card-compact .job-meta { display: grid; gap: var(--space-2); }
  .job-card-compact .job-budget { font-size: var(--text-base); color: var(--color-white); font-weight: 700; margin-block: var(--space-4); }
</style>
