---
import Badge from '../ui/Badge.astro';
import ExpandableButton from '../ui/ExpandableButton.astro';

interface Props {
  job: {
    id: string;
    slug: string;
    title: string;
    company: string;
    city: string;
    modality?: string;
    contractType?: string;
    postedDays: string;
    accessibilityBadge: string;
    description?: string;
  };
}

const { job } = Astro.props;
---

<article class="job-card">
  <!-- Card Header -->
  <div class="job-card-header">
    <div class="company-icon-box">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
      </svg>
    </div>
    <div class="badge-container">
      <Badge variant="whatsapp">
        {job.accessibilityBadge}
      </Badge>
    </div>
  </div>

  <!-- Job Title -->
  <h3 class="job-title">
    <a href={`/empleos/${job.slug}`}>{job.title}</a>
  </h3>

  <!-- Company & Location -->
  <div class="job-meta">
    <span class="company-name">{job.company}</span>
    <span class="meta-separator">•</span>
    <span class="job-location">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      {job.city}
    </span>
  </div>

  <!-- Card Footer -->
  <div class="job-card-footer">
    <span class="posted-time">{job.postedDays}</span>
    <ExpandableButton href={`/empleos/${job.slug}`} text="Ver Puesto" variant="dark" size="sm" />
  </div>
</article>

<style>
  .job-card {
    background: var(--color-bg-card);
    border: 1px solid rgba(var(--color-primary-rgb), 0.1);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 290px;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    box-shadow: none; /* ZERO SHADOWS */
  }

  .job-card:hover {
    box-shadow: none; /* ZERO SHADOWS */
    /* NO TRANSLATEY, NO BORDER CHANGE */
  }

  .job-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: var(--space-4);
    min-width: 0;
  }

  .company-icon-box {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    background-color: rgba(var(--color-primary-rgb), 0.05);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .badge-container {
    min-width: 0;
    flex-shrink: 1;
    display: flex;
    justify-content: flex-end;
  }

  .job-title {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin-bottom: var(--space-2);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .job-title a {
    color: var(--color-primary);
    transition: color var(--transition-fast);
  }

  .job-title a:hover {
    color: var(--color-primary-light);
  }

  .job-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
    word-break: break-word;
  }

  .company-name {
    font-weight: 600;
    color: var(--color-text-main);
  }

  .meta-separator {
    color: var(--color-border-hover);
  }

  .job-location {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .job-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
    gap: 0.5rem;
  }

  .posted-time {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    font-weight: 500;
    white-space: nowrap;
  }

  /* Responsive Mobile Portrait Tier (240px - 479px) */
  @media (max-width: 479px) {
    .job-card {
      padding: var(--space-4);
      min-height: auto;
    }

    .job-card-header {
      align-items: flex-start;
      gap: 0.5rem;
    }

    .company-icon-box {
      width: 38px;
      height: 38px;
    }

    .job-card-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
