---
interface Props {
  profile: {
    id: string;
    slug: string;
    name: string;
    role: string;
    city: string;
    photo: string;
    tagline: string;
    availability: string;
    skills: string[];
  };
}

const { profile } = Astro.props;
---

<article class="story-card">
  <div class="story-image-wrap">
    <img
      src={profile.photo}
      alt={profile.name}
      class="story-image"
      loading="lazy"
    />
    <div class="story-gradient-overlay"></div>
  </div>

  <div class="story-content">

    <p class="story-city">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      {profile.city}, Bolivia
    </p>
    <h3 class="story-title">
      <a href={`/perfiles/${profile.slug}`}>
        {profile.name}: {profile.role}
      </a>
    </h3>


    <p class="story-quote">"{profile.tagline}"</p>
        <!-- Skills pills en lugar del badge -->
    <div class="story-skills-wrap">
      {profile.skills.slice(0, 3).map((skill) => (
        <span class="skill-pill">{skill}</span>
      ))}
      {profile.skills.length > 3 && (
        <span class="skill-pill skill-pill--more">+{profile.skills.length - 3}</span>
      )}
    </div>

    <a href={`/perfiles/${profile.slug}`} class="story-link">
      <span>Ver perfil</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>
  </div>
</article>

<style>
  .story-card {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    transition: transform var(--transition-smooth);
    box-shadow: none;
  }

  .story-card:hover {
    transform: translateY(-6px);
  }

  .story-image-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .story-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .story-card:hover .story-image {
    transform: scale(1.05);
  }

  .story-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(var(--color-primary-rgb), 0.05) 0%,
      rgba(var(--color-primary-rgb), 0.55) 45%,
      rgba(var(--color-primary-rgb), 0.97) 100%
    );
  }

  .story-content {
    position: relative;
    z-index: 2;
    padding: var(--space-6);
    color: var(--color-text-inverse);
  }

  /* Skills pills */
  .story-skills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .skill-pill {
    background-color: rgba(var(--color-accent-rgb), 0.2);
    color: var(--color-accent);
    border: 1px solid rgba(var(--color-accent-rgb), 0.35);
    font-family: var(--font-heading);
    font-size: clamp(0.6rem, 0.5vw + 0.5rem, 0.72rem);
    font-weight: 600;
    padding: clamp(0.15rem, 0.2vw + 0.1rem, 0.22rem) clamp(0.35rem, 0.5vw + 0.25rem, 0.5rem);
    border-radius: var(--radius-full);
    white-space: nowrap;
    line-height: 1.3;
  }

  .skill-pill--more {
    background-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.65);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .story-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-inverse);
    line-height: 1.3;
    margin-bottom: var(--space-2);
  }

  .story-title a {
    color: var(--color-text-inverse);
  }

  .story-title a:hover {
    color: var(--color-accent);
  }

  .story-city {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.65);
    font-weight: 500;
    margin-bottom: var(--space-2);
  }

  .story-quote {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.85);
    font-style: italic;
    line-height: 1.5;
    margin-bottom: var(--space-6);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .story-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    transition: gap var(--transition-fast);
  }

  .story-link:hover {
    gap: 0.75rem;
    color: var(--color-text-inverse);
  }

  @media (max-width: 479px) {
    .story-card {
      height: 480px;
    }
    .story-content {
      padding: var(--space-4);
    }
  }
</style>
