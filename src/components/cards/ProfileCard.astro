---
import ExpandableButton from "../ui/ExpandableButton.astro";

interface Props {
  profile: {
    id: string;
    slug: string;
    name: string;
    role: string;
    city: string;
    photo: string;
    tagline: string;
    availability: string;
    skills: string[];
  };
}

const { profile } = Astro.props;
---

<article class="profile-card">
  <!-- 1. Padded Inset Image with Gradient Overlay and Overlay Role/Name -->
  <div class="profile-image-wrapper">
    <img
      src={profile.photo}
      alt={profile.name}
      class="profile-img"
      loading="lazy"
    />
    <div class="profile-gradient-overlay" aria-hidden="true"></div>
    <div class="profile-image-overlay-content">
      <span class="profile-overlay-role">{profile.role}</span>
      <h3 class="profile-overlay-name">{profile.name}</h3>
    </div>
  </div>

  <!-- 2. Clean Card Body -->
  <div class="profile-body">
    <div class="profile-meta-city">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <span>{profile.city}, Bolivia</span>
    </div>

    <p class="profile-tagline">"{profile.tagline}"</p>

    <!-- Skills pills -->
    <div class="profile-skills-wrap">
      {
        profile.skills.slice(0, 3).map((skill) => (
          <span class="skill-pill">{skill}</span>
        ))
      }
      {
        profile.skills.length > 3 && (
          <span class="skill-pill skill-pill--more">
            +{profile.skills.length - 3}
          </span>
        )
      }
    </div>

    <div class="profile-btn-wrap">
      <ExpandableButton
        href={`/perfiles/${profile.slug}`}
        text="Ver Perfil"
        variant="primary-line"
        size="md"
      />
    </div>
  </div>
</article>

<style>
  .profile-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    box-shadow: none; /* ZERO SHADOWS */
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    transition: border-color var(--transition-fast);
  }

  .profile-card:hover {
    border-color: var(--color-border-hover);
  }

  /* Inset Image with Gradient */
  .profile-image-wrapper {
    position: relative;
    width: 100%;
    height: 270px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-bg-alt);
    flex-shrink: 0;
  }

  .profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* Gradient Overlay */
  .profile-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      transparent 35%,
      rgba(var(--color-primary-rgb), 0.45) 60%,
      rgba(var(--color-primary-rgb), 0.95) 100%
    );
    pointer-events: none;
  }

  /* Overlay Text: Profesión y Nombre */
  .profile-image-overlay-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-4);
    z-index: 2;
    color: var(--color-text-inverse);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .profile-overlay-role {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .profile-overlay-name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-inverse);
    line-height: 1.2;
    margin: 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }

  /* Card Body */
  .profile-body {
    padding-top: var(--space-4);
    padding-inline: var(--space-1);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .profile-meta-city {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .profile-meta-city svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .profile-tagline {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    line-height: 1.55;
    margin: 0 0 var(--space-4) 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Skills pills */
  .profile-skills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .skill-pill {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
    line-height: 1.3;
  }

  .skill-pill--more {
    background-color: rgba(var(--color-primary-rgb), 0.08);
    border-color: rgba(var(--color-primary-rgb), 0.2);
    color: var(--color-primary);
  }

  .profile-btn-wrap {
    margin-top: auto;
    padding-top: var(--space-2);
  }

  @media (max-width: 479px) {
    .profile-card {
      padding: var(--space-3);
    }
    .profile-image-wrapper {
      height: 240px;
    }
    .profile-body {
      padding-top: var(--space-3);
    }
  }
</style>
