---
import Skeleton from '../ui/Skeleton.astro';
---

<article class="profile-card profile-card-skeleton" aria-hidden="true">
  <!-- 1. Image Wrapper Skeleton -->
  <div class="profile-image-wrapper skeleton"></div>

  <!-- 2. Clean Card Body Skeleton -->
  <div class="profile-body">
    <div class="profile-meta-city-skeleton">
      <Skeleton width="105px" height="12px" />
    </div>

    <div class="profile-tagline-skeleton">
      <Skeleton width="90%" height="13px" />
      <Skeleton width="75%" height="13px" />
    </div>

    <!-- Skills pills -->
    <div class="profile-skills-wrap">
      <Skeleton variant="badge" width="65px" height="24px" />
      <Skeleton variant="badge" width="80px" height="24px" />
      <Skeleton variant="badge" width="55px" height="24px" />
    </div>

    <div class="profile-btn-wrap">
      <Skeleton variant="button" width="130px" height="38px" />
    </div>
  </div>
</article>

<style>
  .profile-card-skeleton {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    box-shadow: none;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .profile-image-wrapper {
    position: relative;
    width: 100%;
    height: 270px;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .profile-body {
    padding-top: var(--space-4);
    padding-inline: var(--space-1);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .profile-meta-city-skeleton {
    margin-bottom: var(--space-3);
  }

  .profile-tagline-skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .profile-skills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .profile-btn-wrap {
    margin-top: auto;
  }
</style>
