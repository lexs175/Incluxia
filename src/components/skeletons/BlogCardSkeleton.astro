---
import Skeleton from '../ui/Skeleton.astro';
---

<article class="blog-card blog-card-skeleton" aria-hidden="true">
  <div class="blog-image-wrapper skeleton"></div>

  <div class="blog-body">
    <div class="blog-title-skeleton">
      <Skeleton width="92%" height="20px" />
      <Skeleton width="70%" height="20px" />
    </div>

    <div class="blog-summary-skeleton">
      <Skeleton width="100%" height="14px" />
      <Skeleton width="90%" height="14px" />
      <Skeleton width="60%" height="14px" />
    </div>

    <div class="blog-btn-wrap">
      <Skeleton variant="button" width="125px" height="38px" />
    </div>
  </div>
</article>

<style>
  .blog-card-skeleton {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    height: 100%;
    flex: 1;
    box-shadow: none;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .blog-image-wrapper {
    position: relative;
    width: 100%;
    height: 220px;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .blog-body {
    padding-top: var(--space-5);
    padding-inline: var(--space-1);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .blog-title-skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .blog-summary-skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .blog-btn-wrap {
    margin-top: auto;
  }
</style>
