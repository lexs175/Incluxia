---
import Skeleton from '../ui/Skeleton.astro';
---

<article class="job-card offer-card offer-card-skeleton" aria-hidden="true">
  <!-- Publisher Header -->
  <div class="offer-publisher">
    <Skeleton variant="circle" width="40px" height="40px" />
    <div class="publisher-details">
      <Skeleton width="110px" height="13px" class="skeleton-company" />
      <Skeleton width="75px" height="10px" class="skeleton-location" />
    </div>
  </div>

  <!-- Content (Title + Budget) -->
  <div class="offer-content">
    <div class="skeleton-title-group">
      <Skeleton width="92%" height="18px" />
      <Skeleton width="65%" height="18px" />
    </div>
    <div class="skeleton-budget-row">
      <Skeleton width="105px" height="24px" />
      <Skeleton width="60px" height="14px" />
    </div>
  </div>

  <!-- Footer (Time + Button) -->
  <div class="job-card-footer">
    <Skeleton width="75px" height="14px" />
    <Skeleton variant="button" width="96px" height="34px" />
  </div>
</article>

<style>
  .offer-card-skeleton {
    display: flex;
    flex-direction: column;
    container-type: inline-size;
    min-width: 0;
    min-height: 280px;
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    box-sizing: border-box;
  }

  .offer-publisher {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 40px;
    padding-bottom: var(--space-3);
  }

  .publisher-details {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .offer-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
  }

  .skeleton-title-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .skeleton-budget-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .job-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
</style>
