---
import Skeleton from '../ui/Skeleton.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<article class:list={['story-card', 'story-card-skeleton', { 'story-card--compact': compact }]} aria-hidden="true">
  <div class="story-image-wrapper skeleton"></div>

  <div class="story-body">
    <div class="story-title-skeleton">
      <Skeleton width="88%" height="20px" />
      {!compact && <Skeleton width="60%" height="20px" />}
    </div>

    <div class="story-quote-skeleton">
      <Skeleton width="95%" height="14px" />
      <Skeleton width="80%" height="14px" />
    </div>

    <div class="story-btn-wrap">
      <Skeleton variant="button" width="130px" height="38px" />
    </div>
  </div>
</article>

<style>
  .story-card-skeleton {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    box-shadow: none;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .story-image-wrapper {
    position: relative;
    width: 100%;
    height: 220px;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .story-body {
    padding-top: var(--space-5);
    padding-inline: var(--space-1);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .story-title-skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .story-quote-skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .story-btn-wrap {
    margin-top: auto;
  }
</style>
