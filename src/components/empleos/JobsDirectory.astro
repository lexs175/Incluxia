<script>
  function initJobsMasterDetail() {
    const explorer = document.getElementById("jobsMasterExplorer");
    if (!explorer) return;

    const cards = explorer.querySelectorAll<HTMLElement>(".job-list-card");
    const panels = explorer.querySelectorAll<HTMLElement>(".job-detail-panel");
    const mobileBackBtn = document.getElementById("mobileBackBtn");
    const searchInput = document.getElementById("sidebarSearchInput") as HTMLInputElement | null;
    const cityPills = explorer.querySelectorAll<HTMLButtonElement>(".city-pill");
    const countText = document.getElementById("sidebarJobCount");
    const noResultsMsg = document.getElementById("sidebarNoResults");
    const toast = document.getElementById("jobToastNotification");
    const toastText = document.getElementById("jobToastText");

    let toastTimer: any = null;
    function showToast(msg: string) {
      if (!toast || !toastText) return;
      toastText.textContent = msg;
      toast.classList.add("is-visible");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.remove("is-visible");
      }, 2500);
    }

    // 1. Selección de Empleo
    function selectJob(jobId: string, openMobile: boolean = true) {
      cards.forEach((card) => {
        if (card.getAttribute("data-job-id") === jobId) {
          card.classList.add("active");
          card.setAttribute("aria-selected", "true");
        } else {
          card.classList.remove("active");
          card.setAttribute("aria-selected", "false");
        }
      });

      panels.forEach((panel) => {
        if (panel.getAttribute("data-job-id") === jobId) {
          panel.classList.add("active");
        } else {
          panel.classList.remove("active");
        }
      });

      if (openMobile && window.innerWidth < 992) {
        explorer.classList.add("is-mobile-detail-open");
        window.scrollTo({ top: explorer.offsetTop - 80, behavior: "smooth" });
      }
    }

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        const jobId = card.getAttribute("data-job-id");
        if (jobId) selectJob(jobId, true);
      });
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          const jobId = card.getAttribute("data-job-id");
          if (jobId) selectJob(jobId, true);
        }
      });
    });

    // 2. Retorno móvil
    if (mobileBackBtn) {
      mobileBackBtn.addEventListener("click", () => {
        explorer.classList.remove("is-mobile-detail-open");
      });
    }

    // 3. Menú flotante 3 puntos
    const menuTriggers = explorer.querySelectorAll<HTMLButtonElement>(".job-menu-trigger-btn");
    menuTriggers.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const wrapper = btn.closest(".menu-dropdown-wrapper");
        const dropdown = wrapper?.querySelector(".job-action-menu-dropdown");
        
        // Cerrar otros menús abiertos
        explorer.querySelectorAll(".job-action-menu-dropdown.is-open").forEach((m) => {
          if (m !== dropdown) m.classList.remove("is-open");
        });

        if (dropdown) dropdown.classList.toggle("is-open");
      });
    });

    // Cerrar menú al hacer clic fuera
    document.addEventListener("click", () => {
      explorer.querySelectorAll(".job-action-menu-dropdown.is-open").forEach((m) => {
        m.classList.remove("is-open");
      });
    });

    // 4. Copiar Vínculo
    const copyBtns = explorer.querySelectorAll<HTMLElement>(".action-copy-link");
    copyBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const slug = btn.getAttribute("data-job-slug");
        const url = `${window.location.origin}/empleos/${slug || ""}`;
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(() => {
            showToast("¡Enlace del empleo copiado al portapapeles!");
          }).catch(() => {
            showToast("Enlace: " + url);
          });
        }
      });
    });

    // 5. Guardar Vacante (Estrellita / Botón Guardar)
    const savedJobsKey = "incluxia_saved_jobs";
    function getSavedJobs(): string[] {
      try {
        return JSON.parse(localStorage.getItem(savedJobsKey) || "[]");
      } catch (e) {
        return [];
      }
    }

    function toggleSaveJob(jobId: string) {
      let saved = getSavedJobs();
      if (saved.includes(jobId)) {
        saved = saved.filter((id) => id !== jobId);
        showToast("Vacante eliminada de tus guardados");
      } else {
        saved.push(jobId);
        showToast("¡Vacante guardada con éxito!");
      }
      try {
        localStorage.setItem(savedJobsKey, JSON.stringify(saved));
      } catch (e) {}
      updateSavedButtonsUI();
    }

    function updateSavedButtonsUI() {
      const saved = getSavedJobs();
      explorer.querySelectorAll<HTMLElement>(".job-star-btn, .detail-save-btn").forEach((btn) => {
        const id = btn.getAttribute("data-job-id");
        if (id && saved.includes(id)) {
          btn.classList.add("is-saved");
          const label = btn.querySelector(".save-label");
          if (label) label.textContent = "Guardada";
        } else {
          btn.classList.remove("is-saved");
          const label = btn.querySelector(".save-label");
          if (label) label.textContent = "Guardar vacante";
        }
      });
    }

    explorer.querySelectorAll<HTMLElement>(".job-star-btn, .action-save-job").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const jobId = btn.getAttribute("data-job-id");
        if (jobId) toggleSaveJob(jobId);
      });
    });

    // Reportar oferta
    explorer.querySelectorAll<HTMLElement>(".action-report-job").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        showToast("Gracias por el reporte. El equipo de Incluxia revisará la oferta.");
      });
    });

    updateSavedButtonsUI();

    // 6. Filtros de Búsqueda y Ciudad
    let activeCity = "";
    let searchQuery = "";

    function filterJobs() {
      let visibleCount = 0;
      let firstVisibleId: string | null = null;

      cards.forEach((card) => {
        const itemCity = (card.getAttribute("data-city") || "").toLowerCase();
        const itemTitle = (card.getAttribute("data-title") || "").toLowerCase();
        const itemCompany = (card.getAttribute("data-company") || "").toLowerCase();

        const matchesCity = !activeCity || itemCity === activeCity.toLowerCase();
        const matchesQuery = !searchQuery || itemTitle.includes(searchQuery) || itemCompany.includes(searchQuery);

        if (matchesCity && matchesQuery) {
          card.style.display = "";
          visibleCount++;
          if (!firstVisibleId) firstVisibleId = card.getAttribute("data-job-id");
        } else {
          card.style.display = "none";
        }
      });

      if (countText) {
        countText.innerHTML = `<strong>${visibleCount}</strong> empleos verificados disponibles`;
      }

      if (noResultsMsg) {
        noResultsMsg.style.display = visibleCount === 0 ? "block" : "none";
      }

      // Si el seleccionado quedó oculto, seleccionar el primer visible
      const currentActive = explorer.querySelector(".job-list-card.active") as HTMLElement | null;
      if (currentActive && currentActive.style.display === "none" && firstVisibleId) {
        selectJob(firstVisibleId, false);
      }
    }

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        filterJobs();
      });
    }

    cityPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        cityPills.forEach((p) => p.classList.remove("active"));
        pill.classList.add("active");
        activeCity = pill.getAttribute("data-city") || "";
        filterJobs();
      });
    });

    const resetBtn = document.getElementById("resetFiltersBtn");
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        searchQuery = "";
        activeCity = "";
        cityPills.forEach((p) => {
          if (p.getAttribute("data-city") === "") p.classList.add("active");
          else p.classList.remove("active");
        });
        filterJobs();
      });
    }
  }

  document.addEventListener("astro:page-load", initJobsMasterDetail);
</script>
