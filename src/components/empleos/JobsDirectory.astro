---
import OfferCard from './OfferCard.astro';
import Button from '../ui/Button.astro';
import { seedJobs, categories } from '../../lib/demo';
const quickCategories = [...new Set(seedJobs.map(job => job.category))];
---
<section class="jobs-master-explorer" id="jobsMasterExplorer" data-filters-open="false" aria-label="Buscar ofertas de trabajo">
  <div class="jobs-toolbar">
    <button id="toggleJobFilters" class="filter-toggle" type="button" aria-expanded="false" aria-controls="jobFilters">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 17h16" /><circle cx="9" cy="7" r="3" fill="var(--color-white)" /><circle cx="15" cy="17" r="3" fill="var(--color-white)" /></svg><span>Filtros</span>
    </button>
    <div class="jobs-search-shell">
      <label class="jobs-search"><span class="visually-hidden">Buscar por puesto, empresa o especialidad</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg><input id="jobSearch" type="search" placeholder="Buscar ofertas…" autocomplete="off" /></label>
      <div class="job-type-options" role="group" aria-label="Tipo de trabajo"><button type="button" data-job-type="" aria-pressed="true">Todos</button><button type="button" data-job-type="employment" aria-pressed="false">Empleos</button><button type="button" data-job-type="project" aria-pressed="false">Proyectos</button></div>
    </div>
  </div>
  <div class="jobs-body">
    <aside class="jobs-filters" id="jobFilters" aria-labelledby="filters-heading" hidden>
      <div class="filters-heading-row"><h2 id="filters-heading">Filtros</h2><button type="button" class="filters-reset" data-reset-jobs>Limpiar</button></div>
      <form id="jobFilterForm">
        <input type="hidden" name="type" value="" />
        <details class="filter-group" open><summary>Ubicación<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary><label><span class="visually-hidden">Ubicación</span><select name="city"><option value="">Todas</option>{['Cochabamba', 'La Paz', 'Santa Cruz', 'Sucre', 'Tarija', 'Remoto'].map(city => <option>{city}</option>)}</select></label></details>
        <details class="filter-group"><summary>Modalidad<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary><label><span class="visually-hidden">Modalidad</span><select name="modality"><option value="">Todas</option><option>Presencial</option><option>Híbrido</option><option>Remoto</option></select></label></details>
        <details class="filter-group"><summary>Especialidad<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary><label><span class="visually-hidden">Especialidad</span><select name="category"><option value="">Todas</option>{categories.map(category => <option value={category.name}>{category.name}</option>)}</select></label></details>
        <details class="filter-group"><summary>Pago en Bs.<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary><div class="budget-fields"><label><span class="visually-hidden">Pago mínimo</span><input name="min" type="number" min="0" placeholder="Mínimo" /></label><label><span class="visually-hidden">Pago máximo</span><input name="max" type="number" min="0" placeholder="Máximo" /></label></div></details>
      </form>
      <div class="filters-apply"><button id="applyJobFilters" type="button">Ver resultados</button></div>
    </aside>
    <div class="jobs-results">
      <div class="quick-categories" role="group" aria-label="Filtrar por especialidad"><button type="button" data-job-category="" aria-pressed="true">Todas las áreas</button>{quickCategories.map(category => <button type="button" data-job-category={category} aria-pressed="false">{category}</button>)}</div>
      <div class="jobs-results-bar"><h1 class="results-count"><span id="jobResultCount" role="status" aria-live="polite"></span></h1><select id="jobSort" aria-label="Orden de las ofertas"><option value="recent">Más recientes</option><option value="oldest">Más antiguas</option></select></div>
      <div class="jobs-cards-grid" id="jobGrid">{seedJobs.map(job => <OfferCard job={job} />)}</div>
      <div id="jobsEmpty" class="jobs-empty" hidden><h2>No hay ofertas con esos filtros</h2><p>Prueba con otro puesto o amplía la búsqueda.</p><button type="button" class="reset-empty" data-reset-jobs>Quitar filtros</button></div>
      <div class="jobs-more" id="jobsMore" hidden><Button id="loadMoreJobs" text="Ver más ofertas" variant="primary-line" size="md" /></div>
    </div>
  </div>
  <template id="jobCardTemplate"><OfferCard job={seedJobs[0]} /></template>
</section>
<script>
  import { initJobs } from '../../lib/jobs';
  document.addEventListener('astro:page-load', initJobs);
</script>
<style>
  .jobs-master-explorer { width: 100%; }
  .jobs-toolbar { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: var(--space-3); margin-bottom: var(--space-6); }
  .filter-toggle { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 46px; padding-inline: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-white); color: var(--color-text-main); font-size: var(--text-sm); font-weight: 500; white-space: nowrap; }
  .filter-toggle[aria-expanded='true'] { background: var(--color-bg-alt); border-color: var(--color-border-hover); }
  .jobs-search-shell { display: flex; align-items: center; gap: var(--space-4); min-width: 0; padding: var(--space-1); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-white); }
  .jobs-search-shell:focus-within { border-color: var(--color-primary); }
  .jobs-search { display: flex; flex: 1; align-items: center; gap: var(--space-3); min-width: 0; padding-inline: var(--space-3); color: var(--color-text-muted); }
  .jobs-search svg { flex-shrink: 0; }
  .jobs-search input { width: 100%; min-width: 0; min-height: 36px; padding-block: var(--space-2); background: transparent; border: none; outline: none; font: inherit; font-size: var(--text-base); color: var(--color-text-main); }
  .jobs-search input::placeholder { color: var(--color-text-muted); }
  .job-type-options { display: flex; flex-shrink: 0; gap: var(--space-1); }
  .job-type-options button { min-height: 36px; padding-inline: var(--space-4); border-radius: var(--radius-md); font-size: var(--text-sm); color: var(--color-text-muted); }
  .job-type-options button[aria-pressed='true'] { background: var(--color-bg-alt); color: var(--color-text-main); font-weight: 600; }
  .jobs-body { display: grid; grid-template-columns: minmax(0, 1fr); align-items: start; gap: var(--space-6); }
  .jobs-master-explorer[data-filters-open='true'] .jobs-body { grid-template-columns: 248px minmax(0, 1fr); }
  .jobs-results { min-width: 0; container: job-results / inline-size; }
  .quick-categories { display: flex; align-items: center; gap: var(--space-2); max-width: 100%; overflow-x: auto; padding-block: var(--space-1); scrollbar-width: none; }
  .quick-categories::-webkit-scrollbar { display: none; }
  .quick-categories button { flex-shrink: 0; min-height: 40px; padding-inline: var(--space-4); border: 1px solid transparent; border-radius: var(--radius-md); font-size: var(--text-sm); color: var(--color-text-muted); white-space: nowrap; }
  .quick-categories button[aria-pressed='true'] { border-color: var(--color-border); background: var(--color-white); color: var(--color-text-main); font-weight: 600; }
  .quick-categories button:hover { color: var(--color-text-main); background: var(--color-bg-alt); }
  .jobs-results-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3); min-height: 40px; margin-block: var(--space-3); }
  .results-count { margin: 0; font-size: var(--text-sm); font-weight: 400; color: var(--color-text-muted); }
  .jobs-results-bar select { max-width: 100%; padding: var(--space-2); padding-right: var(--space-6); border: none; background: transparent; font-size: var(--text-sm); color: var(--color-text-muted); cursor: pointer; }
  .jobs-cards-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); }
  .jobs-filters { position: sticky; top: calc(var(--app-header-height) + var(--space-6)); min-width: 0; padding: var(--space-4); border-radius: var(--radius-md); background: var(--color-white); }
  .filters-heading-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-3); }
  .filters-heading-row h2 { font-size: var(--text-base); font-weight: 600; color: var(--color-text-main); }
  .filters-reset { min-height: 40px; color: var(--color-text-muted); font-size: var(--text-sm); text-underline-offset: 4px; }
  .filters-reset:hover { text-decoration: underline; }
  .filter-group { border-top: 1px solid var(--color-border); padding-block: var(--space-2); }
  .filter-group summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); min-height: 44px; cursor: pointer; list-style: none; font-size: var(--text-sm); font-weight: 500; color: var(--color-text-main); }
  .filter-group summary::-webkit-details-marker { display: none; }
  .filter-group[open] summary svg { transform: rotate(180deg); }
  .filter-group label { display: block; min-width: 0; }
  .filter-group select, .filter-group input { width: 100%; min-width: 0; min-height: 44px; margin-block: var(--space-2); padding: var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg); font: inherit; font-size: var(--text-sm); color: var(--color-text-main); }
  .filter-group input::placeholder { color: var(--color-text-muted); }
  .budget-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
  .filters-apply { display: none; }
  .filters-apply button { width: 100%; min-height: 44px; margin-top: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-white); color: var(--color-text-main); font-size: var(--text-sm); }
  .jobs-empty { padding: var(--space-12) var(--space-6); border-radius: var(--radius-md); background: var(--color-white); text-align: center; }
  .jobs-empty h2 { font-size: var(--text-xl); color: var(--color-text-main); margin-bottom: var(--space-3); }
  .jobs-empty p { color: var(--color-text-muted); font-size: var(--text-base); margin-bottom: var(--space-5); }
  .reset-empty { min-height: 44px; padding-inline: var(--space-5); border-radius: var(--radius-md); background: var(--color-primary); color: var(--color-white); font-size: var(--text-sm); font-weight: 600; }
  .jobs-more { text-align: center; margin-top: var(--space-8); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @container job-results (max-width: 1260px) { .jobs-cards-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @container job-results (max-width: 940px) { .jobs-cards-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @container job-results (max-width: 580px) { .jobs-cards-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 767px) {
    .jobs-master-explorer[data-filters-open='true'] .jobs-body { grid-template-columns: minmax(0, 1fr); }
    .jobs-filters { position: static; }
    .jobs-filters form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
    .filters-apply { display: block; }
    .jobs-toolbar { display: flex; flex-wrap: wrap; margin-bottom: var(--space-4); }
    .jobs-search-shell { display: contents; }
    .jobs-search { min-height: 46px; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-white); }
    .job-type-options { flex-basis: 100%; }
    .job-type-options button { min-height: 40px; }
    .jobs-cards-grid { gap: var(--space-4); }
  }
  @media (max-width: 359px) { .jobs-filters form { grid-template-columns: minmax(0, 1fr); } .filter-toggle { padding-inline: var(--space-3); } }
</style>
