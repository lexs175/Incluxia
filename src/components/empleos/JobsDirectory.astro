---
import ExpandableButton from "../ui/ExpandableButton.astro";

interface Props {
  jobs: any[];
}

const { jobs } = Astro.props;
---

<div class="jobs-master-explorer" id="jobsMasterExplorer">
  <!-- ====================================================
       1. COLUMNA IZQUIERDA: SIDEBAR / LISTADO DE EMPLEOS
       ==================================================== -->
  <aside class="jobs-sidebar-column" aria-label="Listado de vacantes de empleo">
    <!-- Cabecera del Sidebar: Contador + Buscador y Filtros -->
    <div class="sidebar-header-box">
      <div class="sidebar-count-row">
        <span class="sidebar-count-text" id="sidebarJobCount">
          <strong>{jobs.length}</strong> empleos verificados disponibles
        </span>
        <span class="sidebar-guarantee-pill">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Ley 977
        </span>
      </div>

      <!-- Barra de búsqueda rápida -->
      <div class="sidebar-search-wrap">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="text"
          id="sidebarSearchInput"
          placeholder="Buscar puesto o empresa..."
          class="sidebar-search-input"
          aria-label="Buscar ofertas de empleo"
        />
      </div>

      <!-- Pastillas de filtro de ciudad -->
      <div class="sidebar-city-pills" id="sidebarCityPills" role="tablist" aria-label="Filtro por ciudad">
        <button type="button" class="city-pill active" data-city="">Todas</button>
        <button type="button" class="city-pill" data-city="Cochabamba">Cochabamba</button>
        <button type="button" class="city-pill" data-city="La Paz">La Paz</button>
        <button type="button" class="city-pill" data-city="Santa Cruz">Santa Cruz</button>
      </div>
    </div>

    <!-- Lista Scrollable de Tarjetas de Empleo -->
    <div class="sidebar-scrollable-list" id="sidebarJobList" role="tablist" aria-orientation="vertical">
      {
        jobs.map((job, index) => (
          <article
            class={`job-list-card ${index === 0 ? "active" : ""}`}
            data-job-id={job.id}
            data-city={job.city}
            data-title={job.title.toLowerCase()}
            data-company={job.company.toLowerCase()}
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            tabindex="0"
          >
            <!-- Indicador activo lateral izquierdo -->

            <div class="job-card-inner">
              <div class="job-card-top-row">
                <!-- Avatar circular de la empresa -->
                <div class="company-avatar-box" aria-hidden="true">
                  <span>{job.companyInitial || job.company.charAt(0)}</span>
                </div>

                <!-- Título y Empresa -->
                <div class="job-card-titles">
                  <h3 class="job-card-title">{job.title}</h3>
                  <p class="job-card-meta">
                    <span class="meta-company">{job.company}</span>
                    <span class="meta-dot">•</span>
                    <span class="meta-city">{job.city}</span>
                    <span class="meta-dot">•</span>
                    <span class="meta-modality">{job.modality}</span>
                  </p>
                </div>

                <!-- Botones superiores derechos: 3 puntos y estrella -->
                <div class="job-card-actions">
                  <div class="menu-dropdown-wrapper">
                    <button
                      type="button"
                      class="job-action-icon-btn job-menu-trigger-btn"
                      aria-label="Más opciones"
                      data-job-slug={job.slug}
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <circle cx="12" cy="12" r="2"></circle>
                        <circle cx="19" cy="12" r="2"></circle>
                        <circle cx="5" cy="12" r="2"></circle>
                      </svg>
                    </button>

                    <!-- Menú desplegable flotante de 3 puntos -->
                    <div class="job-action-menu-dropdown" role="menu">
                      <button type="button" class="dropdown-item-btn action-save-job" role="menuitem" data-job-id={job.id}>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        <span>Guardar vacante</span>
                      </button>
                      <a
                        href={`https://wa.me/59172255726?text=${encodeURIComponent(`Hola Incluxia, deseo postular a la vacante "${job.title}" en "${job.company}" (${job.city}).`)}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="dropdown-item-btn action-apply-job"
                        role="menuitem"
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Postular por WhatsApp</span>
                      </a>
                      <button type="button" class="dropdown-item-btn action-copy-link" role="menuitem" data-job-slug={job.slug}>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                        </svg>
                        <span>Copiar vínculo</span>
                      </button>
                      <div class="dropdown-divider"></div>
                      <button type="button" class="dropdown-item-btn action-report-job text-danger" role="menuitem" data-job-id={job.id}>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                          <line x1="12" y1="9" x2="12" y2="13"></line>
                          <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        <span>Reportar oferta</span>
                      </button>
                    </div>
                  </div>

                  <!-- Botón Estrella de Guardar -->
                  <button
                    type="button"
                    class="job-action-icon-btn job-star-btn"
                    aria-label="Guardar oferta como favorita"
                    data-job-id={job.id}
                  >
                    <svg class="star-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Fila inferior de Pastillas: Tipo de trabajo + Sueldo mensual destacado -->
              <div class="job-card-bottom-row">
                <span class="badge-pill contract-pill">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                  </svg>
                  {job.contractType}
                </span>

                <span class="badge-pill salary-pill">
                  {job.salary}
                </span>
              </div>
            </div>
          </article>
        ))
      }

      <div id="sidebarNoResults" class="sidebar-no-results" style="display: none;">
        <p class="no-results-text">No se encontraron empleos con ese criterio.</p>
        <button type="button" class="reset-filter-btn" id="resetFiltersBtn">Ver todos los empleos</button>
      </div>
    </div>
  </aside>

  <!-- ====================================================
       2. COLUMNA DERECHA: PANEL DE DETALLE DINÁMICO
       ==================================================== -->
  <main class="jobs-detail-column" id="jobsDetailColumn" aria-live="polite">
    <!-- Barra superior para móviles (Volver a la lista) -->
    <div class="mobile-back-bar">
      <button type="button" class="mobile-back-btn" id="mobileBackBtn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Volver a la lista de ofertas</span>
      </button>
    </div>

    <!-- Paneles de detalle pre-renderizados para cada vacante -->
    {
      jobs.map((job, index) => {
        const whatsappApplyUrl = `https://wa.me/59172255726?text=${encodeURIComponent(
          `Hola Incluxia, deseo postular a la vacante de "${job.title}" en "${job.company}" (${job.city}). Adjunto mis datos y CV.`
        )}`;

        return (
          <div
            class={`job-detail-panel ${index === 0 ? "active" : ""}`}
            id={`detail-panel-${job.id}`}
            data-job-id={job.id}
            role="tabpanel"
            aria-labelledby={`tab-${job.id}`}
          >
            <!-- Cabecera del Detalle -->
            <header class="detail-header-card">
              <div class="detail-header-top">
                <div class="detail-company-logo-box" aria-hidden="true">
                  <span>{job.companyInitial || job.company.charAt(0)}</span>
                </div>

                <div class="detail-header-info">
                  <h2 class="detail-job-title">{job.title}</h2>
                  <div class="detail-job-meta-row">
                    <span class="detail-company-name">
                      {job.company}
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    </span>
                    <span class="detail-meta-dot">•</span>
                    <span class="detail-city-tag">{job.city}, Bolivia</span>
                    <span class="detail-meta-dot">•</span>
                    <span class="detail-modality-tag">{job.modality}</span>
                  </div>
                </div>
              </div>

              <!-- Barra de Acciones y Sueldo Destacado -->
              <div class="detail-action-bar">
                <div class="action-buttons-group">
                  <ExpandableButton
                    href={whatsappApplyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    text="Postular por WhatsApp"
                    variant="primary"
                    size="md"
                  />

                  <button
                    type="button"
                    class="detail-save-btn action-save-job"
                    data-job-id={job.id}
                  >
                    <svg class="star-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    <span class="save-label">Guardar vacante</span>
                  </button>

                  <button
                    type="button"
                    class="detail-dots-btn action-copy-link"
                    title="Copiar enlace de vacante"
                    data-job-slug={job.slug}
                    aria-label="Copiar enlace de vacante"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                    </svg>
                  </button>
                </div>

                <!-- Monto que se paga en la oferta laboral -->
                <div class="detail-salary-box">
                  <span class="salary-prefix">Sueldo mensual:</span>
                  <span class="salary-amount">{job.salary}</span>
                </div>
              </div>
            </header>

            <!-- Cuerpo del Detalle (2 Columnas internas: Contenido + Ficha Técnica) -->
            <div class="detail-body-grid">
              <!-- Sub-columna Izquierda: Descripción y Requisitos -->
              <div class="detail-main-content">
                <!-- Descripción del puesto -->
                <section class="detail-section" aria-labelledby={`desc-title-${job.id}`}>
                  <p class="detail-lead-desc">{job.description}</p>
                </section>

                <!-- Funciones principales -->
                <section class="detail-section" aria-labelledby={`func-title-${job.id}`}>
                  <h3 id={`func-title-${job.id}`} class="detail-section-title">Funciones principales</h3>
                  <ul class="detail-bullets-list" role="list">
                    {job.functions.map((fn) => (
                      <li class="detail-bullet-item">
                        <span class="bullet-point" aria-hidden="true">•</span>
                        <span>{fn}</span>
                      </li>
                    ))}
                  </ul>
                </section>

                <!-- Requisitos indispensables -->
                <section class="detail-section" aria-labelledby={`req-title-${job.id}`}>
                  <h3 id={`req-title-${job.id}`} class="detail-section-title">Requisitos del postulante</h3>
                  <ul class="detail-bullets-list" role="list">
                    {job.requirements.map((req) => (
                      <li class="detail-bullet-item">
                        <span class="bullet-point" aria-hidden="true">•</span>
                        <span>{req}</span>
                      </li>
                    ))}
                  </ul>
                </section>

                <!-- Adaptaciones de Accesibilidad e Inclusión Hipoacusia -->
                <section class="detail-section accessibility-guarantee-section" aria-labelledby={`acc-title-${job.id}`}>
                  <h3 id={`acc-title-${job.id}`} class="detail-section-title">Garantías de accesibilidad para hipoacusia</h3>
                  <div class="accessibility-cards-grid">
                    {job.accessibilityHighlights.map((highlight) => (
                      <div class="accessibility-feature-box">
                        <div class="feature-header-row">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                          <h4 class="feature-title">{highlight.title}</h4>
                        </div>
                        <p class="feature-desc">{highlight.desc}</p>
                      </div>
                    ))}
                  </div>
                </section>

                <!-- Barra de postulación repetida al final -->
                <div class="detail-bottom-apply-bar">
                  <ExpandableButton
                    href={whatsappApplyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    text="Postular por WhatsApp"
                    variant="primary"
                    size="md"
                  />
                  <button
                    type="button"
                    class="detail-save-btn action-save-job"
                    data-job-id={job.id}
                  >
                    <svg class="star-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    <span class="save-label">Guardar vacante</span>
                  </button>
                </div>
              </div>

              <!-- Sub-columna Derecha: Ficha Técnica Lateral del Empleo -->
              <aside class="detail-sidebar-card" aria-label="Ficha técnica de la oferta">
                <div class="meta-field-item">
                  <span class="meta-field-label">TIPO DE TRABAJO</span>
                  <span class="meta-field-value">{job.contractType}</span>
                </div>

                <div class="meta-field-item">
                  <span class="meta-field-label">UBICACIÓN DE LA VACANTE</span>
                  <span class="meta-field-value">{job.city}, Bolivia ({job.modality})</span>
                </div>

                <div class="meta-field-item">
                  <span class="meta-field-label">CONTACTO DE CONTRATACIÓN</span>
                  <div class="recruiter-box">
                    <span class="recruiter-avatar" aria-hidden="true">{job.companyInitial}</span>
                    <span class="meta-field-value">{job.recruiter}</span>
                  </div>
                </div>

                <div class="meta-field-item">
                  <span class="meta-field-label">NÚMERO DE SOLICITANTES</span>
                  <span class="meta-field-value bold-value">{job.applicantsCount}</span>
                </div>

                <div class="meta-field-item">
                  <span class="meta-field-label">FECHA DE PUBLICACIÓN</span>
                  <span class="meta-field-value">{job.postedDate}</span>
                </div>

                <div class="meta-field-item">
                  <span class="meta-field-label">SECTORES Y HABILIDADES</span>
                  <div class="sectors-pill-wrap">
                    {job.sectors.map((sector) => (
                      <span class="sector-tag">{sector}</span>
                    ))}
                  </div>
                </div>

                <div class="meta-field-item law-protection-item">
                  <span class="meta-field-label">MARCO LEGAL DE INCLUSIÓN</span>
                  <span class="law-tag">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    Protección Ley N° 977 / SIPRUNPCD
                  </span>
                </div>
              </aside>
            </div>
          </div>
        );
      })
    }
  </main>
</div>

<!-- Notificación Toast de confirmación al copiar enlace o guardar -->
<div id="jobToastNotification" class="job-toast-notification" role="status" aria-live="polite">
  <span id="jobToastText">¡Enlace copiado al portapapeles!</span>
</div>

<style>
  /* ====================================================
     ESTRUCTURA GENERAL DEL MASTER-DETAIL EXPLORER
     Arquitectura de 2 columnas con scroll independiente
     ==================================================== */
  .jobs-master-explorer {
    display: grid;
    grid-template-columns: minmax(340px, 390px) 1fr;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    height: calc(100dvh - 120px);
    min-height: 680px;
    box-sizing: border-box;
    position: relative;
  }

  /* ====================================================
     1. COLUMNA IZQUIERDA: SIDEBAR / LISTADO
     ==================================================== */
  .jobs-sidebar-column {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--color-border);
    background-color: var(--color-bg-card);
    height: 100%;
    overflow: hidden;
  }

  /* Cabecera del Sidebar */
  .sidebar-header-box {
    padding: var(--space-4) var(--space-4) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .sidebar-count-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .sidebar-count-text {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    color: var(--color-text-main);
  }

  .sidebar-count-text strong {
    color: var(--color-primary);
  }

  .sidebar-guarantee-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    background-color: rgba(var(--color-primary-rgb), 0.08);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
  }

  /* Buscador en Sidebar */
  .sidebar-search-wrap {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-light);
    pointer-events: none;
  }

  .sidebar-search-input {
    width: 100%;
    padding: 0.55rem 0.75rem 0.55rem 2.2rem;
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-main);
    outline: none;
    transition: border-color var(--transition-fast);
    box-sizing: border-box;
  }

  .sidebar-search-input:focus {
    border-color: var(--color-primary);
    background-color: var(--color-white);
  }

  /* Pastillas de filtro por ciudad */
  .sidebar-city-pills {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    overflow-x: auto;
    padding-bottom: 2px;
  }

  .city-pill {
    padding: 0.25rem 0.65rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .city-pill:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .city-pill.active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-inverse);
  }

  /* Lista de Empleos con Scroll Vertical */
  .sidebar-scrollable-list {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* Tarjeta de Lista */
  .job-list-card {
    position: relative;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
    user-select: none;
  }

  .job-list-card:hover {
    border-color: var(--color-primary);
    background-color: rgba(var(--color-primary-rgb), 0.02);
  }

  .job-list-card.active {
    background-color: rgba(var(--color-primary-rgb), 0.04);
    border-color: var(--color-primary);
  }

  .job-card-inner {
    padding: var(--space-4) var(--space-4) var(--space-4) calc(var(--space-4) + 2px);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

