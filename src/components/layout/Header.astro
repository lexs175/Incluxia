---
import ExpandableButton from "../ui/ExpandableButton.astro";

interface Props {
  activePath?: string;
}

const { activePath = "/" } = Astro.props;

interface NavLink {
  label: string;
  href: string;
  access: 'guest' | 'member';
  children?: { label: string; href: string }[];
}
const navLinks: NavLink[] = [
  { label: "Inicio", href: "/", access: "guest" },
  { label: "Casos de éxito", href: "/casos-de-exito", access: "guest" },
  { label: "Inicio", href: "/", access: "member" },
  { label: "Contratar", href: "/contratar", access: "member" },
  { label: "Publicar", href: "/publicar", access: "member", children: [
    { label: "Crear publicación", href: "/publicar" },
    { label: "Mis publicaciones", href: "/publicar?tab=mine" },
  ] },
  { label: "Postulaciones", href: "/postulaciones", access: "member", children: [
    { label: "Enviadas", href: "/postulaciones?tab=sent" },
    { label: "Recibidas", href: "/postulaciones?tab=received" },
  ] },
  { label: "Perfil", href: "/perfil", access: "member" },
];
---

<header class="header">
  <div class="container header-container">
    <div class="navbar-capsule">
      <!-- Logo -->
      <a href="/" class="brand" aria-label="Incluxia Bolivia - Inicio">
        <span class="app-brand" data-member>Incluxia</span>
        <!--<img
          src="/images/logo.png"
          alt="Incluxia Bolivia"
          class="brand-logo"
          onerror="this.src='/images/Logo incluxia horizontal-03.png'"
        />-->
      </a>

      <!-- Desktop Navigation -->
      <nav class="nav-desktop" aria-label="Navegación principal">
        <ul class="nav-list">
          {
            navLinks.map((link) => {
              const isActive =
                activePath === link.href ||
                (link.href !== "/" && activePath.startsWith(link.href));
              return (
                <li data-access={link.access}>
                  {link.children ? (
                    <details class="nav-dropdown" data-nav-dropdown>
                      <summary class={`nav-link ${isActive ? "active" : ""}`}>
                        {link.label}
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                      </summary>
                      <ul class="nav-submenu" aria-label={link.label}>
                        {link.children.map(child => <li><a href={child.href} data-nav-destination>{child.label}</a></li>)}
                      </ul>
                    </details>
                  ) : (
                    <a href={link.href} class={`nav-link ${isActive ? "active" : ""}`} aria-current={isActive ? "page" : undefined}>{link.label}</a>
                  )}
                </li>
              );
            })
          }
        </ul>
      </nav>

      <!-- Header Actions -->
      <div class="header-actions">
        <!-- Botón Publicar Trabajo (CTA Principal) -->
        <ExpandableButton text="Crear cuenta" size="sm" variant="primary" data-auth-trigger="register" data-guest />

        <!-- 1. Botón Ingresar (Visible solo cuando NO ha iniciado sesión) -->
        <ExpandableButton text="Ingresar" id="btnHeaderLogin" size="sm" variant="primary-line" data-auth-trigger="login" data-guest />

        <!-- 2. Perfil Autenticado (Recién aparece cuando hayan llenado la simulación de acceso) -->
        <div
          class="header-profile-wrapper"
          id="headerProfileWrapper"
          style="display: none;"
        >
          <a
            href="/perfil"
            class="header-profile-link"
            id="headerProfileLink"
            aria-label="Ver mi perfil profesional"
            title="Ver mi perfil profesional"
          >
            <div class="header-profile-avatar-wrap">
              <img
                src="/images/profiles/valeria-morales.jpg"
                alt="Valeria Morales"
                class="header-profile-img"
                id="headerProfileImg"
                width="38"
                height="38"
                loading="eager"
              />
              <span class="header-profile-status-dot" aria-hidden="true"></span>
            </div>
            <span class="header-profile-name" id="headerProfileName">Valeria</span>
          </a>

          <button
            type="button"
            class="header-logout-btn"
            id="btnHeaderLogout"
            aria-label="Cerrar sesión"
            title="Cerrar sesión"
          >
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
          </button>
        </div>

        <!-- Mobile Hamburger Button -->
        <button
          class="mobile-toggle"
          id="mobileMenuBtn"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
        >
          <svg
            class="icon-open"
            xmlns="http://www.w3.org/2000/svg"
            width="26"
            height="26"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg
            class="icon-close"
            xmlns="http://www.w3.org/2000/svg"
            width="26"
            height="26"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer Floating Dropdown -->
    <div class="mobile-drawer" id="mobileDrawer">
      <nav class="nav-mobile">
        <!-- Mobile Auth State Box -->
        <div class="mobile-auth-box" id="mobileAuthBox">
          <div id="mobileGuestBox" class="mobile-guest-content">
            <ExpandableButton text="Crear cuenta" size="sm" data-auth-trigger="register" />
            <ExpandableButton text="Ingresar" size="sm" variant="primary-line" data-auth-trigger="login" />
          </div>

          <div id="mobileUserBox" class="mobile-user-content" style="display: none;">
            <div class="mobile-user-info">
              <span class="mobile-avatar" id="mobileUserInitial">U</span>
              <div class="mobile-user-text">
                <strong id="mobileUserName">Usuario</strong>
                <span id="mobileUserRole">Candidato verificado</span>
              </div>
            </div>
            <button
              type="button"
              class="mobile-logout-btn"
              id="btnMobileLogout"
              aria-label="Cerrar sesión"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              <span>Salir</span>
            </button>
          </div>
        </div>

        <ul class="mobile-nav-list">
          {
            navLinks.map((link) => {
              const isActive =
                activePath === link.href ||
                (link.href !== "/" && activePath.startsWith(link.href));
              return (
                <li data-access={link.access}>
                  {link.children ? (
                    <details class="nav-dropdown mobile-nav-dropdown" data-nav-dropdown>
                      <summary class={`mobile-nav-link ${isActive ? "active" : ""}`}>
                        {link.label}
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                      </summary>
                      <ul class="nav-submenu" aria-label={link.label}>
                        {link.children.map(child => <li><a href={child.href} data-nav-destination>{child.label}</a></li>)}
                      </ul>
                    </details>
                  ) : (
                    <a href={link.href} class={`mobile-nav-link ${isActive ? "active" : ""}`}>{link.label}</a>
                  )}
                </li>
              );
            })
          }
        </ul>

        <div class="mobile-drawer-cta" id="mobileDrawerProfileCard" style="display: none;">
          <a
            href="/perfil"
            class="mobile-drawer-profile-card"
            aria-label="Ver perfil de Valeria Morales"
          >
            <div class="mobile-drawer-avatar-wrap">
              <img
                src="/images/profiles/valeria-morales.jpg"
                alt="Valeria Morales"
                class="mobile-drawer-profile-img"
                width="42"
                height="42"
                loading="lazy"
              />
              <span class="header-profile-status-dot" aria-hidden="true"></span>
            </div>
            <div class="mobile-drawer-profile-info">
              <span class="mobile-drawer-profile-name" id="mobileDrawerProfileName">Valeria Morales Terán</span>
              <span class="mobile-drawer-profile-action">Ver mi perfil</span>
            </div>
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  import { readStore, user as currentUser, writeStore } from "../../lib/demo";
  function updateHeaderAuthState() {
    const guestBtn = document.getElementById("btnHeaderLogin");
    const profileWrapper = document.getElementById("headerProfileWrapper");
    const profileName = document.getElementById("headerProfileName");

    const mobileGuest = document.getElementById("mobileGuestBox");
    const mobileUser = document.getElementById("mobileUserBox");
    const mobileInitial = document.getElementById("mobileUserInitial");
    const mobileName = document.getElementById("mobileUserName");
    const mobileRole = document.getElementById("mobileUserRole");
    const mobileDrawerProfile = document.getElementById("mobileDrawerProfileCard");
    const mobileDrawerProfileName = document.getElementById("mobileDrawerProfileName");

    try {
      const account = currentUser();
      const stored = account ? JSON.stringify(account) : null;
      document.documentElement.dataset.session = account ? "member" : "guest";
      if (stored) {
        const user = JSON.parse(stored);
        const displayName = user.name;
        const initial = displayName ? displayName.charAt(0).toUpperCase() : "U";

        // Autenticado: ocultar botón Ingresar y mostrar perfil
        if (guestBtn) guestBtn.style.display = "none";
        if (profileWrapper) profileWrapper.style.display = "inline-flex";
        if (profileName) profileName.textContent = displayName ? displayName.split(" ")[0] : "Perfil";
        const image = document.getElementById("headerProfileImg") as HTMLImageElement | null;
        if (image) { image.hidden = !user.photo; if (user.photo) { image.src = user.photo; image.alt = user.name; } }

        if (mobileGuest) mobileGuest.style.display = "none";
        if (mobileUser) mobileUser.style.display = "flex";
        if (mobileInitial) mobileInitial.textContent = initial;
        if (mobileName) mobileName.textContent = displayName || "Usuario";
        if (mobileRole) {
          mobileRole.textContent = "Cuenta común · Trabajar y contratar";
        }
        if (mobileDrawerProfile) mobileDrawerProfile.style.display = "block";
        const mobileLink = mobileDrawerProfile?.querySelector("a");
        mobileLink?.setAttribute("aria-label", "Ver mi perfil");
        const mobileImage = mobileDrawerProfile?.querySelector("img");
        if (mobileImage) { mobileImage.hidden = !user.photo; if (user.photo) { mobileImage.src = user.photo; mobileImage.alt = user.name; } }
        if (mobileDrawerProfileName && displayName) {
          mobileDrawerProfileName.textContent = displayName;
        }
      } else {
        // Invitado / Nadie ha llenado datos: mostrar botón Ingresar y OCULTAR perfil
        if (guestBtn) guestBtn.style.display = "inline-flex";
        if (profileWrapper) profileWrapper.style.display = "none";

        if (mobileGuest) mobileGuest.style.display = "block";
        if (mobileUser) mobileUser.style.display = "none";
        if (mobileDrawerProfile) mobileDrawerProfile.style.display = "none";
      }
    } catch {
      // Ignorar error de parsing
    }
  }

  function handleLogout() {
    const state = readStore();
    state.sessionId = null;
    writeStore(state);
    window.location.assign("/");
  }

  let headerEvents: AbortController | undefined;

  function initHeader() {
    const root = document.querySelector(".header") as HTMLElement;
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";
    headerEvents?.abort();
    headerEvents = new AbortController();
    const signal = headerEvents.signal;
    const dropdowns = [...root.querySelectorAll<HTMLDetailsElement>('[data-nav-dropdown]')];
    const closeDropdowns = (except?: HTMLDetailsElement) => dropdowns.forEach(dropdown => { if (dropdown !== except) dropdown.open = false; });
    const markDestination = () => {
      const current = new URL(location.href);
      for (const link of root.querySelectorAll<HTMLAnchorElement>('[data-nav-destination]')) {
        const destination = new URL(link.href);
        const defaultTab = destination.pathname === '/publicar' ? 'new' : 'sent';
        const selected = destination.pathname === current.pathname && (destination.searchParams.get('tab') || defaultTab) === (current.searchParams.get('tab') || defaultTab);
        if (selected) link.setAttribute('aria-current', 'page'); else link.removeAttribute('aria-current');
      }
    };
    dropdowns.forEach(dropdown => {
      dropdown.addEventListener('toggle', () => { if (dropdown.open) closeDropdowns(dropdown); }, { signal });
      if (!dropdown.classList.contains('mobile-nav-dropdown')) {
        dropdown.addEventListener('pointerenter', event => {
          if (event.pointerType !== 'mouse' || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
          closeDropdowns(dropdown);
          dropdown.open = true;
        }, { signal });
        dropdown.addEventListener('pointerleave', () => {
          if (!dropdown.contains(document.activeElement)) dropdown.open = false;
        }, { signal });
        dropdown.addEventListener('focusout', event => {
          if (!dropdown.contains(event.relatedTarget as Node | null) && !dropdown.matches(':hover')) dropdown.open = false;
        }, { signal });
      }
      dropdown.querySelectorAll('a').forEach(link => link.addEventListener('click', () => closeDropdowns(), { signal }));
    });
    document.addEventListener('click', event => {
      const target = event.target as Node;
      dropdowns.forEach(dropdown => { if (!dropdown.contains(target)) dropdown.open = false; });
    }, { signal });
    document.addEventListener('incluxia:view-changed', markDestination, { signal });
    markDestination();
    const btn = document.getElementById("mobileMenuBtn");
    const drawer = document.getElementById("mobileDrawer");
    const mobileLinks = drawer?.querySelectorAll("a");

    if (btn && drawer) {
      btn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = drawer.classList.toggle("open");
        btn.classList.toggle("open", isOpen);
        btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
      };

      mobileLinks?.forEach((link) => {
        link.onclick = () => {
          drawer.classList.remove("open");
          btn.classList.remove("open");
          btn.setAttribute("aria-expanded", "false");
        };
      });

      const mobileAuthTrigger = drawer.querySelector("[data-auth-trigger]");
      if (mobileAuthTrigger) {
        mobileAuthTrigger.addEventListener("click", () => {
          drawer.classList.remove("open");
          btn.classList.remove("open");
          btn.setAttribute("aria-expanded", "false");
        });
      }
    }

    document.addEventListener('keydown', event => {
      if (event.key !== 'Escape') return;
      const expanded = dropdowns.find(dropdown => dropdown.open);
      if (expanded) {
        closeDropdowns();
        expanded.querySelector('summary')?.focus();
      } else if (drawer?.classList.contains('open')) {
        drawer.classList.remove('open');
        btn?.classList.remove('open');
        btn?.setAttribute('aria-expanded', 'false');
        btn?.focus();
      }
    }, { signal });
    document.addEventListener('astro:before-swap', () => {
      closeDropdowns();
      drawer?.classList.remove('open');
      btn?.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
    }, { once: true, signal });
    updateHeaderAuthState();

    document.getElementById("btnHeaderLogout")?.addEventListener("click", handleLogout);
    document.getElementById("btnMobileLogout")?.addEventListener("click", handleLogout);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeader);
  } else {
    initHeader();
  }
  document.addEventListener("astro:page-load", initHeader);
  window.addEventListener("incluxia:auth-changed", updateHeaderAuthState);
</script>

<style>

  .nav-dropdown { position: relative; }
  .nav-dropdown > summary { display: flex; align-items: center; gap: var(--space-2); cursor: pointer; list-style: none; }
  .nav-dropdown > summary::-webkit-details-marker { display: none; }
  .nav-dropdown > summary svg { flex-shrink: 0; transition: transform var(--transition-fast); }
  .nav-dropdown[open] > summary svg { transform: rotate(180deg); }
  .nav-submenu { position: absolute; top: calc(100% + var(--space-3)); left: 0; min-width: 210px; padding: var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-card); z-index: 1; }
  .nav-submenu::before { content: ''; position: absolute; bottom: 100%; left: 0; right: 0; height: var(--space-3); }
  .nav-submenu a { display: block; padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); font-size: var(--text-sm); font-weight: 500; line-height: 1.4; color: var(--color-text-main); white-space: nowrap; }
  .nav-submenu a:hover, .nav-submenu a:focus-visible { background: var(--color-bg); color: var(--color-primary); }
  .nav-submenu a[aria-current='page'] { color: var(--color-primary); font-weight: 700; }
  .mobile-nav-dropdown > summary { justify-content: space-between; }
  .mobile-nav-dropdown .nav-submenu { position: static; min-width: 0; margin-top: var(--space-2); border: none; padding: 0 0 0 var(--space-4); }
  .mobile-nav-dropdown .nav-submenu::before { display: none; }
  .mobile-nav-dropdown .nav-submenu a { min-height: 44px; white-space: normal; }

  /* 1. Structural Fixed Rail */
  .header {
    position: fixed;
    top: 1rem;
    left: 0;
    width: 100%;
    z-index: 1000;
    pointer-events: none;
    transition: top var(--transition-normal);
  }

  .header-container {
    position: relative;
  }

  /* 2. Floating Navbar Capsule */
  .navbar-capsule {
    pointer-events: auto;
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    border: none;
    box-shadow: none; /* ZERO SHADOWS */
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--space-4);
    padding-block: var(--space-2);
    transition: all var(--transition-normal);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-logo {
    height: 44px;
    width: auto;
    object-fit: contain;
  }

  .app-brand { font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: 800; letter-spacing: -0.035em; color: var(--color-primary); }

  /* Desktop Nav */
  .nav-desktop {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
    padding: 0.5rem 0.25rem;
    position: relative;
    transition: color var(--transition-fast);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 2.5px;
    background-color: var(--color-primary);
    transition: width var(--transition-normal);
    border-radius: var(--radius-full);
  }

  .nav-link:hover {
    color: var(--color-primary-light);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .nav-link.active {
    color: var(--color-primary);
    font-weight: 700;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Botón Publicar Trabajo estilo Contra */
  .header-post-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.48rem 0.95rem;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    transition: all var(--transition-fast);
    box-shadow: none;
    white-space: nowrap;
  }

  .header-post-btn:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-1px);
    box-shadow: none;
    color: var(--color-white);
  }

  .mobile-post-btn-wrap {
    padding: var(--space-3) var(--space-2);
  }

  .mobile-post-job-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background-color: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    box-sizing: border-box;
    transition: background-color var(--transition-fast);
  }

  .mobile-post-job-btn:hover {
    background-color: var(--color-primary-hover);
    color: var(--color-white);
  }

  /* Header Auth Buttons & User Status */
  .auth-header-wrapper {
    display: flex;
    align-items: center;
  }

  .header-auth-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .header-auth-btn:hover {
    background-color: var(--color-primary);
    color: var(--color-white);
    border-color: var(--color-primary);
  }

  .header-user-capsule {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.2rem 0.35rem 0.2rem 0.25rem;
  }

  .user-pill-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-inline: 0.25rem 0.5rem;
  }

  .user-avatar-dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .user-name-label {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    max-width: 100px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header-logout-btn {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
