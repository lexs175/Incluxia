---
import ExpandableButton from "../ui/ExpandableButton.astro";
import ActionButton from "../ui/ActionButton.astro";
import AccountAvatar from "../ui/AccountAvatar.astro";
import HeaderNav from "./HeaderNav.astro";
import MenuToggle from "../ui/MenuToggle.astro";

interface Props { activePath?: string; }
const { activePath = "/" } = Astro.props;
---

<header class="header">
  <div class="container header-container">
    <div class="navbar-capsule">
      <a href="/" class="brand" aria-label="Eco Bolivia - Inicio"><span class="app-brand">Eco</span></a>

      <nav class="nav-desktop" aria-label="Navegación principal"><HeaderNav activePath={activePath} /></nav>

      <div class="header-actions">
        <ActionButton text="Ingresar" id="btnHeaderLogin" variant="secondary" class="header-login" data-auth-trigger="login" data-guest />
        <ExpandableButton text="Crear cuenta" size="md" variant="primary" class="header-register" data-auth-trigger="register" data-guest />

        <details class="nav-dropdown account-menu header-profile-wrapper" id="headerProfileWrapper" data-nav-dropdown data-account-menu data-member>
          <summary class:list={["account-trigger", { active: activePath === "/perfil" }]} id="headerAccountTrigger" aria-label="Menú de cuenta">
            <AccountAvatar imageId="headerProfileImg" />
            <span class="header-profile-name" id="headerProfileName" data-account-short-name>Cuenta</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </summary>
          <div class="account-popup">
            <a href="/perfil" id="headerProfileLink" data-nav-destination>Mi perfil</a>
            <div class="account-logout"><ActionButton text="Cerrar sesión" id="btnHeaderLogout" variant="quiet" /></div>
          </div>
        </details>

        <MenuToggle class="mobile-toggle" id="mobileMenuBtn" controls="mobileDrawer" />
      </div>
    </div>

    <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true" inert>
      <nav class="nav-mobile" aria-label="Navegación móvil">
        <div class="mobile-nav-scroll">
          <div class="mobile-guest-actions" id="mobileGuestBox" data-guest>
            <ActionButton text="Ingresar" variant="secondary" data-auth-trigger="login" />
            <ActionButton text="Crear cuenta" data-auth-trigger="register" />
          </div>

          <HeaderNav activePath={activePath} mobile />
        </div>

        <div class="mobile-menu-footer" data-member>
          <a href="/perfil" class="mobile-account-link" id="mobileAccountLink" data-nav-destination>
            <AccountAvatar />
            <span class="mobile-account-copy"><strong data-account-name>Cuenta</strong><span>Mi perfil</span></span>
          </a>
          <ActionButton text="Cerrar sesión" id="btnMobileLogout" variant="danger" />
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  import { setImage } from "../../lib/image-client";
  import { readStore, user as currentUser, writeStore } from "../../lib/demo";
  function updateHeaderAuthState() {
    const root = document.querySelector(".header");
    if (!root) return;
    const account = currentUser();
    document.documentElement.dataset.session = account ? "member" : "guest";
    const name = account?.name || "Cuenta";
    root.querySelectorAll("[data-account-name]").forEach((element) => { element.textContent = name; });
    root.querySelectorAll("[data-account-short-name]").forEach((element) => { element.textContent = name.split(" ")[0]; });
    root.querySelector("#headerAccountTrigger")?.setAttribute("aria-label", "Menú de cuenta de " + name);
    root.querySelectorAll<HTMLElement>("[data-account-avatar]").forEach((avatar) => {
      const image = avatar.querySelector<HTMLImageElement>("[data-account-image]")!;
      const initial = avatar.querySelector<HTMLElement>("[data-account-initial]")!;
      initial.textContent = name.charAt(0).toLocaleUpperCase("es");
      image.hidden = !account?.photo;
      initial.hidden = !!account?.photo;
      image.onerror = () => { image.hidden = true; initial.hidden = false; };
      setImage(image, account?.photo || undefined);
    });
  }

  function handleLogout() {
    const state = readStore();
    state.sessionId = null;
    writeStore(state);
    window.location.assign("/");
  }

  let headerEvents: AbortController | undefined;

  function initHeader() {
    const root = document.querySelector(".header") as HTMLElement;
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";
    headerEvents?.abort();
    headerEvents = new AbortController();
    const signal = headerEvents.signal;
    const dropdowns = [
      ...root.querySelectorAll<HTMLDetailsElement>("[data-nav-dropdown]"),
    ];
    const closeDropdowns = (except?: HTMLDetailsElement) =>
      dropdowns.forEach((dropdown) => {
        if (dropdown !== except) dropdown.open = false;
      });
    const markDestination = () => {
      const current = new URL(location.href);
      for (const link of root.querySelectorAll<HTMLAnchorElement>(
        "[data-nav-destination]",
      )) {
        const destination = new URL(link.href);
        const defaultTab =
          destination.pathname === "/publicar" ? "new" : "sent";
        const selected =
          destination.pathname === current.pathname &&
          (destination.searchParams.get("tab") || defaultTab) ===
            (current.searchParams.get("tab") || defaultTab);
        if (selected) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      }
    };
    dropdowns.forEach((dropdown) => {
      dropdown.addEventListener(
        "toggle",
        () => {
          if (dropdown.open) closeDropdowns(dropdown);
        },
        { signal },
      );
      if (!dropdown.classList.contains("mobile-nav-dropdown")) {
        let closeTimer: ReturnType<typeof setTimeout> | undefined;
        const cancelClose = () => { clearTimeout(closeTimer); };
        signal.addEventListener("abort", cancelClose, { once: true });
        dropdown.addEventListener(
          "pointerenter",
          (event) => {
            if (
              event.pointerType !== "mouse" ||
              !matchMedia("(hover: hover) and (pointer: fine)").matches
            )
              return;
            cancelClose();
            closeDropdowns(dropdown);
            dropdown.open = true;
          },
          { signal },
        );
        dropdown.addEventListener(
          "pointerleave",
          () => {
            cancelClose();
            closeTimer = setTimeout(() => {
              if (!dropdown.contains(document.activeElement) && !dropdown.matches(":hover"))
                dropdown.open = false;
            }, 160);
          },
          { signal },
        );
        dropdown.addEventListener(
          "focusout",
          (event) => {
            if (
              !dropdown.contains(event.relatedTarget as Node | null) &&
              !dropdown.matches(":hover")
            )
              dropdown.open = false;
          },
          { signal },
        );
      }
      dropdown
        .querySelectorAll("a")
        .forEach((link) =>
          link.addEventListener("click", () => closeDropdowns(), { signal }),
        );
    });
    document.addEventListener(
      "click",
      (event) => {
        const target = event.target as Node;
        dropdowns.forEach((dropdown) => {
          if (!dropdown.contains(target)) dropdown.open = false;
        });
      },
      { signal },
    );
    document.addEventListener("Eco:view-changed", markDestination, {
      signal,
    });
    markDestination();
    const btn = document.getElementById("mobileMenuBtn");
    const drawer = document.getElementById("mobileDrawer");
    let menuOpen = false;
    let savedScrollY = 0;
    let background: [HTMLElement, boolean][] = [];

    function setMobileMenu(open: boolean, restoreFocus = true) {
      if (!btn || !drawer || menuOpen === open) return;
      menuOpen = open;
      root.dataset.menuOpen = String(open);
      drawer.classList.toggle("open", open);
      drawer.setAttribute("aria-hidden", String(!open));
      drawer.inert = !open;
      btn.classList.toggle("open", open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Cerrar menú de navegación" : "Abrir menú de navegación");

      if (open) {
        savedScrollY = window.scrollY;
        document.body.style.setProperty("--mobile-menu-scroll-top", `${-savedScrollY}px`);
        document.documentElement.classList.add("mobile-menu-open");
        root.setAttribute("role", "dialog");
        root.setAttribute("aria-modal", "true");
        root.setAttribute("aria-label", "Menú de navegación");
        background = [...document.querySelectorAll<HTMLElement>("main, body > footer, .skip-to-content")]
          .map((element) => [element, element.inert]);
        background.forEach(([element]) => { element.inert = true; });
        drawer.querySelector(".mobile-nav-scroll")!.scrollTop = 0;
        btn.focus({ preventScroll: true });
      } else {
        closeDropdowns();
        root.removeAttribute("role");
        root.removeAttribute("aria-modal");
        root.removeAttribute("aria-label");
        document.documentElement.classList.remove("mobile-menu-open");
        document.body.style.removeProperty("--mobile-menu-scroll-top");
        background.forEach(([element, inert]) => { element.inert = inert; });
        background = [];
        window.scrollTo({ top: savedScrollY, behavior: "instant" });
        if (restoreFocus) btn.focus({ preventScroll: true });
      }
    }

    if (btn && drawer) {
      btn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        setMobileMenu(!menuOpen);
      };

      drawer.addEventListener("click", (event) => {
        const action = (event.target as Element).closest("a, [data-auth-trigger], #btnMobileLogout");
        if (action) setMobileMenu(false, action.hasAttribute("data-auth-trigger"));
      }, { signal });
    }

    matchMedia("(min-width: 1025px)").addEventListener("change", (event) => {
      closeDropdowns();
      if (event.matches) setMobileMenu(false, false);
    }, { signal });

    document.addEventListener(
      "keydown",
      (event) => {
        if (menuOpen && event.key === "Tab") {
          const controls = [...root.querySelectorAll<HTMLElement>("a[href], button:not(:disabled), summary, [tabindex='0']")]
            .filter((element) => element.getClientRects().length && !element.closest("[inert]"));
          const first = controls[0];
          const last = controls.at(-1);
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault(); last?.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault(); first?.focus();
          }
        }
        if (event.key !== "Escape") return;
        const expanded = dropdowns.find((dropdown) => dropdown.open);
        if (expanded) {
          closeDropdowns();
          expanded.querySelector("summary")?.focus();
        } else if (menuOpen) {
          setMobileMenu(false);
        }
      },
      { signal },
    );
    document.addEventListener(
      "astro:before-swap",
      () => {
        closeDropdowns();
        setMobileMenu(false, false);
      },
      { once: true, signal },
    );
    updateHeaderAuthState();

    document
      .getElementById("btnHeaderLogout")
      ?.addEventListener("click", handleLogout);
    document
      .getElementById("btnMobileLogout")
      ?.addEventListener("click", handleLogout);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeader);
  } else {
    initHeader();
  }
  document.addEventListener("astro:page-load", initHeader);
  window.addEventListener("incluxia:auth-changed", updateHeaderAuthState);
</script>

<style>
  :global(html.mobile-menu-open) { overflow: hidden; overscroll-behavior: none; }
  :global(html.mobile-menu-open body) { position: fixed; top: var(--mobile-menu-scroll-top); overflow: hidden; }
  .header { position: fixed; top: var(--space-4); left: 0; width: 100%; z-index: 1000; pointer-events: none; }
  .header-container { position: relative; }
  .navbar-capsule { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; min-height: var(--app-header-height); padding: var(--space-2) var(--space-4); border-radius: var(--radius-md); background: var(--color-white); pointer-events: auto; }
  .brand { display: inline-flex; align-items: center; justify-self: start; min-height: 44px; color: var(--color-primary); }
  .app-brand { font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: 800; letter-spacing: -0.035em; line-height: 1; }
  .nav-desktop { justify-self: center; }
  .header-actions { display: flex; align-items: center; justify-self: end; gap: var(--space-3); }
  .header-actions :global(.header-register) { --btn-h: 44px; }
  .account-menu { position: relative; }
  .account-trigger { display: flex; align-items: center; gap: var(--space-2); min-height: 44px; padding: var(--space-1) var(--space-2); border-radius: var(--radius-md); color: var(--color-text-main); list-style: none; cursor: pointer; }
  .account-trigger::-webkit-details-marker { display: none; }
  .account-trigger:hover, .account-menu[open] .account-trigger { background: var(--color-bg-alt); }
  .account-trigger.active { color: var(--color-primary); }
  .account-trigger > svg { flex-shrink: 0; transition: transform var(--transition-fast); }
  .account-menu[open] .account-trigger > svg { transform: rotate(180deg); }
  .header-profile-name { max-width: 9rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--text-sm); font-weight: 600; }
  .account-popup { position: absolute; top: calc(100% + var(--space-2)); right: 0; width: 224px; padding: var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-card); }
  .account-popup::before { content: ""; position: absolute; inset-inline: 0; bottom: 100%; height: var(--space-2); }
  .account-popup > a { display: flex; align-items: center; min-height: 44px; padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); color: var(--color-text-main); font-size: var(--text-sm); line-height: 1.4; }
  .account-popup > a:hover, .account-popup > a[aria-current="page"] { background: var(--color-bg-alt); color: var(--color-primary); }
  .account-logout { margin-top: var(--space-2); padding-top: var(--space-2); border-top: 1px solid var(--color-border); }
  .account-popup :global(.management-action) { justify-content: flex-start; width: 100%; padding-inline: var(--space-3); font-weight: 500; }
  .brand:focus-visible, .account-trigger:focus-visible, .account-popup > a:focus-visible, .mobile-account-link:focus-visible { outline: 2px solid var(--color-primary); outline-offset: var(--space-1); border-radius: var(--radius-md); }
  .header-actions :global(.mobile-toggle) { display: none; }
  .mobile-drawer { display: none; padding-top: var(--space-4); background: var(--color-white); }
  .mobile-drawer.open { display: flex; flex: 1; min-height: 0; overflow: hidden; pointer-events: auto; }
  .nav-mobile { display: flex; flex: 1; flex-direction: column; min-width: 0; min-height: 0; }
  .mobile-nav-scroll { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior-y: contain; padding: var(--space-1) var(--space-1) var(--space-6); }
  .mobile-guest-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); padding-bottom: var(--space-5); margin-bottom: var(--space-3); border-bottom: 1px solid var(--color-border); }
  .mobile-guest-actions :global(.management-action) { padding-inline: var(--space-2); }
  .mobile-account-link { display: flex; flex: 1; min-width: 0; align-items: center; gap: var(--space-3); padding: var(--space-3); border-radius: var(--radius-md); color: var(--color-text-main); }
  .mobile-account-link[aria-current="page"] { background: var(--color-bg-alt); }
  .mobile-account-copy { display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
  .mobile-account-copy strong { font-size: var(--text-sm); font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
  .mobile-account-copy > span { color: var(--color-text-muted); font-size: var(--text-sm); line-height: 1.4; }
  .mobile-menu-footer { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); flex-shrink: 0; padding-top: var(--space-3); padding-inline: var(--space-1); padding-bottom: max(var(--space-4), env(safe-area-inset-bottom)); }
  .mobile-menu-footer :global(.management-action) { flex-shrink: 0; padding-inline: var(--space-2); font-weight: 500; }
  @media (hover: hover) and (pointer: fine) { .mobile-account-link:hover { background: var(--color-bg-alt); } }
  @media (max-width: 1024px) {
    .navbar-capsule { grid-template-columns: minmax(0, 1fr) auto; min-height: var(--space-16); }
    .nav-desktop, .header-profile-wrapper { display: none; }
    .header-actions :global(.mobile-toggle) { display: inline-flex; }
    .header[data-menu-open="true"] { inset: 0; height: 100dvh; background: var(--color-white); pointer-events: auto; }
    .header[data-menu-open="true"] .header-container { display: flex; flex-direction: column; height: 100%; min-height: 0; padding-top: env(safe-area-inset-top); }
    .header[data-menu-open="true"] .navbar-capsule { flex-shrink: 0; }
    .header[data-menu-open="true"] .header-actions :global([data-guest]) { display: none !important; }
  }
  @media (max-width: 479px) {
    .header { top: var(--space-3); }
    .navbar-capsule { padding-inline: var(--space-3); }
    .header-actions { gap: var(--space-2); }
    .header-actions :global(.header-login) { display: none; }
  }
  @media (max-width: 359px) {
    .header-actions :global(.header-register) { display: none; }
    .mobile-menu-footer { flex-wrap: wrap; }
    .mobile-account-link { flex-basis: 100%; }
    .mobile-menu-footer :global(.management-action) { margin-inline-start: auto; }
  }
  @media (prefers-reduced-motion: reduce) { .account-trigger > svg { transition: none; } }
</style>
