    </div>

    <!-- Bottom Bar: Sub-Footer -->
    <div class="footer-sub-bar">
      <div class="sub-bar-top-row">
        <p class="sub-bar-copyright">
          &copy; {new Date().getFullYear()} Eco. Todos los derechos reservados.
        </p>
        <p class="sub-bar-affiliation">
          Eco: Trabajos para personas con hipoacusia en Bolivia
        </p>
      </div>

      <p class="sub-bar-legal">
        Eco es una plataforma digital y gratuita para ayudar a personas con
        hipoacusia a encontrar trabajo en Bolivia, bajo el respaldo de la Ley
        223 y la Ley 977. Todas las postulaciones y la atención son 100% por
        chat y sin costo.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    padding-top: 5rem;
    padding-bottom: 3rem;
    margin-top: auto;
    border-top: 1px solid rgba(var(--white-rgb), 0.15);
    width: 100%;
  }

  .footer-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  /* 5-Column Equal Grid */
  .footer-top-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.3fr 1.2fr;
    gap: 2.5rem;
    align-items: start;
    width: 100%;
    margin-bottom: 4rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  /* Connect Heading & Socials */
  .connect-heading {
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.02em;
  }

  /* Column Titles & Desktop Button Reset */
  .col-accordion-toggle {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
    color: inherit;
    cursor: default;
    pointer-events: none;
  }

  .col-title {
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.01em;
  }

  .col-chevron {
    display: none;
  }

  .col-accordion-panel {
    display: block;
    width: 100%;
  }

  /* Links */
  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .col-links li {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .col-links a {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.875rem;
    line-height: 1.4;
    text-decoration: none;
    display: inline-block;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .col-links a:hover {
    color: var(--color-white);
    transform: translateX(3px);
  }

  /* Contact Info */
  .contact-box {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.5;
  }

  .contact-highlight {
    color: var(--color-text-inverse);
    font-weight: 600;
    margin: 0;
  }

  .contact-text {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
  }

  .contact-phone {
    color: var(--color-white);
    font-size: 0.95rem;
    font-weight: 700;
    margin-top: 0.35rem;
    display: inline-block;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-phone:hover {
    text-decoration: underline;
  }

  /* Massive Hero Brand Logo */
  .footer-brand-stage {
    width: 100%;
    margin-top: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .brand-svg-hero {
    width: 100%;
    height: auto;
    max-height: 250px;
    display: block;
    color: var(--color-text-inverse);
    transition:
      color 0.3s ease,
      opacity 0.3s ease;
  }

  .footer-brand-stage:hover .brand-svg-hero {
    opacity: 0.85;
  }

  /* Sub-Footer */
  .footer-sub-bar {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .sub-bar-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .sub-bar-copyright {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.825rem;
    margin: 0;
  }

  .sub-bar-affiliation {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.825rem;
    font-weight: 500;
    margin: 0;
  }

  .sub-bar-legal {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
    line-height: 1.6;
    margin: 0;
  }

  /* ==========================================================
     RESPONSIVE BREAKPOINTS (ESTÁNDAR DEL PROYECTO)
     - Tablet: max-width: 1024px
     - Mobile Landscape: max-width: 767px
     - Mobile Portrait: max-width: 479px (base 240px)
     ========================================================== */

  /* 1. Tablet Tier (hasta 1024px) */
  @media (max-width: 1024px) {
    .footer-top-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6, 1.5rem);
    }
    .col-connect {
      grid-column: span 3;
    }
  }

  /* 2. Mobile Landscape Tier (hasta 767px) - Accordions Activated */
  @media (max-width: 767px) {
    .footer {
      padding-top: var(--space-10, 2.5rem);
      padding-bottom: var(--space-8, 2rem);
    }
    .footer-top-grid {
      grid-template-columns: 1fr;
      gap: 0;
      margin-bottom: var(--space-8, 2rem);
    }
    .col-connect {
      grid-column: span 1;
      margin-bottom: 1.5rem;
    }
    .connect-heading {
      font-size: 1.6rem;
    }

    /* Accordion Toggle UI */
    .col-accordion-toggle {
      pointer-events: auto;
      cursor: pointer;
      padding-block: 0.9rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      transition: background-color 0.2s ease;
    }

    .col-accordion-toggle:active {
      background-color: rgba(255, 255, 255, 0.05);
    }

    .col-title {
      font-size: 1.15rem;
      margin: 0;
    }

    .col-chevron {
      display: block;
      color: var(--color-white);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .footer-accordion.is-open .col-chevron {
      transform: rotate(180deg);
    }

    /* Accordion Panel */
    .col-accordion-panel {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      transition:
        max-height 0.35s ease,
        opacity 0.3s ease,
        padding 0.3s ease;
      padding-top: 0;
      padding-bottom: 0;
    }

    .footer-accordion.is-open .col-accordion-panel {
      max-height: 400px;
      opacity: 1;
      visibility: visible;
      padding-top: 0.85rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .footer-brand-stage {
      margin-top: 3rem;
      margin-bottom: 2.5rem;
    }
    .sub-bar-top-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }

  /* 3. Mobile Portrait Tier (hasta 479px - base 240px) */
  @media (max-width: 479px) {
    .footer {
      padding-top: var(--space-8, 2rem);
      padding-bottom: var(--space-6, 1.5rem);
    }
    .connect-heading {
      font-size: 1.35rem;
    }
    .col-title {
      font-size: 1.5rem;
    }
    .footer-brand-stage {
      margin-top: 2rem;
      margin-bottom: 1.5rem;
    }
  }
</style>

<script>
  function setupFooterAccordions() {
    const accordions = document.querySelectorAll(".footer-accordion");
    accordions.forEach((acc) => {
      const toggle = acc.querySelector(".col-accordion-toggle");
      if (!toggle) return;

      // Handle click on accordion header
      toggle.onclick = (e) => {
        // Only active on mobile / tablet <= 767px
        if (window.innerWidth > 767) return;

        e.preventDefault();
        const isOpen = acc.classList.contains("is-open");

        // Close other accordions for clean accordion UX
        accordions.forEach((other) => {
          if (other !== acc) {
            other.classList.remove("is-open");
            other
              .querySelector(".col-accordion-toggle")
              ?.setAttribute("aria-expanded", "false");
          }
        });

        if (isOpen) {
          acc.classList.remove("is-open");
          toggle.setAttribute("aria-expanded", "false");
        } else {
          acc.classList.add("is-open");
          toggle.setAttribute("aria-expanded", "true");
        }
      };
    });
  }

  document.addEventListener("astro:page-load", setupFooterAccordions);
</script>
