---
import SocialLinks from "../ui/SocialLinks.astro";
// Footer Component with 21shares-inspired layout & mobile accordion
---

<footer class="footer">
  <div class="container footer-container">
    <!-- Top Grid: 4 Columns (Desktop) / Mobile Accordion -->
    <div class="footer-top-grid">
      <!-- Col 1: Connect with us -->
      <div class="footer-col col-connect">
        <h3 class="connect-heading">Conéctate con<br />nosotros hoy</h3>
        <SocialLinks />
      </div>

      <!-- Col 2: Navegación (Accordion on mobile) -->
      <div class="footer-col footer-accordion">
        <button class="col-accordion-toggle" aria-expanded="false">
          <span class="col-title">Navegación</span>
          <svg
            class="col-chevron"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="col-accordion-panel">
          <ul class="col-links">
            <li><a href="/">Inicio</a></li>
            <li><a href="/empleos">Ofertas de Empleo</a></li>
            <li><a href="/casos-de-exito">Casos de Éxito</a></li>
          </ul>
        </div>
      </div>

      <!-- Col 3: Documentos & Leyes (Accordion on mobile) -->
      <div class="footer-col footer-accordion">
        <button class="col-accordion-toggle" aria-expanded="false">
          <span class="col-title">Cómo usar Eco</span>
          <svg
            class="col-chevron"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="col-accordion-panel">
          <ul class="col-links">
            <li>
              <a href="/#buscar-trabajo">Buscar trabajo y postular</a>
            </li>
            <li>
              <a href="/#contratar-talento">Contratar profesionales</a>
            </li>
            <li>
              <a href="/#como-publicar">Publicar como empresa</a>
            </li>
            <li>
              <a href="/#como-publicar">Publicar como persona</a>
            </li>
            <li>
              <a href="/#tu-actividad">Perfil y postulaciones</a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Col 4: Contacto (Accordion on mobile) -->
      <div class="footer-col footer-accordion">
        <button class="col-accordion-toggle" aria-expanded="false">
          <span class="col-title">Contacto</span>
          <svg
            class="col-chevron"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="col-accordion-panel">
          <div class="contact-box">
            <p class="contact-highlight">Eco Bolivia</p>
            <p class="contact-text">Plataforma 100% Digital</p>
            <p class="contact-text">Atención por WhatsApp y Correo</p>
            <a
              href="https://wa.me/59172255726"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-phone"
            >
              (+591) 72255726
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Center/Bottom: Massive Vector Brand Logo -->
    <div class="footer-brand-stage" aria-hidden="true">
